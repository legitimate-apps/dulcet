<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_surface">
    <ImageView android:id="@+id/widget_artwork" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_marginEnd="12dp" android:src="@drawable/widget_artwork" android:scaleType="centerCrop"
        android:importantForAccessibility="no" android:background="@drawable/widget_art_frame" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/widget_on_surface" android:textSize="16sp"
            android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/widget_open_library" android:textColor="@color/widget_on_surface_variant"
            android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginStart="8dp" android:padding="12dp" android:src="@drawable/widget_play"
        android:background="@drawable/widget_control" android:contentDescription="@string/widget_play" />
</LinearLayout>