<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application>
        <!-- Not exported: the notification, lock screen and media buttons reach playback through
             the in-process platform session. Exporting would also expose the local binding. -->
        <service android:name="com.legitimateapps.dulcet.playback.PlaybackService"
            android:exported="false" android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.legitimateapps.dulcet.search.SearchDetailActivity"
            android:exported="false" />
    </application>
</manifest>
