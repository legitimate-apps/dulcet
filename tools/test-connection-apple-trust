class BootedSimulatorContext(unittest.TestCase):
    def test_native_fixture_disables_standalone_on_exact_selected_task(self):
        for mode, task, property_name in [('core-ios', 'iosSimulatorArm64Test', 'dulcet.iosSimulatorUdid'),
                                          ('core-tvos', 'tvosSimulatorArm64Test', 'dulcet.tvosSimulatorUdid')]:
            with self.subTest(mode=mode), tempfile.TemporaryDirectory() as folder:
                root = Path(folder); work = root/'work'; work.mkdir()
                simulator = '11111111-2222-4333-8444-555555555555'
                calls = []
                def run(argv, **kwargs):
                    calls.append((argv, kwargs))
                    if str(argv[0]).endswith('gradlew'):
                        self.assertIn('--init-script', argv)
                        script = Path(argv[argv.index('--init-script')+1]).read_text()
                        self.assertIn("tasks.named('" + task + "')", script)
                        self.assertIn('task.standalone.set(false)', script)
                        self.assertIn("task.device.get() != '" + simulator + "'", script)
                        self.assertIn('|| task.standalone.get()', script)
                        self.assertIn('-P' + property_name + '=' + simulator, argv)
                        self.assertEqual(kwargs['env']['SIMCTL_CHILD_DULCET_MULTIPATH_MANIFEST'], 'fixture-manifest')
                        self.assertEqual(kwargs['env']['SIMCTL_CHILD_DULCET_CONNECTIONS_SEED'], 'fixture-seed')
                with patch.object(proofs, 'ROOT', root), patch.object(proofs, 'run', side_effect=run):
                    proofs.execute(mode, simulator, {'DULCET_MULTIPATH_MANIFEST':'fixture-manifest',
                        'DULCET_CONNECTIONS_SEED':'fixture-seed'}, work, {})
                self.assertEqual(sum(str(argv[0]).endswith('gradlew') for argv, _ in calls), 1)

    def test_missing_or_non_uuid_simulator_is_refused_before_gradle(self):
        for simulator in (None, 'booted', "fixture' injected"):
            with self.subTest(simulator=simulator), tempfile.TemporaryDirectory() as folder:
                with patch.object(proofs, 'run') as run:
                    with self.assertRaisesRegex(RuntimeError, 'concrete native core simulator UUID'):
                        proofs.execute('core-ios', simulator, {}, Path(folder), {})
                run.assert_not_called()


class NativeCoreReportRetention(unittest.TestCase):
    def test_selected_run_keeps_prior_reader_xml_but_verifies_only_new_target_xml(self):
        with tempfile.TemporaryDirectory() as folder:
            root = Path(folder); results = root/'core/build/test-results/iosSimulatorArm64Test'
            results.mkdir(parents=True); (results/'Reader.xml').write_text('<testsuite tests="17"/>')
            work = root/'proof'; work.mkdir(); calls = []
            def run(command, **kwargs):
                calls.append(command)
                if str(command[0]).endswith('gradlew'):
                    self.assertEqual(list(results.glob('*.xml')), [])
                    (results/'Connections.xml').write_text('<testsuite tests="5"/>')
                else:
                    selected = Path(command[4])
                    self.assertEqual(selected, work/'junit')
                    self.assertEqual([p.name for p in selected.glob('*.xml')], ['Connections.xml'])
            with patch.object(proofs, 'ROOT', root), patch.object(proofs, 'run', run):
                proofs.execute('core-ios', '11111111-2222-4333-8444-555555555555',
                    {'DULCET_MULTIPATH_MANIFEST':'fixture', 'DULCET_CONNECTIONS_SEED':'seed'}, work, {})
            self.assertEqual((results/'Reader.xml').read_text(), '<testsuite tests="17"/>')
            self.assertTrue((results/'Connections.xml').exists())
            self.assertEqual(calls[0][-1], '-Pdulcet.iosSimulatorUdid=11111111-2222-4333-8444-555555555555')
            self.assertIn('--rerun', calls[0])
            self.assertNotIn('--rerun-tasks', calls[0])

    def test_a_failed_pretest_cannot_borrow_old_passing_connection_xml(self):
        with tempfile.TemporaryDirectory() as folder:
            root = Path(folder); results = root/'core/build/test-results/macosArm64Test'
            results.mkdir(parents=True); (results/'Connections.xml').write_text('<testsuite tests="5"/>')
            work = root/'proof'; work.mkdir()
            with patch.object(proofs, 'ROOT', root), patch.object(proofs, 'run', side_effect=subprocess.CalledProcessError(1, ['gradlew'])):
                with self.assertRaises(subprocess.CalledProcessError):
                    proofs.execute('core', None, {}, work, {})
            self.assertEqual(list((work/'junit').glob('*.xml')), [])
            self.assertTrue((results/'Connections.xml').exists())


class FocusedWorkflowShell(unittest.TestCase):
    def test_controls_and_all_prebuild_arguments_work_with_hosted_bash_nounset(self):
        workflow = (Path(__file__).parent.parent / '.github/workflows/apple-core-test-soak.yml').read_text()
        start = workflow.index('          case "$CONNECTION_SURFACE" in')
        stop = workflow.index('\n      - name:', start)
        script = '\n'.join(line[10:] for line in workflow[start:stop].splitlines())
        script = script.replace('./gradlew', 'gradlew')
        script = 'gradlew() { printf "%s\\n" "$@"; }\n' + script
        for surface in ('mac', 'iphone', 'tvos'):
            for stage in ('all', 'controls'):
                with self.subTest(surface=surface, stage=stage):
                    result = subprocess.run(['/bin/bash', '-euc', script], text=True, capture_output=True,
                        env={'CONNECTION_SURFACE': surface, 'DULCET_CONNECTIONS_STAGE': stage})
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertIn(':server:installDist', result.stdout)
                    self.assertIn(':core:linkDebugFramework', result.stdout)
                    self.assertEqual(':core:linkDebugTest' in result.stdout, stage == 'all')


