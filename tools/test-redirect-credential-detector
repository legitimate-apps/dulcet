#!/usr/bin/env python3
"""Mutation controls for the closed cross-origin target-request oracle."""

from __future__ import annotations

import base64
from dataclasses import replace
from pathlib import Path
import runpy
from urllib.parse import quote


module = runpy.run_path(Path(__file__).parent / "conformance-env" / "redirect-server")
ObservedChannel = module["ObservedChannel"]
ObservedRequest = module["ObservedRequest"]
cross_origin_target_matches_expectation = module["cross_origin_target_matches_expectation"]

credential = "credential/with+syntax?"
encoded = credential.encode("utf-8")
base64_once = base64.b64encode(encoded)
target_only_mutations = {
    "raw": credential,
    "framed": f"Dulcet/{credential}",
    "percent": f"metadata={quote(credential, safe='')}",
    "base64": f"Dulcet {base64.b64encode(encoded).decode('ascii')}",
    "base64-unpadded": base64.b64encode(encoded).decode("ascii").rstrip("="),
    "base64url": base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("="),
    "base32": base64.b32encode(encoded).decode("ascii").rstrip("="),
    "base85": base64.b85encode(encoded).decode("ascii"),
    "hex": encoded.hex(),
    "uppercase-hex": encoded.hex().upper(),
    "double-base64": base64.b64encode(base64_once).decode("ascii"),
}

salt = "00112233445566778899aabbccddeeff"
encoded_credential = quote(credential, safe="")
source_body = (
    f"c=Dulcet&f=json&s={salt}&t={encoded_credential}&u=dulcet-admin&v=1.16.1"
).encode("ascii")
source_channels = tuple(sorted((
    ObservedChannel("header", "content-length", (str(len(source_body)),)),
    ObservedChannel("header", "content-type", ("application/x-www-form-urlencoded; charset=UTF-8",)),
    ObservedChannel("header", "host", ("127.0.0.1:4540",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("form", "c", ("Dulcet",)),
    ObservedChannel("form", "f", ("json",)),
    ObservedChannel("form", "s", (salt,)),
    ObservedChannel("form", "t", (credential,)),
    ObservedChannel("form", "u", ("dulcet-admin",)),
    ObservedChannel("form", "v", ("1.16.1",)),
)))
target_body = b"c=Dulcet&f=json&v=1.16.1"
target_channels = tuple(sorted((
    ObservedChannel("header", "content-length", (str(len(target_body)),)),
    ObservedChannel("header", "content-type", ("application/x-www-form-urlencoded; charset=UTF-8",)),
    ObservedChannel("header", "host", ("127.0.0.1:4541",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("form", "c", ("Dulcet",)),
    ObservedChannel("form", "f", ("json",)),
    ObservedChannel("form", "v", ("1.16.1",)),
)))
redirect_location = "http://127.0.0.1:4541/cross-target/rest/ping.view"
source_request = ObservedRequest(
    method="POST",
    path="/cross-observe/rest/ping.view",
    raw_query="",
    body=source_body,
    channels=source_channels,
)
target_request = ObservedRequest(
    method="POST",
    path="/cross-target/rest/ping.view",
    raw_query="",
    body=target_body,
    channels=target_channels,
)

credential_bearing_target_path = (
    "/cross-target/rest/dulcet-admin/"
    f"{encoded_credential}/{salt}/ping.view"
)


def require_rejected(
    label: str,
    candidate: object,
    *,
    source: object = source_request,
    location: str = redirect_location,
) -> None:
    if cross_origin_target_matches_expectation(source, candidate, location):
        raise AssertionError(f"{label} target deviation was accepted")


require_rejected(
    "credential-bearing path",
    replace(target_request, path=credential_bearing_target_path),
)
require_rejected("GET-with-body method", replace(target_request, method="GET"))
require_rejected(
    "byte-reordered form body",
    replace(target_request, body=b"v=1.16.1&f=json&c=Dulcet"),
)

if not cross_origin_target_matches_expectation(source_request, target_request, redirect_location):
    raise AssertionError(
        "the specified credential-free target request was rejected"
    )

for label, value in target_only_mutations.items():
    mutated = tuple(
        ObservedChannel(channel.location, channel.name, (value,))
        if channel.location == "header" and channel.name == "user-agent"
        else channel
        for channel in target_channels
    )
    require_rejected(label, replace(target_request, channels=mutated))

source_query = (
    f"c=Dulcet&f=json&v=1.16.1&u=dulcet-admin&t={encoded_credential}&s={salt}"
)
source_query_channels = tuple(sorted((
    ObservedChannel("header", "host", ("127.0.0.1:4540",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("query", "c", ("Dulcet",)),
    ObservedChannel("query", "f", ("json",)),
    ObservedChannel("query", "s", (salt,)),
    ObservedChannel("query", "t", (credential,)),
    ObservedChannel("query", "u", ("dulcet-admin",)),
    ObservedChannel("query", "v", ("1.16.1",)),
)))
target_query = "c=Dulcet&f=json&v=1.16.1"
target_query_channels = tuple(sorted((
    ObservedChannel("header", "host", ("127.0.0.1:4541",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("query", "c", ("Dulcet",)),
    ObservedChannel("query", "f", ("json",)),
    ObservedChannel("query", "v", ("1.16.1",)),
)))
query_source_request = ObservedRequest(
    method="GET",
    path="/cross-observe-query/rest/ping.view",
    raw_query=source_query,
    body=b"",
    channels=source_query_channels,
)
query_target_request = ObservedRequest(
    method="GET",
    path="/cross-target-query/rest/ping.view",
    raw_query=target_query,
    body=b"",
    channels=target_query_channels,
)
query_redirect_location = "http://127.0.0.1:4541/cross-target-query/rest/ping.view"
if not cross_origin_target_matches_expectation(
    query_source_request,
    query_target_request,
    query_redirect_location,
):
    raise AssertionError("the specified credential-free query target request was rejected")
require_rejected(
    "byte-reordered query",
    replace(query_target_request, raw_query="v=1.16.1&f=json&c=Dulcet"),
    source=query_source_request,
    location=query_redirect_location,
)

print("closed redirect target oracle mutation controls pass")
