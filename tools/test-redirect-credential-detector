#!/usr/bin/env python3
"""Mutation controls for the closed cross-origin target-request oracle."""

from __future__ import annotations

import base64
from pathlib import Path
import runpy
from urllib.parse import quote


module = runpy.run_path(Path(__file__).parent / "conformance-env" / "redirect-server")
ObservedChannel = module["ObservedChannel"]
cross_origin_target_matches_expectation = module["cross_origin_target_matches_expectation"]

credential = "credential/with+syntax?"
encoded = credential.encode("utf-8")
base64_once = base64.b64encode(encoded)
target_only_mutations = {
    "raw": credential,
    "framed": f"Dulcet/{credential}",
    "percent": f"metadata={quote(credential, safe='')}",
    "base64": f"Dulcet {base64.b64encode(encoded).decode('ascii')}",
    "base64-unpadded": base64.b64encode(encoded).decode("ascii").rstrip("="),
    "base64url": base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("="),
    "base32": base64.b32encode(encoded).decode("ascii").rstrip("="),
    "base85": base64.b85encode(encoded).decode("ascii"),
    "hex": encoded.hex(),
    "uppercase-hex": encoded.hex().upper(),
    "double-base64": base64.b64encode(base64_once).decode("ascii"),
}

source = tuple(sorted((
    ObservedChannel("header", "content-length", ("132",)),
    ObservedChannel("header", "content-type", ("application/x-www-form-urlencoded; charset=UTF-8",)),
    ObservedChannel("header", "host", ("127.0.0.1:4540",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("form", "c", ("Dulcet",)),
    ObservedChannel("form", "f", ("json",)),
    ObservedChannel("form", "s", ("00112233445566778899aabbccddeeff",)),
    ObservedChannel("form", "t", (credential,)),
    ObservedChannel("form", "u", ("dulcet-admin",)),
    ObservedChannel("form", "v", ("1.16.1",)),
)))
target_body = b"c=Dulcet&f=json&v=1.16.1"
target = tuple(sorted((
    ObservedChannel("header", "content-length", (str(len(target_body)),)),
    ObservedChannel("header", "content-type", ("application/x-www-form-urlencoded; charset=UTF-8",)),
    ObservedChannel("header", "host", ("127.0.0.1:4541",)),
    ObservedChannel("header", "user-agent", ("ktor-client",)),
    ObservedChannel("form", "c", ("Dulcet",)),
    ObservedChannel("form", "f", ("json",)),
    ObservedChannel("form", "v", ("1.16.1",)),
)))

if not cross_origin_target_matches_expectation(source, target, target_body, "127.0.0.1:4541"):
    raise AssertionError("the specified credential-free target request was rejected")

for label, value in target_only_mutations.items():
    mutated = tuple(
        ObservedChannel(channel.location, channel.name, (value,))
        if channel.location == "header" and channel.name == "user-agent"
        else channel
        for channel in target
    )
    if cross_origin_target_matches_expectation(source, mutated, target_body, "127.0.0.1:4541"):
        raise AssertionError(f"{label} target deviation was accepted")

print("closed redirect target oracle mutation controls pass")
