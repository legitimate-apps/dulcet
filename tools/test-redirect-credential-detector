#!/usr/bin/env python3
"""Mutation controls for semantic redirect credential detection."""

from __future__ import annotations

import base64
from pathlib import Path
import runpy
from urllib.parse import quote


module = runpy.run_path(Path(__file__).parent / "conformance-env" / "redirect-server")
contains_source_credential = module["contains_source_credential"]

credential = "credential/with+syntax?"
credentials = {credential}
encoded = credential.encode("utf-8")
base64_once = base64.b64encode(encoded)
cross_origin_values = {
    "raw": credential,
    "framed": f"Dulcet/{credential}",
    "percent": f"metadata={quote(credential, safe='')}",
    "base64": f"Dulcet {base64.b64encode(encoded).decode('ascii')}",
    "base64-unpadded": base64.b64encode(encoded).decode("ascii").rstrip("="),
    "base64url": base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("="),
    "base32": base64.b32encode(encoded).decode("ascii").rstrip("="),
    "base85": base64.b85encode(encoded).decode("ascii"),
    "hex": encoded.hex(),
    "uppercase-hex": encoded.hex().upper(),
    "double-base64": base64.b64encode(base64_once).decode("ascii"),
}

for label, value in cross_origin_values.items():
    if not contains_source_credential(value, credentials):
        raise AssertionError(f"{label} credential representation was not detected")

if contains_source_credential("Dulcet/public-metadata", credentials):
    raise AssertionError("unrelated metadata was classified as a credential")

print("redirect credential detector mutation controls pass")
