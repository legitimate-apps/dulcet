#!/usr/bin/env python3
"""Readiness diagnostics retain the failing prerequisite without authenticated exception text."""
from contextlib import redirect_stdout
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from io import StringIO
from pathlib import Path
from unittest.mock import patch
import json
import os
import subprocess
import tempfile

loader = SourceFileLoader('fixture', str(Path(__file__).parent / 'ci/with-my-library-fixture'))
fixture = module_from_spec(spec_from_loader('fixture', loader))
loader.exec_module(fixture)
canary = 'authenticated-query-canary'
class Child:
    def poll(self): return None
for failed_port in range(4783, 4789):
    calls = []
    def rest(port, endpoint, **parameters):
        calls.append((port, endpoint))
        if port == failed_port:
            raise TimeoutError(canary)
        return {'albumList2': {'album': [{}]}}
    with patch.object(fixture, 'rest', side_effect=rest), redirect_stdout(StringIO()) as output:
        try:
            fixture.wait_for_readiness([Child()], timeout=0)
        except RuntimeError as error:
            assert f'port={failed_port} endpoint=getAlbumList2 error=TimeoutError' in str(error)
            assert canary not in str(error)
        else:
            raise AssertionError('an unreachable proxy cannot authorize UI testing')
    assert canary not in output.getvalue()
    assert calls[-1] == (failed_port, 'getAlbumList2')
    print(f'READINESS NEGATIVE CONTROL PASS port={failed_port} failure retained and redacted')

def ready(port, endpoint, **parameters):
    if endpoint == 'getOpenSubsonicExtensions':
        return {'openSubsonicExtensions': [{'name': 'dulcetLibrary', 'versions': [1]}]}
    return {'albumList2': {'album': [{}]}}
with patch.object(fixture, 'rest', side_effect=ready) as rest:
    fixture.wait_for_readiness([Child()], timeout=0)
    assert rest.call_count == 7
print('READINESS POSITIVE CONTROL PASS all six catalogs and capability observed')

with patch.object(fixture, 'rest', return_value={'openSubsonicExtensions': []}) as rest, redirect_stdout(StringIO()) as output:
    def absent_capability(port, endpoint, **parameters):
        return {'openSubsonicExtensions': []} if endpoint == 'getOpenSubsonicExtensions' else ready(port, endpoint)
    rest.side_effect = absent_capability
    try:
        fixture.wait_for_readiness([Child()], timeout=0)
    except RuntimeError as error:
        assert 'endpoint=getOpenSubsonicExtensions error=RuntimeError' in str(error)
    else:
        raise AssertionError('catalog availability alone cannot authorize the split-library proof')
print('READINESS NEGATIVE CONTROL PASS missing capability rejected')

# The device-member workflow must reach the wrapper's positive readiness gate before booting.
# The wrapper starts its child command only after wait_for_readiness returns; that child is
# where the member boots/settles, then invokes xcodebuild with the original execution limits.
root = Path(__file__).resolve().parents[1]
workflow = (root / '.github/workflows/apple-ci.yml').read_text().split('  apple-conformance-ipad-iphone:', 1)[1]
assert 'First-boot this leg' not in workflow
assert 'tools/ci/isolate-simulator' not in workflow.split("- name: Assert this leg's conformance proofs", 1)[0]
for mode in ['iphone', 'ipad']:
    assert f'-- tools/ci/run-my-library-proofs {mode}' in workflow
    script = (root / 'tools/ci/run-my-library-proofs').read_text().split(f'if [ "$mode" = {mode} ]; then', 1)[1].split('\nfi', 1)[0]
    assert script.index('isolate-simulator') < script.index('xcodebuild')
    preparation = script.split('xcodebuild', 1)[0]
    assert '--settle' in preparation and '--require-settle' in preparation and '--require-isolation' in preparation
print('READINESS ORDER CONTROL PASS fixture gate before first boot and settled device before UI clocks')

def empty_catalog(port, endpoint, **parameters):
    return {'albumList2': {'album': []}} if port == 4785 else ready(port, endpoint)
with patch.object(fixture, 'rest', side_effect=empty_catalog), redirect_stdout(StringIO()):
    try:
        fixture.wait_for_readiness([Child()], timeout=0)
    except RuntimeError as error:
        assert 'port=4785 endpoint=getAlbumList2 error=RuntimeError' in str(error)
    else:
        raise AssertionError('an empty fallback corpus cannot authorize UI testing')
print('READINESS NEGATIVE CONTROL PASS empty catalog rejected')

# Execute the actual shell preparation against fake process boundaries. A missing pressure flag
# would let the fake isolation succeed during pressure failure; a missing/misordered destination
# check would reach fake xcodebuild for a mismatched iPad. Neither control touches a simulator.
with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    python = tmp / 'python3'
    python.write_text('''#!/usr/bin/env python3
import json, os, sys
args = sys.argv[1:]
with open(os.environ['CALLS'], 'a') as f: f.write(json.dumps(args) + '\\n')
if args[0].endswith('isolate-simulator'):
    sys.exit(1 if os.environ['SCENARIO'] == 'pressure-failure' and '--settle-pressure' in args else 0)
if args[0].endswith('resolve-ipad-destination'):
    if os.environ['SCENARIO'] == 'destination-timeout': sys.exit(1)
    print('OTHER' if os.environ['SCENARIO'] == 'destination-mismatch' else 'IPAD')
    sys.exit(0)
raise AssertionError(args)
'''.replace('#!/usr/bin/env python3', '#!' + __import__('sys').executable, 1))
    python.chmod(0o755)
    xcode = tmp / 'xcodebuild'
    xcode.write_text('#!/bin/bash\necho \'["xcodebuild"]\' >> "$CALLS"\nexit 42\n')
    xcode.chmod(0o755)
    for mode in ['iphone', 'ipad']:
        scenarios = ['positive', 'pressure-failure']
        if mode == 'ipad': scenarios += ['destination-mismatch', 'destination-timeout']
        for scenario in scenarios:
            calls = tmp / 'calls'
            calls.write_text('')
            env = dict(os.environ, PATH=str(tmp) + ':' + os.environ['PATH'], CALLS=str(calls),
                       SCENARIO=scenario, RUNNER_TEMP=str(tmp), IPAD_UDID='IPAD')
            result = subprocess.run(['bash', str(root / 'tools/ci/run-my-library-proofs'), mode],
                                    env=env, capture_output=True, text=True, timeout=10)
            invoked = [json.loads(line) for line in calls.read_text().splitlines()]
            reached = ['xcodebuild'] in invoked
            assert reached == (scenario == 'positive'), (mode, scenario, invoked, result)
            assert result.returncode != 0  # positive deliberately stops at fake xcodebuild
            assert invoked[0][0].endswith('isolate-simulator'), invoked
            if reached and mode == 'ipad':
                assert invoked[1][0].endswith('resolve-ipad-destination'), invoked
            print(f'PROOF ADMISSION CONTROL PASS {mode} {scenario} reached_xcodebuild={reached}')
