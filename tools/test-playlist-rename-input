#!/usr/bin/env python3
"""Exercise the actual playlist Rename receipt gate, including unsafe-retry mutants."""
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
source = (root / 'apple/DulcetiOSUITests/DulcetiOSUITests.swift').read_text()
parser = source.split('// BEGIN_RENAME_INPUT_PROOF\n', 1)[1].split('// END_RENAME_INPUT_PROOF', 1)[0]
checks = r'''
var checksRun = 0
func check(_ condition: Bool, _ message: String) {
    checksRun += 1
    if !condition { print("FAIL: " + message); exit(1) }
}
let baseline = "dulcet-ui NAV|7|route|dest=x DETAIL|8|playlist.rename.submit|id=playlist:A INPUT|9|touch=1|phase=ended"
check(DulcetRenameInputProof.observedCompletedContact("INPUT|1|touch=3|phase=began INPUT|2|touch=3|phase=ended"), "positive input monitor witness")
check(!DulcetRenameInputProof.observedCompletedContact("dulcet-input"), "installation alone is not input evidence")
check(!DulcetRenameInputProof.observedCompletedContact("INPUT|1|touch=3|phase=began INPUT|2|touch=4|phase=ended"), "mismatched input witness")
check(!DulcetRenameInputProof.observedCompletedContact("INPUT|1|touch=3|phase=began INPUT|2|touch=3|phase=cancelled"), "cancel alone is not positive delivery control")
check(!DulcetRenameInputProof.observedCompletedContact("INPUT|1|touch=-1|phase=began INPUT|2|touch=-1|phase=ended"), "unknown input witness")
check(DulcetRenameInputProof.sequence(baseline) == 9, "shared monotonic sequence")
check(!DulcetRenameInputProof.received(baseline, playlistID: "playlist:A", after: 8), "stale receipt")
check(DulcetRenameInputProof.received(baseline, playlistID: "playlist:A", after: 7), "exact fresh receipt")
check(!DulcetRenameInputProof.received(baseline, playlistID: "playlist:B", after: 7), "foreign generation")
check(!DulcetRenameInputProof.received(baseline, playlistID: "playlist:", after: 7), "playlist ID prefix")
check(!DulcetRenameInputProof.received("DETAIL|10|playlist.rename.submit.result|id=playlist:A", playlistID: "playlist:A", after: 7), "wrong handler")
check(DulcetRenameInputProof.recovery(baseline, after: 9) == "no-touch", "no new contact")
let began = "INPUT|10|touch=2|phase=began"
let ended = "INPUT|11|touch=2|phase=ended"
let cancelled = "INPUT|11|touch=2|phase=cancelled"
check(DulcetRenameInputProof.recovery(began + " " + ended, after: 9) == nil, "completed touch swallowed by app")
check(DulcetRenameInputProof.recovery(began + " " + cancelled, after: 9) == "cancelled-touch", "cancelled HID input")
check(DulcetRenameInputProof.recovery(began, after: 9) == nil, "still-down contact")
check(DulcetRenameInputProof.recovery(cancelled, after: 9) == nil, "missing down")
check(DulcetRenameInputProof.recovery(began + " INPUT|11|touch=3|phase=cancelled", after: 9) == nil, "wrong contact")
check(DulcetRenameInputProof.recovery(began + " " + cancelled + " " + ended, after: 9) == nil, "mixed normal/cancelled contacts")
check(DulcetRenameInputProof.recovery("INPUT|10|touch=2|phase=unknown", after: 9) == nil, "unknown phase")
print("PASS: \(checksRun) checks; exact playlist / fresh receipt / no touch / cancelled touch / normal and incomplete input rejected")
'''
mutants = {
    'normal-ended-touch': parser.replace('$0[3] == "phase=cancelled"', '$0[3] == "phase=ended"'),
    'wrong-generation': parser.replace('== "id=" + playlistID', '.hasPrefix("id=")'),
    'stale-handler': parser.replace('(Int(fields[1]) ?? -1) > baseline', '(Int(fields[1]) ?? -1) >= baseline'),
}
with tempfile.TemporaryDirectory(prefix='dulcet-rename-input-') as temporary:
    path = Path(temporary)
    for name, implementation in [('actual', parser), *mutants.items()]:
        swift = path / (name + '.swift')
        binary = path / name
        swift.write_text('import Foundation\n' + implementation + checks)
        subprocess.run(['swiftc', str(swift), '-o', str(binary)], check=True)
        result = subprocess.run([str(binary)], capture_output=True, text=True)
        if name == 'actual':
            if result.returncode: raise SystemExit(result.stdout + result.stderr)
            print(result.stdout.strip())
        else:
            if result.returncode == 0: raise SystemExit('unsafe mutant survived: ' + name)
            print('CONTROL rejected ' + name + ': ' + result.stdout.strip())
