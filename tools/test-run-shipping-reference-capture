#!/usr/bin/env python3
"""Run the real process-boundary controls with shipping-reference completion semantics."""
import functools
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest import mock

# Imported controls are executable files. Do not create test-named bytecode that
# the workflow's control inventory would mistake for another executable control.
sys.dont_write_bytecode = True

loader = importlib.machinery.SourceFileLoader(
    'shared_capture_controls', str(Path(__file__).with_name('test-run-design-capture')))
shared = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(shared)
SHIPPING_COMPLETE = 'DULCET SHIPPING REFERENCE COMPLETE shipping=68/68 controls=2/2 missing=0'


class ShippingReferenceControls(shared.CaptureSupervisorTest):
    def run_probe(self, script, **kwargs):
        # Reuse the reviewed real fork/exec/pipe/signal/sample controls unchanged. Only
        # the completion protocol differs; this never replaces the supervisor loop.
        script = script.replace('DULCET CAPTURE PASS images=70', SHIPPING_COMPLETE)
        actual = shared.module.supervise
        with mock.patch.object(shared.module, 'supervise',
                               functools.partial(actual, kind='shipping-reference')):
            return super().run_probe(script, **kwargs)

    def test_blocked_screen_capture_completion_reports_exact_entered_stage(self):
        for stage in ('screen-shareable-content', 'screen-capture-image'):
            with self.subTest(stage=stage):
                phase = ('DULCET_CAPTURE_PHASE stage=' + stage
                         + ' monotonicNs=1 kind=shipping-reference phase=preflight'
                         + ' state=library-browse appearance=light')
                script = f'print({phase!r},flush=True)\n' + shared.WAIT
                result, record, files = self.run_probe(script, mode='blocked')
                self.assertEqual(124, result)
                self.assertEqual(stage, record['lastStage'])
                self.assertIn('kind=shipping-reference', record['lastPhaseLine'])
                self.assertIn(phase, files['console.log'])

    def test_design_pass_cannot_complete_shipping_reference(self):
        # Split the string so run_probe's fixture translation cannot turn it into
        # a shipping completion. The child really prints the other protocol.
        script = shared.PHASE + "print('DULCET '+'CAPTURE PASS images=70',flush=True)"
        result, record, _ = self.run_probe(script)
        self.assertEqual(1, result)
        self.assertFalse(record['completionObserved'])

    def test_partial_shipping_report_retains_existing_non_regression_policy(self):
        completion = 'DULCET SHIPPING REFERENCE COMPLETE shipping=0/68 controls=2/2 missing=68'
        result, record, files = self.run_probe(shared.PHASE + f'print({completion!r},flush=True)')
        self.assertEqual(0, result)
        self.assertTrue(record['completionObserved'])
        self.assertIn(completion, files['console.log'])

    def test_cli_selects_shipping_protocol_and_retains_its_diagnostic_label(self):
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / 'process'
            result = subprocess.run(
                [sys.executable, str(shared.TOOL), '--kind', 'shipping-reference',
                 '--diagnostics', str(output), '--', sys.executable, '-c',
                 f'print({SHIPPING_COMPLETE!r},flush=True)'],
                capture_output=True, text=True, timeout=60,
            )
            self.assertEqual(0, result.returncode, result.stdout + result.stderr)
            self.assertIn('SHIPPING REFERENCE HOST exit=0', result.stdout)
            self.assertTrue(json.loads((output / 'host-result.json').read_text())['completionObserved'])


if __name__ == '__main__':
    unittest.main()
