#!/usr/bin/env python3
"""Reject repository-secret references in workflows that execute for pull requests."""

from __future__ import annotations

from pathlib import Path
import re


errors: list[str] = []
for workflow in sorted(Path(".github/workflows").glob("*.yml")):
    text = workflow.read_text()
    if not re.search(r"(?m)^\s*pull_request(?:_target)?\s*:", text):
        continue
    references = sorted(
        set(
            re.findall(r"secrets\.([A-Za-z_][A-Za-z0-9_]*)", text) +
            re.findall(r"secrets\[['\"]([^'\"]+)['\"]\]", text)
        ),
    )
    if references:
        errors.append(f"{workflow}: pull-request workflow references repository secrets: {references}")

if errors:
    raise SystemExit("\n".join(errors))

print("pull-request workflows contain no repository-secret references")
