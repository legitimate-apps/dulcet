#!/usr/bin/env python3
"""Reject repository-secret references in workflows that execute for pull requests."""

from __future__ import annotations

from pathlib import Path
import re


errors: list[str] = []
workflows = sorted(
    set(Path(".github/workflows").glob("*.yml"))
    | set(Path(".github/workflows").glob("*.yaml")),
)
for workflow in workflows:
    text = workflow.read_text()
    pull_request_trigger = re.search(
        r"(?m)^\s*pull_request(?:_target)?\s*:|^\s*on\s*:\s*\[[^\]]*\bpull_request(?:_target)?\b",
        text,
    )
    if not pull_request_trigger:
        continue
    references = sorted(
        set(
            re.findall(r"secrets\.([A-Za-z_][A-Za-z0-9_]*)", text) +
            re.findall(r"secrets\[['\"]([^'\"]+)['\"]\]", text)
        ),
    )
    if references:
        errors.append(f"{workflow}: pull-request workflow references repository secrets: {references}")

if errors:
    raise SystemExit("\n".join(errors))

print("pull-request workflows contain no repository-secret references")
