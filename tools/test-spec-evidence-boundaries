import re

from verify_promotion_conditions import validate as validate_promotion_conditions


def section(document: str, start: str, end: str) -> str:
    try:
        return document.split(start, 1)[1].split(end, 1)[0]
    except IndexError as error:
        raise SystemExit(f"missing spec section boundary: {start!r} -> {end!r}") from error


spec = Path("docs/superpowers/specs/2026-08-18-dulcet-design.md").read_text()
features = json.loads(Path("FEATURES.yml").read_text())
account_connection_source = Path(
    "core/src/commonMain/kotlin/com/legitimateapps/dulcet/core/AccountConnection.kt"
).read_text()
parity_workflow = Path(".github/workflows/parity-gate.yml").read_text()
drift_workflow = Path(".github/workflows/branch-protection-drift.yml").read_text()
evidence_schema = section(spec, "### 19.2 Row schema", "### 19.3 The gate")
gate = section(spec, "### 19.3 The gate", "### 19.4 As a delegate brief")
authentication = section(spec, "### 13.1 Authentication", "### 13.2 The threat model, stated correctly")
account_setup = section(spec, "**Account-setup timeout decision:**", "### 10.3 The failure modes")
failure_modes = section(spec, "### 10.3 The failure modes", "### 10.4 Gates are conjunctions")
error_model = section(spec, "### 18.12 Error model", "## 19. `FEATURES.yml`")
normalized_evidence_schema = " ".join(evidence_schema.split())
normalized_gate = " ".join(gate.split())
normalized_authentication = " ".join(authentication.split())
normalized_account_setup = " ".join(account_setup.split())
normalized_failure_modes = " ".join(failure_modes.split())
normalized_error_model = " ".join(error_model.split())

errors: list[str] = []
errors.extend(validate_promotion_conditions(Path.cwd()))

account_connect = next(
    feature for feature in features["features"] if feature["id"] == "account.connect"
)
# A signed device receipt goes stale when a source it pins changes, and signed device runs execute only
# on main after merge. The PR that changes such a source may therefore withdraw the receipt: it declares
# the cell in accepted_regressions, returns it to partial behind a blocked promotion condition, stops
# citing the receipt and says so in the reason. A withdrawn cell skips its shipped-cell checks below
# until a new audited signed main run restores them; an undeclared lower status still fails.
declared_regressions = {
    (row.get("id"), row.get("platform")) for row in features.get("accepted_regressions", [])
}


def withdrawn(platform: str, receipt_prefix: str) -> bool:
    if ("account.connect", platform) not in declared_regressions:
        return False
    cell = account_connect["platforms"][platform]
    if cell.get("status") != "partial":
        errors.append(f"account.connect/{platform} is a declared regression but is not partial")
    if (cell.get("promotion_condition") or {}).get("status") != "blocked":
        errors.append(f"account.connect/{platform} withdrawn receipt needs a blocked promotion condition")
    if any(row.get("receipt", "").startswith(receipt_prefix) for row in cell.get("evidence", [])):
        errors.append(f"account.connect/{platform} still cites the receipt it declares withdrawn")
    if "no longer cited as active evidence" not in cell.get("reason", ""):
        errors.append(f"account.connect/{platform} reason must say the withdrawn receipt is no longer cited")
    return True


ipad_account_connect = account_connect["platforms"]["ipados"]
if not withdrawn("ipados", "evidence/receipts/signed-ipad-account-connect-"):
    if ipad_account_connect.get("status") != "shipped":
        errors.append(
            "account.connect/ipados ships on the simulator state proof plus the audited signed main run; "
            "a lower status is an undeclared regression"
        )
    ipad_reason = ipad_account_connect.get("reason", "")
    if not any(
        row.get("receipt", "").startswith("evidence/receipts/signed-ipad-account-connect-")
        and "observes" in row
        and row.get("test")
        == "DulcetSignedIPadAccountConnectUITests/testSignedIPadConnectKeychainRelaunchAndTouchReconnect"
        for row in ipad_account_connect.get("evidence", [])
    ):
        errors.append("account.connect/ipados must cite the signed main receipt as a bounded observation")
    # The device proof types by touch, taps Library Reconnect and rotates once; a hardware keyboard and
    # Split View or Slide Over are deferred by §28, and the reason must keep saying so.
    for marker in ("by touch on the iPad's software keyboard", "Library's own Reconnect button is tapped",
                   "rotates from portrait to landscape", "no account hook", "saved=PASS",
                   "private-token audit", "tools/verify-evidence-receipt",
                   "Hardware-keyboard entry and Split View or Slide Over widths are deferred"):
        if marker not in ipad_reason:
            errors.append(f"account.connect/ipados shipped reason is missing {marker!r}")
    for stale in ("zero device passes", "has not run", "Physical execution is still unobserved",
                  "receipt is historical", "Library Reconnect is observed, not tapped"):
        if stale in ipad_reason:
            errors.append("account.connect/ipados reason must reflect the observed signed run")
ios_account_connect = account_connect["platforms"]["ios"]
if not withdrawn("ios", "evidence/receipts/signed-iphone-account-connect-"):
    if ios_account_connect.get("status") != "shipped":
        errors.append(
            "account.connect/ios ships on the simulator state proof plus the audited signed iPhone main run; "
            "a lower status is an undeclared regression"
        )
    ios_reason = ios_account_connect.get("reason", "")
    if not any(
        row.get("receipt", "").startswith("evidence/receipts/signed-iphone-account-connect-")
        and "observes" in row
        and row.get("test")
        == "DulcetSignedIPhoneAccountConnectUITests/testSignedIPhoneConnectKeychainRelaunchAndTouchReconnect"
        for row in ios_account_connect.get("evidence", [])
    ):
        errors.append("account.connect/ios must cite the signed iPhone main receipt as a bounded observation")
    # The iPhone lane types by touch and taps Library Reconnect but never rotates; a hardware keyboard and
    # rotation are deferred by §28, and the reason must keep saying so.
    for marker in ("by touch into the rendered fields", "Library's own Reconnect button is tapped",
                   "no account hook", "Local Network prompt for that host only", "private-token audit",
                   "tools/verify-evidence-receipt",
                   "Hardware-keyboard entry and rotation on iPhone are deferred",
                   "migration and background enforcement of the saved item remain ASSUMED"):
        if marker not in ios_reason:
            errors.append(f"account.connect/ios shipped reason is missing {marker!r}")
    for stale in ("remains unproved, so shipped would be unearned", "the cell remains partial",
                  "rotates from portrait to landscape", "Library Reconnect is observed, not tapped"):
        if stale in ios_reason:
            errors.append("account.connect/ios reason must reflect the observed signed iPhone run")
macos_account_connect = account_connect["platforms"]["macos"]
if not withdrawn("macos", "evidence/receipts/signed-mac-account-connect-"):
    if macos_account_connect.get("status") != "shipped":
        errors.append(
            "account.connect/macos ships on the hosted state proof plus the audited signed main run; "
            "a lower status is an undeclared regression"
        )
    macos_rows = macos_account_connect.get("evidence", [])
    if not any(
        row.get("conformance") == "CONF-09b"
        and row.get("test")
        == "DulcetMacAccountConnectStatesAppTest/everyAccountConnectStateIsReachedThroughTheHostedMacApp"
        for row in macos_rows
    ):
        errors.append("account.connect/macos must cite the hosted Mac state proof for CONF-09b")
    if not any(
        row.get("receipt", "").startswith("evidence/receipts/signed-mac-account-connect-")
        and row.get("test")
        == "DulcetSignedMacAccountConnectTests/testLiveConnectSavesDeviceOnlyCredentialAndRendersConnectedUI"
        for row in macos_rows
    ):
        errors.append("account.connect/macos must cite the signed main run's receipt for the Keychain half")
    account_reason = macos_account_connect.get("reason", "")
    for marker in (
        "DulcetMacAccountConnectStatesAppTest",
        "in-memory credential store",
        "Keychain half on main",
        "separate host processes",
        "private-token audit",
        "tools/verify-evidence-receipt",
        "capabilityUnsupported has no account-connect origin",
        "connectSuccessCrossesLiveKotlinFacadeIntoPersistenceFailureState",
        "migration and background enforcement of the saved item remain ASSUMED",
    ):
        if marker not in account_reason:
            errors.append(f"account.connect/macos shipped reason is missing {marker!r}")

derived_revision_header = (
    "**Revision:** derived from the highest dated §28 record; "
    "§28 is the single source of truth."
)
declared_revision_match = re.search(r"^\*\*Revision:\*\*.*$", spec, re.MULTILINE)
revision_records = [
    int(value)
    for value in re.findall(r"^\*\*Revision (\d+) \(\d{4}-\d{2}-\d{2}\)\*\*", spec, re.MULTILINE)
]
# Every record header in §28 must be in the dated form the list above is built from. A header
# the pattern does not match is not an error to it: it is simply absent, so a record written as
# "(2026-09-23; written 2026-09-11)" was invisible to every rule below while the document claimed
# the revision before it. Refuse the malformed header instead of silently not counting it.
# A header is a line opening `**Revision N (` or `**Revision N**`; prose that merely starts with
# "**Revision N" and goes on to say something about it ("**Revision 87 informed this.**") is not
# one, and §28 bodies correct earlier revisions in exactly that idiom.
section_start = spec.find("\n## 28. Revision record")
revision_section = ""
if section_start >= 0:
    following_heading = re.search(r"^## (?!28\.)", spec[section_start + 1 :], re.MULTILINE)
    section_end = section_start + 1 + following_heading.start() if following_heading else len(spec)
    revision_section = spec[section_start:section_end]
malformed_revision_headers = [
    line
    for line in re.findall(r"^\*\*Revision \d+(?: \(|\*\*).*$", revision_section, re.MULTILINE)
    if not re.match(r"^\*\*Revision \d+ \(\d{4}-\d{2}-\d{2}\)\*\*", line)
]
if not revision_section:
    errors.append("spec must contain the §28 revision record")
for line in malformed_revision_headers:
    errors.append(f"spec revision record header is not in the dated form: {line[:80]!r}")
if declared_revision_match is None:
    errors.append("spec must declare its revision")
elif declared_revision_match.group(0) != derived_revision_header:
    errors.append("spec revision declaration must derive from the highest dated §28 record")
elif not revision_records:
    errors.append("spec must contain dated revision records")
else:
    # The first §28 record is the document's derived declaration. Keeping that separate from max()
    # preserves the old gate's important direction: a later record cannot exceed what the document
    # claims merely by appearing out of order below the first record.
    declared_revision = revision_records[0]
    recorded_revisions = set(revision_records)
    expected_revisions = set(range(2, declared_revision + 1))
    if len(revision_records) != len(recorded_revisions):
        errors.append("spec revision records must not contain duplicate numbers")
    expected_order = sorted(recorded_revisions, reverse=True)
    if revision_records != expected_order:
        errors.append("spec revision records must be unique and strictly descending")
    if declared_revision != max(recorded_revisions):
        errors.append(
            "spec revision record exceeds its derived declaration: "
            f"declared={declared_revision}, highest={max(recorded_revisions)}"
        )
    missing_revisions = sorted(expected_revisions - recorded_revisions)
    unexpected_revisions = sorted(recorded_revisions - expected_revisions)
    if missing_revisions:
        errors.append(f"spec revision record is missing: {missing_revisions}")
    if unexpected_revisions:
        errors.append(
            f"spec revision record exceeds its derived declaration: {unexpected_revisions}"
        )

if "pull_request:" not in parity_workflow:
    errors.append("parity-gate must execute on pull requests")
if "python3 tools/test-spec-evidence-boundaries" not in parity_workflow:
    errors.append("parity-gate must execute the evidence-boundary marker check")
if "push:" not in drift_workflow or "branches: [main]" not in drift_workflow:
    errors.append("branch-protection-drift must execute after pushes to main")
if "python3 tools/verify_branch_protection.py" not in drift_workflow:
    errors.append("branch-protection-drift must call the live verifier")

for marker in (
    "reviewed static pre-merge declaration",
    "not proof that the live branch rule requires the job",
):
    if marker not in normalized_evidence_schema:
        errors.append(f"§19.2 must state the manifest evidence boundary with {marker!r}")

for marker in (
    "post-merge detection",
    "not pre-merge prevention",
    "branch-protection-drift",
    "required-checks manifest",
):
    if marker not in normalized_gate:
        errors.append(f"§19.3 must state the gate timing boundary with {marker!r}")

for marker in (
    "**OBSERVED, bounded proxy wire control:**",
    "32590761419",
    "97074117183",
    "DarwinProxyAuthenticationConformanceTest.proxyChallengeFailsClosedWithoutAmbientCredentials",
    "tools/conformance-env/redirect-server --forward-proxy-auth",
    "407 Proxy Authentication Required",
    "records every received `Proxy-Authorization` value",
    "zero `Proxy-Authorization` values",
    "`Auth.UnsupportedAuthenticationChallenge`",
    "No broader proxy-routing claim is made",
    "automatic discovery from macOS system proxy settings",
):
    if marker not in normalized_authentication:
        errors.append(f"proxy evidence boundary is missing {marker!r}")

for marker in (
    "**Relaunch decision — a saved account reconnects on its own (every platform):**",
    "A saved account requests a reconnect at launch, on a return to the foreground and when the network comes back.",
    "one Keychain generic-password value",
    "generated local UUID",
    "data-protection Keychain",
    "kSecUseDataProtectionKeychain = true",
    "**OBSERVED unentitled fail-closed boundary:**",
    "32595294491",
    "97085139126",
    "DulcetCredentialStoreError.missingDataProtectionKeychainEntitlement",
    "no matching legacy generic-password item exists",
    "**Signed-host proof OBSERVED on main:**",
    "`account.connect / macos` is shipped",
    "`signed-mac-account-connect` / `signed-account-connect` /",
    "DulcetSignedMacAccountConnectTests/testLiveConnectSavesDeviceOnlyCredentialAndRendersConnectedUI",
    "after a wrong-accessibility control",
    "Only a green run on main and the named checked JUnit can supply public workflow evidence",
    "through a committed receipt",
    "never by making the dispatch-only job a required PR status",
    "it evidences CONF-09b on macOS",
    "No tap is needed and no UI waits for the server.",
    "credential-persistence error surface",
):
    if marker not in normalized_authentication:
        errors.append(f"Keychain/relaunch implementation boundary is missing {marker!r}")

for marker in (
    "**Apple implementation boundary:**",
    "`DulcetMacApp`, `DulcetiOSApp`, and `DulcetTVApp` construct the live "
    "`AppleAccountConnectionClient`",
    "publishes an explicit in-progress state",
    "exposes Cancel through the synchronously returned operation handle",
    # tvOS ships a real account-connect shell, so "other platform shells remain future work" is
    # no longer true and pinning it would pin a false sentence. What must not drift is the pair
    # that keeps the paragraph honest: the named remainder, and the explicit refusal to claim
    # shipped anywhere. The tvOS marker pins the idiom claim so a later edit cannot quietly
    # restate the TV surface as a reused desktop layout.
    "iPadOS-specific layout evidence, Android, and Android TV remain future work",
    "This paragraph makes no `shipped` account-setup claim for any platform",
    "The tvOS root deliberately uses a full-screen `NavigationStack`",
):
    if marker not in normalized_account_setup:
        errors.append(f"account-setup implementation boundary is missing {marker!r}")

for marker in (
    "**OBSERVED live-app seam through the unentitled persistence boundary; ASSUMED signed effects:**",
    "fourteen `account.connect/macos` evidence entries",
    "`DulcetMacProduction.makePresentationStore` composition",
    "root view remains compiled but is not instantiated",
    "32598531311",
    "launchd refuse to spawn",
    "no application or test code ran",
    "32599896419",
    "Every state assertion before the view probe passed",
    "real server success",
    "Kotlin main dispatcher",
    "Swift `@MainActor`",
    "connectSuccessCrossesLiveKotlinFacadeIntoPersistenceFailureState",
    "accountErrorPersistence",
    "credentialPersistenceFailed",
    "loaded no persisted credential",
    "SwiftUI rendering of that live-derived state remains compile-checked",
    "production Keychain save",
    "connected UI",
):
    if marker not in normalized_account_setup:
        errors.append(f"account-setup live-app evidence boundary is missing {marker!r}")

if "required Apple presentation" not in normalized_failure_modes:
    errors.append("account-setup implementation boundary is missing the Apple-presentation table label")

# End the Auth block at ITS OWN closing brace, not at whatever declaration happens to follow.
# The previous delimiter was "public data class CapabilityUnsupported", so adding any sibling
# between Auth and that class swept the sibling's members into this set -- and the gate then
# reported an "Auth enumeration must match" failure for a change with nothing to do with
# authentication. That is a misleading failure, and a misleading failure costs more than a missing
# one: it sends the reader to fix the wrong document. Adding DomainError.Playback triggered exactly
# that.
auth_source = re.split(
    r"^    \}$",
    account_connection_source.split(
        "public sealed interface Auth : DomainError {", 1
    )[1],
    maxsplit=1,
    flags=re.MULTILINE,
)[0]
source_auth_types = set(
    re.findall(r"public data (?:object|class) (\w+)", auth_source)
)
documented_auth_match = re.search(r"- `Auth\.([^`]+)`", normalized_error_model)
if documented_auth_match is None:
    errors.append("§18.12 must enumerate DomainError.Auth")
else:
    documented_auth_types = {
        value.strip().removeprefix("Auth.")
        for value in documented_auth_match.group(1).split("|")
    }
    if documented_auth_types != source_auth_types:
        errors.append(
            "§18.12 Auth enumeration must match DomainError.Auth: "
            f"documented={sorted(documented_auth_types)}, source={sorted(source_auth_types)}"
        )

for marker in (
    "**macOS implementation boundary:**",
    "exhaustive Kotlin `when`",
    "exhaustive `switch` with no default branch",
    "exposes only the canonical target host",
    "exempt `/rest/`",
    "punycode as the available workaround",
    "install a private CA at the macOS operating-system level",
    "Other platform presentation mappings remain future work",
):
    if marker not in normalized_error_model:
        errors.append(f"§18.12 error-presentation implementation boundary is missing {marker!r}")

if errors:
    raise SystemExit("\n".join(errors))

print("required evidence-boundary markers, workflow placement, and revision integrity are present")
