controls = controls.replace('__FOCUS_PREFLIGHT_CONTROLS__', focus_controls if has_focus_preflight else '')
# Current source carries the application for tour-only geometry. Older --source-ref controls
# retain their original signature; both execute the same credential replacement assertions.
if "app: XCUIApplication" in method:
    controls = controls.replace("name: name, secure: secure)", "name: name, secure: secure, app: XCUIApplication())")

with tempfile.TemporaryDirectory(prefix="dulcet-account-text-entry-") as directory:
    swift = Path(directory) / "control.swift"
    binary = Path(directory) / "control"
    swift.write_text(collaborators + "    @MainActor\n" + method + controls)
    subprocess.run(["swiftc", "-parse-as-library", str(swift), "-o", str(binary)], check=True)
    subprocess.run([str(binary)], check=True)

# Execute the real dismissal helper against the captured iPad AX geometry and opposing
# visible-keyboard states. An artificial clock makes the unchanged retry budget immediate.
start = source.index("    private func dismissKeyboardIfPresent(")
end = source.index("\n    }", start) + len("\n    }")
keyboard_method = source[start:end].replace("private func", "func", 1)
keyboard_method = keyboard_method.replace("Date()", "KeyboardClock.now")
keyboard_method = keyboard_method.replace("Thread.sleep(forTimeInterval:", "KeyboardClock.advance(by:")
keyboard_collaborators = r'''
import Foundation
import CoreGraphics
@MainActor enum KeyboardClock {
    static var now = Date(timeIntervalSince1970: 0)
    static func advance(by seconds: Double) { now = now.addingTimeInterval(seconds) }
}
@MainActor var recordedFailures: [String] = []
@MainActor func XCTFail(_ message: String) { recordedFailures.append(message) }
enum ElementType { case application, window, keyboard }
struct XCUIElementSnapshot {
    var frame: CGRect
    var elementType: ElementType
    var children: [XCUIElementSnapshot] = []
}
@MainActor final class XCUIElement {
    var storedExists = true
    var disappearBeforeFrame = false
    var removeOnDismiss = false
    var exists: Bool {
        let result = storedExists
        if disappearBeforeFrame { storedExists = false }
        return result
    }
    var snapshotFrame: CGRect
    var frame: CGRect {
        get {
            precondition(storedExists, "The captured keyboard disappeared between exists and the live frame read")
            return snapshotFrame
        }
        set { snapshotFrame = newValue }
    }
    var taps = 0
    var closeOnTap = 1
    var keyboard: XCUIElement?
    init(_ frame: CGRect) { self.snapshotFrame = frame }
    struct Query {
        var firstMatch: XCUIElement
        subscript(_ label: String) -> Query { self }
    }
    var buttons: Query { Query(firstMatch: hide!) }
    var hide: XCUIElement?
    func waitForExistence(timeout: Double) -> Bool { exists }
    func waitForNonExistence(timeout: Double) -> Bool {
        KeyboardClock.advance(by: timeout)
        return !exists
    }
    func tap() {
        guard let keyboard else { preconditionFailure("Only the keyboard dismissal control should be tapped") }
        precondition(snapshotFrame.intersects(CGRect(x: 0, y: 0, width: 1032, height: 1376)),
                     "The captured stale Hide button is below the window and must never be tapped")
        keyboard.taps += 1
        if keyboard.taps == keyboard.closeOnTap {
            // UIKit has dismissed the visible keyboard; accessibility retains its container.
            if keyboard.removeOnDismiss {
                keyboard.disappearBeforeFrame = true
            } else {
                keyboard.frame = CGRect(x: 0, y: 1376, width: 1032, height: 0)
            }
        }
    }
    @MainActor struct Coordinate {
        var element: XCUIElement
        func tap() { element.hide!.tap() }
    }
    func coordinate(withNormalizedOffset: CGVector) -> Coordinate { Coordinate(element: self) }
}
@MainActor final class XCUIApplication {
    var keyboard: XCUIElement
    let window = XCUIElement(CGRect(x: 0, y: 0, width: 1032, height: 1376))
    var snapshotFailures = 0
    enum SnapshotFailure: Error { case unavailable }
    func snapshot() throws -> XCUIElementSnapshot {
        if snapshotFailures > 0 { snapshotFailures -= 1; throw SnapshotFailure.unavailable }
        // A new root snapshot observes removal atomically; it never resolves a stale keyboard.
        if keyboard.disappearBeforeFrame { keyboard.storedExists = false }
        let children = keyboard.storedExists
            ? [XCUIElementSnapshot(frame: keyboard.snapshotFrame, elementType: .keyboard)] : []
        // Application containers need not have geometry; the real window supplies it.
        return XCUIElementSnapshot(frame: .zero, elementType: .application,
                                  children: [XCUIElementSnapshot(frame: window.snapshotFrame,
                                                               elementType: .window, children: children)])
    }
    init(frame: CGRect, closeOnTap: Int = 1, exists: Bool = true, hideAvailable: Bool = true) {
        keyboard = XCUIElement(frame)
        keyboard.storedExists = exists
        keyboard.closeOnTap = closeOnTap
        let hide = XCUIElement(CGRect(x: 881, y: frame.minY + 262, width: 151.5, height: 68))
        hide.storedExists = hideAvailable
        hide.keyboard = keyboard
        keyboard.hide = hide
    }
    var keyboards: XCUIElement.Query { .init(firstMatch: keyboard) }
    var windows: XCUIElement.Query { .init(firstMatch: window) }
    var debugDescription: String { "keyboard dismissal collaborator" }
}
@MainActor final class KeyboardProof {
'''
