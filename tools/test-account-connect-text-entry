#!/usr/bin/env python3
"""Execute the account-state proof's credential replacement with Swift collaborators.

This checks the input protocol, not UIKit animation completion. The field models a cursor,
secure bullets, placeholders and dropped typing. Hardware-key events are recorded to check the chosen
ordinary-Delete input protocol; throwing snapshots model a transient query failure,
and immutable reads keep a value and its placeholder from the same snapshot; this does not diagnose UIKit animation-idle failures. A trailing-edge
tap on text wider than the field lands short of the end, as iPhone CI showed. --source-ref
replays an earlier helper to prove that the controls reject incorrect cursor handling and stale focus.
The dismissal controls also replay captured iPad keyboard geometry, including a retained
zero-height AX container and disappearance between live queries, while requiring a visible
stuck keyboard or unavailable snapshot to fail.
Focus controls require a fresh successful geometry callback before each actual tap, including a
dropped tap or lost focus; a rejected callback must leave the credential and input events untouched.
"""
import argparse
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
PATH = "apple/DulcetiOSUITests/DulcetAccountConnectStatesUITests.swift"
parser = argparse.ArgumentParser()
parser.add_argument("--source-ref")
parser.add_argument("--mutant", choices=["skip-focus-preflight", "prepare-only-once"])
args = parser.parse_args()
source = (subprocess.check_output(["git", "show", f"{args.source_ref}:{PATH}"],
                                  cwd=ROOT, text=True)
          if args.source_ref else (ROOT / PATH).read_text())
start = source.index("    private func replaceText(")
end = source.index("\n    }", start) + len("\n    }")
method = source[start:end].replace("private func", "func", 1)
has_focus_preflight = "beforeFocusTap:" in method
if args.mutant:
    assert has_focus_preflight and "beforeFocusTap()" in method
    if args.mutant == "skip-focus-preflight":
        method = method.replace("beforeFocusTap()", "true")
    else:
        method = method.replace("        func focusForTyping(", "        var preflightWasCalled = false\n        func focusForTyping(")
        method = method.replace("beforeFocusTap()", "({ if preflightWasCalled { return true }; preflightWasCalled = true; return beforeFocusTap() })()")

collaborators = r'''
import Foundation
import CoreGraphics
@MainActor final class XCUIApplication {
    @MainActor struct Query { var firstMatch: XCUIElement { XCUIElement("") } }
    var windows: Query { Query() }
    var keyboards: Query { Query() }
    var debugDescription: String { "input protocol collaborator" }
    func coordinate(withNormalizedOffset point: CGVector) -> XCUIElement.Coordinate {
        fatalError("This control exercises normal entry, not tour scrolling")
    }
}
struct Modifiers: OptionSet {
    let rawValue: Int
    static let command = Self(rawValue: 1)
}
enum XCUIKeyboardKey: String { case delete = "\u{7f}" }
func XCTFail(_ message: String) { fatalError(message) }
@MainActor
final class XCUIElement {
    var frame: CGRect { CGRect(x: 0, y: 0, width: 320, height: 640) }
    var isHittable: Bool { true }
    var exists: Bool { true }
    var text: String
    let secure: Bool
    let placeholderValue: String? = "Credential"
    var focused = false
    var cursor = 0
    var selected = false
    var hardwareEvents = 0
    var dropNextInsertion = false
    var insertions = 0
    var dropFocusOnNextValueRead = false
    var snapshotFailures = 0
    var requiresPreparation = false
    var preparedForFocus = false
    var covered = false
    var prepareCalls = 0
    var focusTaps = 0
    var ignoredFocusTaps = 0
    var inputEvents = 0
    func prepareFocus() -> Bool {
        prepareCalls += 1
        covered = false
        preparedForFocus = true
        return true
    }
    func recordFocusTap() -> Bool {
        if requiresPreparation {
            precondition(preparedForFocus && !covered, "Every actual focus tap needs a fresh successful geometry preflight")
            preparedForFocus = false
        }
        focusTaps += 1
        if ignoredFocusTaps > 0 { ignoredFocusTaps -= 1; return false }
        return true
    }
    struct Snapshot { let value: Any?; let placeholderValue: String? }
    enum SnapshotFailure: Error { case unavailable }
    func snapshot() throws -> Snapshot {
        if snapshotFailures > 0 { snapshotFailures -= 1; throw SnapshotFailure.unavailable }
        return Snapshot(value: readValue(), placeholderValue: placeholderValue)
    }
    init(_ text: String, secure: Bool = false) { self.text = text; self.secure = secure }
    var value: Any? {
        precondition(snapshotFailures == 0, "A timed-out live value query records a fatal test failure")
        return readValue()
    }
    private func readValue() -> Any? {
        // A live query can outlast keyboard/layout settling. The next typing event must
        // reacquire focus rather than rely on the check made before reading this value.
        if dropFocusOnNextValueRead { dropFocusOnNextValueRead = false; focused = false }
        if text.isEmpty { return placeholderValue }
        return secure ? String(repeating: "•", count: text.count) : text
    }
    func value(forKey key: String) -> Any? { precondition(key == "hasKeyboardFocus"); return focused }
    func waitForExistence(timeout: Double) -> Bool { true }
    func tap() { focused = recordFocusTap(); cursor = text.count / 2 }
    @MainActor struct Coordinate {
        let field: XCUIElement
        let point: CGVector
        func press(forDuration: Double, thenDragTo: Coordinate) {
            fatalError("This control exercises normal entry, not tour scrolling")
        }
        func tap() {
            field.focused = field.recordFocusTap()
            // The field shows 20 characters; a trailing-edge tap on wider text lands under the tap.
            field.cursor = point.dx > 0.9 ? min(field.text.count, 20) : field.text.count / 2
        }
    }
    func coordinate(withNormalizedOffset point: CGVector) -> Coordinate { Coordinate(field: self, point: point) }
    func typeKey(_ key: String, modifierFlags: Modifiers) {
        hardwareEvents += 1
        precondition(key == "a" && modifierFlags == .command)
        selected = true
    }
    func typeKey(_ key: XCUIKeyboardKey, modifierFlags: Modifiers) {
        hardwareEvents += 1
        precondition(key == .delete && modifierFlags.isEmpty)
        typeText(key.rawValue)
    }
    func typeText(_ input: String) {
        inputEvents += 1
        precondition(focused)
        if input.contains(where: { $0 != "\u{7f}" }) {
            insertions += 1
            if dropNextInsertion { dropNextInsertion = false; return }
        }
        var characters = Array(text)
        for character in input {
            if selected { characters = []; cursor = 0; selected = false }
            if character == "\u{7f}" {
                if cursor > 0 { cursor -= 1; characters.remove(at: cursor) }
            } else {
                characters.insert(character, at: cursor)
                cursor += 1
            }
        }
        text = String(characters)
    }
}
@MainActor
final class Proof {
    var tourFilledValues: [String: String] = [:]
    func tourPhotograph(_ screen: String) {
        fatalError("This control exercises normal entry, not tour photographs")
    }
'''
controls = r'''
