#!/usr/bin/env python3
"""Check that POSIX Gradle workers inherit SchemaCrawler's serial scheduler mode."""
from pathlib import Path
import json
import os
import subprocess
import sys
import tempfile
import unittest

WRAPPER = Path(__file__).resolve().parent.parent / 'gradlew'


class SchemaSchedulerEnvironmentTest(unittest.TestCase):
    def test_wrapper_exports_serial_schema_scheduler_and_preserves_arguments(self):
        with tempfile.TemporaryDirectory(prefix='dulcet-schema-wrapper-') as raw:
            root = Path(raw)
            java = root / 'jdk' / 'bin' / 'java'
            java.parent.mkdir(parents=True)
            java.write_text('#!' + sys.executable + '\n'
                'import json, os, sys\n'
                'print(json.dumps({"scheduler": os.environ.get("SC_SINGLE_THREADED"), "args": sys.argv[1:]}))\n')
            java.chmod(0o755)
            for inherited in (None, 'false'):
                with self.subTest(inherited=inherited):
                    env = dict(os.environ, JAVA_HOME=str(java.parent.parent))
                    env.pop('SC_SINGLE_THREADED', None)
                    if inherited is not None:
                        env['SC_SINGLE_THREADED'] = inherited
                    args = [':core:verifyCommonMainDulcetDatabaseMigration', '--rerun-tasks']
                    result = subprocess.run([str(WRAPPER), *args], cwd=root, env=env,
                        capture_output=True, text=True, check=True)
                    report = json.loads(result.stdout)
                    self.assertEqual(report['scheduler'], 'true')
                    self.assertEqual(report['args'][-len(args):], args)


if __name__ == '__main__':
    unittest.main()
