#!/usr/bin/env python3

"""Prove the design-capture verifier rejects missing, mutated, and extra evidence."""

from __future__ import annotations

import argparse
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import shutil
import tempfile


VERIFIER_PATH = Path(__file__).with_name("verify_design_captures.py")
verifier = SourceFileLoader("verify_design_captures", str(VERIFIER_PATH)).load_module()


def expect_rejection(root: Path, expected_fragment: str) -> None:
    try:
        verifier.verify_capture_root(root)
    except verifier.CaptureVerificationError as error:
        if expected_fragment not in str(error):
            raise SystemExit(
                f"negative control rejected for the wrong reason: "
                f"expected {expected_fragment!r}, observed {str(error)!r}"
            ) from error
        return
    raise SystemExit(f"negative control unexpectedly passed: {expected_fragment}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", type=Path)
    args = parser.parse_args()

    with tempfile.TemporaryDirectory(prefix="dulcet-capture-gates-") as temporary:
        missing_root = Path(temporary) / "missing"
        shutil.copytree(args.root, missing_root)
        control = missing_root / "standard" / "macos-CONTROL-DELIBERATELY-BAD-library-browse-light.jpg"
        control.unlink()
        expect_rejection(missing_root, "exact file set mismatch")

        mutated_root = Path(temporary) / "mutated"
        shutil.copytree(args.root, mutated_root)
        target = mutated_root / "standard" / "macos-library-browse-light.jpg"
        target.write_bytes(target.read_bytes() + b"mutation")
        expect_rejection(mutated_root, "SHA-256 mismatch")

        extra_media_root = Path(temporary) / "extra-media"
        shutil.copytree(args.root, extra_media_root)
        (extra_media_root / "standard" / "unreviewed-control.webp").write_bytes(b"extra")
        expect_rejection(extra_media_root, "exact file set mismatch")

        extra_jpeg_root = Path(temporary) / "extra-jpeg"
        shutil.copytree(args.root, extra_jpeg_root)
        (extra_jpeg_root / "standard" / "unexpected.jpg").write_bytes(b"extra")
        expect_rejection(extra_jpeg_root, "exact file set mismatch")

        mislabeled_root = Path(temporary) / "mislabeled-dynamic-type"
        shutil.copytree(args.root, mislabeled_root)
        manifest_path = mislabeled_root / "standard" / "manifest.json"
        manifest = json.loads(manifest_path.read_text())
        original = next(
            record for record in manifest["captures"]
            if record["file"] == "macos-empty-library-no-account-light.jpg"
        )
        original["dynamicType"] = "standard"
        duplicate = dict(original)
        duplicate["dynamicType"] = "accessibility5"
        duplicate["file"] = "macos-empty-library-no-account-light-accessibility5.jpg"
        manifest["captures"].append(duplicate)
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        source = mislabeled_root / "standard" / original["file"]
        target = mislabeled_root / "standard" / duplicate["file"]
        shutil.copyfile(source, target)
        expect_rejection(mislabeled_root, "dynamicType treatment is byte-identical")

        misframed_root = Path(temporary) / "misframed"
        shutil.copytree(args.root, misframed_root)
        manifest_path = misframed_root / "standard" / "manifest.json"
        manifest = json.loads(manifest_path.read_text())
        manifest["captures"][0]["captureBoundsYPoints"] = 90
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        expect_rejection(misframed_root, "captureBoundsYPoints mismatch")

    print(
        "DESIGN CAPTURE NEGATIVE CONTROLS PASS "
        "missing-control=true mutated-jpeg=true extra-media=true extra-jpeg=true "
        "byte-identical-dynamic-type=true misframed-window=true"
    )


if __name__ == "__main__":
    main()
