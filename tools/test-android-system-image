#!/usr/bin/env python3
"""Run the image tool against disposable fake sdkmanager/adb processes, never a real SDK."""
from pathlib import Path
import json
import os
import subprocess
import sys
import tempfile
import time
import unittest

TOOL = (Path(__file__).parent / 'ci/android-system-image').resolve()
FAKE_SDKMANAGER = r'''#!/usr/bin/env python3
from pathlib import Path
import json, os, subprocess, sys, time
sdk = Path(os.environ['ANDROID_HOME']).resolve()
if sys.argv[1:] == ['--licenses']:
    print('All SDK package licenses accepted.')
    sys.exit(0)
package = sys.argv[3]
assert package in json.loads(os.environ['EXPECTED_PACKAGES']), package
assert sys.argv[1:] == [f'--sdk_root={sdk}', '--install', package, '--channel=0'], sys.argv
counter = Path(os.environ['FAKE_COUNTER'])
counter.write_text(str(int(counter.read_text()) + 1 if counter.exists() else 1))
counts_path = counter.with_suffix('.packages')
counts = json.loads(counts_path.read_text()) if counts_path.exists() else {}
attempt = counts.get(package, 0) + 1
counts[package] = attempt
counts_path.write_text(json.dumps(counts))
image = sdk.joinpath(*package.split(';'))
# Each retry must get a fresh download, preserving unrelated installed SDK packages.
if attempt > 1:
    assert not image.exists(), 'partial package survived'
    assert not (sdk / '.temp').exists(), 'bad staged archive survived'
    assert not (sdk / '.downloadIntermediates').exists(), 'partial download survived'
assert (sdk / 'licenses/keep').read_text() == 'keep'
mode = os.environ.get('FAKE_MODE', 'success')
if package != os.environ.get('FAKE_FAIL_PACKAGE', package):
    mode = 'success'
if mode in ('http', 'zip', 'exhausted', 'timeout') and (attempt == 1 or mode in ('exhausted', 'timeout')):
    image.mkdir(parents=True, exist_ok=True)
    (image / '.installer').write_text('partial state')
    (sdk / '.temp').mkdir(exist_ok=True)
    (sdk / '.temp/bad.zip').write_text('not a zip')
    (sdk / '.downloadIntermediates').mkdir(exist_ok=True)
    (sdk / '.downloadIntermediates/partial.zip').write_text('partial download')
    if mode == 'timeout':
        subprocess.Popen([sys.executable, '-c',
            'import time; from pathlib import Path; time.sleep(1.5); Path(' + repr(os.environ['CHILD_MARKER']) + ').write_text("orphan")'])
        time.sleep(10)
    print('Error on ZipFile unknown archive' if mode == 'zip' else 'HTTP 502 from dl.google.com', flush=True)
    sys.exit(1)
if mode == 'empty-success':
    sys.exit(0)
image.mkdir(parents=True, exist_ok=True)
if not package.startswith('system-images;'):
    (image / 'source.properties').write_text('Pkg.Revision=13\n')
    (image / 'package.xml').write_text('<repository><localPackage path="' + package + '"/></repository>')
    names = (['emulator'] if package == 'emulator' else ['adb'] if package == 'platform-tools' else
             ['android.jar'] if package.startswith('platforms;') else ['aapt2', 'apksigner', 'zipalign'])
    if mode != 'missing-payload':
        for name in names:
            binary = image / name
            binary.write_text('fixture payload')
            binary.chmod(0o755)
    sys.exit(0)
_, api, target, arch = package.split(';')
api = api.removeprefix('android-')
values = {'AndroidVersion.ApiLevel': api, 'SystemImage.TagId': target, 'SystemImage.Abi': arch, 'Pkg.Revision': '13'}
if mode == 'wrong-metadata':
    values['SystemImage.Abi'] = 'wrong'
(image / 'source.properties').write_text('\n'.join(k + '=' + v for k, v in values.items()))
(image / 'package.xml').write_text('<repository><localPackage path="' + package + '"/></repository>')
if mode != 'missing-payload':
    for name in ['system.img', 'ramdisk.img', 'kernel-ranchu']:
        (image / name).write_bytes(b'fixture payload')
'''
FAKE_ADB = r'''#!/usr/bin/env python3
import os, sys
assert sys.argv[1:3] == ['-s', 'emulator-5554'], sys.argv
if sys.argv[3:] == ['shell', 'getprop', 'ro.build.version.sdk']:
    print(os.environ.get('BOOT_API', '34'))
elif sys.argv[3:] == ['shell', 'getprop', 'ro.product.cpu.abi']:
    print(os.environ['BOOT_ABI'])
elif sys.argv[3:] == ['emu', 'avd', 'name']:
    print('test\nOK')
else:
    sys.exit(1)
'''


class ImageControl(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='android image control ')
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.sdk = self.root / 'sdk'
        (self.sdk / 'licenses').mkdir(parents=True)
        (self.sdk / 'licenses/keep').write_text('keep')
        self.bin = self.root / 'bin'
        self.bin.mkdir()
        for name, content in [('sdkmanager', FAKE_SDKMANAGER), ('adb', FAKE_ADB)]:
            path = self.bin / name
            path.write_text(content)
            path.chmod(0o755)
        self.env = dict(os.environ, ANDROID_HOME=str(self.sdk), ANDROID_AVD_HOME=str(self.root / 'avd'),
                        PATH=str(self.bin) + os.pathsep + os.environ['PATH'],
                        FAKE_COUNTER=str(self.root / 'attempts'), CHILD_MARKER=str(self.root / 'orphan'))
        self.target = 'google_apis'
        self.arch = 'x86_64'

    def invoke(self, operation='install', timeout=5, dependencies=(), action_log=None):
        package = f'system-images;android-34;{self.target};{self.arch}'
        self.env.update(EXPECTED_PACKAGES=json.dumps([*dependencies, package]), BOOT_ABI=self.env.get('BOOT_ABI', self.arch))
        return subprocess.run([sys.executable, str(TOOL), operation, '--api-level', '34',
                               '--target', self.target, '--arch', self.arch,
                               '--attempt-timeout-seconds', str(timeout), '--retry-delay-seconds', '0',
                               *(['--action-log', str(action_log)] if action_log else []),
                               *[arg for dependency in dependencies for arg in ['--sdk-package', dependency]]],
                              env=self.env, text=True, capture_output=True, timeout=20)

    def attempts(self):
        return int((self.root / 'attempts').read_text())

    def assert_failure(self, result, reason):
        self.assertEqual(result.returncode, 75, result.stdout + result.stderr)
        self.assertIn('::error title=Android emulator SDK infrastructure failure::ANDROID IMAGE INFRA FAILURE', result.stderr)
        self.assertIn(reason, result.stderr)
        self.assertNotIn('ANDROID IMAGE READY', result.stdout)
        self.assertNotIn('ANDROID IMAGE BOOTED', result.stdout)

    def prove_retry(self, mode, signature):
        self.env['FAKE_MODE'] = mode
        result = self.invoke()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.attempts(), 2)
        self.assertIn(signature, result.stdout)
        self.assertEqual(result.stdout.count('ANDROID IMAGE INSTALL'), 2)
        self.assertEqual(result.stdout.count('ANDROID IMAGE RETRY'), 1)
        self.assertIn('clean-partial=true', result.stdout)
        self.assertIn('revision=13 attempt=2', result.stdout)
        for line in result.stdout.splitlines():
            if line.startswith('ANDROID IMAGE '):
                print(f'CONTROL {mode}: {line}', flush=True)

    def test_http_failure_then_success_really_installs_twice(self):
        self.prove_retry('http', 'HTTP 502')

    def test_bad_zip_then_success_discards_partial_archive(self):
        self.prove_retry('zip', 'Error on ZipFile unknown archive')

    def test_emulator_bad_zip_then_success_really_installs_twice(self):
        self.env.update(FAKE_MODE='zip', FAKE_FAIL_PACKAGE='emulator')
        result = self.invoke(dependencies=['emulator'])
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        counts = json.loads((self.root / 'attempts.packages').read_text())
        self.assertEqual(counts['emulator'], 2)
        self.assertEqual(self.attempts(), 3)  # Two emulator attempts, then one image install.
        self.assertIn('ANDROID IMAGE RETRY package=emulator attempt=1/3', result.stdout)
        self.assertIn('ANDROID IMAGE READY package=emulator revision=13 attempt=2', result.stdout)
        for line in result.stdout.splitlines():
            if line.startswith('ANDROID IMAGE '):
                print(f'CONTROL emulator-zip: {line}', flush=True)

    def test_emulator_exhaustion_stops_before_image_and_tests(self):
        self.env.update(FAKE_MODE='exhausted', FAKE_FAIL_PACKAGE='emulator')
        result = self.invoke(dependencies=['emulator'])
        self.assert_failure(result, 'package=emulator attempts=3')
        self.assertEqual(self.attempts(), 3)
        self.assertNotIn('package=system-images;', result.stdout)

    def test_all_action_dependencies_use_same_serial_installer(self):
        dependencies = ['build-tools;37.0.0', 'build-tools;36.0.0', 'platform-tools', 'platforms;android-34',
                        'platforms;android-36', 'emulator']
        result = self.invoke(dependencies=dependencies)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.attempts(), len(dependencies) + 1)
        for dependency in dependencies:
            self.assertIn(f'ANDROID IMAGE READY package={dependency} revision=13 attempt=1', result.stdout)

    def test_emulator_metadata_without_binary_is_not_success(self):
        self.env.update(FAKE_MODE='missing-payload', FAKE_FAIL_PACKAGE='emulator')
        result = self.invoke(dependencies=['emulator'])
        self.assert_failure(result, 'sdk-package-payload-missing-emulator')
        self.assertEqual(self.attempts(), 3)

    def prepare_action_wrapper(self):
        real = self.sdk / 'cmdline-tools/latest/bin/sdkmanager'
        real.parent.mkdir(parents=True)
        real.write_text(FAKE_SDKMANAGER)
        real.chmod(0o755)
        self.action_log = self.root / 'action-install.log'
        result = self.invoke(action_log=self.action_log)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.env.update(EXPECTED_PACKAGES=json.dumps(['emulator']), FAKE_FAIL_PACKAGE='emulator')
        return self.sdk / 'cmdline-tools/latest/sdkmanager'

    def action_install(self, wrapper, *request):
        # Match the action's stdout redirection: evidence must survive on stderr and in the log.
        return subprocess.run([str(wrapper), *request], env=self.env, stdout=subprocess.DEVNULL,
                              stderr=subprocess.PIPE, text=True, timeout=20)

    def test_action_shim_retries_emulator_and_preserves_hidden_output(self):
        wrapper = self.prepare_action_wrapper()
        self.env['FAKE_MODE'] = 'zip'
        result = self.action_install(wrapper, '--install', 'emulator', '--channel=0')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('Error on ZipFile unknown archive', result.stderr)
        self.assertIn('ANDROID IMAGE READY package=emulator revision=13 attempt=2', result.stderr)
        self.assertEqual(self.action_log.read_text(), result.stderr)
        self.assertEqual(json.loads((self.root / 'attempts.packages').read_text())['emulator'], 2)

    def test_action_shim_exhaustion_preserves_infrastructure_exit(self):
        wrapper = self.prepare_action_wrapper()
        self.env['FAKE_MODE'] = 'exhausted'
        result = self.action_install(wrapper, '--install', 'emulator', '--channel=0')
        self.assertEqual(result.returncode, 75, result.stderr)
        self.assertIn('ANDROID IMAGE INFRA FAILURE package=emulator attempts=3', result.stderr)

    def test_action_shim_rejects_a_different_channel_before_installing(self):
        wrapper = self.prepare_action_wrapper()
        result = self.action_install(wrapper, '--install', 'emulator', '--channel=1')
        self.assertEqual(result.returncode, 75, result.stderr)
        self.assertIn('unsupported-action-sdkmanager-package-or-channel', result.stderr)
        self.assertEqual(self.attempts(), 1)

    def test_action_shim_passes_licenses_without_installing_packages(self):
        wrapper = self.prepare_action_wrapper()
        result = self.action_install(wrapper, '--licenses')
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('All SDK package licenses accepted.', result.stderr)
        self.assertEqual(self.attempts(), 1)

    def test_exhaustion_is_bounded_and_classified_as_infrastructure(self):
        self.env['FAKE_MODE'] = 'exhausted'
        result = self.invoke()
        self.assert_failure(result, 'attempts=3')
        self.assertIn('emulator and tests were not started', result.stderr)
        self.assertEqual(self.attempts(), 3)
        self.assertEqual(result.stdout.count('ANDROID IMAGE RETRY'), 2)
        self.assertFalse((self.sdk / '.temp').exists())
        print('CONTROL exhaustion: exit=75 attempts=3 classification=ANDROID IMAGE INFRA FAILURE emulator-and-tests-not-started=true', flush=True)

    def test_success_exit_without_installed_image_is_not_success(self):
        self.env['FAKE_MODE'] = 'empty-success'
        self.assert_failure(self.invoke(), 'attempts=3')
        self.assertEqual(self.attempts(), 3)

    def test_package_metadata_without_payload_is_not_success(self):
        self.env['FAKE_MODE'] = 'missing-payload'
        self.assert_failure(self.invoke(), 'image-payload-missing-system.img')
        self.assertEqual(self.attempts(), 3)

    def test_wrong_installed_abi_is_not_success(self):
        self.env['FAKE_MODE'] = 'wrong-metadata'
        self.assert_failure(self.invoke(), 'image-metadata-mismatch-SystemImage.Abi')
        self.assertEqual(self.attempts(), 3)

    def test_timeout_kills_java_process_group_before_retry(self):
        self.env['FAKE_MODE'] = 'timeout'
        self.assert_failure(self.invoke(timeout=1), 'command-timeout-1s')
        self.assertEqual(self.attempts(), 3)
        time.sleep(1.6)
        self.assertFalse((self.root / 'orphan').exists(), 'installer child outlived timeout and cleanup')

    def prepare_boot(self):
        result = self.invoke()
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(self.attempts(), 1)
        emulator = self.sdk / 'emulator/emulator'
        emulator.parent.mkdir(parents=True, exist_ok=True)
        emulator.write_text("#!/bin/sh\necho 'Android emulator version 37.2.12.0 (build_id 16428233)'\n")
        emulator.chmod(0o755)
        avd = Path(self.env['ANDROID_AVD_HOME']) / 'test.avd'
        avd.mkdir(parents=True)
        (avd / 'config.ini').write_text(f'image.sysdir.1=system-images/android-34/{self.target}/{self.arch}/\n')
        return avd

    def test_phone_normal_install_and_boot_identity(self):
        self.prepare_boot()
        result = self.invoke('verify-booted')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('api=34 target=google_apis abi=x86_64 avd=test', result.stdout)
        self.assertEqual(self.attempts(), 1)

    def test_latest_emulator_cannot_silently_replace_the_pin(self):
        self.prepare_boot()
        (self.sdk / 'emulator/emulator').write_text(
            "#!/bin/sh\necho 'Android emulator version 37.2.13.0 (build_id 16538613)'\n")
        self.assert_failure(self.invoke('verify-booted'), 'emulator-version-mismatch')

    def test_same_version_with_different_build_is_rejected(self):
        self.prepare_boot()
        (self.sdk / 'emulator/emulator').write_text(
            "#!/bin/sh\necho 'Android emulator version 37.2.12.0 (build_id 1)'\n")
        self.assert_failure(self.invoke('verify-booted'), 'emulator-version-mismatch')

    def test_tv_normal_install_and_boot_identity(self):
        self.target, self.arch = 'android-tv', 'x86'
        self.prepare_boot()
        result = self.invoke('verify-booted')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('api=34 target=android-tv abi=x86 avd=test', result.stdout)

    def test_avdmanager_whitespace_around_equals_is_accepted(self):
        avd = self.prepare_boot()
        (avd / 'config.ini').write_text('image.sysdir.1 = system-images/android-34/google_apis/x86_64/\n')
        result = self.invoke('verify-booted')
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn('ANDROID IMAGE BOOTED', result.stdout)
        self.assertIn('image.sysdir.1 = system-images', result.stdout)

    def test_wrong_booted_api_is_rejected(self):
        self.prepare_boot()
        self.env['BOOT_API'] = '35'
        self.assert_failure(self.invoke('verify-booted'), 'booted-image-mismatch')

    def test_wrong_booted_abi_is_rejected(self):
        self.prepare_boot()
        self.env['BOOT_ABI'] = 'x86'
        self.assert_failure(self.invoke('verify-booted'), 'booted-image-mismatch')

    def test_wrong_booted_target_path_is_rejected(self):
        avd = self.prepare_boot()
        (avd / 'config.ini').write_text('image.sysdir.1=system-images/android-34/default/x86_64/\n')
        self.assert_failure(self.invoke('verify-booted'), 'booted-image-mismatch')


if __name__ == '__main__':
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(ImageControl)
    result = unittest.TextTestRunner(verbosity=2).run(suite)
    print(f'ANDROID IMAGE SELF TEST passed={result.testsRun - len(result.failures) - len(result.errors)} '
          f'failed={len(result.failures) + len(result.errors)}', flush=True)
    sys.exit(0 if result.wasSuccessful() else 1)
