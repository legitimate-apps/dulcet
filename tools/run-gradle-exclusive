#!/usr/bin/env python3
"""Run ./gradlew with the arguments given, holding one exclusive lock for the whole invocation.

Eight Apple targets each own a `Compile Kotlin Framework` build phase running
`:core:embedAndSignAppleFrameworkForXcode`, and Xcode builds independent targets in parallel.
Two of those phases therefore start together, and Gradle does not queue: it waits 60 seconds for
`$GRADLE_USER_HOME/caches/journal-1.lock` and then FAILS the build.

  OBSERVED on `main`, run 34127121022 step 37 (2026-09-07):
    Timeout waiting to lock journal cache (/Users/runner/.gradle/caches/journal-1).
    It is currently in use by another process.  Owner PID: 10954  Our PID: 32036
  with `Script-228A...` (DulcetiOS) and `Script-0B17...` (DulcetKitIOSTests) both in that log.

The lock lives beside the Gradle user home because that is the resource being contended, so two
builds using different `GRADLE_USER_HOME` values correctly do not block each other. It is held by
this process, so the kernel releases it if the build is cancelled -- a lock file left on disk is not
a stale lock and never wedges a later build.
"""

from __future__ import annotations

import fcntl
import os
import pathlib
import subprocess
import sys
import time

LOCK_BASENAME = "dulcet-embed-framework.lock"


def gradle_user_home() -> pathlib.Path:
    configured = os.environ.get("GRADLE_USER_HOME")
    if configured:
        return pathlib.Path(configured)
    return pathlib.Path(os.path.expanduser("~")) / ".gradle"


def lock_path() -> pathlib.Path:
    return gradle_user_home() / LOCK_BASENAME


def main(argv: list[str]) -> int:
    if not argv:
        print("run-gradle-exclusive: refusing to run gradle with no arguments", file=sys.stderr)
        return 2

    # Absolute, because `str(Path("./gradlew"))` normalises to `gradlew` and a name with no
    # slash is looked up on PATH rather than in the working directory.
    wrapper = pathlib.Path.cwd() / "gradlew"
    if not wrapper.exists():
        print(
            f"run-gradle-exclusive: no ./gradlew in {os.getcwd()}; "
            "this must run from the repository root",
            file=sys.stderr,
        )
        return 2

    path = lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)

    waited_from = time.monotonic()
    with open(path, "w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print(
                f"run-gradle-exclusive: another Gradle build phase holds {path}; waiting",
                file=sys.stderr,
            )
            fcntl.flock(handle, fcntl.LOCK_EX)
        waited = time.monotonic() - waited_from
        print(
            f"run-gradle-exclusive: acquired {path} after {waited:.1f}s; running {' '.join(argv)}",
            file=sys.stderr,
        )
        # stdin is closed so a Gradle prompt can never block a headless build phase.
        with open(os.devnull, "rb") as devnull:
            completed = subprocess.run([str(wrapper), *argv], stdin=devnull)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
