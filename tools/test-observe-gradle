#!/usr/bin/env python3
"""Controls for the CI observer: preservation, scope, bounded tools and cancellation."""
import atexit
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

OBSERVER = Path(__file__).resolve().parent / "ci" / "observe-gradle"
children = []
@atexit.register
def cleanup():
    for child in children:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    binary = root / "bin"
    binary.mkdir()
    pid_file = root / "child.pid"
    for name, body in {
        "jps": f"print(open({str(pid_file)!r}).read().strip()); print(1)",
        "jcmd": "import os,sys,time; time.sleep(float(os.environ.get('TOOL_DELAY', '0'))); print('THREAD-DUMP',sys.argv[1]); print(' '.join(sys.argv[2:]))",
    }.items():
        file = binary / name
        file.write_text(f"#!{sys.executable}\n{body}\n")
        file.chmod(0o755)
    env = {**os.environ, "PATH": str(binary) + os.pathsep + os.environ["PATH"]}

    def invocation(label, code, delay="0.15", tool_timeout="0.2"):
        return [sys.executable, str(OBSERVER), "--output", str(root / label),
                "--after-seconds", delay, "--tool-timeout", tool_timeout, "--",
                sys.executable, "-c", code]

    def await_file(path):
        deadline = time.monotonic() + 8
        while not path.exists():
            assert time.monotonic() < deadline, f"missing {path}; files={list(root.rglob('*'))}"
            time.sleep(0.01)

    child = f"import os,time,pathlib; pathlib.Path({str(pid_file)!r}).write_text(str(os.getpid())); "
    child += "\nwhile not pathlib.Path(os.environ['RELEASE']).exists(): time.sleep(0.01)"

    def start(label, extra=None, delay="0.5"):
        pid_file.unlink(missing_ok=True)
        release = root / (label + ".release")
        proc = subprocess.Popen(invocation(label, child, delay=delay, tool_timeout="1"),
                                env={**env, "RELEASE":str(release), **(extra or {})})
        children.append(proc)
        await_file(pid_file)
        return proc, release

    proc, release = start("slow")
    target = root / "slow" / ("threads-" + pid_file.read_text() + ".txt")
    await_file(target)
    # File creation precedes jcmd completion; wait for its observed exit marker.
    deadline = time.monotonic() + 8
    while "DIAGNOSTIC exit=0" not in target.read_text():
        assert time.monotonic() < deadline
        time.sleep(0.01)
    release.touch()
    assert proc.wait(timeout=5) == 0
    assert "Thread.print" in target.read_text()
    assert not (root / "slow" / "threads-1.txt").exists(), "foreign JVM must not be touched"
    print("PASS slow command captured exactly its owned JVM")

    for code in [0, 7]:
        label = f"fast-{code}"
        result = subprocess.run(invocation(label, f"raise SystemExit({code})", delay="10"), env=env, timeout=5)
        assert result.returncode == code and not (root / label).exists()
    print("PASS successful/failed fast commands keep their exit status and cancel the observer")

    proc, release = start("blocked-tool", {"TOOL_DELAY":"10"})
    target = root / "blocked-tool" / ("threads-" + pid_file.read_text() + ".txt")
    await_file(target)
    deadline = time.monotonic() + 8
    while "tool timed out" not in target.read_text():
        assert time.monotonic() < deadline
        time.sleep(0.01)
    release.touch()
    assert proc.wait(timeout=5) == 0
    print("PASS stuck diagnostic tool is bounded without killing the observed command")

    (binary / "jps").write_text(f"#!{sys.executable}\nraise SystemExit(3)\n")
    proc, release = start("broken-tool")
    await_file(root / "broken-tool" / "capture-error.txt")
    release.touch()
    assert proc.wait(timeout=5) == 0
    print("PASS diagnostic failure does not replace command success")

    proc, release = start("cancel", delay="10")
    proc.send_signal(signal.SIGTERM)
    assert proc.wait(timeout=5) == 143
    assert not (root / "cancel").exists()
    print("PASS cancellation forwarded and observer stopped")
