#!/usr/bin/env python3
"""Require exactly one named, passing XCTest result in an xcresult bundle."""

from __future__ import annotations

import sys

from pathlib import Path

from xcresult_test_evidence import EvidenceError, read_xcresult, require_exact_test


def fail(message: str) -> None:
    print(f"xcode test execution invalid: {message}", file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) != 4:
    fail(
        "usage: verify-xcode-test-execution "
        "<bundle.xcresult> <expected-class> <expected-method>"
    )

bundle_path = Path(sys.argv[1])
expected_class = sys.argv[2]
expected_method = sys.argv[3]
try:
    cases = read_xcresult(bundle_path)
    require_exact_test(cases, expected_class, expected_method)
except EvidenceError as error:
    fail(str(error))

print(
    "xcode test execution valid: "
    f"test={expected_class}/{expected_method} terminal=Passed individual-results=1"
)
