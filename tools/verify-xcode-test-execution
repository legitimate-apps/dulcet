#!/usr/bin/env python3
"""Require exactly the named, passing XCTest results in an xcresult bundle."""

from __future__ import annotations

import sys

from pathlib import Path

from xcresult_test_evidence import EvidenceError, read_xcresult, require_exact_test


def fail(message: str) -> None:
    print(f"xcode test execution invalid: {message}", file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) < 4:
    fail(
        "usage: verify-xcode-test-execution "
        "<bundle.xcresult> <expected-class> <expected-method> [<expected-method> ...]"
    )

bundle_path = Path(sys.argv[1])
expected_class = sys.argv[2]
expected_methods = sys.argv[3:]
try:
    cases = read_xcresult(bundle_path)
    if len(expected_methods) > 1 and (len(cases) != len(expected_methods) or len(set(expected_methods)) != len(expected_methods)):
        raise EvidenceError(f"expected {len(expected_methods)} distinct tests, observed {len(cases)} results")
    if len(expected_methods) == 1:
        require_exact_test(cases, expected_class, expected_methods[0])
    else:
        for expected_method in expected_methods:
            matching = [case for case in cases if case.name.removesuffix("()") == expected_method]
            require_exact_test(matching, expected_class, expected_method)
except EvidenceError as error:
    fail(str(error))

print(
    "xcode test execution valid: "
    f"class={expected_class} methods={expected_methods} terminal=Passed individual-results={len(cases)}"
)
