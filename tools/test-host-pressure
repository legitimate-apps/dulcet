#!/usr/bin/env python3
"""Controls for tools/ci/host-pressure.

1. A known delta must be reported exactly (a summary that always prints 0 would otherwise read as
   "no paging", the conclusion the instrument exists to test).
2. A file with samples but no phase marks must fail loudly, never summarise as zero pressure.
3. Live sampling on THIS host must parse vm_stat into the counters the summary reads. A parser that
   silently matches nothing produces all-zero deltas, which is indistinguishable from a quiet host.
4. The CPU line names the processes of the phase's highest-load sample, not another sample's, and
   live sampling records a CPU list on this host.
"""
import json
import runpy
import os
import signal
from unittest.mock import patch
from types import SimpleNamespace
import subprocess
import sys
import tempfile
import time
from pathlib import Path

TOOL = str(Path(__file__).resolve().parent / "ci" / "host-pressure")
PAGE = 16384


def run(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, TOOL, *args], capture_output=True, text=True, timeout=60)


with tempfile.TemporaryDirectory() as tmp:
    fixture = Path(tmp) / "known.jsonl"
    base = dict(page_bytes=PAGE, pageins=0, swapins=0, compressions=0, decompressions=0,
                free_pages=100, compressor_pages=64, swapUsedMb=0.0, load1=1.0)
    rows = [
        dict(event="sampler-start", wallTimeMillis=0, memBytes=7 * 2**30, cpus=3),
        dict(event="sample", wallTimeMillis=1000, pageouts=0, swapouts=0, **base),
        dict(event="phase", wallTimeMillis=1500, name="quiet", bootedSimulators=1),
        dict(event="sample", wallTimeMillis=2000, pageouts=0, swapouts=0, **base),
        dict(event="phase", wallTimeMillis=2500, name="paging", bootedSimulators=4),
        # 640 pages of 16 KiB = 10 MB paged out, 1280 pages = 20 MB swapped out.
        dict(event="sample", wallTimeMillis=3000, pageouts=640, swapouts=1280,
             **{**base, "swapUsedMb": 512.0, "load1": 9.5},
             top=[["Simulator", 900]], cpuTop=[["mdworker_shared", 180.5], ["Dulcet", 20.0]]),
        dict(event="stack-capture-end", wallTimeMillis=3100, pid=123, status="complete",
             output="dulcet-hot-app-1-pid-123.log"),
        dict(event="sample", wallTimeMillis=3200, pageouts=640, swapouts=1280,
             **{**base, "swapUsedMb": 100.0, "load1": 2.0},
             top=[["Simulator", 800]], cpuTop=[["quiet", 1.0]]),
    ]
    fixture.write_text("".join(json.dumps(r) + "\n" for r in rows))
    result = run("summarize", str(fixture))
    assert result.returncode == 0, result
    assert 'HOST PRESSURE STACK ' in result.stdout and 'dulcet-hot-app-1-pid-123.log' in result.stdout
    lines = {line.split("phase=")[1].split()[0]: line for line in result.stdout.splitlines()
             if line.startswith("HOST PRESSURE phase=")}
    assert "pageouts_mb=0 " in lines["quiet"] and "booted_simulators=1" in lines["quiet"], result.stdout
    assert "pageouts_mb=10 " in lines["paging"], result.stdout
    assert "swapouts_mb=20 " in lines["paging"], result.stdout
    assert "swap_used_max_mb=512.0" in lines["paging"] and "load1_max=9.5" in lines["paging"], result.stdout
    assert "booted_simulators=4" in lines["paging"], result.stdout
    print("POSITIVE CONTROL PASS known deltas reported: " + lines["paging"])
    cpu = [line for line in result.stdout.splitlines() if line.startswith("HOST PRESSURE CPU phase=paging")]
    assert cpu == ["HOST PRESSURE CPU phase=paging load1=9.5 mdworker_shared:180.5,Dulcet:20.0"], result.stdout
    print("CPU CONTROL PASS the highest-load sample's processes: " + cpu[0])

    unmarked = Path(tmp) / "unmarked.jsonl"
    unmarked.write_text("".join(json.dumps(r) + "\n" for r in rows if r["event"] != "phase"))
    result = run("summarize", str(unmarked))
    assert result.returncode == 1 and "HOST PRESSURE UNAVAILABLE" in result.stdout, result
    print("NEGATIVE CONTROL PASS unmarked file refused: " + result.stdout.strip())

    live = Path(tmp) / "live.jsonl"
    sampler = subprocess.Popen([sys.executable, TOOL, "sample", "--output", str(live),
                                "--interval", "0.5"])
    try:
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            if live.exists() and live.read_text().count('"event":"sample"') >= 3:
                break
            assert sampler.poll() is None, 'live sampler exited before recording three samples'
            time.sleep(.1)
    finally:
        result = run("stop", str(live))
        assert result.returncode == 0, result
        sampler.wait(timeout=10)
    samples = [json.loads(line) for line in live.read_text().splitlines()
               if '"event":"sample"' in line]
    assert len(samples) >= 3, f"expected >=3 live samples, got {len(samples)}"
    for key in ("page_bytes", "pageouts", "swapouts", "pageins", "compressor_pages"):
        assert all(key in s for s in samples), f"live vm_stat parse is missing {key}: {samples[0]}"
    assert samples[0]["page_bytes"] > 0 and samples[-1]["pageins"] > 0, samples[-1]
    listed = [s for s in samples if "cpuTop" in s]
    assert listed and listed[0]["cpuTop"] and all(len(entry) == 2 for entry in listed[0]["cpuTop"]), samples[0]
    print(f"LIVE CONTROL PASS samples={len(samples)} page_bytes={samples[0]['page_bytes']} "
          f"pageins={samples[-1]['pageins']}")

# Behavioral controls for the hot-app trigger. A worker is real subprocess ownership in production;
# this fake keeps observation deterministic and proves that an unfinished capture never blocks it.
module = runpy.run_path(TOOL)
HotAppCapture = module['HotAppCapture']
capture_stack = module['capture_stack']

# Admission controls distinguish low memory from active thrashing. Every interval in a full
# minute counts, so one quiet last poll, a counter reset, or a sampler gap cannot authorize UI.
from contextlib import redirect_stdout
from io import StringIO
quiet = [dict(seconds=t, page_bytes=PAGE, pageins=t * 64, swapins=t, swapouts=t,
              free_pages=3800, swapUsedMb=1500, load1=110 - t / 10) for t in range(0, 71, 10)]
window = module['pressure_window']
cases = [("quiet-with-low-free-and-resident-swap", quiet, True),
         ("short-window", quiet[-6:], False),
         ("high-load", [dict(r, load1=450) for r in quiet], False),
         ("renewed-load-rise", [dict(r, load1=50 + r['seconds'] / 2) for r in quiet], False),
         ("pagein-burst", [dict(r, pageins=r['seconds'] * 2048) for r in quiet], False),
         ("swap-io", [dict(r, swapins=r['seconds'] * 128) for r in quiet], False),
         ("missing-counter", [dict(r, pageins=None) for r in quiet], False),
         ("reset-counter", quiet[:-1] + [dict(quiet[-1], pageins=0)], False),
         ("stale-reading", [quiet[0], quiet[-1]], False)]
for name, readings, expected in cases:
    assert window(readings)['quiet'] == expected, (name, window(readings))
print(f'PRESSURE WINDOW CONTROLS PASS {len(cases)}/{len(cases)} quiet, burst, short, rising, missing, reset, stale')

# Drive the real wait with a virtual monotonic clock. It must wait for 60 seconds of fresh
# quiet evidence, clear the window on command failure, and stop at its cap on persistent load.
settle_pressure = module['settle_pressure']
for scenario, expected, elapsed in [('quiet', 0, 60), ('burst-then-quiet', 0, 90),
                                    ('unreadable-then-quiet', 0, 80), ('busy', 1, 100),
                                    ('unreadable', 1, 100)]:
    now = [0.0]
    def memory(**kwargs):
        if scenario == 'unreadable' or (scenario == 'unreadable-then-quiet' and now[0] == 10):
            raise subprocess.TimeoutExpired('vm_stat', 10)
        return dict(page_bytes=PAGE, pageins=int(now[0]) * 64, swapins=0, swapouts=0,
                    free_pages=3800)
    def load():
        return (450 if scenario == 'busy' or (scenario == 'burst-then-quiet' and now[0] < 30) else 100, 0, 0)
    def sleep(seconds): now[0] += seconds
    with patch.dict(settle_pressure.__globals__, vm_stat=memory, swap_used_mb=lambda **kw: 1500), \
            patch('time.monotonic', side_effect=lambda: now[0]), patch('time.sleep', side_effect=sleep), \
            patch('os.getloadavg', side_effect=load), redirect_stdout(StringIO()) as output:
        assert settle_pressure('control', timeout=100) == expected, output.getvalue()
    assert now[0] == elapsed, (scenario, now, output.getvalue())
    rows = [json.loads(line.split('HOST PRESSURE SETTLE ', 1)[1]) for line in output.getvalue().splitlines()]
    assert rows[-1]['settled'] == (expected == 0), rows[-1]
    print(f'PRESSURE WAIT CONTROL PASS {scenario} exit={expected} seconds={now[0]:.0f}')

def app(pid=123, cpu=90.0, started='Fri Oct 23 20:00:00 2026', name='Dulcet DEV'):
    return dict(pid=pid, cpu=cpu, started=started, name=name, rss=1024)

class Worker:
    pid = 987654
    done = False
    def poll(self):
        return 0 if self.done else None

with tempfile.TemporaryDirectory() as tmp:
    pressure = str(Path(tmp) / 'pressure.log')
    worker = Worker()
    with patch('subprocess.Popen', return_value=worker) as launch, patch('time.monotonic') as clock:
        clock.return_value = 0
        trigger = HotAppCapture(pressure)
        trigger.observe([app(cpu=89.9)])
        trigger.observe([app()])
        clock.return_value = 5
        trigger.observe([app()])
        assert launch.call_count == 0, 'short hot work must preserve the budget'
        clock.return_value = 15
        trigger.observe([app()])
        assert launch.call_count == 1
        assert launch.call_args.args[0][-2].endswith('dulcet-hot-app-1-pid-123.log')
        # A capture that is still resolving symbols never blocks observation or overlaps.
        clock.return_value = 80
        before = time.perf_counter()
        trigger.observe([app()])
        assert time.perf_counter() - before < .1 and launch.call_count == 1
        worker.done = True
        trigger.observe([app()])
        assert launch.call_count == 2
        clock.return_value = 140
        trigger.observe([app()])
        assert launch.call_count == 3
        # Seed old files: starting the fourth capture must remove these, keeping three pairs.
        trigger.outputs[0].write_text('old call tree')
        Path(str(trigger.outputs[0]) + '.stderr.log').write_text('old stderr')
        old = trigger.outputs[0]
        clock.return_value = 200
        trigger.observe([app()])
        assert launch.call_count == 3, 'ten-minute window bounds attachment cost'
        clock.return_value = 615
        trigger.observe([app()])
        assert launch.call_count == 4, 'early work must not exhaust the rest of a long job'
        assert len(trigger.outputs) == 3 and not old.exists()
        assert not Path(str(old) + '.stderr.log').exists(), 'rotation must bound both trees and stderr'
        trigger.observe([app()])
        assert launch.call_count == 4, 'same-launch cooldown prevents immediate recapture'
        launch.reset_mock()
        trigger = HotAppCapture(pressure)
        clock.return_value = 1000
        trigger.observe([app(cpu=50), app(pid=124, cpu=50)])
        clock.return_value = 1015
        trigger.observe([app(cpu=50), app(pid=124, cpu=50)])
        trigger.observe([app(name='DulcetiOSUITests-Runner')])
        clock.return_value = 1030
        trigger.observe([app(name='DulcetiOSUITests-Runner')])
        assert launch.call_count == 0, 'summed CPU or test runners must not trigger'
        trigger.observe([app()])
        trigger.observe([])
        clock.return_value = 1045
        trigger.observe([app()])
        assert launch.call_count == 0, 'a missing reading resets the streak'
        clock.return_value = 1060
        trigger.observe([app(started='another launch')])
        assert launch.call_count == 0, 'PID reuse must reset the streak'
        clock.return_value = 1075
        trigger.observe([app(started='another launch')])
        assert launch.call_count == 1
        Path(pressure + '.stop').touch()
        clock.return_value = 1140
        trigger.observe([app(started='another launch')])
        assert launch.call_count == 1, 'job-end sentinel must prevent new workers'
    print('STACK TRIGGER CONTROL PASS duration, PID identity, reset, exclusion, overlap, rolling budget, retention, stop')

    Path(pressure + ".stop").unlink()

    # Run an actual hanging executable under the same subprocess timeout as sample. This must
    # return promptly, kill/reap the child and leave a timeout receipt while the sampler continues.
    hanging = Path(tmp) / 'hanging-sample'
    hanging.write_text('#!/usr/bin/env python3\nwhile True: pass\n')
    hanging.chmod(0o755)
    output = str(Path(tmp) / 'stack.log')
    before = time.monotonic()
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: [app()]):
        capture_stack(123, app()['started'], output, pressure, str(hanging), timeout=.15)
    assert time.monotonic() - before < 2, 'capture timeout must bound elapsed time'
    receipts = [json.loads(line) for line in Path(pressure).read_text().splitlines()]
    assert receipts[-1]['event'] == 'stack-capture-end' and receipts[-1]['status'] == 'timeout'
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: []):
        capture_stack(123, app()['started'], output, pressure, str(hanging), timeout=.15)
    assert json.loads(Path(pressure).read_text().splitlines()[-1])['event'] == 'stack-capture-exited'
    Path(pressure + '.stop').touch()
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: (_ for _ in ()).throw(AssertionError('must not attach'))):
        capture_stack(123, app()['started'], output, pressure, str(hanging), timeout=.15)
    assert json.loads(Path(pressure).read_text().splitlines()[-1])['status'] == 'job-end-before-sampling'
    assert run('stop', '').returncode == 0
    print('STACK WORKER CONTROL PASS actual timeout, exited PID refused, worker starting during stop refused')

# ps uses a five-field lstart and can return executable names containing spaces. Preserve both.
snapshot = module['process_snapshot']
with patch('subprocess.run', return_value=SimpleNamespace(stdout=(
        '123 1 4096 91.2 1-02:03:04.50 S Fri Oct 23 20:00:00 2026 /tmp/Dulcet DEV\n'
        '124 1 2048 50,5 03:04,50 T Fri Oct 23 20:00:01 2026 /tmp/Dulcet\n'))):
    parsed = snapshot()
assert parsed == [dict(pid=123, ppid=1, rss=4096, cpu=91.2, cpuSeconds=93784.5, state='S', started=app()['started'], name='Dulcet DEV', executable='/tmp/Dulcet DEV'),
                  dict(pid=124, ppid=1, rss=2048, cpu=50.5, cpuSeconds=184.5, state='T', started='Fri Oct 23 20:00:01 2026', name='Dulcet', executable='/tmp/Dulcet')]
print('PS CONTROL PASS PID, launch identity, locale decimal and executable name with spaces')

with tempfile.TemporaryDirectory() as tmp:
    pressure = str(Path(tmp) / 'pressure.log')
    output = str(Path(tmp) / 'stack.log')
    writer = Path(tmp) / 'successful-sample'
    writer.write_text('#!/usr/bin/env python3\nimport sys, time\n'
                      'print("Sampling completed, processing symbols...", flush=True)\n'
                      'time.sleep(10.5)\n'
                      'assert sys.argv[1:4] == ["123", "3", "-file"]\n'
                      'open(sys.argv[4], "w").write("Call graph: control-main-frame\\n")\n')
    writer.chmod(0o755)
    before = time.monotonic()
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: [app()]):
        # Exercise CLI argument dispatch too, using the real worker implementation.
        original = module['main'].__globals__['capture_stack']
        def control_capture(pid, started, stack, log):
            return original(pid, started, stack, log, str(writer))
        with patch.dict(module['main'].__globals__, capture_stack=control_capture):
            assert module['main'](['capture', '123', app()['started'], output, pressure]) == 0
    assert time.monotonic() - before > 10, "fake symbol processing must outlast the old timeout"
    assert Path(output).read_text() == 'Call graph: control-main-frame\n'
    assert json.loads(Path(pressure).read_text().splitlines()[-1])['status'] == 'complete'
    print('STACK SUCCESS CONTROL PASS symbol processing past old ten-second timeout writes complete call tree')

# A real detached worker and child represent symbol processing at job end. Stop must kill their
# group, record the cutoff before returning, and never signal a reused/unrelated PID.
with tempfile.TemporaryDirectory() as tmp:
    pressure = str(Path(tmp) / 'pressure.log')
    output = str(Path(tmp) / 'stack.log')
    child_file = str(Path(tmp) / 'child.pid')
    code = ('import subprocess,time; '
            'p=subprocess.Popen(["sleep","60"]); '
            f'open({child_file!r},"w").write(str(p.pid)); time.sleep(60)')
    argv = [sys.executable, '-c', code, 'capture', '123', app()['started'], output, pressure]
    worker = subprocess.Popen(argv, start_new_session=True)
    child_pid = None
    try:
        deadline = time.monotonic() + 5
        while not Path(child_file).exists() and time.monotonic() < deadline:
            time.sleep(.05)
        child_pid = int(Path(child_file).read_text())
        module['append'](pressure, dict(event='stack-capture-start', pid=123,
            started=app()['started'], workerPid=worker.pid, output='stack.log'))
        before = time.monotonic()
        assert module['stop'](pressure, grace=.1) == 0
        assert time.monotonic() - before < 3, 'cleanup must stay bounded'
        worker.wait(timeout=2)
        rows = [json.loads(line) for line in Path(pressure).read_text().splitlines()]
        assert next(r for r in reversed(rows) if r['event'] == 'stack-capture-end')['status'] == 'job-end-cutoff' and rows[-1]['event'] == 'sampler-stop', rows
        assert rows[-2]['event'] == 'cpu-snapshot' and rows[-2]['cpuProcesses'], rows[-2]
        state = subprocess.run(['ps', '-p', str(child_pid), '-o', 'state='], capture_output=True, text=True).stdout
        assert not state.strip() or state.strip().startswith('Z'), 'sample child must not survive cleanup'
        assert not module['process_matches'](os.getpid(), ' capture an-unrelated-job'), 'PID identity must be checked'
        result = run('stop', pressure)
        assert result.returncode == 0
        rows = [json.loads(line) for line in Path(pressure).read_text().splitlines()]
        assert sum(r.get('status') == 'job-end-cutoff' for r in rows) == 1, 'stop must be idempotent'
    finally:
        if worker.poll() is None:
            os.killpg(worker.pid, signal.SIGKILL)
        worker.wait(timeout=2)
    unrelated = subprocess.Popen(['sleep', '30'], start_new_session=True)
    try:
        module['append'](pressure, dict(event='stack-capture-start', pid=123,
            started=app()['started'], workerPid=unrelated.pid, output='unrelated.log'))
        module['stop'](pressure, grace=0)
        assert unrelated.poll() is None, 'a recorded PID with a different command must not be signaled'
        rows = [json.loads(line) for line in Path(pressure).read_text().splitlines()]
        assert next(r for r in reversed(rows) if r['event'] == 'stack-capture-end')['status'] == 'job-end-worker-unavailable'
    finally:
        unrelated.terminate()
        unrelated.wait(timeout=2)
    print('STACK CLEANUP CONTROL PASS real worker and child cutoff, bounded receipt, unrelated PID spared, repeated stop')

# Same basename, different executable; PID reuse, counter reset and disappearance. A peak
# percent or sum of lifetime CPU would give the wrong answer for this phase.
def cpu_process(pid, path, seconds, started='launch-1'):
    return dict(pid=pid, started=started, executable=path, cpuSeconds=seconds)
def cpu_read(ms, processes):
    return dict(wallTimeMillis=ms, cpuProcesses=processes)
a = cpu_process(1, '/host/diagnosticd', 100)
b = cpu_process(2, '/runtime/diagnosticd', 5)
reads = [cpu_read(0, [a, b]), cpu_read(10000, [dict(a, cpuSeconds=103), dict(b, cpuSeconds=12),
    cpu_process(3, '/runtime/apsd', 90)]),
    cpu_read(20000, [dict(a, cpuSeconds=105), cpu_process(2, '/runtime/diagnosticd', 1, 'launch-2'),
        cpu_process(3, '/runtime/apsd', 2)]),
    cpu_read(30000, [dict(a, cpuSeconds=106)])]
rows = module['cpu_deltas'](reads)
assert module['cpu_deltas']([reads[2], reads[0], reads[3], reads[1]]) == rows, 'concurrent append order must not double-count CPU'
by_id = {(r['pid'], r['started']): r for r in rows}
assert by_id[1, 'launch-1']['cpuLowerBoundSeconds'] == 6, rows
assert by_id[1, 'launch-1']['observedSeconds'] == 30, rows
assert by_id[2, 'launch-1']['cpuLowerBoundSeconds'] == 7, rows
assert not by_id[2, 'launch-1']['presentAtEnd'], rows
assert by_id[2, 'launch-2']['intervals'] == 0, rows
assert by_id[3, 'launch-1']['resets'] == 1, rows
assert by_id[3, 'launch-1']['cpuLowerBoundSeconds'] == 0, rows
assert module['cpu_deltas']([cpu_read(0, []), cpu_read(1000, [])]) == []
assert module['cpu_seconds']('123:45.67') == 7425.67
assert module['cpu_seconds']('25:00:00') == 90000
with tempfile.TemporaryDirectory() as tmp:
    path = Path(tmp) / 'cpu.jsonl'
    # Boundary snapshots make a 20-second phase independent of the sampler's cadence.
    records = [dict(event='sampler-start', wallTimeMillis=0),
        dict(event='phase', name='cpu-phase', **reads[0]),
        dict(event='sample', **reads[1], pageouts=0, swapouts=0, **base),
        dict(event='phase', name='next', **reads[2]),
        dict(event='sample', **reads[3], pageouts=0, swapouts=0, **base)]
    path.write_text(''.join(json.dumps(r) + '\n' for r in records))
    result = run('summarize', str(path))
    totals = [json.loads(line.removeprefix('HOST PRESSURE CPU-TIME '))
        for line in result.stdout.splitlines() if line.startswith('HOST PRESSURE CPU-TIME {')]
    host = next(row for row in totals if row['phase'] == 'cpu-phase' and row['pid'] == 1)
    assert host['cpuLowerBoundSeconds'] == 5 and host['observedSeconds'] == 20, result.stdout
    assert {row['executable'] for row in totals} >= {'/host/diagnosticd', '/runtime/diagnosticd'}, totals
print('CPU TIME CONTROL PASS boundaries, separate executable paths, reuse, reset, birth/exit gaps')
