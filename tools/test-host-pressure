#!/usr/bin/env python3
"""Controls for tools/ci/host-pressure.

1. A known delta must be reported exactly (a summary that always prints 0 would otherwise read as
   "no paging", the conclusion the instrument exists to test).
2. A file with samples but no phase marks must fail loudly, never summarise as zero pressure.
3. Live sampling on THIS host must parse vm_stat into the counters the summary reads. A parser that
   silently matches nothing produces all-zero deltas, which is indistinguishable from a quiet host.
4. The CPU line names the processes of the phase's highest-load sample, not another sample's, and
   live sampling records a CPU list on this host.
"""
import json
import runpy
from unittest.mock import patch
import subprocess
import sys
import tempfile
import time
from pathlib import Path

TOOL = str(Path(__file__).resolve().parent / "ci" / "host-pressure")
PAGE = 16384


def run(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, TOOL, *args], capture_output=True, text=True, timeout=60)


with tempfile.TemporaryDirectory() as tmp:
    fixture = Path(tmp) / "known.jsonl"
    base = dict(page_bytes=PAGE, pageins=0, swapins=0, compressions=0, decompressions=0,
                free_pages=100, compressor_pages=64, swapUsedMb=0.0, load1=1.0)
    rows = [
        dict(event="sampler-start", wallTimeMillis=0, memBytes=7 * 2**30, cpus=3),
        dict(event="sample", wallTimeMillis=1000, pageouts=0, swapouts=0, **base),
        dict(event="phase", wallTimeMillis=1500, name="quiet", bootedSimulators=1),
        dict(event="sample", wallTimeMillis=2000, pageouts=0, swapouts=0, **base),
        dict(event="phase", wallTimeMillis=2500, name="paging", bootedSimulators=4),
        # 640 pages of 16 KiB = 10 MB paged out, 1280 pages = 20 MB swapped out.
        dict(event="sample", wallTimeMillis=3000, pageouts=640, swapouts=1280,
             **{**base, "swapUsedMb": 512.0, "load1": 9.5},
             top=[["Simulator", 900]], cpuTop=[["mdworker_shared", 180.5], ["Dulcet", 20.0]]),
        dict(event="sample", wallTimeMillis=3200, pageouts=640, swapouts=1280,
             **{**base, "swapUsedMb": 100.0, "load1": 2.0},
             top=[["Simulator", 800]], cpuTop=[["quiet", 1.0]]),
    ]
    fixture.write_text("".join(json.dumps(r) + "\n" for r in rows))
    result = run("summarize", str(fixture))
    assert result.returncode == 0, result
    lines = {line.split("phase=")[1].split()[0]: line for line in result.stdout.splitlines()
             if line.startswith("HOST PRESSURE phase=")}
    assert "pageouts_mb=0 " in lines["quiet"] and "booted_simulators=1" in lines["quiet"], result.stdout
    assert "pageouts_mb=10 " in lines["paging"], result.stdout
    assert "swapouts_mb=20 " in lines["paging"], result.stdout
    assert "swap_used_max_mb=512.0" in lines["paging"] and "load1_max=9.5" in lines["paging"], result.stdout
    assert "booted_simulators=4" in lines["paging"], result.stdout
    print("POSITIVE CONTROL PASS known deltas reported: " + lines["paging"])
    cpu = [line for line in result.stdout.splitlines() if line.startswith("HOST PRESSURE CPU phase=paging")]
    assert cpu == ["HOST PRESSURE CPU phase=paging load1=9.5 mdworker_shared:180.5,Dulcet:20.0"], result.stdout
    print("CPU CONTROL PASS the highest-load sample's processes: " + cpu[0])

    unmarked = Path(tmp) / "unmarked.jsonl"
    unmarked.write_text("".join(json.dumps(r) + "\n" for r in rows if r["event"] != "phase"))
    result = run("summarize", str(unmarked))
    assert result.returncode == 1 and "HOST PRESSURE UNAVAILABLE" in result.stdout, result
    print("NEGATIVE CONTROL PASS unmarked file refused: " + result.stdout.strip())

    live = Path(tmp) / "live.jsonl"
    sampler = subprocess.Popen([sys.executable, TOOL, "sample", "--output", str(live),
                                "--interval", "0.5"])
    try:
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            if live.exists() and live.read_text().count('"event":"sample"') >= 3:
                break
            assert sampler.poll() is None, 'live sampler exited before recording three samples'
            time.sleep(.1)
    finally:
        sampler.terminate()
        sampler.wait(timeout=10)
    samples = [json.loads(line) for line in live.read_text().splitlines()
               if '"event":"sample"' in line]
    assert len(samples) >= 3, f"expected >=3 live samples, got {len(samples)}"
    for key in ("page_bytes", "pageouts", "swapouts", "pageins", "compressor_pages"):
        assert all(key in s for s in samples), f"live vm_stat parse is missing {key}: {samples[0]}"
    assert samples[0]["page_bytes"] > 0 and samples[-1]["pageins"] > 0, samples[-1]
    listed = [s for s in samples if "cpuTop" in s]
    assert listed and listed[0]["cpuTop"] and all(len(entry) == 2 for entry in listed[0]["cpuTop"]), samples[0]
    print(f"LIVE CONTROL PASS samples={len(samples)} page_bytes={samples[0]['page_bytes']} "
          f"pageins={samples[-1]['pageins']}")

# Behavioral controls for the hot-app trigger. A worker is real subprocess ownership in production;
# this fake keeps observation deterministic and proves that an unfinished capture never blocks it.
module = runpy.run_path(TOOL)
HotAppCapture = module['HotAppCapture']
capture_stack = module['capture_stack']

def app(pid=123, cpu=90.0, started='Fri Oct 23 20:00:00 2026', name='Dulcet DEV'):
    return dict(pid=pid, cpu=cpu, started=started, name=name, rss=1024)

class Worker:
    done = False
    def poll(self):
        return 0 if self.done else None

with tempfile.TemporaryDirectory() as tmp:
    pressure = str(Path(tmp) / 'pressure.log')
    worker = Worker()
    with patch.dict(HotAppCapture.observe.__globals__, subprocess=__import__('subprocess')):
        with patch('subprocess.Popen', return_value=worker) as launch:
            trigger = HotAppCapture(pressure)
            trigger.observe([app(cpu=89.9)])
            trigger.observe([app()])
            assert launch.call_count == 0, 'a single hot reading must not capture'
            trigger.observe([app()])
            assert launch.call_count == 1
            assert launch.call_args.args[0][-2].endswith('dulcet-hot-app-1-pid-123.log')
            # The next launch is hot but a capture is still in flight: no blocking or overlap.
            trigger.observe([app(pid=124)])
            trigger.observe([app(pid=124)])
            assert launch.call_count == 1
            worker.done = True
            trigger.observe([app(pid=124)])
            assert launch.call_count == 2
            trigger.observe([app(pid=125)])
            trigger.observe([app(pid=125)])
            assert launch.call_count == 3
            trigger.observe([app(pid=126)])
            trigger.observe([app(pid=126)])
            assert launch.call_count == 3, 'job limit must bound captures'
            launch.reset_mock()
            trigger = HotAppCapture(pressure)
            trigger.observe([app(cpu=50), app(pid=124, cpu=50)])
            trigger.observe([app(cpu=50), app(pid=124, cpu=50)])
            trigger.observe([app(name='DulcetiOSUITests-Runner')])
            trigger.observe([app(name='DulcetiOSUITests-Runner')])
            assert launch.call_count == 0, 'summed CPU or test runners must not trigger'
            trigger.observe([app()])
            trigger.observe([])
            trigger.observe([app()])
            assert launch.call_count == 0, 'a missing reading resets the streak'
            trigger.observe([app(started='another launch')])
            assert launch.call_count == 0, 'PID reuse must reset the streak'
            trigger.observe([app(started='another launch')])
            assert launch.call_count == 1
            trigger.observe([app(started='another launch')])
            assert launch.call_count == 1, 'capture only once per process launch'
    print('STACK TRIGGER CONTROL PASS threshold, consecutive PID identity, reset, exclusion, overlap, job cap')

    # Run an actual hanging executable under the same subprocess timeout as sample. This must
    # return promptly, kill/reap the child and leave a timeout receipt while the sampler continues.
    hanging = Path(tmp) / 'hanging-sample'
    hanging.write_text('#!/usr/bin/env python3\nwhile True: pass\n')
    hanging.chmod(0o755)
    output = str(Path(tmp) / 'stack.log')
    before = time.monotonic()
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: [app()]):
        capture_stack(123, app()['started'], output, pressure, str(hanging), timeout=.15)
    assert time.monotonic() - before < 2, 'capture timeout must bound elapsed time'
    receipts = [json.loads(line) for line in Path(pressure).read_text().splitlines()]
    assert receipts[-1]['event'] == 'stack-capture-end' and receipts[-1]['status'] == 'timeout'
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: []):
        capture_stack(123, app()['started'], output, pressure, str(hanging), timeout=.15)
    assert json.loads(Path(pressure).read_text().splitlines()[-1])['event'] == 'stack-capture-exited'
    print('STACK WORKER CONTROL PASS actual child timed out and exited PID refused')

# ps uses a five-field lstart and can return executable names containing spaces. Preserve both.
from types import SimpleNamespace
snapshot = module['process_snapshot']
with patch('subprocess.run', return_value=SimpleNamespace(stdout=(
        '123 4096 91.2 Fri Oct 23 20:00:00 2026 /tmp/Dulcet DEV\n'
        '124 2048 50,5 Fri Oct 23 20:00:01 2026 /tmp/Dulcet\n'))):
    parsed = snapshot()
assert parsed == [dict(pid=123, rss=4096, cpu=91.2, started=app()['started'], name='Dulcet DEV'),
                  dict(pid=124, rss=2048, cpu=50.5, started='Fri Oct 23 20:00:01 2026', name='Dulcet')]
print('PS CONTROL PASS PID, launch identity, locale decimal and executable name with spaces')

with tempfile.TemporaryDirectory() as tmp:
    pressure = str(Path(tmp) / 'pressure.log')
    output = str(Path(tmp) / 'stack.log')
    writer = Path(tmp) / 'successful-sample'
    writer.write_text('#!/usr/bin/env python3\nimport sys\n'
                      'assert sys.argv[1:4] == ["123", "3", "-file"]\n'
                      'open(sys.argv[4], "w").write("Call graph: control-main-frame\\n")\n')
    writer.chmod(0o755)
    with patch.dict(capture_stack.__globals__, process_snapshot=lambda: [app()]):
        # Exercise CLI argument dispatch too, using the real worker implementation.
        original = module['main'].__globals__['capture_stack']
        def control_capture(pid, started, stack, log):
            return original(pid, started, stack, log, str(writer))
        with patch.dict(module['main'].__globals__, capture_stack=control_capture):
            assert module['main'](['capture', '123', app()['started'], output, pressure]) == 0
    assert Path(output).read_text() == 'Call graph: control-main-frame\n'
    assert json.loads(Path(pressure).read_text().splitlines()[-1])['status'] == 'complete'
    print('STACK SUCCESS CONTROL PASS CLI dispatch writes call tree and completion receipt')
