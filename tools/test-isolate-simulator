#!/usr/bin/env python3
"""Controls for tools/ci/isolate-simulator's plan, offline against a fixed device list.

The tool's value is WHICH devices it shuts down and which it keeps. Keeping the wrong iPhone (an
older runtime than `OS=latest` picks, or an unavailable one) would isolate a device xcodebuild then
ignores, booting a second one and silently restoring the contention the tool exists to remove.
"""
import json
import subprocess
import sys
import tempfile
from pathlib import Path

TOOL = str(Path(__file__).resolve().parent / "ci" / "isolate-simulator")
RT = "com.apple.CoreSimulator.SimRuntime."
fixture = {"devices": {
    RT + "iOS-26-4": [
        {"name": "iPhone 17 Pro", "udid": "PHONE-264", "state": "Booted", "isAvailable": True},
        {"name": "iPad Pro 13-inch (M5)", "udid": "IPAD-264", "state": "Booted", "isAvailable": True},
    ],
    RT + "iOS-26-5": [
        {"name": "iPhone 17 Pro", "udid": "PHONE-265", "state": "Shutdown", "isAvailable": True},
    ],
    RT + "iOS-26-10": [
        {"name": "iPhone 17 Pro", "udid": "PHONE-2610", "state": "Shutdown", "isAvailable": True},
    ],
    RT + "iOS-26-11": [
        {"name": "iPhone 17 Pro", "udid": "PHONE-2611-UNAVAILABLE", "state": "Shutdown",
         "isAvailable": False},
    ],
    RT + "tvOS-26-5": [
        {"name": "Apple TV 4K (3rd generation)", "udid": "TV-265", "state": "Booted", "isAvailable": True},
    ],
}}


def plan(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run([sys.executable, TOOL, "--devices-json", path, "--plan", "--phase", "t", *args],
                          capture_output=True, text=True, timeout=30)


with tempfile.TemporaryDirectory() as tmp:
    path = str(Path(tmp) / "devices.json")
    Path(path).write_text(json.dumps(fixture))

    result = plan("--keep-name", "iPhone 17 Pro")
    assert result.returncode == 0, result
    # Newest AVAILABLE runtime: 26.10 -- not the booted 26.4, not 26.5 (a string sort ranks "26-5"
    # above "26-10"), and not the unavailable 26.11.
    assert "keep=PHONE-2610 " in result.stdout, result.stdout
    assert "shut_down=IPAD-264,PHONE-264,TV-265" in result.stdout, result.stdout
    print("POSITIVE CONTROL PASS " + result.stdout.strip())

    result = plan("--none")
    assert "keep=none shut_down=IPAD-264,PHONE-264,TV-265" in result.stdout, result.stdout
    print("POSITIVE CONTROL PASS " + result.stdout.strip())

    result = plan("--keep", "TV-265")
    assert "keep=TV-265 shut_down=IPAD-264,PHONE-264" in result.stdout, result.stdout
    print("POSITIVE CONTROL PASS " + result.stdout.strip())

    result = plan("--keep-name", "iPhone 99")
    assert result.returncode != 0 and "no available simulator named" in (result.stdout + result.stderr), result
    print("NEGATIVE CONTROL PASS unknown device name refused")

    result = plan("--keep", "IPAD-264", "--settle")
    assert result.returncode == 0 and "keep=IPAD-264 " in result.stdout and "settle=yes" in result.stdout, result
    print("POSITIVE CONTROL PASS " + result.stdout.strip())

    result = plan("--none", "--settle")
    assert result.returncode != 0 and "--settle needs a device to keep" in result.stderr, result
    print("NEGATIVE CONTROL PASS --settle without a device refused")

# The settle decision, read from the tool itself: a burst still starting services is not settled,
# a count that holds within the tolerance is, and an unreadable poll never counts as steady.
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
loader = SourceFileLoader("isolate_simulator", TOOL)
tool = module_from_spec(spec_from_loader("isolate_simulator", loader))
loader.exec_module(tool)
for counts, expected in [
    ([40, 61, 88, 112], False),   # the burst: still rising
    ([88, 112, 113, 112], True),  # holding within 2 over the last three polls
    ([112, 113], False),          # too few polls to say
    ([112, None, 112], False),    # a poll that could not be read
    ([100, 103, 100], False),     # wider than the tolerance
    ([70, 71, 72], True),
]:
    assert tool.settled(counts) is expected, (counts, expected)
print("SETTLE DECISION CONTROLS PASS 6/6")

# Execute the shutdown prerequisite with a controlled simctl boundary. A successful shutdown
# command is insufficient: the subsequent device list must positively show no booted device.
from contextlib import redirect_stdout
from io import StringIO
from unittest.mock import patch

# Boot and readiness share one subprocess deadline. A timed-out or failed boot must
# stop before service/pressure admission or any app warm-up, and retain timing evidence.
for outcome, expected, reason in [
    (subprocess.CompletedProcess([], 0), True, "ready=true"),
    (subprocess.CompletedProcess([], 149), False, "ready=false"),
    (subprocess.TimeoutExpired(["xcrun", "simctl", "bootstatus"], 660), False, "reason=deadline"),
]:
    with patch.object(tool, "simctl", side_effect=outcome if isinstance(outcome, Exception) else None,
                      return_value=outcome) as command, \
            patch.object(tool.time, "monotonic", side_effect=[10.0, 13.5]), \
            redirect_stdout(StringIO()) as output:
        assert tool.boot("first-boot-ipad", "IPAD") is expected
    command.assert_called_once_with("bootstatus", "IPAD", "-b", timeout=660, capture_output=False)
    assert reason in output.getvalue() and "seconds=3.5" in output.getvalue(), output.getvalue()
    assert "budget_seconds=660" in output.getvalue(), output.getvalue()
    print(f"BOOT DEADLINE CONTROL PASS {reason} single-command=true streamed=true")

with patch.object(sys, "argv", [TOOL, "--phase", "first-boot-ipad", "--keep", "IPAD",
                               "--settle", "--require-settle", "--require-isolation"]), \
        patch.object(tool, "devices", return_value={"runtime": []}), \
        patch.object(tool, "boot", return_value=False), patch.object(tool, "settle") as settle, \
        patch.object(tool, "warm_first_launch") as warm, redirect_stdout(StringIO()):
    assert tool.main() == 1
settle.assert_not_called()
warm.assert_not_called()
print("BOOT FAILURE CONTROL PASS admission-and-app-launch-not-reached")

for remaining, strict, expected in [(False, True, 0), (True, True, 1), (True, False, 0)]:
    empty = {"runtime": []}
    leftover = {"runtime": [{"udid": "PHONE", "state": "Booted"}]}
    invocations = []
    def fake_simctl(*arguments, **kwargs):
        invocations.append(arguments)
        return subprocess.CompletedProcess(arguments, 0, "", "")
    arguments = [TOOL, "--phase", "platform-before-ipad", "--none"]
    if strict:
        arguments.append("--require-isolation")
    with patch.object(sys, "argv", arguments), patch.object(tool, "devices", side_effect=[leftover, leftover if remaining else empty]), patch.object(tool, "simctl", side_effect=fake_simctl), patch.dict(tool.os.environ, {}, clear=True), redirect_stdout(StringIO()) as output:
        assert tool.main() == expected, (remaining, strict, output.getvalue())
    assert invocations == [("shutdown", "PHONE")], invocations
    assert ("isolated=true" in output.getvalue()) == (not remaining), output.getvalue()
    print(f"SHUTDOWN ACK CONTROL PASS leftover={remaining} required={strict} exit={expected}")

workflow = (Path(TOOL).parents[2] / ".github/workflows/apple-ci.yml").read_text()
# Discovery can publish before shutdown; Actions must still acknowledge shutdown before boot.
# Inspect step order directly, since the output now belongs to the separate discovery step.
import re

def require_platform_ipad_order(candidate):
    platform = candidate.split("  apple-platform:", 1)[1]
    platform = re.split(r"(?m)^  [A-Za-z0-9_-]+:\s*$", platform, maxsplit=1)[0]
    def named(name):
        matches = list(re.finditer(r"(?m)^      - name: " + re.escape(name) + r"$", platform))
        assert len(matches) == 1, f"expected one platform step: {name}"
        start = matches[0].start()
        return start, platform[start:].split("\n      - ", 1)[0]
    resolve_index, resolve = named("Resolve the platform iPadOS destination")
    release_index, release = named("Release the platform iPhone before iPadOS boot")
    boot_index, boot = named("Boot iPadOS simulator before the layout launch")
    assert resolve_index < release_index < boot_index, "destination resolution and required shutdown must precede iPad boot"
    for step in [resolve, release, boot]:
        properties = step.split("        run:", 1)[0]
        allowed_failure = re.search(r"(?m)^        continue-on-error:[ \t]*(.*)$", properties)
        assert allowed_failure is None or allowed_failure[1] == "false", "platform prerequisites must fail closed"
        condition = re.search(r"(?m)^        if:\s*(.*)$", properties)
        assert condition is None or condition[1] in ["success()", "${{ success() }}"], "platform prerequisites require prior success"
        assert "set -euo pipefail" in step, "platform prerequisite shell must stop on failure"
    assert "id: ipados_layout_destination" in resolve
    assert resolve.index("resolve-ipad-destination --print udid") < resolve.index('echo "udid=$IPAD_UDID" >> "$GITHUB_OUTPUT"')
    assert "--none --require-isolation" in release, "shutdown requires an empty booted-device acknowledgment"
    assert "timeout-minutes: 19" in boot, "platform boot must retain its Xcode 27 readiness allowance"
    assert "IPAD_UDID: ${{ steps.ipados_layout_destination.outputs.udid }}" in boot, "boot must consume the published destination"
    assert 'tools/ci/isolate-simulator --phase platform-ipad-first-boot' in boot
    assert '--keep "$IPAD_UDID" --require-isolation' in boot
    assert "resolve-ipad-destination" not in boot, "boot must not rediscover its destination"
    return release, boot

release, boot = require_platform_ipad_order(workflow)
print("PLATFORM IPAD ORDER CONTROL PASS resolve publishes udid; required shutdown precedes nineteen-minute boot using that output")

for mutation, changed in [
    ("boot-before-shutdown", workflow.replace(release, "RELEASE_STEP_PLACEHOLDER").replace(boot, release).replace("RELEASE_STEP_PLACEHOLDER", boot)),
    ("shutdown-continue-on-error", workflow.replace(release, release.replace("        run:", "        continue-on-error: true\n        run:"))),
    ("boot-old-budget", workflow.replace(boot, boot.replace("timeout-minutes: 19", "timeout-minutes: 6"))),
    ("boot-wrong-output", workflow.replace(boot, boot.replace("steps.ipados_layout_destination.outputs.udid", "steps.other_destination.outputs.udid"))),
]:
    assert changed != workflow, f"mutation changed nothing: {mutation}"
    try:
        require_platform_ipad_order(changed)
    except AssertionError as error:
        print(f"PLATFORM IPAD ORDER NEGATIVE CONTROL PASS {mutation} rejected: {error}")
    else:
        raise AssertionError(f"platform ordering control accepted {mutation}")

# Discover's dedicated iPad job must use the same bounded discovery and retain its result.
def require_discover_ipad_destination(candidate):
    job = candidate.split("  discover-wishlist-ipad:", 1)[1].split("\n  apple-ci:", 1)[0]
    resolution = job.split("      - name: Resolve the iPadOS simulator for Discover and Wishlist", 1)[1].split("\n      - ", 1)[0]
    proof = job.split("      - name: Drive Discover and Wishlist through the native ipad app", 1)[1].split("\n      - ", 1)[0]
    assert job.index(resolution) < job.index(proof), "Discover iPad must resolve before proof execution"
    assert "timeout-minutes: 6" in resolution and "id: discover_ipad_destination" in resolution
    assert "set -euo pipefail" in resolution and "resolve-ipad-destination --print udid" in resolution
    assert 'echo "udid=$IPAD_UDID" >> "$GITHUB_OUTPUT"' in resolution
    assert "DULCET_DISCOVER_PROOF_UDID: ${{ steps.discover_ipad_destination.outputs.udid }}" in proof, "Discover iPad must reuse its proven destination"
    assert "resolve-ipad-destination" not in proof

require_discover_ipad_destination(workflow)
print("DISCOVER IPAD DESTINATION CONTROL PASS six-minute discovery precedes proof using published UDID")
changed = workflow.replace("DULCET_DISCOVER_PROOF_UDID: ${{ steps.discover_ipad_destination.outputs.udid }}", "DULCET_DISCOVER_PROOF_UDID: WRONG")
assert changed != workflow
try:
    require_discover_ipad_destination(changed)
except AssertionError:
    print("DISCOVER IPAD DESTINATION NEGATIVE CONTROL PASS wrong destination binding rejected")
else:
    raise AssertionError("Discover iPad control accepted a different destination")

# Service-count stability is a prerequisite in a device member, not a best-effort sleep.
for did_settle in [True, False]:
    calls = []
    def fake_simctl(*arguments, **kwargs):
        calls.append(arguments)
        return subprocess.CompletedProcess(arguments, 0, "", "")
    arguments = [TOOL, '--phase', 'my-library-ipad', '--keep', 'IPAD', '--settle', '--require-settle', '--require-isolation']
    shut = {'runtime': [{'udid': 'IPAD', 'state': 'Shutdown'}]}
    running = {'runtime': [{'udid': 'IPAD', 'state': 'Booted'}]}
    with patch.object(sys, 'argv', arguments), patch.object(tool, 'devices', side_effect=[shut, running]), patch.object(tool, 'simctl', side_effect=fake_simctl), patch.object(tool, 'settle', return_value=did_settle), patch.dict(tool.os.environ, {}, clear=True), redirect_stdout(StringIO()):
        assert tool.main() == (0 if did_settle else 1)
    assert ('bootstatus', 'IPAD', '-b') in calls
    print(f'SETTLE ACK CONTROL PASS observed={did_settle} accepted={did_settle}')

# Pressure admission is mandatory when requested, even if service counts already stabilized.
for pressure_ok in [True, False]:
    arguments = [TOOL, '--phase', 'my-library-ipad', '--keep', 'IPAD', '--settle',
                 '--require-settle', '--settle-pressure', '--require-isolation']
    with patch.object(sys, 'argv', arguments), patch.object(tool, 'devices', return_value=running), \
            patch.object(tool, 'simctl', side_effect=fake_simctl), patch.object(tool, 'settle', return_value=True), \
            patch.object(tool, 'settle_pressure', return_value=pressure_ok) as pressure, \
            patch.dict(tool.os.environ, {}, clear=True), redirect_stdout(StringIO()):
        assert tool.main() == (0 if pressure_ok else 1)
        pressure.assert_called_once_with('my-library-ipad')
    print(f'PRESSURE ACK CONTROL PASS observed={pressure_ok} accepted={pressure_ok}')

# The sacrificial first launch pays installation/render work before admission, never connects
# an account, and must be gone before proof execution. Failures cannot authorize a proof.
import plistlib
with tempfile.TemporaryDirectory() as directory:
    app = Path(directory) / 'Dulcet DEV.app'
    app.mkdir()
    (app / 'Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier': 'com.legitimateapps.dulcet.dev'}))
    for scenario in ['positive', 'install-failure', 'launch-failure', 'launch-timeout',
                     'pressure-failure', 'terminate-failure', 'pressure-timeout']:
        operations = []
        def fake_warm_simctl(*arguments, **kwargs):
            operations.append(arguments)
            if scenario == 'launch-timeout' and arguments[0] == 'launch':
                raise subprocess.TimeoutExpired(arguments, 120)
            failed = scenario == arguments[0] + '-failure'
            return subprocess.CompletedProcess(arguments, int(failed), '', '')
        def fake_pressure(phase):
            operations.append(('pressure', phase))
            if scenario == 'pressure-timeout':
                raise subprocess.TimeoutExpired(['pressure'], 930)
            return scenario != 'pressure-failure'
        with patch.object(tool, 'simctl', side_effect=fake_warm_simctl), \
                patch.object(tool, 'settle_pressure', side_effect=fake_pressure), redirect_stdout(StringIO()):
            assert tool.warm_first_launch('my-library-ipad', 'IPAD', str(app)) == (scenario == 'positive')
        assert operations[0] == ('install', 'IPAD', str(app)), operations
        if scenario == 'install-failure':
            assert len(operations) == 1, operations
        else:
            assert operations[1] == ('launch', '--terminate-running-process', 'IPAD',
                                     'com.legitimateapps.dulcet.dev', '-dulcet-account-connect-layout-fixture'), operations
            assert operations[-1] == ('terminate', 'IPAD', 'com.legitimateapps.dulcet.dev'), operations
            assert any(op[0] == 'pressure' for op in operations) == (not scenario.startswith('launch-')), operations
        print(f'WARMUP CONTROL PASS {scenario} proof_allowed={scenario == "positive"}')
    (app / 'Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier': 'other.app'}))
    with patch.object(tool, 'simctl') as sim, redirect_stdout(StringIO()):
        assert not tool.warm_first_launch('my-library-ipad', 'IPAD', str(app))
        sim.assert_not_called()
    print('WARMUP CONTROL PASS wrong app rejected without simulator commands')

# The main path must choose warm-up plus admission, rather than silently ignoring the argument.
arguments = [TOOL, '--phase', 'my-library-ipad', '--keep', 'IPAD', '--settle',
             '--require-settle', '--settle-pressure', '--require-isolation', '--warmup-app', '/built.app']
for warm_ok in [True, False]:
    with patch.object(sys, 'argv', arguments), patch.object(tool, 'devices', return_value=running), \
            patch.object(tool, 'simctl', side_effect=fake_simctl), patch.object(tool, 'settle', return_value=True), \
            patch.object(tool, 'warm_first_launch', return_value=warm_ok) as warm, \
            patch.object(tool, 'settle_pressure') as pressure, \
            patch.dict(tool.os.environ, {}, clear=True), redirect_stdout(StringIO()):
        assert tool.main() == (0 if warm_ok else 1)
        warm.assert_called_once_with('my-library-ipad', 'IPAD', '/built.app')
        pressure.assert_not_called()
print('WARMUP ACK CONTROLS PASS 2/2')
