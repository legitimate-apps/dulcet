#!/usr/bin/env python3

"""Compare one design-capture pair and retain forensics when it diverges."""

from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys

from design_capture_forensics import ForensicsError, decode_image


FORENSICS = Path(__file__).with_name("design_capture_forensics.py")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("run_a", type=Path)
    parser.add_argument("run_b", type=Path)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument("--forensics-output", type=Path)
    modes.add_argument("--expect-distinct", action="store_true",
                       help="Fail if two Apple tour photographs decode to the same pixels")
    args = parser.parse_args()

    if args.expect_distinct:
        try:
            duplicate = decode_image(args.run_a) == decode_image(args.run_b)
        except (ForensicsError, OSError) as error:
            print(f"DESIGN CAPTURE PAIR DETECTOR ERROR {error}")
            return 2
        verdict = "DUPLICATE" if duplicate else "DISTINCT"
        print(f"DESIGN CAPTURE PAIR {verdict} {args.run_a.name} {args.run_b.name}")
        return int(duplicate)

    if args.forensics_output.exists():
        print(
            "DESIGN CAPTURE PAIR DETECTOR ERROR forensics output already exists: "
            f"{args.forensics_output}"
        )
        return 2

    difference = subprocess.run(
        ["diff", "-qr", str(args.run_a), str(args.run_b)],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    if difference.returncode == 0:
        print("DESIGN CAPTURE PAIR MATCH exact-recursive-file-bytes=true")
        return 0
    if difference.returncode != 1:
        print(
            "DESIGN CAPTURE PAIR DETECTOR ERROR recursive diff failed: "
            f"exit={difference.returncode} output={difference.stdout!r}"
        )
        return 2

    forensics = subprocess.run(
        [
            sys.executable,
            str(FORENSICS),
            str(args.run_a),
            str(args.run_b),
            "--output",
            str(args.forensics_output),
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    print(forensics.stdout, end="")
    if forensics.returncode != 1:
        print(
            "DESIGN CAPTURE PAIR DETECTOR ERROR forensics did not measure the divergence: "
            f"exit={forensics.returncode}"
        )
        return 2

    (args.forensics_output / "recursive-byte-diff.txt").write_text(
        difference.stdout
    )
    print(
        "DESIGN CAPTURE PAIR DIVERGED exact-recursive-file-bytes=false "
        f"forensics={args.forensics_output}"
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
