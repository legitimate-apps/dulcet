                if item.get("isa") == "PBXNativeTarget" and item["name"] == name)


def pbx_synchronized_group(targets: tuple[str, ...], dev_only_exception: bool = False):
    """A synchronized folder of endpoint files attached to `targets`, optionally with a membership
    exception that removes its file from DulcetiOS only -- so PROD alone compiles it in."""
    def apply(root: Path) -> None:
        path = root / PBXPROJ
        text = path.read_text()
        group, exception = "5EED0000000000000000000A", "5EED0000000000000000000B"
        exceptions = ""
        if dev_only_exception:
            dev_id, _ = native_target(text, "DulcetiOS")
            exceptions = f" exceptions = ({exception}, );"
            text = text.replace("/* Begin PBXGroup section */",
                                f"/* Begin PBXFileSystemSynchronizedBuildFileExceptionSet section */\n\t\t{exception} = "
                                f"{{isa = PBXFileSystemSynchronizedBuildFileExceptionSet; membershipExceptions = (endpoint.txt, ); "
                                f"target = {dev_id}; }};\n/* End PBXFileSystemSynchronizedBuildFileExceptionSet section */\n\n"
                                "/* Begin PBXGroup section */", 1)
        text = text.replace("/* Begin PBXGroup section */",
                            f"/* Begin PBXFileSystemSynchronizedRootGroup section */\n\t\t{group} = {{isa = "
                            f"PBXFileSystemSynchronizedRootGroup;{exceptions} path = DulcetEndpoint; sourceTree = \"<group>\"; }};\n"
                            "/* End PBXFileSystemSynchronizedRootGroup section */\n\n/* Begin PBXGroup section */", 1)
        for name in targets:
            identifier, _ = native_target(text, name)
            anchor = f"\t\t{identifier} /* {name} */ = {{\n\t\t\tisa = PBXNativeTarget;\n"
            text = text.replace(anchor, anchor + f"\t\t\tfileSystemSynchronizedGroups = (\n\t\t\t\t{group},\n\t\t\t);\n", 1)
        path.write_text(text)
        (root / "apple/DulcetEndpoint").mkdir()
        (root / "apple/DulcetEndpoint/endpoint.txt").write_text("https://srv.invalid\n")
    return apply


