def run_validator(platform: str, channel: str, info: dict, files: dict[str, bytes] | None = None) -> subprocess.CompletedProcess:
    with tempfile.TemporaryDirectory() as root:
        app = Path(root, "Dulcet.app")
        plist = app / ("Contents/Info.plist" if platform == "macos" else "Info.plist")
        plist.parent.mkdir(parents=True)
        plist.write_bytes(plistlib.dumps(info, fmt=plistlib.FMT_BINARY))
        for relative, data in (files or {"Dulcet": b"\xcf\xfa\xed\xfe binary"}).items():
            Path(app, relative).parent.mkdir(parents=True, exist_ok=True)
            Path(app, relative).write_bytes(data)
        return subprocess.run([sys.executable, str(VALIDATOR), platform, channel, str(app)], capture_output=True, text=True)


def without(document: dict, *path: str) -> dict:
    copy = json.loads(json.dumps(document))
    holder = copy
    for key in path[:-1]:
        holder = holder[key]
    del holder[path[-1]]
    return copy


