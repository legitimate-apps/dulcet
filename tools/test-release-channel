                        "\t\t};\n/* End XCLocalSwiftPackageReference section */", 1)
    path.write_text(text)


def pbx_duplicate_object(root: Path) -> None:
    """A well-formed second copy of iOS PROD's Release configuration, with the same object id, placed
    first and carrying a compile condition. Which copy Xcode keeps is not this policy's to guess."""
    path = root / PBXPROJ
    text = path.read_text()
    objects = policy.parse_pbxproj(text)["objects"]
    _, target = native_target(text, "DulcetiOSRelease")
    identifier = next(item for item in objects[target["buildConfigurationList"]]["buildConfigurations"]
                      if objects[item]["name"] == "Release")
    start = text.index(f"\t\t{identifier} /* Release */ = {{")
    end = text.index("\n\t\t};\n", start) + len("\n\t\t};\n")
    original = text[start:end]
    evil = original.replace("buildSettings = {\n", "buildSettings = {\n\t\t\t\tSWIFT_ACTIVE_COMPILATION_CONDITIONS = X;\n", 1)
    path.write_text(text[:start] + evil + original + text[end:])


