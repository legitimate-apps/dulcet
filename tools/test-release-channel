FOOTER = "violation(s) of spec §22.3/§22.6 (PROD must be unable to carry a server). The rules and every allowlist live in tools/verify_release_policy.py"
for label, mutate, reason in MUTATIONS:
    result = run_policy(mutate)
    expect(result.returncode == 1 and reason in result.stderr,
           f"release policy must reject {label} ({reason!r}); rc={result.returncode} stderr={result.stderr!r}")
    # A refusal with no remedy invites a workaround: every one names where the rules live and §22.3.
    expect(FOOTER in result.stderr, f"release policy's refusal of {label} must name its remedy; stderr={result.stderr!r}")
# Every allowlist refusal names its constant, where it lives, and that extending it is a §22.3 decision.
for label, mutation, constant in [
    ("a PROD setting whose name does not say server", edit("apple/project.yml", PROD_ANCHOR, PROD_ANCHOR + '        DULCET_HOME: "x"\n'),
     "PROD_TARGETS['DulcetMacRelease']['settings']"),
    ("a project-level setting", edit("apple/project.yml", '    MARKETING_VERSION: "0.1.0"\n', '    MARKETING_VERSION: "0.1.0"\n    DEAD_CODE_STRIPPING: YES\n'),
     "PROJECT_SETTINGS"),
    ("a test target using postBuildScripts", edit("apple/project.yml", "  DulcetKitIOSTests:\n",
                                                  "  DulcetExtraTests:\n    type: bundle.unit-test\n    platform: iOS\n    sources:\n      - DulcetKitIOSTests\n"
                                                  "    postBuildScripts:\n      - name: x\n        script: echo\n  DulcetKitIOSTests:\n"),
     "TARGET_KEYS"),
    ("an extra top-level key", edit("apple/project.yml", "packages:\n", "include:\n  - x.yml\npackages:\n"), "TOP_LEVEL_KEYS"),
    ("an extra PROD plist key", edit(IOS_PLIST, "<dict>\n", "<dict>\n\t<key>DulcetHome</key>\n\t<string>x</string>\n"),
     "PROD_TARGETS['DulcetiOSRelease']['keys']"),
]:
    result = run_policy(mutation)
    wanted = f"[allowlist: {constant} in tools/verify_release_policy.py; adding to it is a spec §22.3 decision made in review"
    expect(result.returncode == 1 and wanted in result.stderr,
           f"the refusal of {label} must name {constant} and §22.3; stderr={result.stderr!r}")

# The sanctioned home for a DEV convenience server (spec §22.6): its DEV-only plist. The parity rule
# exempts exactly that key, so this must pass, or the rule leaves DEV no place to put one.
for label, mutate in [
    ("the server key in iOS DEV's partial plist", edit("apple/DulcetiOS/BackgroundAudio.plist", "<dict>\n",
                                                        "<dict>\n\t<key>DulcetPreconfiguredServer</key>\n\t<string>music.invalid</string>\n")),
