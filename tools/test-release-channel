                                                 "<dict>\n\t<key>DulcetPreconfiguredServer</key>\n\t<string>music.invalid</string>\n")),
]:
    result = run_policy(mutate)
    expect(result.returncode == 0, f"release policy must accept {label}; stderr={result.stderr!r}")

if failures:
    print("\n".join(f"FAIL {failure}" for failure in failures), file=sys.stderr)
    raise SystemExit(1)
print(f"release channel controls passed ({passed} assertions, {len(MUTATIONS)} policy mutations rejected, "
      f"{len(VALIDATIONS)} bundle validations)")
