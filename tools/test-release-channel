                                 "        env:\n          DULCET_ASC_KEY_ID: ${{ secrets.DULCET_ASC_KEY_ID }}\n          DULCET_ASC_ISSUER_ID: ${{ secrets.DULCET_ASC_ISSUER_ID }}\n          DULCET_ASC_KEY_P8_BASE64: ${{ secrets.DULCET_ASC_KEY_P8_BASE64 }}\n          PACKAGE: ${{ steps.package.outputs.path }}\n        run: python3 tools/app_store_connect.py upload"),
     "guarded by steps.plan.outputs.upload"),
    ("an unknown secret", edit(WORKFLOW, "secrets.DULCET_ASC_KEY_ID }}", "secrets.DULCET_ASC_KEY_IDX }}"),
     "does not hold"),
    ("a server setting passed to the build", edit(WORKFLOW, "          RELEASE_BUILD_NUMBER:", "          DULCET_DEV_SERVER_URL: x\n          RELEASE_BUILD_NUMBER:"),
     "passes a server, URL or plist setting"),
    ("another workflow reading a release secret", edit(".github/workflows/core-ci.yml", "jobs:\n", "env:\n  LEAK: ${{ secrets.DULCET_CI_SIGNING_P12_BASE64 }}\njobs:\n"),
     "only release.yml may read the release secrets"),
    ("a server setting on the PROD target", edit("apple/project.yml", PROD_ANCHOR,
                                                  PROD_ANCHOR + '        DULCET_PRECONFIGURED_SERVER_URL: "https://example.invalid"\n'),
     "declares DULCET_PRECONFIGURED_SERVER_URL, which is not allowlisted"),
    ("a PROD setting whose name does not say server", edit("apple/project.yml", PROD_ANCHOR,
                                                           PROD_ANCHOR + '        DULCET_HOME: "music.example.invalid"\n'),
     "declares DULCET_HOME, which is not allowlisted"),
    ("a project-level server setting PROD inherits", edit("apple/project.yml", '    MARKETING_VERSION: "0.1.0"\n',
                                                          '    MARKETING_VERSION: "0.1.0"\n    DULCET_SERVER_URL: "https://example.invalid"\n'),
     "project-level setting DULCET_SERVER_URL is not allowlisted"),
    ("project-level configs", edit("apple/project.yml", "packages:\n", "  configs:\n    Release:\n      X: y\npackages:\n"),
     "project-level configs would reach PROD"),
    ("PROD reading the shared plist again", edit("apple/project.yml", "path: DulcetMacRelease/Info.plist", "path: DulcetMac/Info.plist"),
     "must use its own DulcetMacRelease/Info.plist"),
    ("a DEV target reading the PROD plist directory", edit("apple/project.yml", "      path: DulcetMacDev/Info.plist", "      path: DulcetMacRelease/Info.plist"),
     "target DulcetMac reads the PROD-only DulcetMacRelease directory"),
    ("an extra PROD plist key", edit("apple/DulcetMacRelease/Info.plist", "<dict>\n", "<dict>\n\t<key>DulcetHome</key>\n\t<string>x</string>\n"),
     "keys must be exactly the allowlist"),
    ("a URL in a PROD plist value", edit("apple/DulcetMacRelease/Info.plist", "<string>en</string>", "<string>https://example.invalid</string>"),
     "CFBundleDevelopmentRegion holds a URL"),
    ("a quoted release environment elsewhere", edit(".github/workflows/core-ci.yml", "    runs-on: ubuntu-latest\n", "    environment: 'release'\n    runs-on: ubuntu-latest\n"),
     "only release.yml may use the release environment"),
    ("a mapping-form release environment elsewhere", edit(".github/workflows/core-ci.yml", "    runs-on: ubuntu-latest\n", "    environment:\n      name: release\n    runs-on: ubuntu-latest\n"),
     "only release.yml may use the release environment"),
    ("a direct altool upload step", edit(WORKFLOW, "      - name: Summarise\n", "      - name: Sneak\n        run: xcrun altool --upload-package x.pkg\n      - name: Summarise\n"),
     "exactly one upload step"),
    ("an upload in another workflow", edit(".github/workflows/core-ci.yml", "    steps:\n", "    steps:\n      - run: xcrun altool --upload-app -f x.ipa\n"),
     "core-ci.yml: contains an upload mechanism"),
    ("an export that uploads", edit("tools/release/archive-and-export", '"destination": "export"', '"destination": "upload"'),
     "archive-and-export: contains an upload mechanism"),
    ("an extra archive build setting", edit("tools/release/archive-and-export", '  CURRENT_PROJECT_VERSION="$RELEASE_BUILD_NUMBER"',
                                             '  CURRENT_PROJECT_VERSION="$RELEASE_BUILD_NUMBER" \\\n  DULCET_HOME="$X"'),
     "may override CURRENT_PROJECT_VERSION only"),
    ("release.yml deleted", lambda root: (root / WORKFLOW).unlink(), "no delivery channel"),
]
for label, mutate, reason in MUTATIONS:
    result = run_policy(mutate)
    expect(result.returncode == 1 and reason in result.stderr,
           f"release policy must reject {label} ({reason!r}); rc={result.returncode} stderr={result.stderr!r}")

if failures:
    print("\n".join(f"FAIL {failure}" for failure in failures), file=sys.stderr)
    raise SystemExit(1)
print(f"release channel controls passed ({passed} assertions, {len(MUTATIONS)} policy mutations rejected)")
