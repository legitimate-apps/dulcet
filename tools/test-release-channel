POLICY = TOOLS / "verify_release_policy.py"


# Every file the policy reads: the workflows, the Apple tree (the project source and the committed
# project Xcode builds, both channels' plists and entitlements, and every source PROD compiles), the
# Kotlin sources and Gradle build scripts, and the archive script with its validator. Images and audio
# are left out for speed; the policy scans them, and a mutation that needs one writes it.
POLICY_INPUTS = [
    ".github/workflows", "apple", "core/src/commonMain", "core/src/appleMain", "core/src/androidMain",
    "core/src/jvmMain", "build.gradle.kts", "settings.gradle.kts", "core/build.gradle.kts",
    "core-conformance/build.gradle.kts", "android/app/build.gradle.kts", "android/shared/build.gradle.kts",
    "android/tv/build.gradle.kts", "tools/release/archive-and-export", "tools/release/validate-app-bundle",
]
COPY_IGNORES = shutil.ignore_patterns("*.png", "*.mp3", "build", ".build", "DerivedData", ".swiftpm", "xcuserdata")


def run_policy(mutate) -> subprocess.CompletedProcess:
    with tempfile.TemporaryDirectory() as root:
        for relative in POLICY_INPUTS:
            source, target = REPO / relative, Path(root, relative)
            target.parent.mkdir(parents=True, exist_ok=True)
            if source.is_dir():
                shutil.copytree(source, target, ignore=COPY_IGNORES)
            else:
                shutil.copy(source, target)
        mutate(Path(root))
        return subprocess.run([sys.executable, str(POLICY)], cwd=root, capture_output=True, text=True)


def edit(relative: str, old: str, new: str):
    def apply(root: Path) -> None:
        path = root / relative
        text = path.read_text()
        if old not in text:
            raise SystemExit(f"mutation anchor missing in {relative}: {old!r}")
        path.write_text(text.replace(old, new, 1))
    return apply


def pbx(target: str, configuration: str, change):
    """Edit one target configuration's buildSettings in the committed project, as a hand edit or a
    regeneration would leave it. `change` maps that block of text to its replacement."""
    def apply(root: Path) -> None:
        path = root / "apple/Dulcet.xcodeproj/project.pbxproj"
        text = path.read_text()
        objects = policy.parse_pbxproj(text)["objects"]
        owner = next(item for item in objects.values()
                     if item.get("isa") == "PBXNativeTarget" and item["name"] == target)
        identifier = next(item for item in objects[owner["buildConfigurationList"]]["buildConfigurations"]
                          if objects[item]["name"] == configuration)
        start = text.index(f"\t\t{identifier} /* {configuration} */ = {{")
        end = text.index("\t\t};\n", start)
        block = change(text[start:end])
        if block == text[start:end]:
            raise SystemExit(f"pbxproj mutation changed nothing in {target} {configuration}")
        path.write_text(text[:start] + block + text[end:])
    return apply


def add_setting(line: str):
    return lambda block: block.replace("buildSettings = {\n", "buildSettings = {\n\t\t\t\t" + line + "\n", 1)


def both(*mutations):
    def apply(root: Path) -> None:
        for mutation in mutations:
            mutation(root)
    return apply


