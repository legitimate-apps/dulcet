#!/usr/bin/env python3
"""Fault-inject the actual platform startup acknowledgment and destination bindings.

These controls launch no simulator. They prove a mere attempt to boot/settle cannot
satisfy the prerequisite, and the native/UI tests use the device that did satisfy it.
"""
import os
import json
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
import textwrap


root = Path(__file__).resolve().parents[1]
workflow = (root / ".github/workflows/apple-ci.yml").read_text()
preparation = workflow.split("id: platform_iphone_destination", 1)[1].split(
    "      - name: Build iOS shell and test", 1
)[0]
code = textwrap.dedent(preparation.split("<<'PY'\n", 1)[1].rsplit("          PY\n", 1)[0])
device = "11111111-1111-1111-1111-111111111111"
other = "22222222-2222-2222-2222-222222222222"
settle = (
    f"SIMULATOR SETTLE phase=platform-iphone-first-boot udid={device} "
    "running=100,101,100 settled=true seconds=20.0\n"
)
isolation = (
    f"SIMULATOR ISOLATION phase=platform-iphone-first-boot keep={device} "
    f"shut_down=0 booted_after=['{device}'] isolated=true seconds=22.0\n"
)
cases = [
    ("positive", settle + isolation, True),
    ("unsettled", settle.replace("settled=true", "settled=false") + isolation, False),
    ("not-isolated", settle + isolation.replace("isolated=true", "isolated=false"), False),
    ("wrong-phase", (settle + isolation).replace("platform-iphone-first-boot", "unrelated-proof"), False),
    ("different-devices", settle + isolation.replace(device, other), False),
    ("duplicate", settle + settle + isolation, False),
    ("missing-settle", isolation, False),
    ("malformed-uuid", (settle + isolation).replace(device, "-" * 36), False),
]
with tempfile.TemporaryDirectory(prefix="dulcet-startup-acks-") as directory:
    for name, transcript, accepted in cases:
        log = Path(directory) / "startup.log"
        log.write_text(transcript)
        output = Path(directory) / "output"
        output.write_text("")
        result = subprocess.run(
            [sys.executable, "-", str(log)], input=code, text=True, capture_output=True,
            env=dict(os.environ, GITHUB_OUTPUT=str(output)),
        )
        assert (result.returncode == 0) == accepted, (name, result.stdout, result.stderr)
        assert output.read_text() == (f"udid={device}\n" if accepted else ""), (name, output.read_text())
        print(f"PLATFORM IPHONE ACK CONTROL PASS {name} accepted={str(accepted).lower()}")


def verify_destinations(candidate):
    for name, expected_calls in (
        ("Build iOS shell and test DulcetKit plus stored Keychain attributes on iPhone", 2),
        ("Verify iPhone uses the full display", 1),
        ("Verify the first-run Library title wraps on iPhone", 1),
    ):
        step = candidate.split("      - name: " + name, 1)[1].split("      - name: ", 1)[0]
        assert "IPHONE_UDID: ${{ steps.platform_iphone_destination.outputs.udid }}" in step, name
        commands = [shlex.split(line) for line in step.replace("\\\n", " ").splitlines()
                    if line.strip().startswith("xcodebuild ")]
        assert len(commands) == expected_calls, (name, commands)
        for command in commands:
            destinations = [command[i + 1] for i, token in enumerate(command) if token == "-destination"]
            assert destinations == ["id=$IPHONE_UDID"], (name, destinations)


verify_destinations(workflow)
binding = '-destination "id=$IPHONE_UDID"'
assert workflow.count(binding) == 4
for index in range(4):
    for replacement in ('-destination "id=$WRONG_UDID"', '-destination "name=iPhone 18 Pro"', ''):
        pieces = workflow.split(binding)
        mutated = binding.join(pieces[:index + 1]) + replacement + binding.join(pieces[index + 1:])
        try:
            verify_destinations(mutated)
        except AssertionError:
            pass
        else:
            raise AssertionError(("destination mutation escaped", index, replacement))
    print(f"PLATFORM IPHONE DESTINATION MUTATION CONTROL PASS invocation={index + 1} wrong/generic/missing rejected")
print("PLATFORM IPHONE DESTINATION CONTROL PASS native/keychain/full-display/first-run use acknowledged UDID")

# Execute the actual pressure/confirmation steps in workflow order with fake process boundaries.
# Represent the first proof by a sentinel: failure of a prerequisite must prevent reaching it.
steps = []
for block in workflow.split('      - name: ')[1:]:
    if '        run: |\n' in block:
        steps.append(dict(name=block.splitlines()[0].strip(),
                          run=textwrap.dedent(block.split('        run: |\n', 1)[1])))
groups = {
    'iphone': {'Settle iPhone host pressure before the first platform test',
               'Build iOS shell and test DulcetKit plus stored Keychain attributes on iPhone'},
    'ipad': {'Settle iPadOS host pressure before destination confirmation',
             'Confirm booted iPad remains an Xcode destination',
             'Launch iPadOS shell and prove layout plus stored Keychain attributes'},
}
with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    fake = tmp / 'python3'
    fake.write_text('''#!PYTHON
import json, os, sys
args = sys.argv[1:]
with open(os.environ['CALLS'], 'a') as f: f.write(json.dumps(args) + '\\n')
if args[0].endswith('host-pressure'):
    sys.exit(1 if args[1] == 'settle' and os.environ['SCENARIO'] == 'pressure-failure' else 0)
if args[0].endswith('resolve-ipad-destination'):
    if os.environ['SCENARIO'] == 'destination-failure': sys.exit(1)
    print('OTHER' if os.environ['SCENARIO'] == 'destination-mismatch' else 'IPAD')
    sys.exit(0)
raise AssertionError(args)
'''.replace('PYTHON', sys.executable, 1))
    fake.chmod(0o755)
    sentinel = tmp / 'xcodebuild'
    sentinel.write_text('#!/bin/bash\necho \'["proof"]\' >> "$CALLS"\n')
    sentinel.chmod(0o755)
    for mode, names in groups.items():
        selected = [s for s in steps if s.get('name') in names]
        for scenario in ['positive', 'pressure-failure'] + ([] if mode == 'iphone' else
                                                           ['destination-failure', 'destination-mismatch']):
            calls = tmp / 'calls'
            calls.write_text('')
            env = dict(os.environ, PATH=str(tmp) + ':' + os.environ['PATH'], CALLS=str(calls),
                       SCENARIO=scenario, IPAD_UDID='IPAD', DULCET_HOST_PRESSURE_LOG=str(tmp / 'pressure'))
            for step in selected:
                proof = step['name'].startswith(('Build iOS shell', 'Launch iPadOS shell'))
                result = subprocess.run(['bash', '-e', '-o', 'pipefail', '-c',
                                         'xcodebuild' if proof else textwrap.dedent(step['run'])],
                                        env=env, capture_output=True, text=True, timeout=10)
                if result.returncode:
                    break
            invoked = [json.loads(line) for line in calls.read_text().splitlines()]
            reached = ['proof'] in invoked
            assert reached == (scenario == 'positive'), (mode, scenario, invoked)
            if scenario == 'pressure-failure':
                assert not any('resolve-ipad-destination' in row[0] for row in invoked), invoked
            print(f'PLATFORM PRESSURE ADMISSION CONTROL PASS {mode} {scenario} reached_proof={reached}')
