#!/usr/bin/env python3
"""Fault-inject the actual platform startup acknowledgment and destination bindings.

These controls launch no simulator. They prove a mere attempt to boot/settle cannot
satisfy the prerequisite, and the native/UI tests use the device that did satisfy it.
"""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import textwrap


root = Path(__file__).resolve().parents[1]
workflow = (root / ".github/workflows/apple-ci.yml").read_text()
preparation = workflow.split("id: platform_iphone_destination", 1)[1].split(
    "      - name: Build iOS shell and test", 1
)[0]
code = textwrap.dedent(preparation.split("<<'PY'\n", 1)[1].rsplit("          PY\n", 1)[0])
device = "11111111-1111-1111-1111-111111111111"
other = "22222222-2222-2222-2222-222222222222"
settle = (
    f"SIMULATOR SETTLE phase=platform-iphone-first-boot udid={device} "
    "running=100,101,100 settled=true seconds=20.0\n"
)
isolation = (
    f"SIMULATOR ISOLATION phase=platform-iphone-first-boot keep={device} "
    f"shut_down=0 booted_after=['{device}'] isolated=true seconds=22.0\n"
)
cases = [
    ("positive", settle + isolation, True),
    ("unsettled", settle.replace("settled=true", "settled=false") + isolation, False),
    ("not-isolated", settle + isolation.replace("isolated=true", "isolated=false"), False),
    ("wrong-phase", (settle + isolation).replace("platform-iphone-first-boot", "unrelated-proof"), False),
    ("different-devices", settle + isolation.replace(device, other), False),
    ("duplicate", settle + settle + isolation, False),
    ("missing-settle", isolation, False),
    ("malformed-uuid", (settle + isolation).replace(device, "-" * 36), False),
]
with tempfile.TemporaryDirectory(prefix="dulcet-startup-acks-") as directory:
    for name, transcript, accepted in cases:
        log = Path(directory) / "startup.log"
        log.write_text(transcript)
        output = Path(directory) / "output"
        output.write_text("")
        result = subprocess.run(
            [sys.executable, "-", str(log)], input=code, text=True, capture_output=True,
            env=dict(os.environ, GITHUB_OUTPUT=str(output)),
        )
        assert (result.returncode == 0) == accepted, (name, result.stdout, result.stderr)
        assert output.read_text() == (f"udid={device}\n" if accepted else ""), (name, output.read_text())
        print(f"PLATFORM IPHONE ACK CONTROL PASS {name} accepted={str(accepted).lower()}")

for name in (
    "Build iOS shell and test DulcetKit plus stored Keychain attributes on iPhone",
    "Verify iPhone uses the full display",
    "Verify the first-run Library title wraps on iPhone",
):
    step = workflow.split("      - name: " + name, 1)[1].split("      - name: ", 1)[0]
    assert "steps.platform_iphone_destination.outputs.udid" in step, name
    assert "name=iPhone 17 Pro" not in step, name
    assert '-destination "id=$IPHONE_UDID"' in step, name
print("PLATFORM IPHONE DESTINATION CONTROL PASS native/keychain/full-display/first-run use acknowledged UDID")
