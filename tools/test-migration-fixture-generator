#!/usr/bin/env python3
"""Prove that the fixture generator's semantic check can fail, and that it fails for the right reason.

tools/generate_migration_fixture.py --all --check-semantic runs in CI with whatever SQLite the
runner has. A check that always passes would look exactly like one that holds, so each case below
runs the check on a scratch copy of the files it reads, changes exactly one thing, and requires the
check to refuse naming what changed. The unmodified copy must pass: the positive control.

It also proves that a seed never lowers the issue sequence an earlier fixture set: with the previous
fixture's last_issued raised above the seed's own, the regeneration must keep the higher value.
"""

from __future__ import annotations

import shutil
import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TOOL = "tools/generate_migration_fixture.py"
COPIED = [
    TOOL,
    "tools/migration-fixtures/v7",
    "tools/migration-fixtures/v8",
    "core/src/commonMain/sqldelight/migrations/7.sqm",
    "tools/migration-fixtures/v10",
    "tools/migration-fixtures/v11",
    "core/src/commonMain/sqldelight/migrations/10.sqm",
    "tools/migration-fixtures/v12",
    "tools/migration-fixtures/v13",
    "tools/migration-fixtures/v14",
    "core/src/commonMain/sqldelight/migrations/13.sqm",
    "core/src/commonMain/sqldelight/migrations/12.sqm",
]


def scratch(directory: Path) -> Path:
    for relative in COPIED:
        source, target = ROOT / relative, directory / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_dir():
            shutil.copytree(source, target)
        else:
            shutil.copy2(source, target)
    return directory


def check(root: Path, version: int = 8) -> subprocess.CompletedProcess:
    return subprocess.run(
        [sys.executable, str(root / TOOL), "--to", str(version), "--check-semantic"],
        capture_output=True,
        text=True,
    )


def edit_tool(root: Path, old: str, new: str) -> None:
    path = root / TOOL
    text = path.read_text(encoding="utf-8")
    if text.count(old) != 1:
        raise SystemExit(f"test-migration-fixture-generator: the anchor {old!r} is not unique in {TOOL}")
    path.write_text(text.replace(old, new), encoding="utf-8")


def edit_fixture(root: Path, version: int, sql: str) -> None:
    connection = sqlite3.connect(root / f"tools/migration-fixtures/v{version}/database.db")
    try:
        connection.execute(sql)
        connection.commit()
    finally:
        connection.close()


def edit_queue_migration(root: Path, old: str, new: str) -> None:
    path = root / "core/src/commonMain/sqldelight/migrations/12.sqm"
    source = path.read_text()
    if old not in source:
        raise AssertionError(f"migration anchor missing: {old!r}")
    path.write_text(source.replace(old, new))


CASES = [
    (
        "a changed seed row",
        lambda root: edit_tool(root, '(500, "first line")', '(500, "first lime")'),
        "rows of cache_lyrics_line differ",
    ),
    (
        "a changed seeded sequence",
        lambda root: edit_tool(root, "MAX(last_issued, 44)", "MAX(last_issued, 45)"),
        "rows of cache_meta differ",
    ),
    (
        "a committed row edited by hand",
        lambda root: edit_fixture(root, 8, "UPDATE cache_lyrics SET dropped_layers = 3 WHERE raw_id = 'track:download-opaque'"),
        "rows of cache_lyrics differ",
    ),
    (
        "a committed user_version edited by hand",
        lambda root: edit_fixture(root, 8, "PRAGMA user_version = 99"),
        "user_version",
    ),
    (
        "a stray file beside the committed database",
        lambda root: (root / "tools/migration-fixtures/v8/files/stray").write_bytes(b"not generated"),
        "files/ differs",
    ),
    (
        "a committed schema edited by hand",
        lambda root: edit_fixture(root, 8, "CREATE INDEX extra_index ON cache_lyrics(source)"),
        "schema differs",
    ),
    (
        "a seed that lowers an earlier sequence",
        lambda root: (
            edit_fixture(root, 7, "UPDATE cache_meta SET last_issued = 100 WHERE singleton_id = 1"),
            edit_fixture(root, 8, "UPDATE cache_meta SET last_issued = 100 WHERE singleton_id = 1"),
            edit_tool(root, "SET last_issued = MAX(last_issued, 44)", "SET last_issued = 44"),
        ),
        "rows of cache_meta differ",
    ),
]

OFFLINE_CASES = [
    (
        "a changed offline settings seed",
        lambda root: edit_tool(root, '64_000_000', '64_000_001'),
        "rows of offline_library_settings differ",
    ),
    (
        "a committed explicit ownership flag edited by hand",
        lambda root: edit_fixture(root, 11, "UPDATE offline_media_retention SET explicit_download = 0 WHERE explicit_download = 1"),
        "rows of offline_media_retention differ",
    ),
    (
        "a committed automatic ownership flag edited by hand",
        lambda root: edit_fixture(root, 11, "UPDATE offline_media_retention SET automatic_download = 0 WHERE automatic_download = 1"),
        "rows of offline_media_retention differ",
    ),
    (
        "a committed source snapshot edited by hand",
        lambda root: edit_fixture(root, 11, "UPDATE offline_source_snapshot SET size_bytes = 0 WHERE size_bytes IS NOT NULL"),
        "rows of offline_source_snapshot differ",
    ),
]

QUEUE_CASES = [
    (
        "a missing backfill",
        lambda root: edit_queue_migration(root, ");\n", ") WHERE 0;\n"),
        "v13 queue backfill differs",
    ),
    (
        "a backfill from the wrong server",
        lambda root: edit_queue_migration(root, "cache_track.server_id = queue_entry.server_id AND ", ""),
        "v13 queue backfill differs",
    ),
    (
        "an existing queue row deleted during migration",
        lambda root: edit_queue_migration(root, "UPDATE queue_entry", "DELETE FROM queue_entry WHERE queue_entry_id = 'queue:alpha-1';\nUPDATE queue_entry"),
        "v13 queue backfill differs",
    ),
    (
        "unknown metadata invented during migration",
        lambda root: edit_queue_migration(root, ");\n", ");\nUPDATE queue_entry SET duration_milliseconds = COALESCE(duration_milliseconds, 0);\n"),
        "v13 queue backfill differs",
    ),
    (
        "committed queue metadata erased",
        lambda root: edit_fixture(root, 13, "UPDATE queue_entry SET album_raw_id = NULL, duration_milliseconds = NULL"),
        "rows of queue_entry differ",
    ),
]


DISCOVER_CASES = [
    (
        "a changed pending wish seed",
        lambda root: edit_tool(root, '\"pending\", None, 51', '\"synced\", None, 51'),
        "rows of wish_intent differ",
    ),
    (
        "a committed pending wish erased",
        lambda root: edit_fixture(root, 14, "DELETE FROM wish_intent"),
        "rows of wish_intent differ",
    ),
    (
        "a committed wish action clock lowered",
        lambda root: edit_fixture(root, 14, "UPDATE wish_clock SET last_action_time = 0"),
        "rows of wish_clock differ",
    ),
    (
        "a committed wish receipt erased",
        lambda root: edit_fixture(root, 14, "DELETE FROM wish_receipt"),
        "rows of wish_receipt differ",
    ),
    (
        "queue metadata erased alongside Discover",
        lambda root: edit_fixture(root, 14, "UPDATE queue_entry SET album_raw_id = NULL, duration_milliseconds = NULL"),
        "rows of queue_entry differ",
    ),
]


def main() -> None:
    failures = []
    with tempfile.TemporaryDirectory(prefix="dulcet-fixture-control-") as directory:
        root = scratch(Path(directory) / "positive")
        result = check(root)
        if result.returncode != 0:
            failures.append(f"the unmodified copy was refused: {result.stderr.strip()}")
        result = check(root, 11)
        if result.returncode != 0:
            failures.append(f"the unmodified offline fixture was refused: {result.stderr.strip()}")
        result = check(root, 13)
        if result.returncode != 0:
            failures.append(f"the unmodified queue fixture was refused: {result.stderr.strip()}")
        result = check(root, 14)
        if result.returncode != 0:
            failures.append(f"the unmodified Discover fixture was refused: {result.stderr.strip()}")
        # A cached placeholder and a completely absent cached track both leave NULL metadata.
        # Keep released v12 immutable; exercise the absent-track input on an isolated copy.
        uncached = scratch(Path(directory) / "uncached")
        connection = sqlite3.connect(uncached / "tools/migration-fixtures/v12/database.db")
        before = connection.execute("SELECT * FROM queue_entry ORDER BY server_id, queue_entry_id").fetchall()
        connection.execute("DELETE FROM cache_pin WHERE server_id = 'server:fixture-beta'")
        connection.execute("DELETE FROM cache_track WHERE server_id = 'server:fixture-beta'")
        connection.executescript((uncached / "core/src/commonMain/sqldelight/migrations/12.sqm").read_text())
        after = connection.execute("SELECT * FROM queue_entry ORDER BY server_id, queue_entry_id").fetchall()
        connection.close()
        if after != [row + (None, None) for row in before]:
            failures.append("absent cached tracks changed existing queue rows or invented metadata")
        # The sequence guard's positive case: an earlier fixture's higher sequence is kept.
        root = scratch(Path(directory) / "raised")
        edit_fixture(root, 7, "UPDATE cache_meta SET last_issued = 100 WHERE singleton_id = 1")
        edit_fixture(root, 8, "UPDATE cache_meta SET last_issued = 100 WHERE singleton_id = 1")
        result = check(root)
        if result.returncode != 0:
            failures.append(f"a seed lowered an earlier fixture's sequence: {result.stderr.strip()}")
        cases = ([(8, *case) for case in CASES] + [(11, *case) for case in OFFLINE_CASES]
                 + [(13, *case) for case in QUEUE_CASES] + [(14, *case) for case in DISCOVER_CASES])
        for index, (version, name, change, expected) in enumerate(cases):
            root = scratch(Path(directory) / f"case-{index}")
            change(root)
            result = check(root, version)
            if result.returncode == 0:
                failures.append(f"{name}: accepted")
            elif expected not in result.stderr:
                failures.append(f"{name}: refused without naming '{expected}': {result.stderr.strip()}")
    if failures:
        for failure in failures:
            print(f"test-migration-fixture-generator: FAIL {failure}", file=sys.stderr)
        sys.exit(1)
    print(
        f"test-migration-fixture-generator: the committed fixture and a raised sequence accepted; "
        f"uncached queue rows preserved; "
        f"{len(CASES) + len(OFFLINE_CASES) + len(QUEUE_CASES) + len(DISCOVER_CASES)} single changes refused, "
        f"each named (SQLite {sqlite3.sqlite_version})"
    )


if __name__ == "__main__":
    main()
