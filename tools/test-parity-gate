#!/usr/bin/env python3
"""Mutation tests proving parity evidence resolves to an executed passing test."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Callable


REPOSITORY = Path(__file__).resolve().parent.parent
ACTUAL_BRANCH_PROTECTION = {
    "strict": True,
    "contexts": ["apple-ci", "core-ci", "parity-gate"],
    "checks": [
        {"context": "apple-ci", "app_id": 15368},
        {"context": "core-ci", "app_id": 15368},
        {"context": "parity-gate", "app_id": 15368},
    ],
}


def materialize(root: Path) -> None:
    for relative in (
        "FEATURES.yml",
        "tools/parity_gate.py",
        "tools/verify-parity-evidence",
    ):
        source = REPOSITORY / relative
        target = root / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    for relative in (".github/workflows", "docs", "core-conformance"):
        shutil.copytree(REPOSITORY / relative, root / relative)


def invoke(
    root: Path,
    branch_protection: dict[str, object] = ACTUAL_BRANCH_PROTECTION,
) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment.pop("GITHUB_BASE_REF", None)
    environment.pop("GITHUB_ACTIONS", None)
    fixture = root / "branch-protection.json"
    fixture.write_text(json.dumps(branch_protection))
    environment["DULCET_BRANCH_PROTECTION_FIXTURE"] = str(fixture)
    return subprocess.run(
        [sys.executable, "tools/parity_gate.py"],
        cwd=root,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def invoke_execution(root: Path, report: str) -> subprocess.CompletedProcess[str]:
    results = root / "results"
    results.mkdir()
    (results / "TEST-evidence.xml").write_text(report)
    environment = os.environ.copy()
    environment.update(GITHUB_WORKFLOW="apple-ci", GITHUB_JOB="apple-ci")
    return subprocess.run(
        [sys.executable, "tools/verify-parity-evidence", str(results)],
        cwd=root,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def mutate(root: Path, change: Callable[[dict[str, object]], None]) -> None:
    path = root / "FEATURES.yml"
    document = json.loads(path.read_text())
    change(document)
    path.write_text(json.dumps(document, indent=2) + "\n")


def macos_evidence(document: dict[str, object]) -> dict[str, str]:
    features = document["features"]
    assert isinstance(features, list)
    account = features[0]
    assert isinstance(account, dict)
    platforms = account["platforms"]
    assert isinstance(platforms, dict)
    macos = platforms["macos"]
    assert isinstance(macos, dict)
    evidence = macos["evidence"]
    assert isinstance(evidence, dict)
    return evidence


def declare_core_build_required(root: Path) -> None:
    declaration = root / ".github/required-checks.json"
    declaration.parent.mkdir(parents=True, exist_ok=True)
    document = {
        "schema_version": 1,
        "default_branch": "main",
        "contexts": ["apple-ci", "core-ci", "parity-gate", "core-build"],
    }
    declaration.write_text(json.dumps(document, indent=2) + "\n")

    workflow = root / ".github/workflows/core-ci.yml"
    text = workflow.read_text()
    marker = "      - name: Verify CI policy\n"
    if marker not in text:
        raise AssertionError("core-build mutation marker is absent")
    workflow.write_text(
        text.replace(
            marker,
            "      - name: Mutated evidence verifier\n"
            "        run: python3 tools/verify-parity-evidence results\n" + marker,
            1,
        )
    )


def expect_rejection(
    label: str,
    change: Callable[[dict[str, object]], None],
    expected: str,
) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
        root = Path(directory)
        materialize(root)
        mutate(root, change)
        result = invoke(root)
        if result.returncode == 0 or expected not in result.stdout:
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )


with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
    root = Path(directory)
    materialize(root)
    baseline = invoke(root)
    if baseline.returncode != 0:
        raise AssertionError(f"valid evidence tuple rejected: {baseline.stdout}")

expect_rejection(
    "existing but non-required job",
    lambda document: macos_evidence(document).update(workflow="core-ci", job="core-build"),
    "evidence job is not required by branch protection",
)
expect_rejection(
    "missing workflow and job",
    lambda document: macos_evidence(document).update(workflow="missing-ci", job="missing-ci"),
    "evidence workflow/job does not exist",
)
expect_rejection(
    "missing test",
    lambda document: macos_evidence(document).update(test="MissingTest/missingTest"),
    "evidence test does not exist",
)
expect_rejection(
    "required aggregator that never verifies executed tests",
    lambda document: macos_evidence(document).update(workflow="core-ci", job="core-ci"),
    "evidence job is not wired to executed-test verification",
)

with tempfile.TemporaryDirectory(prefix="dulcet-parity-protection-") as directory:
    root = Path(directory)
    materialize(root)
    mutate(
        root,
        lambda document: macos_evidence(document).update(
            workflow="core-ci",
            job="core-build",
        ),
    )
    declare_core_build_required(root)
    result = invoke(root)
    expected = "evidence job is not required by branch protection"
    if result.returncode == 0 or expected not in result.stdout:
        raise AssertionError(
            "PR-editable required-check declaration bypass: expected rejection containing "
            f"{expected!r}, returncode={result.returncode}, output={result.stdout!r}"
        )

passing_report = """\
<testsuite tests="1" failures="0" errors="0" skipped="0">
  <testcase classname="com.legitimateapps.dulcet.conformance.AccountConnectConformanceTest[macosArm64]"
            name="conf01UnauthenticatedExtensionDiscovery[macosArm64]" time="0.1" />
</testsuite>
"""
with tempfile.TemporaryDirectory(prefix="dulcet-parity-execution-") as directory:
    root = Path(directory)
    materialize(root)
    result = invoke_execution(root, passing_report)
    if result.returncode != 0:
        raise AssertionError(f"executed passing evidence rejected: {result.stdout}")

execution_rejections = {
    "existing but unexecuted source test": (
        """<testsuite><testcase classname="AccountConnectConformanceTest"
        name="conf02RedirectPolicy" /></testsuite>""",
        "evidence test did not execute",
    ),
    "self-declared text without a testcase": (
        """<testsuite><system-out>
        AccountConnectConformanceTest/conf01UnauthenticatedExtensionDiscovery passed
        </system-out></testsuite>""",
        "evidence test did not execute",
    ),
    "failed testcase": (
        """<testsuite><testcase classname="AccountConnectConformanceTest"
        name="conf01UnauthenticatedExtensionDiscovery"><failure /></testcase></testsuite>""",
        "evidence test did not pass",
    ),
    "skipped testcase": (
        """<testsuite><testcase classname="AccountConnectConformanceTest"
        name="conf01UnauthenticatedExtensionDiscovery"><skipped /></testcase></testsuite>""",
        "evidence test did not pass",
    ),
}
for label, (report, expected) in execution_rejections.items():
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-execution-") as directory:
        root = Path(directory)
        materialize(root)
        result = invoke_execution(root, report)
        if result.returncode == 0 or expected not in result.stdout:
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )

print("parity-gate mutation and executed-evidence tests pass")
