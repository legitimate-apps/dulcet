def receipt_comparison(
    label: str,
    arrange: Callable[[dict[str, object], dict[str, object]], None],
    expected: str | None,
    receipts: Callable[[Path], None] = lambda root: write_receipt(root, fixture_receipt(root)),
) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-receipt-comparison-") as directory:
        root = Path(directory)
        materialize(root)
        receipts(root)
        base, current = comparison_documents()
        arrange(base, current)
        result = invoke_comparison(root, base, current)
        if expected is None and result.returncode != 0:
            raise AssertionError(f"{label}: expected acceptance, output={result.stdout!r}")
        if expected is not None and (result.returncode == 0 or expected not in result.stdout):
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )


def _ship_account_connect_macos(document: dict[str, object]) -> None:
