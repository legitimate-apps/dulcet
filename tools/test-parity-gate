def _shipped_receipt_replaced_by_a_fresh_run(base: dict[str, object], current: dict[str, object]) -> None:
    cite_receipt_for_gap(base)
    _ship_account_connect_macos(base)
    for row in macos_evidence(base):
        if row.get("receipt") == RECEIPT_PATH:
            row["receipt"] = "evidence/receipts/signed-mac-account-connect-100.json"
    cite_receipt_for_gap(current)
    _ship_account_connect_macos(current)


