#!/usr/bin/env python3
"""Mutation tests proving parity evidence resolves to an executed passing test."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Callable


REPOSITORY = Path(__file__).resolve().parent.parent
def materialize(root: Path) -> None:
    for relative in (
        "FEATURES.yml",
        ".github/required-checks.json",
        "tools/parity_gate.py",
        "tools/required_checks.py",
        "tools/feature_json.py",
        "tools/verify-parity-evidence",
    ):
        source = REPOSITORY / relative
        target = root / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    for relative in (
        ".github/workflows",
        "docs",
        "core-conformance",
        "apple/DulcetKit/Tests",
        "apple/DulcetPlaybackIntegrationTests",
        "apple/DulcetKeychainAppTests",
        "apple/DulcetiOSUITests",
        # The search cells cite the macOS app-host proof and the tvOS UI proof, and the gate
        # verifies every cited test NAME exists in the tree. Without these the fixture rejects a
        # correct FEATURES.yml for citing tests that do not exist -- a false negative that reads
        # exactly like a bad promotion.
        "apple/DulcetMacTests",
        "apple/DulcetTVUITests",
        # The Android app carries the account-connect controls CONF-09a..CONF-10b, and the gate
        # verifies that every cited evidence test NAME exists in the tree. Without this the fixture
        # is missing those sources and a correct FEATURES.yml is rejected as citing tests that do
        # not exist -- a false negative that looks exactly like a bad promotion.
        "android/app/src",
        # Android TV has its own app/runtime and evidence class; copying only the mobile sources
        # would make this fixture reject a valid TV promotion before its mutation cases run.
        "android/tv/src",
        # library.sync/macos cites the macOS app-host integration observation, so this fixture
        # needs the DulcetMacTests sources for the same reason as the line above.
        "apple/DulcetMacTests",
    ):
        shutil.copytree(REPOSITORY / relative, root / relative)
    if "--source-ref" in sys.argv:
        reference = sys.argv[sys.argv.index("--source-ref") + 1]
        (root / "tools/parity_gate.py").write_text(subprocess.check_output(
            ["git", "show", f"{reference}:tools/parity_gate.py"], cwd=REPOSITORY, text=True,
        ))
    commit_fixture_base(root)


def invoke(root: Path, base_ref: str | None = "main") -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    if base_ref is None:
        environment.pop("GITHUB_BASE_REF", None)
    else:
        environment["GITHUB_BASE_REF"] = base_ref
    return subprocess.run(
        [sys.executable, "tools/parity_gate.py"],
        cwd=root,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def invoke_execution(root: Path, report: str) -> subprocess.CompletedProcess[str]:
    results = root / "results"
    results.mkdir()
    (results / "TEST-evidence.xml").write_text(report)
    environment = os.environ.copy()
    environment.update(GITHUB_WORKFLOW="apple-ci", GITHUB_JOB="apple-ci")
    return subprocess.run(
        [sys.executable, "tools/verify-parity-evidence", str(results)],
        cwd=root,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def mutate(root: Path, change: Callable[[dict[str, object]], None]) -> None:
    path = root / "FEATURES.yml"
    document = json.loads(path.read_text())
    change(document)
    path.write_text(json.dumps(document, indent=2) + "\n")


def feature_cell(document: dict[str, object], feature_id: str, platform: str) -> dict[str, object]:
    features = document["features"]
    assert isinstance(features, list)
    feature = next(item for item in features if item["id"] == feature_id)
    platforms = feature["platforms"]
    assert isinstance(platforms, dict)
    cell = platforms[platform]
    assert isinstance(cell, dict)
    return cell


def copy_document(document: dict[str, object]) -> dict[str, object]:
    return json.loads(json.dumps(document))


def write_document(root: Path, document: dict[str, object]) -> None:
    (root / "FEATURES.yml").write_text(json.dumps(document, indent=2) + "\n")


def commit_fixture_base(root: Path) -> None:
    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
    # Local fixture only: declare ownership for commit-identity hooks; never fetch or push.
    subprocess.run(
        ["git", "config", "remote.origin.url", "https://github.com/legitimate-apps/dulcet.git"],
        cwd=root, check=True,
    )
    subprocess.run(["git", "add", "FEATURES.yml"], cwd=root, check=True)
    subprocess.run(
        [
            "git",
            "-c",
            "user.name=legitimate-apps",
            "-c",
            "user.email=309192374+legitimate-apps@users.noreply.github.com",
            "commit",
            "--allow-empty",
            "-qm",
            "base fixture",
        ],
        cwd=root,
        check=True,
    )
    subprocess.run(
        ["git", "update-ref", "refs/remotes/origin/main", "HEAD"],
        cwd=root,
        check=True,
    )


def invoke_comparison(
    root: Path,
    base: dict[str, object],
    current: dict[str, object],
) -> subprocess.CompletedProcess[str]:
    """Run the gate against a controlled origin/main base and working-tree current document."""
    write_document(root, base)
    commit_fixture_base(root)
    write_document(root, current)
    return invoke(root, base_ref="main")


# Every comparison control in this file uses library.sync/macos as its subject and needs that cell
# to START partial with a promotion_condition, because what they test is a promotion. They used to
# read whichever status the live FEATURES.yml happened to carry, so the day that cell shipped they
# stopped testing a promotion -- three of them raised KeyError and the rest would have gone green
# while asserting nothing. Pin the starting state instead of borrowing it.
PINNED_FIXTURE_CELL = ("library.sync", "macos")
PINNED_FIXTURE_PROMOTION_CONDITION = {
    "status": "blocked",
    "blocked_on": "parity-gate-review-control",
    "reason": "Synthetic base state owned by tools/test-parity-gate.",
}


# The second fixture cell, for the controls that need a `planned` starting point. Same reasoning:
# `library.sync/ipados` is bare `planned` in the live document today, and one control asserts the
# gate rejects `planned -> blocked` by name. The day that cell gains a real status -- which is
# already on the follow-up list -- the control breaks for a reason that has nothing to do with the
# rule it guards.
PINNED_PLANNED_CELL = ("library.sync", "ipados")


def pin_fixture_cell(document: dict[str, object]) -> None:
    cell = feature_cell(document, *PINNED_FIXTURE_CELL)
    cell["status"] = "partial"
    cell["promotion_condition"] = copy_document(
        {"value": PINNED_FIXTURE_PROMOTION_CONDITION}
    )["value"]
    planned = feature_cell(document, *PINNED_PLANNED_CELL)
    planned.clear()
    planned["status"] = "planned"


def comparison_documents() -> tuple[dict[str, object], dict[str, object]]:
    document = json.loads((REPOSITORY / "FEATURES.yml").read_text())
    base, current = copy_document(document), copy_document(document)
    pin_fixture_cell(base)
    pin_fixture_cell(current)
    return base, current


def macos_evidence(document: dict[str, object]) -> list[dict[str, str]]:
    features = document["features"]
    assert isinstance(features, list)
    account = features[0]
    assert isinstance(account, dict)
    platforms = account["platforms"]
    assert isinstance(platforms, dict)
    macos = platforms["macos"]
    assert isinstance(macos, dict)
    evidence = macos["evidence"]
    assert isinstance(evidence, list)
    return evidence


def ios_evidence(document: dict[str, object]) -> list[dict[str, str]]:
    features = document["features"]
    assert isinstance(features, list)
    account = features[0]
    assert isinstance(account, dict)
    platforms = account["platforms"]
    assert isinstance(platforms, dict)
    ios = platforms["ios"]
    assert isinstance(ios, dict)
    evidence = ios["evidence"]
    assert isinstance(evidence, list)
    return evidence


def expect_rejection(
    label: str,
    change: Callable[[dict[str, object]], None],
    expected: str,
) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
        root = Path(directory)
        materialize(root)
        mutate(root, change)
        result = invoke(root)
        if result.returncode == 0 or expected not in result.stdout:
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )


COVERAGE_CONTROLS = (
    "observation-only-stream-partial", "observation-only-stream-blocked",
    "observation-only-scrobble-partial", "observation-only-scrobble-blocked",
    "shipped-incomplete-coverage", "partial-conformance-incomplete-coverage",
    "blocked-conformance-incomplete-coverage", "observation-only-promotion",
)


def coverage_control(root: Path, label: str) -> None:
    base, current = comparison_documents()
    feature_id = "playback.scrobble" if "scrobble" in label else "playback.stream"
    old = feature_cell(base, feature_id, "ipados")
    old.pop("evidence", None)
    old["status"] = "blocked" if label.endswith("blocked") else "partial"
    if old["status"] == "blocked":
        old.pop("promotion_condition", None)
        old["blocked_by"] = "coverage-control"
    cell = feature_cell(current, feature_id, "ipados")
    cell.clear()
    cell.update(copy_document(old))
    template = feature_cell(base, feature_id, "ios")["evidence"][0]
    observation = {key: template[key] for key in ("workflow", "job", "test")}
    observation["observes"] = "bounded observation independent of conformance coverage"
    cell["evidence"] = [observation]
    expected = None
    if label.endswith("incomplete-coverage"):
        cell["status"] = label.split("-")[0]
        cell["evidence"].append(dict(template))
        if cell["status"] == "blocked":
            cell["blocked_by"] = "coverage-control"
        expected = "evidence must cover each declared conformance id exactly once"
    elif label == "observation-only-promotion":
        cell["status"] = "shipped"
        expected = "evidence must cover each declared conformance id exactly once"
    if cell["status"] != "partial":
        cell.pop("promotion_condition", None)
    # An added observation satisfies the promotion-delta rule. Coverage must independently
    # reject shipped, even when there are zero conformance-shaped rows.
    result = invoke_comparison(root, base, current)
    passed = (result.returncode == 0 if expected is None else
              result.returncode != 0 and expected in result.stdout)
    print(f"{label}: {'PASS' if passed else 'FAIL'}; gate exit={result.returncode}; {result.stdout.strip()}")
    assert passed, f"{label}: expected {expected or 'acceptance'}"


def review_control(label: str) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-review-") as directory:
        root = Path(directory)
        materialize(root)
        if label in COVERAGE_CONTROLS:
            coverage_control(root, label)
            return
        if label in {"whitespace", "whitespace-internal", "new-row"}:
            base, current = comparison_documents()
            old = feature_cell(base, "library.sync", "macos")
            row = {key: old["evidence"][0][key] for key in ("workflow", "job", "test")}
            row["observes"] = "platform integration"
            old["evidence"].append(row)
            new = feature_cell(current, "library.sync", "macos")
            new["evidence"] = copy_document(old["evidence"])
            new["status"] = "shipped"
            new.pop("promotion_condition")
            assert old["status"] == "partial" and new["status"] == "shipped", (
                "review control must compare a real promotion"
            )
            new["evidence"][-1]["observes"] = (
                " \tplatform integration \n" if label == "whitespace" else
                "platform \t\n  integration" if label == "whitespace-internal" else
                "platform integration after reconnect"
            )
            result = invoke_comparison(root, base, current)
            expected = "promotion without added evidence" if label.startswith("whitespace") else None
        else:
            if label == "missing-requested-base":
                # HEAD^ exists and is valid: it must NOT substitute for origin/missing.
                commit_fixture_base(root)
                result = invoke(root, base_ref="missing")
                expected = "cannot resolve base document origin/missing:FEATURES.yml"
            elif label == "missing-parent":
                # The fixture has only its initial commit and no HEAD^.
                result = invoke(root, base_ref=None)
                expected = "cannot resolve base document HEAD^:FEATURES.yml"
            else:
                raise ValueError(f"unknown review control: {label}")
        if expected is None:
            assert result.returncode == 0, result.stdout
        else:
            assert result.returncode != 0 and expected in result.stdout, (
                f"{label}: expected rejection containing {expected!r}; "
                f"exit={result.returncode}; output={result.stdout.strip()}"
            )
        print(f"{label}: PASS; gate exit={result.returncode}; {result.stdout.strip()}")


REVIEW_CONTROLS = ("whitespace", "whitespace-internal", "new-row", "missing-parent", "missing-requested-base")
if "--control" in sys.argv:
    review_control(sys.argv[sys.argv.index("--control") + 1])
    raise SystemExit(0)
for review_label in (*REVIEW_CONTROLS, *COVERAGE_CONTROLS):
    review_control(review_label)


with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
    root = Path(directory)
    materialize(root)
    baseline = invoke(root)
    if baseline.returncode != 0:
        raise AssertionError(f"valid evidence tuple rejected: {baseline.stdout}")

def _cite_one_test_for_every_id(document: dict[str, object]) -> None:
    """Point every macOS evidence row at the SAME test.

    This is the shape a false promotion takes: the cited test exists in the tree, so the
    existence check passes, but one test is standing in as proof of several distinct
    conformance requirements. Without this control the gate accepts it, which is worse than
    rejecting nothing -- the row then LOOKS evidenced.
    """
    rows = macos_evidence(document)
    borrowed = rows[0]["test"]
    for row in rows:
        row["test"] = borrowed


expect_rejection(
    "one test cited for several conformance ids",
    _cite_one_test_for_every_id,
    "cites one test for",
)


def expect_acceptance(label: str, change: Callable[[dict[str, object]], None]) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
        root = Path(directory)
        materialize(root)
        mutate(root, change)
        result = invoke(root)
        if result.returncode != 0:
            raise AssertionError(
                f"{label}: expected acceptance, returncode={result.returncode}, "
                f"output={result.stdout!r}"
            )


def expect_comparison(
    label: str,
    arrange: Callable[[dict[str, object], dict[str, object]], None],
    expected: str | None = None,
) -> subprocess.CompletedProcess[str]:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-comparison-") as directory:
        root = Path(directory)
        materialize(root)
        base, current = comparison_documents()
        arrange(base, current)
        result = invoke_comparison(root, base, current)
        if expected is None and result.returncode != 0:
            raise AssertionError(
                f"{label}: expected acceptance, returncode={result.returncode}, "
                f"output={result.stdout!r}"
            )
        if expected is not None and (result.returncode == 0 or expected not in result.stdout):
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )
        return result


def _valid_observation_entry(
    rows: list[dict[str, str]],
    observes: str = "the macOS job actually launched and drove the real UI, not a host-only unit test",
) -> dict[str, str]:
    """Build an observation-shaped entry that reuses an existing row's workflow/job/test.

    Reusing an already-valid citation keeps every other invariant (workflow/job exist, the job is
    required and wired to executed-test verification, the test exists in the tree) satisfied by
    construction, so each control below isolates the one thing it means to exercise.
    """
    template = rows[0]
    return {
        "observes": observes,
        "workflow": template["workflow"],
        "job": template["job"],
        "test": template["test"],
    }


def _append_observation_entry(
    document: dict[str, object],
    observes: str = "the macOS job actually launched and drove the real UI, not a host-only unit test",
) -> None:
    rows = macos_evidence(document)
    rows.append(_valid_observation_entry(rows, observes))


expect_acceptance(
    "valid observation row alongside its cell's existing conformance evidence",
    _append_observation_entry,
)

expect_rejection(
    "evidence entry mixes conformance and observes keys",
    lambda document: macos_evidence(document)[0].update(
        observes="pasted onto an already conformance-shaped row"
    ),
    "evidence entries require exactly",
)


def _observation_row_with_unknown_key(document: dict[str, object]) -> None:
    _append_observation_entry(document)
    macos_evidence(document)[-1]["note"] = "unknown key"


expect_rejection(
    "observation row carries an unknown extra key",
    _observation_row_with_unknown_key,
    "evidence entries require exactly",
)

for blank in ("", "   ", "\n\t"):
    expect_rejection(
        f"observation row observes is blank ({blank!r})",
        lambda document, blank=blank: _append_observation_entry(document, observes=blank),
        "evidence observes must be a non-empty string",
    )


def _cite_one_test_for_two_observation_claims(document: dict[str, object]) -> None:
    """The observation analogue of _cite_one_test_for_every_id above.

    Dropping the conformance id does not drop the risk: an existing test pasted against two
    different prose claims is the same laundering move the conformance rule exists to stop, so it
    must be rejected the same way.
    """
    rows = macos_evidence(document)
    rows.append(_valid_observation_entry(rows, "first observation claim about this platform"))
    rows.append(_valid_observation_entry(rows, "a second, different claim reusing the same test"))


expect_rejection(
    "one test cited for two different observation claims",
    _cite_one_test_for_two_observation_claims,
    "observation claims",
)


