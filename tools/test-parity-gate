# --- Receipt evidence for dispatch-only main runs (spec §21.3.1) -------------------------------
# A receipt row cites a committed record of one audited green main run of a dispatch-only job.
# Every fixture receipt is built here against the fixture's own tree and commit, so these cases do
# not depend on the worked example under evidence/receipts, which goes stale by design whenever its
# test source changes.

RECEIPT_TEST = (
    "DulcetSignedMacAccountConnectTests/testLiveConnectSavesDeviceOnlyCredentialAndRendersConnectedUI"
)
RECEIPT_SOURCE = "apple/DulcetSignedMacTests/DulcetSignedMacAccountConnectTests.swift"
RECEIPT_PATH = "evidence/receipts/signed-mac-account-connect-111.json"


def fixture_receipt(root: Path, run_id: str = "111", **overrides: object) -> dict[str, object]:
    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=root, text=True).strip()
    blob = subprocess.check_output(["git", "hash-object", RECEIPT_SOURCE], cwd=root, text=True).strip()
    receipt: dict[str, object] = {
        "workflow": "signed-mac-account-connect",
        "job": "signed-account-connect",
        "run_id": run_id,
        "run_url": f"https://github.com/legitimate-apps/dulcet/actions/runs/{run_id}",
        "head_sha": head,
        "conclusion": "success",
        "tests": [{"name": RECEIPT_TEST, "result": "passed"}],
        "junit_sha256": "f" * 64,
        "test_sources": {RECEIPT_SOURCE: blob},
        "audit": {"tool": "tools/verify_signed_mac_privacy.py", "result": "pass",
                  "files_scanned": 12, "tokens_checked": 28},
    }
    receipt.update(overrides)
    return receipt


def write_receipt(root: Path, receipt: dict[str, object], path: str = RECEIPT_PATH) -> None:
    target = root / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(receipt, indent=2) + "\n")


def receipt_row(test: str = RECEIPT_TEST, receipt: str = RECEIPT_PATH, **shape: str) -> dict[str, str]:
    return {**(shape or {"observes": "the entitled signed Mac host saved to the real Keychain"}),
            "receipt": receipt, "test": test}


def cite_receipt(*rows: dict[str, str]) -> Callable[[dict[str, object]], None]:
    def change(document: dict[str, object]) -> None:
        macos_evidence(document).extend(copy_document({"rows": list(rows)})["rows"])
    return change


def cite_receipt_for_gap(document: dict[str, object]) -> None:
    """Close account.connect/macos's CONF-09b gap with a receipt row, keeping coverage exact."""
    cell = feature_cell(document, "account.connect", "macos")
    cell.pop("unevidenced_conformance")
    macos_evidence(document).append(receipt_row(conformance="CONF-09b"))


def receipt_case(
    label: str,
    change: Callable[[dict[str, object]], None],
    expected: str | None,
    arrange: Callable[[Path], None] = lambda root: write_receipt(root, fixture_receipt(root)),
) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-receipt-") as directory:
        root = Path(directory)
        materialize(root)
        arrange(root)
        mutate(root, change)
        result = invoke(root)
        if expected is None and result.returncode != 0:
            raise AssertionError(f"{label}: expected acceptance, output={result.stdout!r}")
        if expected is not None and (result.returncode == 0 or expected not in result.stdout):
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )


