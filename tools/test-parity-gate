#!/usr/bin/env python3
"""Mutation tests proving the parity gate validates partial evidence tuples."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Callable


REPOSITORY = Path(__file__).resolve().parent.parent


def materialize(root: Path) -> None:
    for relative in ("FEATURES.yml", ".github/required-checks.json", "tools/parity_gate.py"):
        source = REPOSITORY / relative
        target = root / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    for relative in (".github/workflows", "docs", "core-conformance"):
        shutil.copytree(REPOSITORY / relative, root / relative)


def invoke(root: Path) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    environment.pop("GITHUB_BASE_REF", None)
    return subprocess.run(
        [sys.executable, "tools/parity_gate.py"],
        cwd=root,
        env=environment,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def mutate(root: Path, change: Callable[[dict[str, object]], None]) -> None:
    path = root / "FEATURES.yml"
    document = json.loads(path.read_text())
    change(document)
    path.write_text(json.dumps(document, indent=2) + "\n")


def macos_evidence(document: dict[str, object]) -> dict[str, str]:
    features = document["features"]
    assert isinstance(features, list)
    account = features[0]
    assert isinstance(account, dict)
    platforms = account["platforms"]
    assert isinstance(platforms, dict)
    macos = platforms["macos"]
    assert isinstance(macos, dict)
    evidence = macos["evidence"]
    assert isinstance(evidence, dict)
    return evidence


def expect_rejection(
    label: str,
    change: Callable[[dict[str, object]], None],
    expected: str,
) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
        root = Path(directory)
        materialize(root)
        mutate(root, change)
        result = invoke(root)
        if result.returncode == 0 or expected not in result.stdout:
            raise AssertionError(
                f"{label}: expected rejection containing {expected!r}, "
                f"returncode={result.returncode}, output={result.stdout!r}"
            )


with tempfile.TemporaryDirectory(prefix="dulcet-parity-gate-") as directory:
    root = Path(directory)
    materialize(root)
    baseline = invoke(root)
    if baseline.returncode != 0:
        raise AssertionError(f"valid evidence tuple rejected: {baseline.stdout}")

expect_rejection(
    "existing but non-required job",
    lambda document: macos_evidence(document).update(workflow="core-ci", job="core-build"),
    "evidence job is not a required status check",
)
expect_rejection(
    "missing workflow and job",
    lambda document: macos_evidence(document).update(workflow="missing-ci", job="missing-ci"),
    "evidence workflow/job does not exist",
)
expect_rejection(
    "missing test",
    lambda document: macos_evidence(document).update(test="MissingTest/missingTest"),
    "evidence test does not exist",
)

print("parity-gate mutation tests pass")
