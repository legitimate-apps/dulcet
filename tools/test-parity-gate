# A change may delete a test together with the evidence rows that cited it: the base document then
# cites a test the submitted tree no longer has, and that alone must not fail the gate. The second
# control is the other half: a row the submitted document KEEPS must still name a test that exists,
# whatever the base cited.
_DELETED_TEST_ROW = {
    "observes": "a proof this change deleted together with this row",
    "workflow": "apple-ci",
    "job": "apple-ci",
    "test": "DeletedWithItsRowTest/deletedWithItsRow",
}


