def _pr65_promotion(base: dict[str, object], current: dict[str, object]) -> None:
    """Reproduce PR #65's partial -> shipped edit with byte-identical evidence rows."""
    base_cell = feature_cell(base, "library.sync", "macos")
    # A replay, so the historical rows are WRITTEN here. Asserting the live document still carries
    # them made this control a hostage of the very pull request it reproduces.
    assert base_cell["status"] == "partial"
    base_cell["evidence"] = copy_document({"rows": PR65_LIBRARY_SYNC_EVIDENCE})["rows"]
    current_cell = feature_cell(current, "library.sync", "macos")
    current_cell.clear()
    current_cell.update(
        status="shipped",
        evidence=copy_document({"rows": PR65_LIBRARY_SYNC_EVIDENCE})["rows"],
        reason=PR65_PROMOTED_REASON,
    )


pr65_control = expect_comparison(
    "PR #65 library.sync/macos promoted with byte-identical evidence",
    _pr65_promotion,
