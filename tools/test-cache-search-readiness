#!/usr/bin/env python3
"""Exercise cache-search recovery without changing stream or corpus assertions."""

from pathlib import Path
import re
import os
import runpy
import subprocess
import sys
import time

controls = runpy.run_path(str(Path(__file__).with_name("test-transcode-probe-timeout-diagnostic")))
controls["require_port_free"]()
run_probe = controls["run_probe"]
if "DULCET_TEST_CACHE_PROBE" in os.environ:
    run_probe.__globals__["PROBE"] = Path(os.environ["DULCET_TEST_CACHE_PROBE"])
subprocess.run([sys.executable, str(Path(__file__).with_name("test-cache-loopback-diagnostic"))], check=True)

def resolved_counts(stderr: str) -> tuple[int, int]:
    """Read the attempts/completed pair the probe reports, so a control can check the PROCESS."""
    match = re.search(r"cache search resolved attempts=(\d+) completed=(\d+)", stderr)
    assert match, f"probe did not report its attempt count: {stderr}"
    return int(match.group(1)), int(match.group(2))


recovered = run_probe(mode="search-reset", budget=2)
assert recovered.returncode == 0, recovered.stdout + recovered.stderr
assert "cache search transport error:" in recovered.stderr, recovered.stderr
assert "TRANSCODE CACHE OBSERVATION cached=false transcoding=true" in recovered.stdout, recovered.stdout
# Assert the retry happened rather than printing that it did. The previous version of this control
# claimed `cache_search_transport_retried=true` while asserting only that ONE error line existed --
# a claim its own assertions could not support, and the poll it certified made exactly one attempt.
attempts, completed = resolved_counts(recovered.stderr)
assert attempts >= 2, f"transport error did not lead to a retry: attempts={attempts}"
assert completed >= 1, f"recovery never completed a search: completed={completed}"
print(f"POSITIVE CONTROL PASS cache_search_transport_retried=true attempts={attempts} completed={completed}")
print(recovered.stderr.strip())
print(recovered.stdout.strip())

started = time.monotonic()
stalled = run_probe(mode="search-stall", budget=2)
elapsed = time.monotonic() - started
assert stalled.returncode != 0, stalled.stdout
assert "cache search transport error: timed out" in stalled.stderr, stalled.stderr
# A stalled transport must NOT be reported as an absent corpus item. That message names the corpus
# seeder, which the readiness gate has already proven healthy, and the run's real event was a
# timeout. Requiring the absence wording here is what previously certified the conflation.
assert "cache search never completed:" in stalled.stderr, stalled.stderr
assert "absent from the disposable corpus" not in stalled.stderr, stalled.stderr
stall_attempts, stall_completed = resolved_counts(stalled.stderr)
assert stall_completed == 0, f"a stalled search reported a completion: {stall_completed}"
# The poll must poll. A per-attempt timeout equal to the remaining budget lets attempt one consume
# the whole window, and every outcome-only control still passes while it does.
assert stall_attempts >= 2, f"search budget was spent by a single attempt: attempts={stall_attempts}"
assert elapsed < 7, f"search escaped its five-second deadline: {elapsed:.3f}s"
# The failure path must record WHICH layer stopped answering, and the verdict must be earned. This
# fixture stalls only the search endpoint, so every other layer replies instantly and the honest
# verdict is "server-answering" -- a diagnosis keying on exception-vs-no-exception instead of on
# elapsed time reports "database-path-blocked" here off a one-millisecond parse error.
assert "loopback diagnosis=" in stalled.stderr, stalled.stderr
assert "loopback diagnosis=server-answering" in stalled.stderr, stalled.stderr
print(
    f"NEGATIVE CONTROL PASS cache_search_deadline=true elapsed_seconds={elapsed:.3f} "
    f"attempts={stall_attempts} completed={stall_completed}"
)

for mode, message in [
    ("search-http-error", "HTTP Error 503"),
    ("search-missing-id", "known transcode cache probe is absent from the disposable corpus"),
    ("search-error-envelope", "known transcode cache probe is absent from the disposable corpus"),
]:
    rejected = run_probe(mode=mode, budget=2)
    assert rejected.returncode != 0, rejected.stdout
    assert message in rejected.stderr, rejected.stderr
    assert "cache search transport error:" not in rejected.stderr, rejected.stderr
    if "absent from the disposable corpus" in message:
        # These modes ANSWER the search and legitimately find nothing, which is the only state that
        # justifies claiming absence. Proving a search completed is what separates them from a stall.
        _, answered = resolved_counts(rejected.stderr)
        assert answered >= 1, f"{mode} claimed absence without completing a search: {answered}"
    print(f"NEGATIVE CONTROL PASS {mode}=rejected message={message}")
