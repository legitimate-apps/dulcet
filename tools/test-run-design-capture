#!/usr/bin/env python3
"""Process controls for the deterministic capture supervisor; no AppKit/window access."""
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import unittest
from unittest import mock

TOOL = Path(__file__).with_name('run-design-capture')
loader = importlib.machinery.SourceFileLoader('design_capture_runner', str(TOOL))
module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(module)
PHASE = "print('DULCET_CAPTURE_PHASE stage=bitmap-draw monotonicNs=1',flush=True); "
PASS = "print('DULCET CAPTURE PASS images=70',flush=True); "


class CaptureSupervisorTest(unittest.TestCase):
    def run_probe(self, script, *, real_diagnostics=False, inactivity=1.0):
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / 'diagnostics'
            # Keep launch, exact PID, exec, pipes, inactivity clock, signals and reap real.
            diagnostic = contextlib.nullcontext() if real_diagnostics else mock.patch.object(
                module, 'collect_diagnostics', return_value={'control': 'sample-requested'})
            with diagnostic, contextlib.redirect_stdout(io.TextIOWrapper(io.BytesIO(), write_through=True)):
                started = time.monotonic()
                result = module.supervise(Path(sys.executable), ['-c', script], output,
                                          inactivity=inactivity, cleanup_grace=0.15)
                elapsed = time.monotonic() - started
            record = json.loads((output / 'host-result.json').read_text())
            files = {p.name: p.read_text() for p in output.iterdir()}
            self.assertLess(elapsed, 5 if not real_diagnostics else 20)
            return result, record, files

    def test_old_direct_command_waits_while_supervisor_fails_and_names_stage(self):
        script = 'import time; ' + PHASE + 'time.sleep(60)'
        old = subprocess.Popen([sys.executable, '-c', script], stdout=subprocess.DEVNULL)
        try:
            with self.assertRaises(subprocess.TimeoutExpired):
                old.wait(timeout=0.4)
            self.assertIsNone(old.poll(), 'old direct invocation did not reproduce the blocked wait')
        finally:
            old.kill()
            old.wait(timeout=2)
        result, record, files = self.run_probe(script)
        self.assertEqual(124, result)
        self.assertEqual('bitmap-draw', record['lastStage'])
        self.assertTrue(record['timedOut'])
        self.assertTrue(record['reaped'])
        self.assertEqual({'control': 'sample-requested'}, record['diagnostics'])
        self.assertIn(f"DULCET_CAPTURE_HOST_EXEC pid={record['pid']}", files['console.log'])
        self.assertIn('"stage": "bitmap-draw"', files['phase-receipts.jsonl'])

    def test_sigstop_is_killed_without_unbounded_reap(self):
        script = 'import os,signal; ' + PHASE + 'os.kill(os.getpid(),signal.SIGSTOP)'
        result, record, _ = self.run_probe(script)
        self.assertEqual(124, result)
        self.assertIn(record['childExit'], (-signal.SIGTERM, -signal.SIGKILL))
        self.assertTrue(record['reaped'])

    def test_pre_main_wait_has_launch_stage_and_reported_exact_pid(self):
        result, record, _ = self.run_probe('import time; time.sleep(60)')
        self.assertEqual(124, result)
        self.assertEqual('launch-before-main', record['lastStage'])

    def test_valid_phase_progress_can_exceed_inactivity_total(self):
        script = ("import time; "
                  "[(print('DULCET_CAPTURE_PHASE stage=render-complete monotonicNs='+str(i),flush=True),"
                  "time.sleep(0.35)) for i in range(6)]; " + PASS)
        result, record, _ = self.run_probe(script)
        self.assertEqual(0, result, record)
        self.assertFalse(record['timedOut'])
        self.assertTrue(record['completionObserved'])
        self.assertGreater(record['elapsedSeconds'], 1.0)

    def test_closed_output_does_not_hide_live_blocked_child(self):
        script = 'import os,time; ' + PHASE + 'os.close(1); os.close(2); time.sleep(60)'
        result, record, _ = self.run_probe(script)
        self.assertEqual(124, result)
        self.assertTrue(record['reaped'])

    def test_stderr_chatter_cannot_extend_deadline(self):
        script = ('import sys,time; ' + PHASE +
                  "[(print('unrelated stderr',file=sys.stderr,flush=True),time.sleep(0.04)) "
                  "for i in range(500)]")
        result, record, files = self.run_probe(script)
        self.assertEqual(124, result)
        self.assertIn('unrelated stderr', files['console.log'])
        self.assertEqual('bitmap-draw', record['lastStage'])

    def test_pass_line_does_not_hide_nonzero_exit(self):
        result, record, _ = self.run_probe(PHASE + PASS + 'raise SystemExit(7)')
        self.assertEqual(7, result)
        self.assertTrue(record['completionObserved'])

    def test_zero_exit_without_capture_completion_fails(self):
        result, record, _ = self.run_probe(PHASE)
        self.assertEqual(1, result, record)
        self.assertEqual(0, record['childExit'])
        self.assertFalse(record['completionObserved'])

    @unittest.skipUnless(hasattr(os, 'fork'), 'pipe inheritance control requires fork')
    def test_exit_does_not_wait_for_grandchild_pipe_eof(self):
        # The grandchild self-exits after one second. The supervisor must return before that,
        # grading its direct child without acquiring or signalling any other process.
        script = ('import os,time; ' + PHASE + PASS +
                  "pid=os.fork(); time.sleep(1) if pid == 0 else None; os._exit(0)")
        result, record, _ = self.run_probe(script)
        self.assertEqual(0, result, record)
        self.assertLess(record['elapsedSeconds'], 0.7)

    @unittest.skipUnless(hasattr(os, 'fork'), 'pipe inheritance control requires fork')
    def test_exit_drain_is_bounded_even_when_grandchild_keeps_writing(self):
        script = ('import os,time\n' + PHASE + PASS + '\n'
                  'pid=os.fork()\n'
                  'if pid == 0:\n'
                  ' try:\n'
                  '  end=time.monotonic()+1\n'
                  '  while time.monotonic()<end: os.write(1,b"noise\\n"*100)\n'
                  ' except BrokenPipeError: pass\n'
                  ' os._exit(0)\n'
                  'os._exit(0)\n')
        result, record, _ = self.run_probe(script)
        self.assertEqual(0, result, record)
        self.assertLess(record['elapsedSeconds'], 0.7)

    def test_unreapable_child_cleanup_is_bounded_and_reportable(self):
        child = mock.Mock(pid=12345)
        child.poll.return_value = None
        child.wait.side_effect = subprocess.TimeoutExpired('control', 0.01)
        with mock.patch.object(module, 'signal_child') as send:
            self.assertFalse(module.stop_child(child, grace=0.01))
        self.assertEqual([mock.call(child, signal.SIGTERM), mock.call(child, signal.SIGKILL)],
                         send.call_args_list)
        self.assertEqual([mock.call(timeout=0.01), mock.call(timeout=0.01)],
                         child.wait.call_args_list)

    def test_diagnostic_timeout_bounds_cleanup(self):
        with tempfile.TemporaryDirectory() as directory:
            result = module.diagnostic_command(
                [sys.executable, '-c', 'import time; time.sleep(60)'],
                Path(directory) / 'probe.log', timeout=0.05)
            self.assertEqual('timeout', result)
            self.assertIn('reaped=True', (Path(directory) / 'probe.log').read_text())

    @unittest.skipUnless(sys.platform == 'darwin', 'usable stacks require macOS sample')
    def test_supported_host_records_stack_of_its_exact_blocked_process(self):
        result, record, files = self.run_probe('import time; ' + PHASE + 'time.sleep(60)',
                                             real_diagnostics=True)
        self.assertEqual(124, result)
        self.assertIn(str(record['pid']), files['process.log'])
        self.assertIn('Call graph:', files['sample.log'])
        self.assertRegex(files['sample.log'], r'(?i)(nanosleep|sleep|semaphore_wait)')


if __name__ == '__main__':
    unittest.main()
