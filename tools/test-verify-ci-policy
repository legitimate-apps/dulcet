     "must download by an exact name that carries the producing job's attempt output"),
    # A matrix combines its members' outputs, so one unguarded output is whichever member finished
    # last: after a re-run of one surface it is the wrong attempt for the other.
    ("one attempt output shared by every matrix member is rejected",
     lambda t: edit("${{ needs.emulator.outputs.attempt-tv }}", "${{ needs.emulator.outputs.attempt }}")(
         edit("${{ needs.emulator.outputs.attempt-phone }}", "${{ needs.emulator.outputs.attempt }}")(
             edit("      attempt-phone: ${{ matrix.surface == 'phone' && matrix.rep == 1 && github.run_attempt || '' }}\n",
                  "      attempt: ${{ github.run_attempt }}\n")(t))),
     "from EVERY matrix member"),
    # The stale-evidence case: phone's artifact named by TV's attempt reads a superseded phone
    # attempt whenever only the phone leg was re-run.
    ("one surface's evidence named by another surface's attempt is rejected",
     edit("emulator-phone-${{ github.run_id }}-${{ needs.emulator.outputs.attempt-phone }}",
          "emulator-phone-${{ github.run_id }}-${{ needs.emulator.outputs.attempt-tv }}"),
     "downloads emulator-phone-${{ github.run_id }}-${{ needs.emulator.outputs.attempt-tv }}, "
     "which no upload in emulator produces"),
    ("an attempt output that does not pin the repetition is rejected",
     edit("attempt-tv: ${{ matrix.surface == 'tv' && matrix.rep == 1 && github.run_attempt || '' }}",
          "attempt-tv: ${{ matrix.surface == 'tv' && github.run_attempt || '' }}"),
     "downloads emulator-tv-${{ github.run_id }}-${{ needs.emulator.outputs.attempt-tv }}, "
     "which no upload in emulator produces"),
    ("a guard on something other than the matrix is rejected",
     edit("attempt-tv: ${{ matrix.surface == 'tv' && matrix.rep == 1 && github.run_attempt || '' }}",
          "attempt-tv: ${{ github.event_name == 'push' && github.run_attempt || '' }}"),
     "only matrix.<key> == <literal> terms are understood"),
    ("an attempt output that is not the attempt is rejected",
     edit("      attempt: ${{ github.run_attempt }}\n", "      attempt: ${{ github.run_number }}\n"),
     "job build output attempt is not an attempt output"),
    ("a missing attempt output is rejected",
     edit("    outputs:\n      attempt: ${{ github.run_attempt }}\n", ""),
     "job build output attempt is not defined"),
    ("an attempt output of a job the aggregator does not need is rejected",
     edit("    needs: [build, emulator]\n", "    needs: [emulator]\n"),
     "reads needs.build, which it does not need"),
    ("a download whose name no upload produces is rejected",
     edit("name: build-evidence-${{ github.run_id }}-${{ needs.build.outputs.attempt }}",
          "name: build-results-${{ github.run_id }}-${{ needs.build.outputs.attempt }}"),
     "which no upload in build produces"),
    # The other half of attempt scoping: a name without the attempt collides with the earlier
    # attempt's immutable artifact, and `overwrite: true` would delete a superseded failure's
    # evidence -- the evidence a re-run is most likely to be needed for.
    ("an upload name without the attempt is rejected",
     edit("          name: build-evidence-${{ github.run_id }}-${{ github.run_attempt }}\n",
          "          name: build-evidence-${{ github.run_id }}\n          overwrite: true\n"),
     "uploads build-evidence-${{ github.run_id }} without ${{ github.run_attempt }}"),
)
EXPECTED_RERUN_CASES = 16
rerun_cases_run: list[str] = []


def run_rerun_case(name: str, mutate, expected: str) -> None:
    text = mutate(RERUN_WORKFLOW)
    if expected and text in (RERUN_WORKFLOW, REAL_CORE_CI.read_text()):
        raise AssertionError(f"{name}: the mutation changed nothing, so it proves nothing")
    with tempfile.TemporaryDirectory(prefix="dulcet-rerun-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "core-ci.yml").write_text(text)
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root, text=True,
                                capture_output=True, check=False)
    if not expected:
        if result.returncode != 0:
            raise AssertionError(f"{name}: expected acceptance, got {result.returncode}\n"
                                 f"{result.stderr}")
    else:
        if result.returncode != 1:
            raise AssertionError(f"{name}: expected exit 1, got {result.returncode} -- a rule that "
                                 f"reports and still exits 0 is not a gate\n{result.stderr}")
        if expected not in result.stderr:
            raise AssertionError(f"{name}: rejected, but not by the rule under test; expected "
                                 f"{expected!r}\n{result.stderr}")
    rerun_cases_run.append(name)
    print(f"PASS: partial re-run: {name}")


for rerun_case in RERUN_CASES:
    run_rerun_case(*rerun_case)
# Counted against a declared constant, not the tuple's length: emptying RERUN_CASES must fail.
assert len(rerun_cases_run) == EXPECTED_RERUN_CASES == len(set(rerun_cases_run)), (
    f"partial re-run controls ran {len(rerun_cases_run)} of {EXPECTED_RERUN_CASES}: {rerun_cases_run}"
)
