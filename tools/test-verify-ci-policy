    unexpected = Counter(completed) - Counter(required)
    if missing or unexpected or not required:
        incomplete.append(f"{group} completed {len(completed)}/{len(required)}; "
                          f"missing={list(missing.elements())}; unexpected={list(unexpected.elements())}")
