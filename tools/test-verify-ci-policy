# The class checks need a FEATURES.yml to have anything to compare against, so the bijection
# fixtures above cannot reach them -- and that is exactly how the defect below survived review.
#
# 🚨 MEASURED 2026-09-08: moving an emission out of the YAML into a `tools/ci/` script removed it
# from the class scans' input, because they read the YAML while the directory scan read the scripts
# too. A mutation emitting the TARGET name where FEATURES.yml cites the CLASS name was rejected
# before the extraction and ACCEPTED after it. Nothing failed. This case exists so that re-blinding
# either scan to the YAML alone cannot pass again.
CLASS_EMISSION_SCRIPT = """#!/bin/bash
set -euo pipefail
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/exampleMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/x.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\
  %(emitted)s
"""

CLASS_EMISSION_FEATURES = json.dumps({
    "features": [{
        "id": "example.row",
        "platforms": {
            "macos": {"evidence": [{"workflow": "apple-ci", "test": "Example/exampleMethod"}]},
        },
    }],
})


def run_class_emission_case(emitted: str, expected_returncode: int, label: str) -> None:
    """The emission lives in an invoked script, never inline, so only a script-reading scan sees it."""
    with tempfile.TemporaryDirectory(prefix="dulcet-class-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(
            APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"},
        )
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(CLASS_EMISSION_SCRIPT % {"emitted": emitted})
        (root / "FEATURES.yml").write_text(CLASS_EMISSION_FEATURES)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    if result.returncode != expected_returncode:
        raise AssertionError(
            f"{label}: expected exit {expected_returncode}, got {result.returncode} -- a scan that "
            "reads only the workflow YAML cannot see an emission that lives in the script it "
            f"invokes\nstderr:\n{result.stderr}",
        )
    if expected_returncode and "verify-parity-evidence matches on" not in result.stderr:
        raise AssertionError(
            f"{label}: rejected, but not for the class-name reason\nstderr:\n{result.stderr}",
        )
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


# Emitting the cited class SOMEWHERE is necessary and not sufficient, and the case above cannot tell
# the difference: when only one emission exists, blinding the per-method pairing scan still leaves
# the "is it emitted at all" scan to reject. So this fixture emits the cited name correctly for one
# method and the TARGET name for another, which is the shape that actually reached CI -- two of three
# macOS emissions were right, the third was not, and the file passed while the bundle holding the
# cited test wrote unusable evidence.
PAIRED_EMISSION_SCRIPT = """#!/bin/bash
set -euo pipefail
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/otherMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/a.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Other.xml" \\
  Example
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/exampleMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/b.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\
  %(emitted)s
"""

PAIRED_EMISSION_FEATURES = json.dumps({
    "features": [{
        "id": "example.row",
        "platforms": {
            "macos": {"evidence": [
                {"workflow": "apple-ci", "test": "Example/exampleMethod"},
                {"workflow": "apple-ci", "test": "Example/otherMethod"},
            ]},
        },
    }],
})


def run_paired_emission_case(emitted: str, expected_returncode: int, label: str) -> None:
