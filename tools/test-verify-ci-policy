#!/usr/bin/env python3
"""Exercise the CI policy verifier against isolated synthetic workflows."""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
import subprocess
import json
import sys
import tempfile


VERIFIER = Path(__file__).with_name("verify_ci_policy.py").resolve()


@dataclass(frozen=True)
class Case:
    name: str
    triggers: str
    runs_on: str
    accepted: bool
    expected_error: str = ""
    comment: str = ""
    include_timeout: bool = True
    job_name: str = "policy-test"


CASES = (
    Case(
        name="self-hosted with workflow_dispatch only",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: [self-hosted, macOS, dulcet-device]",
        accepted=True,
    ),
    Case(
        name="self-hosted with pull_request",
        triggers="  pull_request:",
        runs_on="    runs-on: self-hosted",
        accepted=False,
        expected_error="uses a self-hosted runner in a workflow that is not workflow_dispatch-only",
    ),
    Case(
        name="self-hosted with push",
        triggers="  push:",
        runs_on="    runs-on:\n      - self-hosted\n      - macOS\n      - dulcet-device",
        accepted=False,
        expected_error="uses a self-hosted runner in a workflow that is not workflow_dispatch-only",
    ),
    Case(
        name="self-hosted in a comment with a hosted runner",
        triggers="  pull_request:",
        runs_on="    runs-on: ubuntu-latest",
        accepted=True,
        comment="# self-hosted is discussed here but is not a runner label",
        job_name="self-hosted-comment-control",
    ),
    Case(
        name="xlarge runner with workflow_dispatch only",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: macos-latest-xlarge",
        accepted=False,
        expected_error="forbidden runner token -xlarge",
    ),
    Case(
        name="missing timeout-minutes",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: ubuntu-latest",
        accepted=False,
        expected_error="missing per-job timeout",
        include_timeout=False,
    ),
)


# Appended by each extra check as it PASSES, and the summary counts this list rather than a literal.
# A hardcoded count is a claim about the suite that the suite does not verify: while writing these
# cases the summary was updated to say "2/2 per-method pairing cases" at a moment when those two
# calls had not been wired in at all, and it printed that line happily. A count derived from what
# actually executed cannot make that claim.
EXTRA_PASSES: list[str] = []

def workflow_for(case: Case) -> str:
    lines = ["name: synthetic-core-ci"]
    if case.comment:
        lines.append(case.comment)
    lines.extend(
        [
            "on:",
            *case.triggers.splitlines(),
            "",
            "concurrency:",
            "  group: synthetic-core-ci",
            "  cancel-in-progress: true",
            "",
            "jobs:",
            f"  {case.job_name}:",
            *case.runs_on.splitlines(),
        ],
    )
    if case.include_timeout:
        lines.append("    timeout-minutes: 5")
    lines.extend(
        [
            "    steps:",
            "      - name: Preserve the two core-ci database gates",
            "        run: |",
            "          python3 tools/migration_gate.py",
            "          ./gradlew :core:verifySqlDelightMigration",
        ],
    )
    return "\n".join(lines) + "\n"


def run_case(case: Case) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-ci-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "core-ci.yml").write_text(workflow_for(case))
        result = subprocess.run(
            [sys.executable, str(VERIFIER)],
            cwd=root,
            text=True,
            capture_output=True,
            check=False,
        )

    if case.accepted:
        if result.returncode != 0:
            raise AssertionError(
                f"{case.name}: expected acceptance, got exit {result.returncode}\n"
                f"stdout:\n{result.stdout}stderr:\n{result.stderr}",
            )
        outcome = "accepted"
    else:
        if result.returncode == 0:
            raise AssertionError(f"{case.name}: expected rejection, but verifier accepted it")
        if case.expected_error not in result.stderr:
            raise AssertionError(
                f"{case.name}: rejection did not contain {case.expected_error!r}\n"
                f"stdout:\n{result.stdout}stderr:\n{result.stderr}",
            )
        outcome = "rejected"
    print(f"PASS: {case.name} -> {outcome}")


# ---------------------------------------------------------------------------------------------
# The JUnit bijection is apple-ci-specific, so the core-ci fixtures above cannot reach it: the
# verifier guards that block on apple-ci.yml being present, and it is legitimately absent from a
# synthetic single-workflow fixture. These cases supply an apple-ci-shaped fixture instead.
#
# They exist because the write may now live in a `tools/ci/` script rather than inline in the YAML.
# That is forced, not stylistic: the Darwin composite step is at a hard GitHub workflow size ceiling
# (29,893 characters of inline `run:` loads; 34,557 makes the whole file invalid and no job runs at
# all), and extraction is GitHub's own remedy. A check that stopped at the YAML would be blinded by
# exactly the change the ceiling forces.
#
# Each case asserts BOTH the specific diagnostic AND the process exit status. The sentence is what
# makes the case about the bijection rather than about fixture completeness; the exit status is what
# makes it a rejection rather than a complaint.
#
# 🚨 An earlier version asserted only the sentence, on the stated grounds that "a minimal fixture
# legitimately trips other, unrelated policy rules". MEASURED 2026-09-08: it does not -- the fixture
# exits 0 with empty stderr. So the reason was false, and the cost was real: mutating the verifier to
# print its errors and then return success left this entire suite green, 6/6 core and 4/4 apple,
# while CI would have accepted a missing script and an unwritten JUnit directory. A control that
# cannot distinguish "reported and rejected" from "reported and accepted" is not checking the thing
# its name claims.

APPLE_WORKFLOW = """name: apple-ci
on:
  pull_request:
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  apple-ci:
    runs-on: macos-latest
    timeout-minutes: 10
    steps:
      - name: Produce evidence
        run: |
          %(invocation)s
      - name: Verify evidence
        run: |
          python3 tools/verify-parity-evidence \\
            "$RUNNER_TEMP/dulcet-example-junit"
"""

APPLE_SCRIPT = """#!/bin/bash
set -euo pipefail
python3 tools/swift-testing-junit "$RUNNER_TEMP/x.xcresult" \\
  "%(junit)s/TEST-Example.xml" Example
"""

BIJECTION_MISSING = "verify-parity-evidence reads dulcet-example-junit, which no step writes"
SCRIPT_MISSING = "invokes tools/ci/produce-evidence, which does not exist"
BIJECTION_ORPHANED = "JUnit directory dulcet-unread-junit is written but never passed"


def run_apple_case(
    name: str,
    invocation: str,
    script: str | None,
    present: str,
    absent: str,
    expected_returncode: int,
) -> None:
    """`present` must appear in stderr, `absent` must not, and the exit status must match.

    Either message may be empty. `expected_returncode` is 0 for a fixture the verifier must accept
    and 1 for one it must reject.
    """
    with tempfile.TemporaryDirectory(prefix="dulcet-apple-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(APPLE_WORKFLOW % {"invocation": invocation})
        # The verifier reads core-ci.yml unconditionally, so an apple-only fixture would crash it
        # before reaching the check under test. Reuse the accepted core-ci fixture verbatim.
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        if script is not None:
            scripts = root / "tools" / "ci"
            scripts.mkdir(parents=True)
            (scripts / "produce-evidence").write_text(script)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    if present and present not in result.stderr:
        raise AssertionError(f"{name}: expected {present!r} in stderr\nstderr:\n{result.stderr}")
    if absent and absent in result.stderr:
        raise AssertionError(f"{name}: did not expect {absent!r} in stderr\nstderr:\n{result.stderr}")
    if result.returncode != expected_returncode:
        verdict = (
            "the verifier reported the problem but still exited zero, so CI would have accepted it"
            if expected_returncode and result.returncode == 0
            else "the verifier rejected a fixture it must accept"
        )
        raise AssertionError(
            f"{name}: expected exit {expected_returncode}, got {result.returncode} -- {verdict}\n"
            f"stderr:\n{result.stderr}",
        )
    print(f"PASS: {name}")


APPLE_CASES = (
    (
        "a script that writes the directory satisfies the bijection",
        "tools/ci/produce-evidence",
        APPLE_SCRIPT % {"junit": "$RUNNER_TEMP/dulcet-example-junit"},
        "",
        BIJECTION_MISSING,
        0,
    ),
    (
        "a script that stops writing the directory is rejected",
        "tools/ci/produce-evidence",
        APPLE_SCRIPT % {"junit": "$RUNNER_TEMP/somewhere-else"},
        BIJECTION_MISSING,
        "",
        1,
    ),
    (
        "invoking a script that does not exist is rejected",
        "tools/ci/produce-evidence",
        None,
        SCRIPT_MISSING,
        "",
        1,
    ),
    (
        "an inline write still satisfies the bijection, unchanged",
        'python3 tools/swift-testing-junit a "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" Example',
        None,
        "",
        BIJECTION_MISSING,
        0,
    ),
    (
        # The other direction of the bijection had no case at all: removing the written-minus-read
        # check left the whole suite green. A directory that is written and never verified is how a
        # FEATURES.yml row comes to cite a test whose execution nothing proves.
        "a directory written but never passed to verify-parity-evidence is rejected",
        "tools/ci/produce-evidence",
        APPLE_SCRIPT % {"junit": "$RUNNER_TEMP/dulcet-unread-junit"},
        BIJECTION_ORPHANED,
        "",
        1,
    ),
    (
        # A `#` line cannot invoke anything. Treating one as an invocation failed a correct workflow
        # with "invokes ..., which does not exist" -- a gate that blocks runs which would otherwise
        # pass is a false blocker, not safety.
        "a tools/ci path named only in a comment is not an invocation",
        'python3 tools/swift-testing-junit a "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" Example\n'
        "          # superseded by tools/ci/retired-proof",
        None,
        "",
        "tools/ci/retired-proof",
        0,
    ),
)


# The class checks need a FEATURES.yml to have anything to compare against, so the bijection
# fixtures above cannot reach them -- and that is exactly how the defect below survived review.
#
# 🚨 MEASURED 2026-09-08: moving an emission out of the YAML into a `tools/ci/` script removed it
# from the class scans' input, because they read the YAML while the directory scan read the scripts
# too. A mutation emitting the TARGET name where FEATURES.yml cites the CLASS name was rejected
# before the extraction and ACCEPTED after it. Nothing failed. This case exists so that re-blinding
# either scan to the YAML alone cannot pass again.
CLASS_EMISSION_SCRIPT = """#!/bin/bash
set -euo pipefail
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/exampleMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/x.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\
  %(emitted)s
"""

CLASS_EMISSION_FEATURES = json.dumps({
    "features": [{
        "id": "example.row",
        "platforms": {
            "macos": {"evidence": [{"workflow": "apple-ci", "test": "Example/exampleMethod"}]},
        },
    }],
})


def run_class_emission_case(emitted: str, expected_returncode: int, label: str) -> None:
    """The emission lives in an invoked script, never inline, so only a script-reading scan sees it."""
    with tempfile.TemporaryDirectory(prefix="dulcet-class-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(
            APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"},
        )
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(CLASS_EMISSION_SCRIPT % {"emitted": emitted})
        (root / "FEATURES.yml").write_text(CLASS_EMISSION_FEATURES)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    if result.returncode != expected_returncode:
        raise AssertionError(
            f"{label}: expected exit {expected_returncode}, got {result.returncode} -- a scan that "
            "reads only the workflow YAML cannot see an emission that lives in the script it "
            f"invokes\nstderr:\n{result.stderr}",
        )
    if expected_returncode and "verify-parity-evidence matches on" not in result.stderr:
        raise AssertionError(
            f"{label}: rejected, but not for the class-name reason\nstderr:\n{result.stderr}",
        )
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


# Emitting the cited class SOMEWHERE is necessary and not sufficient, and the case above cannot tell
# the difference: when only one emission exists, blinding the per-method pairing scan still leaves
# the "is it emitted at all" scan to reject. So this fixture emits the cited name correctly for one
# method and the TARGET name for another, which is the shape that actually reached CI -- two of three
# macOS emissions were right, the third was not, and the file passed while the bundle holding the
# cited test wrote unusable evidence.
PAIRED_EMISSION_SCRIPT = """#!/bin/bash
set -euo pipefail
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/otherMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/a.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Other.xml" \\
  Example
xcodebuild test-without-building \\
  -only-testing:ExampleTarget/Example/exampleMethod
python3 tools/swift-testing-junit "$RUNNER_TEMP/b.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\
  %(emitted)s
"""

PAIRED_EMISSION_FEATURES = json.dumps({
    "features": [{
        "id": "example.row",
        "platforms": {
            "macos": {"evidence": [
                {"workflow": "apple-ci", "test": "Example/exampleMethod"},
                {"workflow": "apple-ci", "test": "Example/otherMethod"},
            ]},
        },
    }],
})


def run_paired_emission_case(emitted: str, expected_returncode: int, label: str) -> None:
    """The cited class is emitted for another method, so only the per-method pairing can object."""
    with tempfile.TemporaryDirectory(prefix="dulcet-paired-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(
            APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"},
        )
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(PAIRED_EMISSION_SCRIPT % {"emitted": emitted})
        (root / "FEATURES.yml").write_text(PAIRED_EMISSION_FEATURES)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    if result.returncode != expected_returncode:
        raise AssertionError(
            f"{label}: expected exit {expected_returncode}, got {result.returncode} -- the cited "
            "class is emitted for the OTHER method, so only the per-method pairing can reject "
            f"this\nstderr:\n{result.stderr}",
        )
    if expected_returncode and "the JUnit for exampleMethod is emitted as" not in result.stderr:
        raise AssertionError(
            f"{label}: rejected, but not by the per-method pairing\nstderr:\n{result.stderr}",
        )
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


def run_orphan_control_case() -> None:
    """A control in tools/ that no workflow names must be rejected, and a wired one accepted.

    Both directions matter. Rejecting the unwired one is the gate; accepting the wired one is what
    stops the gate from being satisfiable only by having no controls at all.
    """
    for wired in (False, True):
        with tempfile.TemporaryDirectory(prefix="dulcet-orphan-policy-") as temporary_directory:
            root = Path(temporary_directory)
            workflows = root / ".github" / "workflows"
            workflows.mkdir(parents=True)
            core = workflow_for(next(case for case in CASES if case.accepted))
            if wired:
                core += "      - run: python3 tools/test-example-control\n"
            (workflows / "core-ci.yml").write_text(core)
            tools = root / "tools"
            tools.mkdir()
            (tools / "test-example-control").write_text("#!/usr/bin/env python3\n")
            result = subprocess.run(
                [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True,
                check=False,
            )
        expected = 0 if wired else 1
        label = "a wired control is accepted" if wired else "an unwired control is rejected"
        if result.returncode != expected:
            raise AssertionError(
                f"{label}: expected exit {expected}, got {result.returncode}\n"
                f"stderr:\n{result.stderr}",
            )
        if not wired and "no workflow invokes this control" not in result.stderr:
            raise AssertionError(
                f"{label}: rejection did not name the reason\nstderr:\n{result.stderr}",
            )
        EXTRA_PASSES.append(label)
        print(f"PASS: {label}")


for test_case in CASES:
    run_case(test_case)

for apple_case in APPLE_CASES:
    run_apple_case(*apple_case)

run_class_emission_case(
    "Example", 0, "a script emitting the cited class name is accepted",
)
run_class_emission_case(
    "ExampleTarget", 1, "a script emitting the target name where the class is cited is rejected",
)
run_paired_emission_case(
    "Example", 0, "a correct per-method emission is accepted",
)
run_paired_emission_case(
    "ExampleTarget", 1,
    "a wrong emission is rejected even though the cited class is emitted elsewhere",
)

run_orphan_control_case()

# Counted explicitly rather than from len(APPLE_CASES) alone: the class-emission and
# orphan-control checks are not in that tuple, and a summary that silently omits them would
# under-report the suite in exactly the direction that flatters it.
print(
    f"CI policy control passed: {len(CASES)}/{len(CASES)} core cases, "
    f"{len(APPLE_CASES)}/{len(APPLE_CASES)} apple cases, "
    f"{len(EXTRA_PASSES)} extra checks: {', '.join(EXTRA_PASSES)}"
)

# Exercise the standalone diagnostic contract separately from JUnit-directory coverage.
DIAGNOSTIC_CONTROLS = (
    'tools/test-conformance-access-log',
    'tools/test-capture-conformance-stall',
    'tools/test-measure-conformance-phase-gaps',
)
DIAGNOSTIC_WORKFLOW = '''name: apple-ci
on:
  pull_request:
concurrency:
  group: controls
  cancel-in-progress: true
jobs:
  apple-ci:
    name: apple-ci
    runs-on: macos-26
    timeout-minutes: 5
    steps:
'''

def diagnostic_case(control=None, mutation=None):
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / 'core-conformance').mkdir()
        (root / 'tools').mkdir()
        workflows = root / '.github/workflows'
        workflows.mkdir(parents=True)
        steps = []
        for item in DIAGNOSTIC_CONTROLS:
            if not (item == control and mutation == 'missing-file'):
                (root / item).write_text('# synthetic control\n')
            command = '        run: python3 ' + item + '\n'
            condition = ''
            if item == control:
                if mutation == 'missing':
                    command = '        run: true\n'
                elif mutation == 'comment':
                    command = '        # run: python3 ' + item + '\n        run: true\n'
                elif mutation == 'echo':
                    command = '        run: echo python3 ' + item + '\n'
                elif mutation == 'disabled':
                    condition = '        if: false\n'
                elif mutation == 'allowed-failure':
                    condition = '        continue-on-error: true\n'
            steps.append('      - name: control\n' + condition + command)
        apple = DIAGNOSTIC_WORKFLOW + ''.join(steps)
        if mutation == 'job-disabled':
            apple = apple.replace('    name: apple-ci', '    if: false\n    name: apple-ci')
        if mutation == 'linux-only':
            apple = apple.replace('macos-26', 'ubuntu-latest')
        if mutation == 'manual-only':
            apple = apple.replace('pull_request:', 'workflow_dispatch:')
        (workflows / 'apple-ci.yml').write_text(apple)
        (workflows / 'core-ci.yml').write_text(workflow_for(CASES[0]))
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root,
                                capture_output=True, text=True)
        if mutation is None:
            assert result.returncode == 0, result.stderr
        else:
            assert result.returncode != 0, f'{control} {mutation} was accepted'
            assert 'required diagnostic control ' + (control or DIAGNOSTIC_CONTROLS[0]) in result.stderr, result.stderr
    print(f'PASS: diagnostic wiring {mutation or "present"} {control or "job"}')

diagnostic_case()
for control in DIAGNOSTIC_CONTROLS:
    for mutation in ('missing', 'comment', 'echo', 'disabled', 'allowed-failure', 'missing-file'):
        diagnostic_case(control, mutation)
for mutation in ('job-disabled', 'linux-only', 'manual-only'):
    diagnostic_case(mutation=mutation)
print('Diagnostic wiring controls passed: 22/22 cases')
