# Exercise the standalone diagnostic contract separately from JUnit-directory coverage.
DIAGNOSTIC_CONTROLS = (
    'tools/test-conformance-access-log',
    'tools/test-capture-conformance-stall',
    'tools/test-measure-conformance-phase-gaps',
)
DIAGNOSTIC_WORKFLOW = '''name: apple-ci
on:
  pull_request:
concurrency:
  group: controls
  cancel-in-progress: true
jobs:
  apple-conformance:
    name: apple-conformance
    runs-on: macos-26
    timeout-minutes: 5
    steps:
'''
# The leg above only gates a merge through the required job, so the fixture carries one.
DIAGNOSTIC_AGGREGATOR = '''  apple-ci:
    name: apple-ci
    if: ${{ always() }}
    needs: [apple-conformance]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      APPLE_CONFORMANCE_RESULT: ${{ needs.apple-conformance.result }}
    steps:
      - run: test "$APPLE_CONFORMANCE_RESULT" = success
      - run: python3 tools/verify-parity-evidence
'''

def diagnostic_case(control=None, mutation=None):
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / 'core-conformance').mkdir()
        (root / 'tools').mkdir()
        workflows = root / '.github/workflows'
        workflows.mkdir(parents=True)
        steps = []
        for item in DIAGNOSTIC_CONTROLS:
            if not (item == control and mutation == 'missing-file'):
                (root / item).write_text('# synthetic control\n')
            command = '        run: python3 ' + item + '\n'
            condition = ''
            if item == control:
                if mutation == 'missing':
                    command = '        run: true\n'
                elif mutation == 'comment':
                    command = '        # run: python3 ' + item + '\n        run: true\n'
                elif mutation == 'echo':
                    command = '        run: echo python3 ' + item + '\n'
                elif mutation == 'disabled':
                    condition = '        if: false\n'
                elif mutation == 'allowed-failure':
                    condition = '        continue-on-error: true\n'
            steps.append('      - name: control\n' + condition + command)
        apple = DIAGNOSTIC_WORKFLOW + ''.join(steps) + DIAGNOSTIC_AGGREGATOR
        if mutation == 'job-disabled':
            apple = apple.replace('    name: apple-conformance', '    if: false\n    name: apple-conformance')
        if mutation == 'linux-only':
            apple = apple.replace('macos-26', 'ubuntu-latest')
        if mutation == 'manual-only':
            apple = apple.replace('pull_request:', 'workflow_dispatch:')
        if mutation == 'not-needed':
            # A leg the required job does not need can fail and still let the pull request merge.
            apple = apple.replace('    needs: [apple-conformance]\n', '')
        (workflows / 'apple-ci.yml').write_text(apple)
        (workflows / 'core-ci.yml').write_text(workflow_for(CASES[0]))
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root,
                                capture_output=True, text=True)
        if mutation is None:
            assert result.returncode == 0, result.stderr
        else:
            assert result.returncode != 0, f'{control} {mutation} was accepted'
            assert 'required diagnostic control ' + (control or DIAGNOSTIC_CONTROLS[0]) in result.stderr, result.stderr
    diagnostic_cases_run.append((control, mutation))
    print(f'PASS: diagnostic wiring {mutation or "present"} {control or "job"}')

def verifier_diagnostic_controls() -> tuple[str, ...]:
    """Read the contract out of the verifier's own source.

    This file and verify_ci_policy.py each declared DIAGNOSTIC_CONTROLS independently. Two copies of
    a contract are one copy that lies as soon as they drift: grow the verifier's list and this suite
    goes on proving the old one, reporting a pass for coverage it no longer has.
    """
    # Parsed, not matched. The first version of this used a regex for the parenthesised block and
    # smeared: `\((.*?)^\)` ran past the declaration to the next line-initial ")" and returned every
    # quoted token in between -- regex source strings, comment prose, the lot. It read correctly on
    # the unmutated file, which is the only reason it survived one round of testing.
    for node in ast.parse(VERIFIER.read_text()).body:
        if isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "DIAGNOSTIC_CONTROLS"
            for target in node.targets
        ):
            return tuple(ast.literal_eval(node.value))
    raise AssertionError("verify_ci_policy.py no longer declares DIAGNOSTIC_CONTROLS at module level")


assert DIAGNOSTIC_CONTROLS == verifier_diagnostic_controls(), (
    f"this suite tests {DIAGNOSTIC_CONTROLS} but the verifier enforces "
    f"{verifier_diagnostic_controls()}"
)
# A FLOOR, deliberately not derived from the contract. Deriving the expected total from
# DIAGNOSTIC_CONTROLS makes emptying it self-consistent -- expected falls to match actual and the
# suite still passes, which is the defect being repaired here wearing a slightly better disguise.
# Shrinking the contract has to be an explicit act that edits this number.
MINIMUM_DIAGNOSTIC_CONTROLS = 3
assert len(DIAGNOSTIC_CONTROLS) >= MINIMUM_DIAGNOSTIC_CONTROLS, (
    f"the diagnostic contract shrank to {len(DIAGNOSTIC_CONTROLS)} controls; "
    f"at least {MINIMUM_DIAGNOSTIC_CONTROLS} are required"
)

# 1 unmutated baseline + one per (control x mutation) + 4 job-level mutations.
EXPECTED_DIAGNOSTIC_CASES = 1 + len(DIAGNOSTIC_CONTROLS) * 6 + 4
diagnostic_cases_run: list[tuple[str | None, str | None]] = []

diagnostic_case()
for control in DIAGNOSTIC_CONTROLS:
    for mutation in ('missing', 'comment', 'echo', 'disabled', 'allowed-failure', 'missing-file'):
        diagnostic_case(control, mutation)
for mutation in ('job-disabled', 'linux-only', 'manual-only', 'not-needed'):
    diagnostic_case(mutation=mutation)

# The count is asserted against a declared constant, not printed from one. An independent review
# emptied every case above and this suite still printed "22/22 cases" and exited 0 -- a literal
# total is a claim about the code that wrote it, never evidence that anything ran. That is the
# exact defect this whole file exists to prevent, so it may not live inside it.
#
# Changing the contract deliberately means changing this number too. That is the point: a surface
# change must update every declaration of that surface, or the declaration is not a control.
assert len(diagnostic_cases_run) == EXPECTED_DIAGNOSTIC_CASES, (
    f'diagnostic wiring ran {len(diagnostic_cases_run)} cases, expected '
    f'{EXPECTED_DIAGNOSTIC_CASES}; cases={diagnostic_cases_run}'
)
assert len(set(diagnostic_cases_run)) == len(diagnostic_cases_run), (
    f'diagnostic wiring repeated a case: {diagnostic_cases_run}'
)
print(f'Diagnostic wiring controls passed: '
      f'{len(diagnostic_cases_run)}/{EXPECTED_DIAGNOSTIC_CASES} cases')


# ---------------------------------------------------------------------------------------------
# The release.yml cancellation exemption. Each condition of the exemption must be necessary: the
# file name, dispatch-only triggers, and an explicit `cancel-in-progress: false`. The positive case
# proves the exemption exists at all; without it the three rejections would pass vacuously.
RELEASE_FIXTURE = """name: release
on:
%(triggers)s
concurrency:
  group: release
%(cancel)s
jobs:
  release:
    runs-on: macos-latest
    timeout-minutes: 5
    steps:
      - run: true
"""
EXPECTED_RELEASE_CASES = 4
release_cases_run: list[str] = []


def release_case(name: str, filename: str, triggers: str, cancel: str, accepted: bool) -> None:
    with tempfile.TemporaryDirectory() as directory:
        workflows = Path(directory) / ".github/workflows"
        workflows.mkdir(parents=True)
        (workflows / "core-ci.yml").write_text(workflow_for(next(case for case in CASES if case.accepted)))
        (workflows / filename).write_text(RELEASE_FIXTURE % {"triggers": triggers, "cancel": cancel})
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=directory,
                                capture_output=True, text=True)
    if accepted:
        assert result.returncode == 0, f"{name}: expected acceptance\n{result.stderr}"
    else:
        assert result.returncode == 1, f"{name}: expected rejection, got {result.returncode}"
        assert f"{filename}: missing cancel-in-progress" in result.stderr, f"{name}: {result.stderr}"
    release_cases_run.append(name)
    print(f"PASS: release exemption {name} -> {'accepted' if accepted else 'rejected'}")


release_case("dispatch-only release.yml, explicit false", "release.yml",
             "  workflow_dispatch:", "  cancel-in-progress: false", True)
release_case("same shape under another name", "nightly.yml",
             "  workflow_dispatch:", "  cancel-in-progress: false", False)
release_case("release.yml that also runs on push", "release.yml",
             "  push:\n    branches: [main]\n  workflow_dispatch:", "  cancel-in-progress: false", False)
release_case("release.yml with no cancellation policy", "release.yml",
             "  workflow_dispatch:", "", False)
assert len(release_cases_run) == EXPECTED_RELEASE_CASES, release_cases_run
print(f"Release cancellation exemption controls passed: {len(release_cases_run)}/{EXPECTED_RELEASE_CASES}")
