#!/usr/bin/env python3
"""Exercise the CI policy verifier against isolated synthetic workflows."""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
import subprocess
import sys
import tempfile


VERIFIER = Path(__file__).with_name("verify_ci_policy.py").resolve()


@dataclass(frozen=True)
class Case:
    name: str
    triggers: str
    runs_on: str
    accepted: bool
    expected_error: str = ""
    comment: str = ""
    include_timeout: bool = True
    job_name: str = "policy-test"


CASES = (
    Case(
        name="self-hosted with workflow_dispatch only",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: [self-hosted, macOS, dulcet-device]",
        accepted=True,
    ),
    Case(
        name="self-hosted with pull_request",
        triggers="  pull_request:",
        runs_on="    runs-on: self-hosted",
        accepted=False,
        expected_error="uses a self-hosted runner in a workflow that is not workflow_dispatch-only",
    ),
    Case(
        name="self-hosted with push",
        triggers="  push:",
        runs_on="    runs-on:\n      - self-hosted\n      - macOS\n      - dulcet-device",
        accepted=False,
        expected_error="uses a self-hosted runner in a workflow that is not workflow_dispatch-only",
    ),
    Case(
        name="self-hosted in a comment with a hosted runner",
        triggers="  pull_request:",
        runs_on="    runs-on: ubuntu-latest",
        accepted=True,
        comment="# self-hosted is discussed here but is not a runner label",
        job_name="self-hosted-comment-control",
    ),
    Case(
        name="xlarge runner with workflow_dispatch only",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: macos-latest-xlarge",
        accepted=False,
        expected_error="forbidden runner token -xlarge",
    ),
    Case(
        name="missing timeout-minutes",
        triggers="  workflow_dispatch:",
        runs_on="    runs-on: ubuntu-latest",
        accepted=False,
        expected_error="missing per-job timeout",
        include_timeout=False,
    ),
)


def workflow_for(case: Case) -> str:
    lines = ["name: synthetic-core-ci"]
    if case.comment:
        lines.append(case.comment)
    lines.extend(
        [
            "on:",
            *case.triggers.splitlines(),
            "",
            "concurrency:",
            "  group: synthetic-core-ci",
            "  cancel-in-progress: true",
            "",
            "jobs:",
            f"  {case.job_name}:",
            *case.runs_on.splitlines(),
        ],
    )
    if case.include_timeout:
        lines.append("    timeout-minutes: 5")
    lines.extend(
        [
            "    steps:",
            "      - name: Preserve the two core-ci database gates",
            "        run: |",
            "          python3 tools/migration_gate.py",
            "          ./gradlew :core:verifySqlDelightMigration",
        ],
    )
    return "\n".join(lines) + "\n"


def run_case(case: Case) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-ci-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "core-ci.yml").write_text(workflow_for(case))
        result = subprocess.run(
            [sys.executable, str(VERIFIER)],
            cwd=root,
            text=True,
            capture_output=True,
            check=False,
        )

    if case.accepted:
        if result.returncode != 0:
            raise AssertionError(
                f"{case.name}: expected acceptance, got exit {result.returncode}\n"
                f"stdout:\n{result.stdout}stderr:\n{result.stderr}",
            )
        outcome = "accepted"
    else:
        if result.returncode == 0:
            raise AssertionError(f"{case.name}: expected rejection, but verifier accepted it")
        if case.expected_error not in result.stderr:
            raise AssertionError(
                f"{case.name}: rejection did not contain {case.expected_error!r}\n"
                f"stdout:\n{result.stdout}stderr:\n{result.stderr}",
            )
        outcome = "rejected"
    print(f"PASS: {case.name} -> {outcome}")


# ---------------------------------------------------------------------------------------------
# The JUnit bijection is apple-ci-specific, so the core-ci fixtures above cannot reach it: the
# verifier guards that block on apple-ci.yml being present, and it is legitimately absent from a
# synthetic single-workflow fixture. These cases supply an apple-ci-shaped fixture instead.
#
# They exist because the write may now live in a `tools/ci/` script rather than inline in the YAML.
# That is forced, not stylistic: the Darwin composite step is at a hard GitHub workflow size ceiling
# (29,893 characters of inline `run:` loads; 34,557 makes the whole file invalid and no job runs at
# all), and extraction is GitHub's own remedy. A check that stopped at the YAML would be blinded by
# exactly the change the ceiling forces.
#
# These assert on the PRESENCE or ABSENCE of the bijection messages rather than on the process exit
# code, because a minimal fixture legitimately trips other, unrelated policy rules. Asserting the
# specific sentence is what makes the case about the bijection and not about fixture completeness.

APPLE_WORKFLOW = """name: apple-ci
on:
  pull_request:
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  apple-ci:
    runs-on: macos-latest
    timeout-minutes: 10
    steps:
      - name: Produce evidence
        run: |
          %(invocation)s
      - name: Verify evidence
        run: |
          python3 tools/verify-parity-evidence \\
            "$RUNNER_TEMP/dulcet-example-junit"
"""

APPLE_SCRIPT = """#!/bin/bash
set -euo pipefail
python3 tools/swift-testing-junit "$RUNNER_TEMP/x.xcresult" \\
  "%(junit)s/TEST-Example.xml" Example
"""

BIJECTION_MISSING = "verify-parity-evidence reads dulcet-example-junit, which no step writes"
SCRIPT_MISSING = "invokes tools/ci/produce-evidence, which does not exist"


def run_apple_case(name: str, invocation: str, script: str | None, present: str, absent: str) -> None:
    """`present` must appear in stderr and `absent` must not; either may be empty."""
    with tempfile.TemporaryDirectory(prefix="dulcet-apple-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(APPLE_WORKFLOW % {"invocation": invocation})
        # The verifier reads core-ci.yml unconditionally, so an apple-only fixture would crash it
        # before reaching the check under test. Reuse the accepted core-ci fixture verbatim.
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        if script is not None:
            scripts = root / "tools" / "ci"
            scripts.mkdir(parents=True)
            (scripts / "produce-evidence").write_text(script)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    if present and present not in result.stderr:
        raise AssertionError(f"{name}: expected {present!r} in stderr\nstderr:\n{result.stderr}")
    if absent and absent in result.stderr:
        raise AssertionError(f"{name}: did not expect {absent!r} in stderr\nstderr:\n{result.stderr}")
    print(f"PASS: {name}")


APPLE_CASES = (
    (
        "a script that writes the directory satisfies the bijection",
        "tools/ci/produce-evidence",
        APPLE_SCRIPT % {"junit": "$RUNNER_TEMP/dulcet-example-junit"},
        "",
        BIJECTION_MISSING,
    ),
    (
        "a script that stops writing the directory is rejected",
        "tools/ci/produce-evidence",
        APPLE_SCRIPT % {"junit": "$RUNNER_TEMP/somewhere-else"},
        BIJECTION_MISSING,
        "",
    ),
    (
        "invoking a script that does not exist is rejected",
        "tools/ci/produce-evidence",
        None,
        SCRIPT_MISSING,
        "",
    ),
    (
        "an inline write still satisfies the bijection, unchanged",
        'python3 tools/swift-testing-junit a "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" Example',
        None,
        "",
        BIJECTION_MISSING,
    ),
)


for test_case in CASES:
    run_case(test_case)

for apple_case in APPLE_CASES:
    run_apple_case(*apple_case)

print(
    f"CI policy control passed: {len(CASES)}/{len(CASES)} core cases, "
    f"{len(APPLE_CASES)}/{len(APPLE_CASES)} apple cases"
)

# Exercise the standalone diagnostic contract separately from JUnit-directory coverage.
DIAGNOSTIC_CONTROLS = (
    'tools/test-conformance-access-log',
    'tools/test-capture-conformance-stall',
    'tools/test-measure-conformance-phase-gaps',
)
DIAGNOSTIC_WORKFLOW = '''name: apple-ci
on:
  pull_request:
concurrency:
  group: controls
  cancel-in-progress: true
jobs:
  apple-ci:
    name: apple-ci
    runs-on: macos-26
    timeout-minutes: 5
    steps:
'''

def diagnostic_case(control=None, mutation=None):
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / 'core-conformance').mkdir()
        (root / 'tools').mkdir()
        workflows = root / '.github/workflows'
        workflows.mkdir(parents=True)
        steps = []
        for item in DIAGNOSTIC_CONTROLS:
            if not (item == control and mutation == 'missing-file'):
                (root / item).write_text('# synthetic control\n')
            command = '        run: python3 ' + item + '\n'
            condition = ''
            if item == control:
                if mutation == 'missing':
                    command = '        run: true\n'
                elif mutation == 'comment':
                    command = '        # run: python3 ' + item + '\n        run: true\n'
                elif mutation == 'echo':
                    command = '        run: echo python3 ' + item + '\n'
                elif mutation == 'disabled':
                    condition = '        if: false\n'
                elif mutation == 'allowed-failure':
                    condition = '        continue-on-error: true\n'
            steps.append('      - name: control\n' + condition + command)
        apple = DIAGNOSTIC_WORKFLOW + ''.join(steps)
        if mutation == 'job-disabled':
            apple = apple.replace('    name: apple-ci', '    if: false\n    name: apple-ci')
        if mutation == 'linux-only':
            apple = apple.replace('macos-26', 'ubuntu-latest')
        if mutation == 'manual-only':
            apple = apple.replace('pull_request:', 'workflow_dispatch:')
        (workflows / 'apple-ci.yml').write_text(apple)
        (workflows / 'core-ci.yml').write_text(workflow_for(CASES[0]))
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root,
                                capture_output=True, text=True)
        if mutation is None:
            assert result.returncode == 0, result.stderr
        else:
            assert result.returncode != 0, f'{control} {mutation} was accepted'
            assert 'required diagnostic control ' + (control or DIAGNOSTIC_CONTROLS[0]) in result.stderr, result.stderr
    print(f'PASS: diagnostic wiring {mutation or "present"} {control or "job"}')

diagnostic_case()
for control in DIAGNOSTIC_CONTROLS:
    for mutation in ('missing', 'comment', 'echo', 'disabled', 'allowed-failure', 'missing-file'):
        diagnostic_case(control, mutation)
for mutation in ('job-disabled', 'linux-only', 'manual-only'):
    diagnostic_case(mutation=mutation)
print('Diagnostic wiring controls passed: 22/22 cases')
