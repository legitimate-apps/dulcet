# apple-ci's split shape (spec §21.5). The aggregator is the ONLY thing branch protection sees, so
# every property of it is a merge gate: its name, `if: always()`, needing every leg, and requiring
# each leg's result to equal `success` -- anything weaker lets a cancelled or skipped leg through,
# and a skipped required check does not block a merge. The evidence handoff between machines is
# checked too, because each break in it fails only after both legs have run. Every case asserts the
# exit status AND the rule's own sentence, and the positive cases prove the shape is satisfiable.
SHAPE_WRITE = ('python3 tools/swift-testing-junit a '
               '"$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" Example')
SHAPE_BASE = APPLE_WORKFLOW % {"invocation": SHAPE_WRITE}
LEG_START = "  apple-leg:\n"
AGGREGATOR_START = "  apple-ci:\n"


def with_second_leg(text: str, directory: str) -> str:
    """Add leg apple-leg-b, fully wired, writing `directory`."""
    leg = text[text.index(LEG_START):text.index(AGGREGATOR_START)]
    leg = leg.replace("apple-leg", "apple-leg-b").replace("dulcet-example-junit", directory)
    text = text.replace(AGGREGATOR_START, leg + AGGREGATOR_START)
    text = text.replace("needs: [apple-leg]", "needs: [apple-leg, apple-leg-b]")
    text = text.replace(
        "      APPLE_LEG_RESULT: ${{ needs.apple-leg.result }}\n",
        "      APPLE_LEG_RESULT: ${{ needs.apple-leg.result }}\n"
        "      APPLE_LEG_B_RESULT: ${{ needs.apple-leg-b.result }}\n")
    text = text.replace(
        '          test "$APPLE_LEG_RESULT" = success\n',
        '          test "$APPLE_LEG_RESULT" = success\n'
        '          test "$APPLE_LEG_B_RESULT" = success\n')
    download = text[text.index("      - name: Download parity evidence\n"):
                    text.index("      - name: Verify evidence\n")]
    text = text.replace(download, download + download.replace("apple-leg", "apple-leg-b"))
    return text.replace(
        '            "$RUNNER_TEMP/dulcet-example-junit"\n',
        '            "$RUNNER_TEMP/dulcet-example-junit" \\\n'
        f'            "$RUNNER_TEMP/{directory}"\n')


def edit(old: str, new: str, count: int = 1):
    def apply(text: str) -> str:
        if text.count(old) != count:
            raise AssertionError(f"shape fixture edit expected {count} x {old!r}")
        return text.replace(old, new)
    return apply


def extra_macos_legs(text: str) -> str:
    for name in ("apple-leg-2", "apple-leg-3"):
        text = text.replace(AGGREGATOR_START, f"  {name}:\n    runs-on: macos-latest\n"
                            "    timeout-minutes: 5\n    steps:\n      - run: true\n"
                            + AGGREGATOR_START)
    return text



def verify_before_download(text: str) -> str:
    """Move the aggregator's download step to the end, after the verify step."""
    download = text[text.index("      - name: Download parity evidence\n"):
                    text.index("      - name: Verify evidence\n")]
    return text.replace(download, "").rstrip("\n") + "\n" + download

