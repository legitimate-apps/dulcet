# Record completions only after all assertions return. Compare identities as well
# as counts so skipped and duplicate executions cannot cancel one another out.
incomplete = []
for group, completed, required in (
    ("core", CORE_PASSES, [case.name for case in CASES]),
    ("apple", APPLE_PASSES, [case[0] for case in APPLE_CASES]),
