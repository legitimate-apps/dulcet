def run_required_association_case(shape: str) -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-required-association-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        workflow = APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"}
        script = PAIRED_EMISSION_SCRIPT % {"emitted": "ExampleTarget"}
        if shape == "deleted-emission":
            script = script[:script.rindex("python3 tools/swift-testing-junit")]
        elif shape == "exported-selector":
            selector = "ExampleTarget/Example/exampleMethod"
            workflow = "env:\n  MAC_LIBRARY_SYNC_SELECTOR: " + selector + "\n" + workflow
            script = script.replace("-only-testing:" + selector,
                                    '-only-testing:"$MAC_LIBRARY_SYNC_SELECTOR"')
        else:
            raise AssertionError(f"unknown shape: {shape}")
        (workflows / "apple-ci.yml").write_text(workflow)
        (workflows / "core-ci.yml").write_text(workflow_for(next(c for c in CASES if c.accepted)))
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(script)
        (root / "FEATURES.yml").write_text(PAIRED_EMISSION_FEATURES)
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root, text=True,
                                capture_output=True, check=False)
    label = f"required association: {shape}"
    if result.returncode != 1 or "Example/exampleMethod cannot be resolved" not in result.stderr:
        raise AssertionError(f"{label}: expected unresolved-association rejection, got exit "
                             f"{result.returncode}\n{result.stdout}{result.stderr}")
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


def run_accounting_forms_case(shape: str, accepted: bool) -> None:
    """Existing whole-target and parameterized producers must resolve, not be exempted."""
    script = PAIRED_EMISSION_SCRIPT % {"emitted": "Example"}
    if shape.startswith("suite"):
        script = script.replace("ExampleTarget/Example/otherMethod", "Example")
        script = script.replace("ExampleTarget/Example/exampleMethod", "Example")
        if not accepted:
            script = script.replace("xcodebuild test-without-building \\\n  -only-testing:Example", "true")
    else:
        split = script.rindex("xcodebuild test-without-building")
        body = script[split:].replace("ExampleTarget/Example/exampleMethod", '$target/Example/$method')
        body = body.replace("  Example\n", '  "$emitted"\n')
        script = script[:split] + 'proof() {\n target="$1"\n method="$2"\n emitted="$3"\n' + body + "}\n"
        if shape != "helper-call-deleted":
            emitted = "ExampleTarget" if shape == "helper-wrong-class" else "Example"
            script += f"proof ExampleTarget exampleMethod {emitted}\n"
    with tempfile.TemporaryDirectory(prefix="dulcet-accounting-forms-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"})
        (workflows / "core-ci.yml").write_text(workflow_for(next(c for c in CASES if c.accepted)))
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(script)
        (root / "FEATURES.yml").write_text(PAIRED_EMISSION_FEATURES)
        result = subprocess.run([sys.executable, str(VERIFIER)], cwd=root, text=True,
                                capture_output=True, check=False)
    label = f"association accounting form: {shape}"
    if result.returncode != (0 if accepted else 1):
        raise AssertionError(f"{label}: unexpected exit {result.returncode}\n{result.stderr}")
    if not accepted and "cannot be resolved" not in result.stderr:
        raise AssertionError(f"{label}: rejected for the wrong reason\n{result.stderr}")
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


# The LAST uncovered mutation, and it guards a false-FAILURE rather than a missed defect: without a
# per-source reset of `pending_method`, a method left dangling at the end of one source pairs with
# the first emission in the next and rejects a workflow that is correct. I listed this as "NOT
# CAUGHT" in a PR body and nearly left it there. An enumeration is a to-do list, not coverage.
#
# The fixture is built so ONLY the seam can produce a verdict: the workflow emits the cited class
# correctly (so the "emitted somewhere" scan is satisfied), then ends with an unpaired
# `-only-testing:` for that method, and the invoked script OPENS with an emission that has no
# `-only-testing:` of its own.
SEAM_WORKFLOW_INVOCATION = (
    "xcodebuild test -only-testing:ExampleTarget/Example/exampleMethod\n          "
    'python3 tools/swift-testing-junit "$RUNNER_TEMP/a.xcresult" \\\n'
    '            "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\\n'
    "            Example\n"
    "          tools/ci/produce-evidence\n"
    "          xcodebuild test-without-building -only-testing:ExampleTarget/Example/exampleMethod"
)

SEAM_SCRIPT = """#!/bin/bash
set -euo pipefail
python3 tools/swift-testing-junit "$RUNNER_TEMP/b.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Other.xml" \\
  Other
"""


def run_source_seam_case() -> None:
    """A method dangling at the end of one source must not pair with the next source's emission."""
    with tempfile.TemporaryDirectory(prefix="dulcet-seam-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(
            APPLE_WORKFLOW % {"invocation": SEAM_WORKFLOW_INVOCATION},
        )
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(SEAM_SCRIPT)
        (root / "FEATURES.yml").write_text(CLASS_EMISSION_FEATURES)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    label = "a method dangling at a source boundary does not pair across it"
    if result.returncode != 0:
        raise AssertionError(
            f"{label}: expected exit 0, got {result.returncode} -- the pending method from the "
            "workflow's last line paired with the script's first emission, which is a mismatch "
            f"that exists only at the seam\nstderr:\n{result.stderr}",
        )
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


# Script discovery must be TRANSITIVE. A one-level scan leaves an inner script's JUnit write in
# neither `written` nor `read`, so the bijection reports the directory as read-but-never-written and
# a correct workflow is rejected. It also silently shrinks the set that the step-ordering rule is
# built on, which is the more dangerous half: that rule would inherit the blind spot rather than
# introduce it, and nothing would point at the cause.
OUTER_SCRIPT = """#!/bin/bash
set -euo pipefail
tools/ci/inner-evidence
"""

INNER_SCRIPT = """#!/bin/bash
set -euo pipefail
python3 tools/swift-testing-junit "$RUNNER_TEMP/x.xcresult" \\
  "$RUNNER_TEMP/dulcet-example-junit/TEST-Example.xml" \\
  Example
"""


def run_transitive_invocation_case() -> None:
    """The workflow invokes a script that invokes the script doing the actual write."""
    with tempfile.TemporaryDirectory(prefix="dulcet-transitive-policy-") as temporary_directory:
        root = Path(temporary_directory)
        workflows = root / ".github" / "workflows"
        workflows.mkdir(parents=True)
        (workflows / "apple-ci.yml").write_text(
            APPLE_WORKFLOW % {"invocation": "tools/ci/produce-evidence"},
        )
        (workflows / "core-ci.yml").write_text(
            workflow_for(next(case for case in CASES if case.accepted)),
        )
        scripts = root / "tools" / "ci"
        scripts.mkdir(parents=True)
        (scripts / "produce-evidence").write_text(OUTER_SCRIPT)
        (scripts / "inner-evidence").write_text(INNER_SCRIPT)
        result = subprocess.run(
            [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True, check=False,
        )
    label = "a write inside a transitively invoked script satisfies the bijection"
    if result.returncode != 0:
        raise AssertionError(
            f"{label}: expected exit 0, got {result.returncode} -- the inner script's write was "
            "not discovered, so the directory reads as written by nothing\n"
            f"stderr:\n{result.stderr}",
        )
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


def run_orphan_control_case(variants=None) -> None:
    """A control in tools/ that no workflow names must be rejected, and a wired one accepted.

    Both directions matter. Rejecting the unwired one is the gate; accepting the wired one is what
    stops the gate from being satisfiable only by having no controls at all.
    """
    # Four variants, because a bare substring test passes two of them wrongly. MEASURED against the
    # real workflows before this was fixed: a genuine orphan whose name is a strict PREFIX of a wired
    # control read as wired, and a name appearing only in a `#` comment read as wired.
    shapes = {
        "echoed": "      - run: echo python3 tools/test-example-control\n",
        "inline-comment": "      - run: true # python3 tools/test-example-control\n",
        "suppressed": "      - run: python3 tools/test-example-control || true\n",
        "continue-on-error": "      - run: python3 tools/test-example-control\n        continue-on-error: true\n",
        "empty-comment": "      - run: # python3 tools/test-example-control\n",
        "if-false": "      - run: |\n          if false; then\n            python3 tools/test-example-control\n          fi\n",
        "literal-block": "      - run: |\n          python3 tools/test-example-control # real command\n",
        "quoted": "      - run: 'python3 tools/test-example-control'\n",
        "if-false-inline": "      - run: if false; then python3 tools/test-example-control; fi\n",
        "heredoc": "      - run: |\n          cat <<'EOF'\n          python3 tools/test-example-control\n          EOF\n",
        "continue-before-run": "      - continue-on-error: true\n        run: python3 tools/test-example-control\n",
        "errexit-disabled": "      - run: |\n          set +e\n          python3 tools/test-example-control\n          true\n",
        "workflow-shell-default": "      - run: python3 tools/test-example-control\n",
    }
    for wired in variants or ("no", "yes", "prefix-of-a-wired-control", "named-only-in-a-comment", *shapes):
        with tempfile.TemporaryDirectory(prefix="dulcet-orphan-policy-") as temporary_directory:
            root = Path(temporary_directory)
            workflows = root / ".github" / "workflows"
            workflows.mkdir(parents=True)
            core = workflow_for(next(case for case in CASES if case.accepted))
            if wired == "yes":
                core += "      - run: python3 tools/test-example-control\n"
            elif wired == "prefix-of-a-wired-control":
                # Only the LONGER control is invoked. The shorter one is a real orphan.
                core += "      - run: python3 tools/test-example-control-extended\n"
            elif wired == "named-only-in-a-comment":
                core += "      # superseded by tools/test-example-control\n"
            core += shapes.get(wired, "")
            if wired == "workflow-shell-default":
                core = "defaults:\n  run:\n    shell: bash {0}\n" + core
            (workflows / "core-ci.yml").write_text(core)
            tools = root / "tools"
            tools.mkdir()
            (tools / "test-example-control").write_text("#!/usr/bin/env python3\n")
            if wired == "prefix-of-a-wired-control":
                (tools / "test-example-control-extended").write_text("#!/usr/bin/env python3\n")
            result = subprocess.run(
                [sys.executable, str(VERIFIER)], cwd=root, text=True, capture_output=True,
                check=False,
            )
        expected = 0 if wired in {"yes", "literal-block", "quoted"} else 1
        label = {
            "no": "an unwired control is rejected",
            "yes": "a wired control is accepted",
            "prefix-of-a-wired-control":
                "an orphan whose name prefixes a wired control is still rejected",
            "named-only-in-a-comment": "a control named only in a comment is not wired",
        }.get(wired, f"control invocation shape: {wired}")
        if result.returncode != expected:
            raise AssertionError(
                f"{label}: expected exit {expected}, got {result.returncode}\n"
                f"stderr:\n{result.stderr}",
            )
        if expected and "no workflow invokes this control" not in result.stderr:
            raise AssertionError(
                f"{label}: rejection did not name the reason\nstderr:\n{result.stderr}",
            )
        EXTRA_PASSES.append(label)
        print(f"PASS: {label}")


def run_completion_mutation_case(groups: tuple[str, ...]) -> None:
    source = Path(__file__).read_text()
    for group, loop in (("core", "for test_case in CASES:"),
                        ("apple", "for apple_case in APPLE_CASES:")):
        if group in groups:
            replacement = loop[:loop.index(" in ")] + " in ():"
            if source.count("\n" + loop) != 1:
                raise AssertionError(f"completion mutation cannot find {group} execution loop")
            source = source.replace("\n" + loop, "\n" + replacement)
    # Keep the real __file__ so verifier and fixture paths resolve exactly as in
    # the parent. The child flag prevents recursive mutation testing only.
    harness = "import sys; source=sys.stdin.read(); exec(compile(source, __file__, 'exec'))"
    harness = "__file__=" + repr(str(Path(__file__).resolve())) + "; " + harness
    result = subprocess.run([sys.executable, "-c", harness, "--completion-child"],
                            input=source, text=True, capture_output=True, check=False)
    label = "completion ledger: empty " + "+".join(groups) + " execution loop"
    if result.returncode != 1 or "CI policy control incomplete:" not in result.stderr:
        raise AssertionError(f"{label}: expected incomplete-check rejection, got exit "
                             f"{result.returncode}\n{result.stdout}{result.stderr}")
    if "CI policy control passed:" in result.stdout:
        raise AssertionError(f"{label}: an incomplete suite printed a success summary")
    EXTRA_PASSES.append(label)
    print(f"PASS: {label}")


