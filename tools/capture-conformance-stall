#!/usr/bin/env python3
"""Forward a native test command unchanged; sample its exact binary on phase inactivity.

The monitor lives on the host, outside Kotlin dispatchers and the simulator. It never
kills a test, retries a request, or changes a deadline. Evidence stays in CI artifacts.
"""
import argparse
import pathlib
import queue
import re
import subprocess
import threading
import time


PHASE = re.compile(r"CONFORMANCE_PHASE (\S+) elapsedMs=\d+ (begin|end|event) (\S+)")


class Progress:
    def __init__(self):
        self.active = {}

    def observe(self, line, now):
        match = PHASE.search(line)
        if not match:
            return
        label, event, phase = match.groups()
        if event == "begin" and phase == "test-body":
            self.active[label] = now
        elif event == "end" and phase == "test-body":
            self.active.pop(label, None)
        elif label in self.active:
            self.active[label] = now

    def overdue(self, now, interval):
        return [label for label, last in self.active.items() if now - last >= interval]


def sample_binary(binary, output, sequence):
    # Match an open executable file, not a process-name substring or another project's simulator.
    found = subprocess.run(
        ["/usr/sbin/lsof", "-t", str(binary)], capture_output=True, text=True, timeout=5,
    )
    pids = sorted({int(pid) for pid in found.stdout.split() if pid.isdecimal()})
    print(f"CONFORMANCE_HOST_SAMPLE sequence={sequence} matchingPids={pids}", flush=True)
    for pid in pids:
        destination = output / f"dulcet-stall-{sequence}-{pid}.log"
        with destination.open("w") as report:
            subprocess.run(
                ["/bin/ps", "-p", str(pid), "-o", "pid,ppid,state,%cpu,time,etime"],
                stdout=report, stderr=report, timeout=5,
            )
            subprocess.run(
                ["/usr/bin/sample", str(pid), "1", "10"],
                stdout=report, stderr=report, timeout=10,
            )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=pathlib.Path, required=True)
    parser.add_argument("--output", type=pathlib.Path, required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("a test command is required after --")
    args.output.mkdir(parents=True, exist_ok=True)
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    lines = queue.Queue()

    def read_output():
        try:
            for line in child.stdout:
                lines.put(line)
        finally:
            lines.put(None)

    threading.Thread(target=read_output, daemon=True).start()
    progress = Progress()
    sampled_at = {}
    sequence = 0
    with (args.output / "dulcet-stall-console.log").open("w") as transcript:
        while True:
            try:
                line = lines.get(timeout=2)
            except queue.Empty:
                line = ""
            if line is None:
                break
            if line:
                print(line, end="", flush=True)
                transcript.write(line)
                transcript.flush()
                progress.observe(line, time.monotonic())
            now = time.monotonic()
            for label in progress.overdue(now, 40):
                if now - sampled_at.get(label, float("-inf")) < 15:
                    continue
                sampled_at[label] = now
                sequence += 1
                try:
                    sample_binary(args.binary.resolve(), args.output, sequence)
                except (OSError, subprocess.TimeoutExpired) as failure:
                    print(f"CONFORMANCE_HOST_SAMPLE failed={type(failure).__name__}", flush=True)
    return child.wait()


if __name__ == "__main__":
    raise SystemExit(main())
