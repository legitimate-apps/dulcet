#!/usr/bin/env python3

"""Negative control for exact ffmpeg version-token matching."""

from pathlib import Path
import sys


sys.path.insert(0, str(Path(__file__).parent / "conformance-env"))
from ffmpeg_version import parse_ffmpeg_version, require_ffmpeg_version  # noqa: E402


def main() -> None:
    expected_version = "9.0.1"
    observed_banner = "ffmpeg version 9.0.10 forged-banner"
    observed_version = parse_ffmpeg_version(observed_banner)
    expected_detail = "ffmpeg version mismatch: expected 9.0.1, observed 9.0.10"
    expected_rejected = True
    observed_rejected = False
    observed_detail = ""
    try:
        require_ffmpeg_version(observed_banner, expected_version)
    except ValueError as error:
        observed_rejected = True
        observed_detail = str(error)
        if observed_detail != expected_detail:
            raise SystemExit(
                "ffmpeg prefix-collision negative control rejected for the wrong reason: "
                f"expected_detail={expected_detail!r} observed_detail={observed_detail!r}"
            ) from error
    if observed_rejected != expected_rejected:
        raise SystemExit("ffmpeg prefix-collision negative control failed open")
    print(
        f"NEGATIVE CONTROL PASS expected={expected_version} observed={observed_version} "
        f"expected_rejected={str(expected_rejected).lower()} "
        f"observed_rejected={str(observed_rejected).lower()} detail={observed_detail}"
    )


if __name__ == "__main__":
    main()
