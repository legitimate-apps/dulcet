def raw_ecdsa_to_der(signature: bytes) -> bytes:
    def integer(value: bytes) -> bytes:
        value = value.lstrip(b"\x00") or b"\x00"
        if value[0] & 0x80:
            value = b"\x00" + value
        return b"\x02" + bytes([len(value)]) + value

    sequence = integer(signature[:32]) + integer(signature[32:])
    return b"\x30" + bytes([len(sequence)]) + sequence


class AppStoreConnectUploadTests(unittest.TestCase):
    def test_dev_export_is_internal_only(self) -> None:
        workflow = (TOOL.parent.parent / ".github/workflows/release.yml").read_text()
        self.assertIn("python3 tools/write-release-export-options", workflow)
        with tempfile.TemporaryDirectory() as raw:
            output = Path(raw) / "ExportOptions.plist"
            for bundle in ("com.legitimateapps.dulcet.dev", "com.legitimateapps.dulcet"):
                result = subprocess.run([sys.executable, str(TOOL.with_name("write-release-export-options"))],
                    env={**os.environ, "EXPECTED_BUNDLE_ID": bundle, "EXPORT_OPTIONS": str(output),
                         "RELEASE_PROFILE_NAME": "Example Profile", "DULCET_SIGNING_IDENTITY_SHA1": "example"},
                    capture_output=True, text=True)
                self.assertEqual(result.returncode, 0, result.stderr)
                options = plistlib.loads(output.read_bytes())
                self.assertIs(options["testFlightInternalTestingOnly"], bundle.endswith(".dev"))
                self.assertEqual(options["destination"], "export")
                self.assertEqual(options["method"], "app-store-connect")
                self.assertEqual(options["provisioningProfiles"], {bundle: "Example Profile"})

    def test_dev_client_refuses_review_and_submission_before_transport(self) -> None:
        client = upload.AppStoreConnectClient("key", "issuer", b"unused", "com.legitimateapps.dulcet.dev")
        paths = ["/v1/appStoreVersions", "/v1/reviewSubmissions", "/v1/reviewSubmissionItems",
                 "/v1/appStoreVersionSubmissions", "/v1/betaAppReviewSubmissions",
                 "/v1/apps/app-id/relationships/reviewSubmissions",
                 "/v1/%72eviewSubmissions", "/v1/REVIEWSubmissions", "/v1/futureSubmission"]
        with mock.patch.object(client, "token") as token, mock.patch.object(upload.urllib.request, "urlopen") as send:
            send.return_value.__enter__.return_value.read.return_value = b"{}"
            token.return_value = "canary-placeholder"
            for path in paths:
                for method in ("GET", "POST", "PATCH", "DELETE"):
                    with self.subTest(path=path, method=method), self.assertRaises(upload.UploadFailure):
                        client.request(method, path, {})
            token.assert_not_called()
            send.assert_not_called()

    def test_installer_prerequisite_fails_before_archive(self) -> None:
        workflow = (TOOL.parent.parent / ".github/workflows/release.yml").read_text()
        marker = "- name: Require Mac installer signing support"
        self.assertIn(marker, workflow)
        self.assertLess(workflow.index(marker), workflow.index("- name: Read toolchain pins"))
        step = workflow.split(marker, 1)[1].split("\n      - ", 1)[0]
        program = textwrap.dedent(step.split("run: |\n", 1)[1])
        result = subprocess.run(["/bin/bash", "-c", program], capture_output=True, text=True)
        self.assertEqual(result.returncode, 78)
        self.assertIn("Mac Installer Distribution", result.stderr)
        self.assertIn("import", result.stderr)

    def test_upload_requires_explicit_confirmation(self) -> None:
        workflow = TOOL.parent.parent / ".github/workflows/release.yml"
        text = workflow.read_text()
        step = text.split("- name: Upload to App Store Connect", 1)[1]
        self.assertIn("if: ${{ steps.upload_decision.outputs.confirmed == 'true' }}", step)
        self.assertIn('python3 tools/release-upload-decision >> "$GITHUB_OUTPUT"', text)
        self.assertIn("id: upload_decision", text)
        values = [None, "", 0, "0", 1, "1", False, "false", True, "true", [], {}]
        with tempfile.TemporaryDirectory() as raw:
            event = Path(raw) / "event.json"
            for dry in values:
                for affirmative in values:
                    event.write_text(json.dumps({"inputs": {"dry_run": dry, "upload": affirmative}}))
                    result = subprocess.run([sys.executable, str(TOOL.with_name("release-upload-decision"))],
                        env={**os.environ, "GITHUB_EVENT_PATH": str(event)}, capture_output=True, text=True)
                    expected = (dry is False or dry == "false") and (affirmative is True or affirmative == "true")
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual(result.stdout.strip(), f"confirmed={str(expected).lower()}", (dry, affirmative))
            event.write_text('{}')
            result = subprocess.run([sys.executable, str(TOOL.with_name("release-upload-decision"))],
                env={**os.environ, "GITHUB_EVENT_PATH": str(event)}, capture_output=True, text=True)
            self.assertEqual(result.stdout.strip(), "confirmed=false")

    def test_main_keeps_key_in_memory(self) -> None:
        key = b"-----BEGIN PRIVATE KEY-----\nCANARY_ASC_MEMORY_ONLY\n-----END PRIVATE KEY-----"
        with tempfile.TemporaryDirectory() as raw:
            package = Path(raw) / "Dulcet.pkg"
            package.write_bytes(b"package")
            args = [str(TOOL), "--package", str(package), "--bundle-id",
                    "com.legitimateapps.dulcet.dev", "--version", "0.1", "--build-number", "1"]
            with mock.patch.dict(os.environ, dict(zip(upload.REQUIRED_ENVIRONMENT,
                    ["EXAMPLEKEY", "example-issuer", base64.b64encode(key).decode()]))), \
                    mock.patch.object(sys, "argv", args), \
