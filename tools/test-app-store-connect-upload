#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import importlib.util
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest import mock


TOOL = Path(__file__).with_name("app_store_connect_upload.py")
SPEC = importlib.util.spec_from_file_location("app_store_connect_upload", TOOL)
assert SPEC is not None and SPEC.loader is not None
upload = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(upload)


def raw_ecdsa_to_der(signature: bytes) -> bytes:
    def integer(value: bytes) -> bytes:
        value = value.lstrip(b"\x00") or b"\x00"
        if value[0] & 0x80:
            value = b"\x00" + value
        return b"\x02" + bytes([len(value)]) + value

    sequence = integer(signature[:32]) + integer(signature[32:])
    return b"\x30" + bytes([len(sequence)]) + sequence


class AppStoreConnectUploadTests(unittest.TestCase):
    def test_generated_jwt_has_a_valid_es256_signature(self) -> None:
        with tempfile.TemporaryDirectory(prefix="dulcet-upload-test-") as directory:
            root = Path(directory)
            private_key = root / "private.pem"
            public_key = root / "public.pem"
            subprocess.run(
                ["/usr/bin/openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", private_key],
                check=True,
                capture_output=True,
            )
            subprocess.run(
                ["/usr/bin/openssl", "ec", "-in", private_key, "-pubout", "-out", public_key],
                check=True,
                capture_output=True,
            )
            token = upload.AppStoreConnectClient("EXAMPLEKEY", "example-issuer", private_key).token()
            header, payload, encoded_signature = token.split(".")
            padding = "=" * (-len(encoded_signature) % 4)
            import base64

            raw_signature = base64.urlsafe_b64decode(encoded_signature + padding)
            self.assertEqual(len(raw_signature), 64)
            der_path = root / "signature.der"
            der_path.write_bytes(raw_ecdsa_to_der(raw_signature))
            verified = subprocess.run(
                ["/usr/bin/openssl", "dgst", "-sha256", "-verify", public_key, "-signature", der_path],
                input=f"{header}.{payload}".encode(),
                capture_output=True,
                check=False,
            )
            self.assertEqual(verified.returncode, 0, verified.stderr.decode(errors="replace"))

    def test_upload_flow_uses_only_build_upload_endpoints(self) -> None:
        class FakeClient:
            def __init__(self) -> None:
                self.calls: list[tuple[str, str, object]] = []

            def request(self, method: str, path: str, payload: object = None) -> dict:
                self.calls.append((method, path, payload))
                if method == "GET" and path.startswith("/v1/apps?"):
                    return {
                        "data": [
                            {
                                "type": "apps",
                                "id": "app-id",
                                "attributes": {"bundleId": "com.legitimateapps.dulcet.dev"},
                            }
                        ]
                    }
                if method == "POST" and path == "/v1/buildUploads":
                    return {"data": {"type": "buildUploads", "id": "upload-id"}}
                if method == "POST" and path == "/v1/buildUploadFiles":
                    return {
                        "data": {
                            "type": "buildUploadFiles",
                            "id": "file-id",
                            "attributes": {
                                "uploadOperations": [
                                    {
                                        "method": "PUT",
                                        "url": "https://upload.example.invalid/signed?token=secret",
                                        "offset": 0,
                                        "length": 7,
                                        "requestHeaders": [],
                                    }
                                ]
                            },
                        }
                    }
                if method == "PATCH" and path == "/v1/buildUploadFiles/file-id":
                    return {}
                if method == "GET" and path.startswith("/v1/buildUploads/upload-id?"):
                    return {
                        "data": {
                            "attributes": {"state": {"state": "COMPLETE"}}
                        }
                    }
                raise AssertionError((method, path))

        with tempfile.TemporaryDirectory(prefix="dulcet-upload-test-") as directory:
            package = Path(directory) / "Dulcet.pkg"
            package.write_bytes(b"package")
            client = FakeClient()
            with mock.patch.object(upload, "upload_operations") as upload_parts:
                upload.upload_build(
                    client,
                    package,
                    "com.legitimateapps.dulcet.dev",
                    "0.1.0",
                    "42",
                )
            upload_parts.assert_called_once()

        paths = [path for _, path, _ in client.calls]
        self.assertTrue(all("review" not in path.lower() for path in paths))
        self.assertEqual(
            [path.split("?", 1)[0] for path in paths],
            [
                "/v1/apps",
                "/v1/buildUploads",
                "/v1/buildUploadFiles",
                "/v1/buildUploadFiles/file-id",
                "/v1/buildUploads/upload-id",
            ],
        )
        patch_payload = client.calls[3][2]
        checksum = patch_payload["data"]["attributes"]["sourceFileChecksums"]["file"]
        self.assertEqual(checksum["algorithm"], "SHA_256")
        self.assertEqual(checksum["hash"], hashlib.sha256(b"package").hexdigest())

    def test_operation_coverage_rejects_a_gap(self) -> None:
        with self.assertRaisesRegex(upload.UploadFailure, "gap or overlap"):
            upload.validate_operations(
                [
                    {
                        "method": "PUT",
                        "url": "https://upload.example.invalid/part",
                        "offset": 1,
                        "length": 4,
                        "requestHeaders": [],
                    }
                ],
                5,
            )

    def test_diagnostics_redact_urls_and_bearer_values(self) -> None:
        diagnostic = upload.redact(
            "failed https://upload.example.invalid/file?Signature=credential "
            "Authorization: Bearer header.payload.signature"
        )
        self.assertNotIn("Signature=", diagnostic)
        self.assertNotIn("header.payload.signature", diagnostic)
        self.assertIn("[REDACTED_URL]", diagnostic)


if __name__ == "__main__":
    unittest.main()
