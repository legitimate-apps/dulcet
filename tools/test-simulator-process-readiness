#!/usr/bin/env python3
"""Prove simulator process readiness retries, succeeds, and expires as a prerequisite failure."""

from __future__ import annotations

import os
import subprocess
import sys
import time
from pathlib import Path
from tempfile import TemporaryDirectory

PROBE = Path(__file__).resolve().parent / "wait-for-simulator-process"
ANNOTATION = "::error title=iPadOS simulator prerequisite failed::"


def invoke(
    mode: str,
    *,
    deadline: float,
    attempt_timeout: float = 5.0,
    probe_command: tuple[str, ...] = ("launchctl", "error", "0"),
) -> tuple[subprocess.CompletedProcess[str], int, str]:
    with TemporaryDirectory(prefix="dulcet-simulator-process-probe-") as directory:
        root = Path(directory)
        counter = root / "attempts"
        arguments = root / "arguments"
        shim = root / "xcrun"
        shim.write_text(
            "#!/usr/bin/env python3\n"
            "import os, pathlib, sys, time\n"
            "counter = pathlib.Path(os.environ['DULCET_PROBE_COUNTER'])\n"
            "arguments = pathlib.Path(os.environ['DULCET_PROBE_ARGUMENTS'])\n"
            "attempt = int(counter.read_text()) + 1 if counter.exists() else 1\n"
            "counter.write_text(str(attempt))\n"
            "arguments.write_text('\\0'.join(sys.argv[1:]))\n"
            "mode = os.environ['DULCET_PROBE_MODE']\n"
            "if mode == 'eventual-success' and attempt >= 3:\n"
            "    raise SystemExit(0)\n"
            "if mode == 'hang':\n"
            "    time.sleep(30)\n"
            "print('simulated process launch rejection', file=sys.stderr)\n"
            "raise SystemExit(17)\n"
        )
        shim.chmod(0o755)
        environment = os.environ.copy()
        environment["PATH"] = f"{root}{os.pathsep}{environment['PATH']}"
        environment["DULCET_PROBE_COUNTER"] = str(counter)
        environment["DULCET_PROBE_ARGUMENTS"] = str(arguments)
        environment["DULCET_PROBE_MODE"] = mode
        result = subprocess.run(
            [
                sys.executable,
                str(PROBE),
                "--udid",
                "DULCET-CONTROL-UDID",
                "--deadline-seconds",
                str(deadline),
                "--attempt-timeout-seconds",
                str(attempt_timeout),
                "--poll-interval-seconds",
                "0.03",
                "--",
                *probe_command,
            ],
            text=True,
            capture_output=True,
            check=False,
            env=environment,
        )
        attempts = int(counter.read_text()) if counter.exists() else 0
        return result, attempts, arguments.read_text() if arguments.exists() else ""


def main() -> None:
    eventual, attempts, arguments = invoke("eventual-success", deadline=1.0)
    if eventual.returncode != 0 or attempts != 3:
        raise SystemExit(
            "POSITIVE CONTROL FAILED: a probe that became ready on attempt three did not pass:\n"
            + eventual.stdout
            + eventual.stderr
        )
    expected_arguments = "\0".join(
        ("simctl", "spawn", "DULCET-CONTROL-UDID", "launchctl", "error", "0")
    )
    if arguments != expected_arguments:
        raise SystemExit(
            "POSITIVE CONTROL FAILED: probe command did not reach xcrun exactly: "
            f"expected={expected_arguments!r} actual={arguments!r}"
        )
    print("POSITIVE CONTROL PASS transient_launch_rejections_retried=true attempts=3")

    impossible_command = ("dulcet-probe-target-that-cannot-exist",)
    impossible, attempts, arguments = invoke(
        "always-fail",
        deadline=1.0,
        probe_command=impossible_command,
    )
    combined = impossible.stdout + impossible.stderr
    if impossible.returncode == 0:
        raise SystemExit("NEGATIVE CONTROL FAILED: an impossible probe target passed")
    if ANNOTATION not in combined or "the layout test did not run" not in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: deadline expiry lacks the prerequisite annotation:\n" + combined
        )
    if "dulcet-probe-target-that-cannot-exist" not in arguments:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: control did not target the impossible executable: "
            f"arguments={arguments!r} output={combined!r}"
        )
    if attempts < 2:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: the impossible target was asserted once instead of polled: "
            f"attempts={attempts}"
        )
    print(
        "NEGATIVE CONTROL PASS impossible_target_rejected=true "
        f"annotation={ANNOTATION!r} exit={impossible.returncode} attempts={attempts}"
    )

    started = time.monotonic()
    hung, shim_starts, _arguments = invoke("hang", deadline=0.5)
    wall_seconds = time.monotonic() - started
    combined = hung.stdout + hung.stderr
    if hung.returncode == 0 or ANNOTATION not in combined or "attempt-timeout" not in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: an in-flight spawn escaped the absolute deadline:\n" + combined
        )
    if wall_seconds >= 2:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: the half-second absolute deadline took "
            f"{wall_seconds:.2f} seconds to return"
        )
    print(
        "NEGATIVE CONTROL PASS hung_spawn_bounded=true "
        f"annotation={ANNOTATION!r} exit={hung.returncode} shim_starts={shim_starts} "
        f"wall_seconds={wall_seconds:.2f}"
    )

    started = time.monotonic()
    polled_hang, shim_starts, _arguments = invoke(
        "hang",
        deadline=0.5,
        attempt_timeout=0.1,
    )
    wall_seconds = time.monotonic() - started
    combined = polled_hang.stdout + polled_hang.stderr
    if polled_hang.returncode == 0 or ANNOTATION not in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: a repeatedly hung probe did not fail as a prerequisite:\n"
            + combined
        )
    attempt_count = combined.count("IPADOS SIMULATOR PROCESS WAIT attempt=")
    if attempt_count <= 1 or shim_starts <= 1:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: a hung attempt consumed the entire polling deadline: "
            f"attempts={attempt_count} shim_starts={shim_starts} output={combined!r}"
        )
    if combined.count("status=attempt-timeout") != attempt_count:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: timeout diagnostics do not account for every attempt: "
            f"attempts={attempt_count} output={combined!r}"
        )
    if f"IPADOS SIMULATOR PROCESS NOT READY attempts={attempt_count} " not in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: final diagnostic does not report the polled attempt count: "
            f"attempts={attempt_count} output={combined!r}"
        )
    if wall_seconds >= 2:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: repeatedly timing out attempts escaped the half-second "
            f"absolute deadline; wall_seconds={wall_seconds:.2f}"
        )
    print(
        "NEGATIVE CONTROL PASS hung_attempt_retried=true "
        f"attempt_timeout_seconds=0.1 total_deadline_seconds=0.5 attempts={attempt_count} "
        f"shim_starts={shim_starts} "
        f"annotation={ANNOTATION!r} exit={polled_hang.returncode} "
        f"wall_seconds={wall_seconds:.2f}"
    )


if __name__ == "__main__":
    main()
