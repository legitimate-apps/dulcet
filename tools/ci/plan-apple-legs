# Gradle configuration is read by every Kotlin/Native framework build, wherever the file lives.
GRADLE_INPUTS = ("*.gradle.kts", "*.gradle", "gradle.properties", "gradlew", "gradlew.bat")

NOT_APPLE = (
    "docs/*",
    "*.md",
    "LICENSE",
    "NOTICE",
    "FEATURES.yml",  # read by parity-gate; full Apple evidence resolves on full runs before release
    "android/*",
    # Kotlin source sets no Apple target compiles (the default hierarchy: android* and jvm* sit
    # beside appleMain, not under it). commonMain, commonTest and apple* stay Apple inputs.
    "core/src/androidMain/*",
    "core/src/androidHostTest/*",
    "core/src/jvmMain/*",
    "core/src/jvmTest/*",
    "core-conformance/src/androidDeviceTest/*",
    "core-conformance/src/androidHostTest/*",
    "core-conformance/src/jvmTest/*",
    # Every workflow but apple-ci's own definition, and repository metadata.
    ".github/*",
) + NOT_APPLE_TOOLS

# Checked BEFORE NOT_APPLE, so these win: apple-ci's own definition, and Gradle inputs inside an
# otherwise excluded directory (android/app/build.gradle.kts configures with the frameworks).
ALWAYS_APPLE = (".github/workflows/apple-ci.yml",) + tuple(
    pattern for name in GRADLE_INPUTS for pattern in (name, "*/" + name))


def apple_affecting(path: str) -> bool:
    if any(fnmatch.fnmatchcase(path, pattern) for pattern in ALWAYS_APPLE):
        return True
    return not any(fnmatch.fnmatchcase(path, pattern) for pattern in NOT_APPLE)


def plan(event: str, changed: list[str] | None, conformance_only: bool = False, discover_only: bool = False) -> tuple[bool, bool, str]:
    """(platform, conformance, reason). `changed` is None when the diff could not be read."""
    if event == "workflow_dispatch" and discover_only:
        return False, False, "manual dispatch requested Discover proofs only (not a full release run)"
    if event == "workflow_dispatch" and conformance_only:
        return False, True, "manual dispatch requested conformance only (not a full release run)"
    if event != "pull_request":
        return True, True, f"event {event!r} runs every leg"
    if changed is None:
        return True, False, "pull request: changed paths unknown, so the platform leg runs"
    if not changed:
        return True, False, "pull request: empty diff read, so the platform leg runs"
    affecting = [path for path in changed if apple_affecting(path)]
    if affecting:
        shown = ", ".join(affecting[:5]) + (" ..." if len(affecting) > 5 else "")
        return True, False, (f"pull request: {len(affecting)} of {len(changed)} changed paths are "
                             f"Apple-affecting ({shown})")
    return False, False, f"pull request: none of {len(changed)} changed paths is Apple-affecting"


def merge_diff() -> list[str] | None:
    def git(*args: str) -> str | None:
        result = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
        return result.stdout if result.returncode == 0 else None

    parents = git("rev-list", "--parents", "-n", "1", "HEAD")
    if parents is None or len(parents.split()) != 3:
        return None
    names = git("diff", "--name-only", "HEAD^1", "HEAD")
    if names is None:
        return None
    return [line for line in names.splitlines() if line.strip()]


REPOSITORY = "legitimate-apps/dulcet"
WORKFLOW_PATH = ".github/workflows/apple-ci.yml"
CONFORMANCE_JOBS = {"apple-conformance-core", "apple-conformance-ipad", "apple-conformance-iphone"}


class ProofUnavailable(ValueError):
    """Uncertain evidence means run every leg, never an optimistic skip."""


def require(condition: bool, reason: str) -> None:
    if not condition:
        raise ProofUnavailable(reason)


class GitHub:
    def __init__(self, token: str, fixture: str | None = None):
        self.token = token
        self.responses = json.loads(Path(fixture).read_text())["responses"] if fixture else None

    def get(self, path: str):
        if self.responses is not None:
            # Replay exactly the live endpoint, pagination and validation path. No canned verdicts.
            return self.responses[path]
        require(bool(self.token), "GITHUB_TOKEN is unavailable")
        request = urllib.request.Request("https://api.github.com" + path, headers={
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        })
        with urllib.request.urlopen(request, timeout=15) as response:
            return json.load(response)

    def listing(self, path: str, key: str | None = None) -> list[dict]:
        result = []
        total = None
        # Bounded API work. Truncation, changing totals or malformed pages refuse reuse.
        for page in range(1, 11):
            document = self.get(f"{path}{'&' if '?' in path else '?'}per_page=100&page={page}")
            if key:
                count = document["total_count"]
                require(type(count) is int and count >= 0, "invalid API total_count")
                require(total is None or total == count, "API total_count changed")
                total = count
                batch = document[key]
            else:
                batch = document
            require(isinstance(batch, list) and all(isinstance(x, dict) for x in batch),
                    "invalid API list")
            result.extend(batch)
            if len(batch) < 100:
                require(total is None or total == len(result), "API list truncated")
                return result
        raise ProofUnavailable("API pagination limit reached")


def proven_main_push(api: GitHub, repository: str, sha: str, ref: str) -> str:
    """Return an audit receipt or raise. Only this repository's merged, non-fork PR can qualify."""
    require(repository == REPOSITORY and ref == "refs/heads/main", "not this repository's main push")
    require(bool(re.fullmatch(r"[0-9a-f]{40}", sha)), "invalid pushed SHA")
    base = f"/repos/{repository}"
    pulls = api.listing(f"{base}/commits/{sha}/pulls")
    require(len(pulls) == 1, "push must have exactly one associated PR")
    number = pulls[0]["number"]
    require(type(number) is int and number > 0, "invalid PR number")
    pr = api.get(f"{base}/pulls/{number}")
    require(pr["number"] == number and pr["merged"] is True and pr["state"] == "closed"
            and pr["merge_commit_sha"] == sha and pr["base"]["ref"] == "main",
            "associated PR did not produce this main commit")
    own = pr["base"]["repo"]
    require(own["full_name"] == repository and type(own["id"]) is int and own["id"] > 0
            and pr["head"]["repo"]["id"] == own["id"]
            and pr["head"]["repo"]["full_name"] == repository, "foreign or fork PR")
    head = pr["head"]["sha"]
    require(bool(re.fullmatch(r"[0-9a-f]{40}", head)), "invalid PR head SHA")

    def tree(commit: str) -> str:
        document = api.get(f"{base}/commits/{commit}")
        value = document["commit"]["tree"]["sha"]
        require(document["sha"] == commit and bool(re.fullmatch(r"[0-9a-f]{40}", value)),
                "invalid commit/tree response")
        return value

    pushed_tree = tree(sha)
    require(pushed_tree == tree(head), "pushed tree differs from PR head tree")
    workflow = api.get(f"{base}/actions/workflows/apple-ci.yml")
    require(workflow["path"] == WORKFLOW_PATH and type(workflow["id"]) is int
            and workflow["id"] > 0, "wrong workflow identity")
    runs = api.listing(f'{base}/actions/workflows/{workflow["id"]}/runs?head_sha={head}',
                       "workflow_runs")
    require(len({run["id"] for run in runs}) == len(runs), "duplicate workflow runs")

    def valid_run(run: dict, event: str) -> None:
        require(type(run["id"]) is int and run["id"] > 0
                and run["workflow_id"] == workflow["id"] and run["path"] == WORKFLOW_PATH
                and run["event"] == event and run["head_sha"] == head
                and run["repository"]["id"] == own["id"]
                and run["repository"]["full_name"] == repository
                and run["head_repository"]["id"] == own["id"]
                and run["head_repository"]["full_name"] == repository,
                "wrong run provenance, event, workflow or head")
        require(type(run["run_attempt"]) is int and run["run_attempt"] > 0
                and run["status"] == "completed" and run["conclusion"] == "success",
                "latest workflow attempt is not successful")

    def proof(event: str, names: set[str]) -> int:
        candidates = [run for run in runs if run["event"] == event]
        require(bool(candidates), f"missing {event} run")
        # Do not rescue a newer failed/pending run with an older green run.
        listed = max(candidates, key=lambda run: run["id"])
        valid_run(listed, event)
        path = f'{base}/actions/runs/{listed["id"]}'
        current = api.get(path)
        valid_run(current, event)
        require(current["id"] == listed["id"] and current["run_attempt"] == listed["run_attempt"],
                "workflow attempt changed since listing")
        jobs = api.listing(f'{path}/attempts/{current["run_attempt"]}/jobs', "jobs")
        for name in names | {"apple-ci"}:
            found = [job for job in jobs if job["name"] == name]
            require(len(found) == 1, f"missing or ambiguous {name} job")
            job = found[0]
            require(job["run_id"] == current["id"] and job["head_sha"] == head
                    and job["run_attempt"] == current["run_attempt"]
                    and job["status"] == "completed" and job["conclusion"] == "success",
                    f"{name} did not succeed in latest attempt")
        # Detect a rerun started while its jobs were read.
        require(api.get(path) == current, "workflow run changed while reading jobs")
        return current["id"]

    platform_run = proof("pull_request", {"apple-platform"})
    dispatch_run = proof("workflow_dispatch", CONFORMANCE_JOBS)
    return (f"Reused Apple proof for PR #{number}: head `{head}`, tree `{pushed_tree}`, "
            f"PR run [{platform_run}](https://github.com/{repository}/actions/runs/{platform_run}), "
            f"dispatch run [{dispatch_run}](https://github.com/{repository}/actions/runs/{dispatch_run}). "
            "No macOS legs planned. FEATURES evidence is not resolved on this run; "
            "it requires a full run, including the release's plain full dispatch.")


def push_plan(api: GitHub, repository: str, sha: str, ref: str) -> tuple[bool, bool, str]:
    try:
        return False, False, proven_main_push(api, repository, sha, ref)
    except (OSError, http.client.HTTPException, ValueError, KeyError, TypeError, AttributeError) as error:
        # No raw HTTP bodies, URLs, tokens or PR-controlled text in logs or summaries.
        reason = str(error) if isinstance(error, ProofUnavailable) else type(error).__name__
        return True, True, f"main proof unavailable ({reason}); run every leg"


def main() -> int:
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    plan_parser = commands.add_parser("plan")
    plan_parser.add_argument("--event", required=True)
    plan_parser.add_argument("--changed-files")
    plan_parser.add_argument("--conformance-only", choices=("true", "false"), default="false")
    plan_parser.add_argument("--discover-only", choices=("true", "false"), default="false")
    plan_parser.add_argument("--proof-fixture", help="Replay recorded REST responses without network access")
    require = commands.add_parser("require-leg")
    require.add_argument("planned")
    require.add_argument("result")
    arguments = parser.parse_args()

    if arguments.command == "require-leg":
        expected = {"true": "success", "false": "skipped"}.get(arguments.planned)
        if expected is None or arguments.result != expected:
            print(f"APPLE LEG REFUSED planned={arguments.planned!r} result={arguments.result!r}; "
                  f"a planned leg must succeed and an unplanned one must be skipped",
                  file=sys.stderr)
            return 1
        print(f"APPLE LEG OK planned={arguments.planned} result={arguments.result}")
        return 0

    changed: list[str] | None = None
    if arguments.event == "pull_request":
        if arguments.changed_files:
            with open(arguments.changed_files, encoding="utf-8") as handle:
                changed = [line.strip() for line in handle if line.strip()]
        else:
            changed = merge_diff()
    platform, conformance, reason = plan(arguments.event, changed, arguments.conformance_only == "true", arguments.discover_only == "true")
    if arguments.event == "push":
        try:
            api = GitHub(os.environ.get("GITHUB_TOKEN", ""), arguments.proof_fixture)
            platform, conformance, reason = push_plan(
                api, os.environ.get("GITHUB_REPOSITORY", ""), os.environ.get("GITHUB_SHA", ""),
                os.environ.get("GITHUB_REF", ""))
        except (OSError, ValueError, KeyError, TypeError):
            platform, conformance, reason = True, True, "proof fixture unreadable; run every leg"
    if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(summary, "a", encoding="utf-8") as handle:
            handle.write(f"Apple leg plan: platform={str(platform).lower()}, "
                         f"conformance={str(conformance).lower()}. {reason}\n\n")
    print(f"APPLE LEG PLAN platform={str(platform).lower()} "
          f"conformance={str(conformance).lower()}: {reason}", file=sys.stderr)
    print(f"platform={str(platform).lower()}")
    print(f"conformance={str(conformance).lower()}")
    discover = conformance or (arguments.event == "workflow_dispatch" and arguments.discover_only == "true")
    print(f"discover={str(discover).lower()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
