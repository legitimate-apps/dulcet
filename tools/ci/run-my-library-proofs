#!/bin/bash
# Run the shared My Library UI suite, with platform-specific evidence names. The caller supplies
# the finite Dulcet Server/proxy fixture and disposable Navidrome (with-my-library-fixture).
set -euo pipefail
: "${RUNNER_TEMP:?}"
mode="${1:?macos|tvos|iphone|ipad}"
case "$mode" in macos|tvos|iphone|ipad) ;; *) exit 2 ;; esac

# The opt-in apsd experiment repeats one existing method in separate result bundles. These
# are predeclared comparisons, never replacements for the original full-suite verdict.
device_test_allowance=300
if [ -n "${DULCET_APSD_PROBE_ARM:-}" ]; then
    case "$mode:${DULCET_APSD_PROBE_ARM}" in iphone:a1|iphone:b|iphone:a2|ipad:a1|ipad:b|ipad:a2) ;; *) exit 2 ;; esac
    : "${DULCET_APSD_PROBE_UDID:?}" "${DULCET_APSD_PROBE_OUTPUT:?}"
    if [ "$mode" = iphone ]; then
        probe_derived="$RUNNER_TEMP/DulcetiOSDerivedData"
    else
        probe_derived="$RUNNER_TEMP/DulcetiPadOSDerivedData"
    fi
    # No admission wait between comparison arms: that would select different load windows.
    # The experiment has already warmed/settled this exact device. No assertion changes.
    xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme DulcetiOS -configuration Debug \
        -destination "platform=iOS Simulator,id=$DULCET_APSD_PROBE_UDID" \
        -derivedDataPath "$probe_derived" \
        -resultBundlePath "$DULCET_APSD_PROBE_OUTPUT/my-library.xcresult" \
        -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance "$device_test_allowance" -maximum-test-execution-time-allowance "$device_test_allowance" \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay \
        2>&1 | tee "$DULCET_APSD_PROBE_OUTPUT/my-library.log"
    python3 tools/verify-xcode-test-execution \
        "$DULCET_APSD_PROBE_OUTPUT/my-library.xcresult" DulcetiOSUITests.DulcetMyLibraryUITests \
        testBrowseAddRemoveRelaunchAndOfflineReplay
    exit 0
fi

if [ "$mode" = macos ]; then
    xcodebuild test \
        -project apple/Dulcet.xcodeproj -scheme DulcetMac -configuration Debug \
        -destination "platform=macOS" \
        -derivedDataPath "$RUNNER_TEMP/DulcetMacAppTestDerivedData" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-macos-my-library.xcresult" \
        -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance 300 -maximum-test-execution-time-allowance 300 \
        -only-testing:DulcetMacUITests/DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay \
        -only-testing:DulcetMacUITests/DulcetMyLibraryUITests/testNonDulcetServerKeepsTheOriginalLibraryNavigation \
        -only-testing:DulcetMacUITests/DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText \
        -only-testing:DulcetMacUITests/DulcetMyLibraryUITests/testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable \
        -only-testing:DulcetMacUITests/DulcetMyLibraryUITests/testLibrarySearchGroupsAndRecentQuerySurviveRelaunch \
        CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= \
        CODE_SIGN_ENTITLEMENTS= \
        2>&1 | tee "$RUNNER_TEMP/dulcet-macos-my-library.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-macos-my-library.xcresult" \
        DulcetMacUITests.DulcetMyLibraryUITests \
        testBrowseAddRemoveRelaunchAndOfflineReplay testNonDulcetServerKeepsTheOriginalLibraryNavigation testLibraryBrowseAndAlbumInLightDarkAndLargestText testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable testLibrarySearchGroupsAndRecentQuerySurviveRelaunch
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-macos-my-library.xcresult" \
        "$RUNNER_TEMP/dulcet-macos-my-library-junit/TEST-MyLibrary.xml" \
        DulcetMyLibraryMacUITests
    xcrun xcresulttool export attachments \
        --test-id 'DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText()' \
        --path "$RUNNER_TEMP/dulcet-macos-my-library.xcresult" \
        --output-path "$RUNNER_TEMP/dulcet-macos-my-library-captures"
fi

if [ "$mode" = tvos ]; then
    python3 tools/ci/isolate-simulator --phase my-library-tvos --keep-name "Apple TV 4K (3rd generation)"
    xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme DulcetTV -configuration Debug \
        -destination "platform=tvOS Simulator,name=Apple TV 4K (3rd generation),OS=latest" \
        -derivedDataPath "$RUNNER_TEMP/DulcetTVDerivedData" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-tvos-my-library.xcresult" \
        -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance 300 -maximum-test-execution-time-allowance 300 \
        -only-testing:DulcetTVUITests/DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay \
        -only-testing:DulcetTVUITests/DulcetMyLibraryUITests/testNonDulcetServerKeepsTheOriginalLibraryNavigation \
        -only-testing:DulcetTVUITests/DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText \
        -only-testing:DulcetTVUITests/DulcetMyLibraryUITests/testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable \
        2>&1 | tee "$RUNNER_TEMP/dulcet-tvos-my-library.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-tvos-my-library.xcresult" \
        DulcetTVUITests.DulcetMyLibraryUITests \
        testBrowseAddRemoveRelaunchAndOfflineReplay testNonDulcetServerKeepsTheOriginalLibraryNavigation testLibraryBrowseAndAlbumInLightDarkAndLargestText testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-tvos-my-library.xcresult" \
        "$RUNNER_TEMP/dulcet-tvos-my-library-junit/TEST-MyLibrary.xml" \
        DulcetMyLibraryTVUITests
    xcrun xcresulttool export attachments \
        --test-id 'DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText()' \
        --path "$RUNNER_TEMP/dulcet-tvos-my-library.xcresult" \
        --output-path "$RUNNER_TEMP/dulcet-tvos-my-library-captures"
fi

if [ "$mode" = iphone ]; then
    # The caller has positively validated the server and every proxy. Pay the first boot and
    # post-boot service AND paging burst now, before any test's execution clock. A stable service
    # count alone still admitted load1 671 in run 40117378423. Warm the built shell's in-memory
    # connect screen before the quiet window, then terminate it; an idle-device window alone
    # renewed pressure on first launch in 40153793474. No production account/library is opened.
    python3 tools/ci/isolate-simulator --phase my-library-iphone --keep-name "iPhone 17 Pro" --settle --require-settle --settle-pressure --require-isolation \
        --warmup-app "$RUNNER_TEMP/DulcetiOSDerivedData/Build/Products/Debug-iphonesimulator/Dulcet DEV.app"
    xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme DulcetiOS -configuration Debug \
        -destination "platform=iOS Simulator,name=iPhone 17 Pro,OS=latest" \
        -derivedDataPath "$RUNNER_TEMP/DulcetiOSDerivedData" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-iphone-my-library.xcresult" \
        -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance "$device_test_allowance" -maximum-test-execution-time-allowance "$device_test_allowance" \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testNonDulcetServerKeepsTheOriginalLibraryNavigation \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibrarySearchGroupsAndRecentQuerySurviveRelaunch \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testAlbumAddRemainsVisibleAtLargestTextOnIPhone \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testIPhoneLibrarySortShuffleAndArtistDepth \
        2>&1 | tee "$RUNNER_TEMP/dulcet-iphone-my-library.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-iphone-my-library.xcresult" \
        DulcetiOSUITests.DulcetMyLibraryUITests \
        testBrowseAddRemoveRelaunchAndOfflineReplay testNonDulcetServerKeepsTheOriginalLibraryNavigation testLibraryBrowseAndAlbumInLightDarkAndLargestText testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable testLibrarySearchGroupsAndRecentQuerySurviveRelaunch testAlbumAddRemainsVisibleAtLargestTextOnIPhone testIPhoneLibrarySortShuffleAndArtistDepth
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-iphone-my-library.xcresult" \
        "$RUNNER_TEMP/dulcet-iphone-my-library-junit/TEST-MyLibrary.xml" \
        DulcetMyLibraryIPhoneUITests
    xcrun xcresulttool export attachments \
        --test-id 'DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText()' \
        --path "$RUNNER_TEMP/dulcet-iphone-my-library.xcresult" \
        --output-path "$RUNNER_TEMP/dulcet-iphone-my-library-captures"
fi

if [ "$mode" = ipad ]; then
    python3 tools/ci/isolate-simulator --phase my-library-ipad --keep "${IPAD_UDID:?}" --settle --require-settle --settle-pressure --require-isolation \
        --warmup-app "$RUNNER_TEMP/DulcetiPadOSDerivedData/Build/Products/Debug-iphonesimulator/Dulcet DEV.app"
    # Post-boot destination discovery competes with the same burst as accessibility. Confirm the
    # build's original device only after pressure settles, before starting any proof allowance.
    confirmed_ipad="$(python3 tools/resolve-ipad-destination --print udid)"
    if [ "$confirmed_ipad" != "$IPAD_UDID" ]; then
        echo "Booted iPad destination changed: expected=$IPAD_UDID resolved=$confirmed_ipad" >&2
        exit 1
    fi
    xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme DulcetiOS -configuration Debug \
        -destination "platform=iOS Simulator,id=${IPAD_UDID:?}" \
        -derivedDataPath "$RUNNER_TEMP/DulcetiPadOSDerivedData" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ipad-my-library.xcresult" \
        -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance "$device_test_allowance" -maximum-test-execution-time-allowance "$device_test_allowance" \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testNonDulcetServerKeepsTheOriginalLibraryNavigation \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable \
        -only-testing:DulcetiOSUITests/DulcetMyLibraryUITests/testLibrarySearchGroupsAndRecentQuerySurviveRelaunch \
        2>&1 | tee "$RUNNER_TEMP/dulcet-ipad-my-library.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-ipad-my-library.xcresult" \
        DulcetiOSUITests.DulcetMyLibraryUITests \
        testBrowseAddRemoveRelaunchAndOfflineReplay testNonDulcetServerKeepsTheOriginalLibraryNavigation testLibraryBrowseAndAlbumInLightDarkAndLargestText testLibraryDepthPinSurvivesRelaunchAndOfflineDestinationsRemainReachable testLibrarySearchGroupsAndRecentQuerySurviveRelaunch
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ipad-my-library.xcresult" \
        "$RUNNER_TEMP/dulcet-ipad-my-library-junit/TEST-MyLibrary.xml" \
        DulcetMyLibraryIPadUITests
    xcrun xcresulttool export attachments \
        --test-id 'DulcetMyLibraryUITests/testLibraryBrowseAndAlbumInLightDarkAndLargestText()' \
        --path "$RUNNER_TEMP/dulcet-ipad-my-library.xcresult" \
        --output-path "$RUNNER_TEMP/dulcet-ipad-my-library-captures"
fi
