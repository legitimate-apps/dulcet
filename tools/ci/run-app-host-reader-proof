    }
    # A simulator test process does not inherit this shell's environment: TEST_RUNNER_-prefixed
    # variables in xcodebuild's own environment arrive with the prefix stripped. They reuse the
    # products the library-sync simulator proofs ran from.
    export TEST_RUNNER_DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533
    export TEST_RUNNER_DULCET_CONFORMANCE_DISPOSABLE=true
    export TEST_RUNNER_DULCET_LYRICS_FAULT_PROXY_URL="$proxy_url"
    allowance=(-test-timeouts-enabled YES -default-test-execution-time-allowance 300 -maximum-test-execution-time-allowance 300)
