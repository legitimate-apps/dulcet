    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ios-reader-conf76.xcresult" \
        "$RUNNER_TEMP/dulcet-ios-reader-conf76-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests
    xcodebuild test-without-building "${iphone[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ios-reader-conf77.xcresult" \
        -only-testing:DulcetKeychainIOSTests/DulcetReaderCountedAppTests/testConf77AReconnectFlushesReadsTheEpochRevalidatesTheVisibleScreenAndNothingElseOnIPhone 2>&1 |
