    python3 tools/ci/isolate-simulator --phase reader-counted-iphone --keep-name "iPhone 17 Pro"
    xcodebuild test-without-building "${iphone[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ios-reader-conf76.xcresult" \
