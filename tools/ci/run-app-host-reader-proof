        "$RUNNER_TEMP/dulcet-ios-reader-conf77-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests
    xcodebuild test-without-building "${iphone[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ios-reader-conf86.xcresult" \
        -only-testing:DulcetKeychainIOSTests/DulcetReaderCountedAppTests/testConf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveOnIPhone 2>&1 |
        tee "$RUNNER_TEMP/dulcet-ios-reader-conf86.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-ios-reader-conf86.xcresult" \
        DulcetKeychainIOSTests.DulcetReaderCountedAppTests \
        testConf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveOnIPhone
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ios-reader-conf86.xcresult" \
        "$RUNNER_TEMP/dulcet-ios-reader-conf86-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests

    python3 tools/ci/isolate-simulator --phase reader-counted-ipad --keep "$ipad_udid"
    xcodebuild test-without-building "${ipad[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ipados-reader-conf76.xcresult" \
        -only-testing:DulcetKeychainIOSTests/DulcetReaderCountedAppTests/testConf76ACachedOpenPublishesBeforeAnyAnswerOnIPadOS 2>&1 |
        tee "$RUNNER_TEMP/dulcet-ipados-reader-conf76.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf76.xcresult" \
        DulcetKeychainIOSTests.DulcetReaderCountedAppTests \
        testConf76ACachedOpenPublishesBeforeAnyAnswerOnIPadOS
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf76.xcresult" \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf76-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests
    xcodebuild test-without-building "${ipad[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ipados-reader-conf77.xcresult" \
        -only-testing:DulcetKeychainIOSTests/DulcetReaderCountedAppTests/testConf77AReconnectFlushesReadsTheEpochRevalidatesTheVisibleScreenAndNothingElseOnIPadOS 2>&1 |
        tee "$RUNNER_TEMP/dulcet-ipados-reader-conf77.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf77.xcresult" \
        DulcetKeychainIOSTests.DulcetReaderCountedAppTests \
        testConf77AReconnectFlushesReadsTheEpochRevalidatesTheVisibleScreenAndNothingElseOnIPadOS
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf77.xcresult" \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf77-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests
    xcodebuild test-without-building "${ipad[@]}" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-ipados-reader-conf86.xcresult" \
        -only-testing:DulcetKeychainIOSTests/DulcetReaderCountedAppTests/testConf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveOnIPadOS 2>&1 |
        tee "$RUNNER_TEMP/dulcet-ipados-reader-conf86.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf86.xcresult" \
        DulcetKeychainIOSTests.DulcetReaderCountedAppTests \
        testConf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveOnIPadOS
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf86.xcresult" \
        "$RUNNER_TEMP/dulcet-ipados-reader-conf86-junit/TEST-DulcetKeychainIOSTests.xml" \
        DulcetKeychainIOSTests
    exit 0
fi

if [ "$mode" = tvos ]; then
