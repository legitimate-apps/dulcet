#!/bin/bash
# Run one Apple reader proof (library.browse, spec §16.14 and §16.18) against the disposable server
# and turn its result bundle into cited evidence.
#
# A file rather than inline YAML for the reason tools/ci/run-app-host-library-sync-proof gives: the
# "Assert Darwin conformance preconditions" step is already the largest `run:` block in apple-ci,
# and GitHub's remedy for a block that grows too large is to extract it. It must run INSIDE that
# step, because the disposable server's lifetime is that step's shell.
#
# Usage:
#   run-app-host-reader-proof macos
#   run-app-host-reader-proof ipados <ipad-simulator-destination>
#   run-app-host-reader-proof iphone
#   run-app-host-reader-proof counted-simulators <ipad-simulator-udid>
#   run-app-host-reader-proof tvos
#
# One mode per call, so each proof keeps its own position in the calling step's sequence. The two
# simulator proofs connect through the app's debug launch hook and then relaunch with the account
# saved; earlier phases on the same device already leave a saved account and a seen-cache behind,
# and the proof starts from its own connect whatever they left. Each simulator proof is its own
# test method that fails on the other idiom and window class, so an iPhone run cannot stand as
# iPad evidence.
#
# `macos` and `counted-simulators` also run the counted proofs (CONF-76, CONF-77, CONF-86): app-host
# tests whose account's server is the fault proxy the calling step starts beside the disposable
# server, so the proxy's log is everything the app sent, and its hold and fail rules make a read
# late or failed on purpose (each proof clears them, pass or fail). One proof per result bundle,
# because the execution guard requires exactly one. `counted-simulators` runs them in the iOS app
# host on the iPhone and then the iPad, each method failing on the other device class.
#
# `tvos` runs the same three counted proofs in the Apple TV app host, then the Apple TV saved-account
# proof: a UI test that favourites an album by remote, relaunches with the account saved and no
# account hook into Library from what this device saw, searches there, and reconnects in place. Each
# method fails on any device class but Apple TV. It reuses the products the tvOS search proof built.

set -euo pipefail

: "${RUNNER_TEMP:?RUNNER_TEMP must be set}"

mode="${1:-}"
case "$mode" in
    macos|iphone)
        [ "$#" -eq 1 ] || { echo "run-app-host-reader-proof $mode: takes no further arguments" >&2; exit 2; }
        ;;
    ipados)
        [ "$#" -eq 2 ] || { echo "run-app-host-reader-proof ipados: needs the iPad destination" >&2; exit 2; }
        ipad_destination="$2"
        ;;
    counted-simulators)
        [ "$#" -eq 2 ] || { echo "run-app-host-reader-proof counted-simulators: needs the iPad simulator's UDID" >&2; exit 2; }
        ipad_udid="$2"
        ;;
    tvos)
        [ "$#" -eq 1 ] || { echo "run-app-host-reader-proof tvos: takes no further arguments" >&2; exit 2; }
        ;;
    *)
        echo "run-app-host-reader-proof: mode must be 'macos', 'ipados', 'iphone', 'counted-simulators' or 'tvos', got '${mode}'" >&2
        exit 2
        ;;
esac

# The execution guard comes BEFORE junit generation in every mode: `swift-testing-junit` writes a
# well-formed tests="0" file for an empty bundle, so a renamed or silently-matching-nothing test
# would otherwise ship green. Each JUnit path is spelled out in full because
# tools/verify_ci_policy.py greps for `$RUNNER_TEMP/<name>-junit/` to prove every directory
# verify-parity-evidence reads is written by something.

if [ "$mode" = macos ]; then
    # A macOS host test does not inherit xcodebuild's environment, so the disposable-server
    # contract is passed both as shell environment and as build settings, as the other macOS
    # app-host proofs do. It reuses the product the first macOS app-host proof built.
    DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 \
        DULCET_CONFORMANCE_DISPOSABLE=true \
        xcodebuild test-without-building \
            -project apple/Dulcet.xcodeproj \
            -scheme DulcetMac \
            -configuration Debug \
            -destination 'platform=macOS' \
            -derivedDataPath "$RUNNER_TEMP/DulcetMacAppTestDerivedData" \
            -resultBundlePath "$RUNNER_TEMP/dulcet-mac-reader-test.xcresult" \
            -parallel-testing-enabled NO \
            -only-testing:DulcetMacTests/DulcetMacAccountConnectAppTest/readerLibraryPaintsLiveThenReopensFromWhatThisDeviceSaw \
            CODE_SIGN_STYLE=Manual \
            CODE_SIGN_IDENTITY=- \
            CODE_SIGN_ENTITLEMENTS= \
            DEVELOPMENT_TEAM= \
            PROVISIONING_PROFILE_SPECIFIER= \
            DULCET_TEST_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 \
            DULCET_TEST_CONFORMANCE_DISPOSABLE=true 2>&1 |
        tee "$RUNNER_TEMP/dulcet-mac-reader-test.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-mac-reader-test.xcresult" \
        DulcetMacTests.DulcetMacAccountConnectAppTest \
        readerLibraryPaintsLiveThenReopensFromWhatThisDeviceSaw
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-mac-reader-test.xcresult" \
        "$RUNNER_TEMP/dulcet-mac-reader-test-junit/TEST-DulcetMacAccountConnectAppTest.xml" \
        DulcetMacAccountConnectAppTest

    # The counted proofs (see the header).
    proxy_url=http://127.0.0.1:4544
    curl --fail --silent "$proxy_url/__dulcet/health" >/dev/null || {
        echo "run-app-host-reader-proof: the fault proxy does not answer on $proxy_url" >&2
        exit 1
    }
    export DULCET_LYRICS_FAULT_PROXY_URL="$proxy_url"
    counted=(
        -project apple/Dulcet.xcodeproj -scheme DulcetMac -configuration Debug -destination 'platform=macOS'
        -derivedDataPath "$RUNNER_TEMP/DulcetMacAppTestDerivedData" -parallel-testing-enabled NO
        -test-timeouts-enabled YES -default-test-execution-time-allowance 300 -maximum-test-execution-time-allowance 300
        CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- CODE_SIGN_ENTITLEMENTS= DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER=
        DULCET_TEST_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 DULCET_TEST_CONFORMANCE_DISPOSABLE=true
        DULCET_TEST_LYRICS_FAULT_PROXY_URL="$proxy_url"
    )
    DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 DULCET_CONFORMANCE_DISPOSABLE=true \
        xcodebuild test-without-building "${counted[@]}" \
            -resultBundlePath "$RUNNER_TEMP/dulcet-mac-reader-conf76.xcresult" \
            -only-testing:DulcetMacTests/DulcetMacReaderCountedAppTest/conf76ACachedOpenPublishesBeforeAnyAnswerThroughTheHostedMacApp 2>&1 |
        tee "$RUNNER_TEMP/dulcet-mac-reader-conf76.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-mac-reader-conf76.xcresult" \
        DulcetMacTests.DulcetMacReaderCountedAppTest \
        conf76ACachedOpenPublishesBeforeAnyAnswerThroughTheHostedMacApp
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-mac-reader-conf76.xcresult" \
        "$RUNNER_TEMP/dulcet-mac-reader-conf76-junit/TEST-DulcetMacReaderCountedAppTest.xml" \
        DulcetMacReaderCountedAppTest
    DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 DULCET_CONFORMANCE_DISPOSABLE=true \
        xcodebuild test-without-building "${counted[@]}" \
            -resultBundlePath "$RUNNER_TEMP/dulcet-mac-reader-conf77.xcresult" \
            -only-testing:DulcetMacTests/DulcetMacReaderCountedAppTest/conf77AReconnectFlushesReadsTheEpochRevalidatesTheVisibleScreenAndNothingElseThroughTheHostedMacApp 2>&1 |
        tee "$RUNNER_TEMP/dulcet-mac-reader-conf77.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-mac-reader-conf77.xcresult" \
        DulcetMacTests.DulcetMacReaderCountedAppTest \
        conf77AReconnectFlushesReadsTheEpochRevalidatesTheVisibleScreenAndNothingElseThroughTheHostedMacApp
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-mac-reader-conf77.xcresult" \
        "$RUNNER_TEMP/dulcet-mac-reader-conf77-junit/TEST-DulcetMacReaderCountedAppTest.xml" \
        DulcetMacReaderCountedAppTest
    DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533 DULCET_CONFORMANCE_DISPOSABLE=true \
        xcodebuild test-without-building "${counted[@]}" \
            -resultBundlePath "$RUNNER_TEMP/dulcet-mac-reader-conf86.xcresult" \
            -only-testing:DulcetMacTests/DulcetMacReaderCountedAppTest/conf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveThroughTheHostedMacApp 2>&1 |
        tee "$RUNNER_TEMP/dulcet-mac-reader-conf86.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-mac-reader-conf86.xcresult" \
        DulcetMacTests.DulcetMacReaderCountedAppTest \
        conf86HomeRowsPublishIndependentlyAndOneFailureLeavesTheOthersLiveThroughTheHostedMacApp
    python3 tools/swift-testing-junit \
        "$RUNNER_TEMP/dulcet-mac-reader-conf86.xcresult" \
        "$RUNNER_TEMP/dulcet-mac-reader-conf86-junit/TEST-DulcetMacReaderCountedAppTest.xml" \
        DulcetMacReaderCountedAppTest
    exit 0
fi

if [ "$mode" = counted-simulators ]; then
    proxy_url=http://127.0.0.1:4544
    curl --fail --silent "$proxy_url/__dulcet/health" >/dev/null || {
