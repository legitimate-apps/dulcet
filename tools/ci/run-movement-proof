#!/bin/bash
# One diagnostic job: trace, three independent original suites, then gated position measurement.
set -euo pipefail
sources=(apple/DulcetKit/Sources/DulcetKit/DulcetMyLibraryViews.swift apple/DulcetKit/Sources/DulcetKit/DulcetLibraryReading.swift apple/DulcetMyLibraryUITestSupport/DulcetMyLibraryUITests.swift)
build() {
 xcodebuild build-for-testing -project apple/Dulcet.xcodeproj -scheme DulcetiOS -configuration Debug \
  -destination 'platform=iOS Simulator,name=iPhone 18 Pro,OS=latest' -derivedDataPath "$RUNNER_TEMP/DulcetiOSDerivedData" > "$RUNNER_TEMP/movement-$1-build.log" 2>&1
 python3 tools/ci/stop-build-daemons
}
set +e
tools/ci/run-movement-case trace
trace_exit=$?
set -e
printf 'MOVEMENT TRACE exit=%s\n' "$trace_exit"
python3 tools/ci/summarize-library-movement "$RUNNER_TEMP" trace
# Clean production app and original tests. No trace modifiers, logging or extra measurement steps.
git restore --source=d60b1e72 --worktree -- "${sources[@]}"
git diff --exit-code d60b1e72 -- "${sources[@]}"
git hash-object "${sources[@]}" > "$RUNNER_TEMP/movement-clean-source-hashes.log"
build clean
for iteration in 1 2 3; do
 set +e
 tools/ci/run-my-library-proofs iphone
 result=$?
 set -e
 xcrun xcresulttool get test-results summary --path "$RUNNER_TEMP/dulcet-iphone-my-library.xcresult" > "$RUNNER_TEMP/movement-clean-$iteration-summary.json"
 printf '%s\n' "$result" > "$RUNNER_TEMP/movement-clean-$iteration-exit.log"
 python3 - "$RUNNER_TEMP" "$iteration" <<'PY'
import json,pathlib,sys
p=pathlib.Path(sys.argv[1]);n=sys.argv[2]
s=json.loads((p/f'movement-clean-{n}-summary.json').read_text())
print('MOVEMENT CLEAN',n,json.dumps({k:s[k] for k in ['totalTestCount','passedTests','failedTests','skippedTests']}))
for x in p.glob('dulcet-iphone-my-library*'):
 x.rename(p/('movement-clean-'+n+x.name.removeprefix('dulcet-iphone-my-library')))
PY
done
python3 - "$RUNNER_TEMP" <<'PY'
import json,pathlib,sys
p=pathlib.Path(sys.argv[1]);rows=[]
for n in range(1,4):
 s=json.loads((p/f'movement-clean-{n}-summary.json').read_text());e=int((p/f'movement-clean-{n}-exit.log').read_text())
 rows.append(dict(iteration=n,exit=e,**{k:s[k] for k in ['totalTestCount','passedTests','failedTests','skippedTests']}))
(p/'movement-clean-conclusions.json').write_text(json.dumps(rows,indent=2))
assert all(r['exit']==0 and r['totalTestCount']==7 and r['passedTests']==7 and r['failedTests']==0 and r['skippedTests']==0 for r in rows),rows
print('MOVEMENT CLEAN RESULT 3/3 suites passed, 21/21 original tests, zero skips')
PY
python3 - "$RUNNER_TEMP/movement-trace-geometry-summary.json" <<'PYTHON'
import json,sys
s=json.load(open(sys.argv[1]));assert s['rows']>0,s
assert s['maxResetsPerRoot']<=5,('Movement reset feedback loop',s['resetsPerRoot'])
PYTHON
# Restore the diagnostic build only after all original production cases passed three times.
git restore --source=HEAD --worktree -- "${sources[@]}"
build cost
tools/ci/run-movement-case cost
python3 - "$RUNNER_TEMP" <<'PY'
import json,pathlib,re,sys
p=pathlib.Path(sys.argv[1]);s=json.loads((p/'movement-cost-summary.json').read_text())
assert s['totalTestCount']==1 and s['passedTests']==1 and s['failedTests']==0 and s['skippedTests']==0,s
rows=[]
for l in (p/'movement-cost-live.log').read_text().splitlines():
 if 'MOVEMENT_PROOF ' not in l:continue
 raw=l.split('MOVEMENT_PROOF ',1)[1];raw=re.sub(r'\\([0-7]{3})',lambda m:chr(int(m[1],8)),raw)
 rows.append(json.loads(raw))
pairs=[r for r in rows if r['event']=='reset-after' and r['status']=='failure' and r['before']['distanceFromTop']>0 and r['before']['firstID']!='none' and r['sample']['firstID']!='none']
(p/'movement-cost-pairs.json').write_text(json.dumps(pairs,indent=2))
assert pairs,'No valid scrolled before/after pair; no cost claim'
print('MOVEMENT COST recorded scrolled pairs',len(pairs))
PY
