#!/usr/bin/env python3
"""Run finite native connection proofs on an ephemeral GitHub-hosted macOS runner.

Usage (inside multipath-fixture): run-connection-apple-proofs core|core-ios|core-tvos|mac|ios|tvos [SIMULATOR_UDID]
The fixture supplies DULCET_MULTIPATH_MANIFEST. Trust is installed only on the
explicitly guarded hosted runner. Finally deletes the exact fresh certificate; its
admin trust record expires when GitHub decommissions this job VM. No trust-all TLS.
"""
from __future__ import annotations

from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path
import plistlib
import shlex
import signal
import ssl
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[2]
CORE_CLASS = 'com.legitimateapps.dulcet.core.AppleConnectionOwnershipTest'
CORE_METHODS = ['mp03ReaderCacheAndQueuedValuesSurviveHeldOldPagesAndLostAcknowledgement',
                'mp01DarwinTlsAndLineageAdmissionKeepUnverifiedCandidatesCredentialFree',
                'mp02HttpEnrollmentAndFactoryRouteChangePreserveAllOwnedRowsAndFiles',
                'mp10RevokedPreparedRequestsAndRetiredHttpTasksStayClosed',
                'mp02AutomaticSelectorPreservesOwnedRowsAndFilesAcrossThreeListenersAndRelaunch']
APP_CLASS = 'DulcetAppleConnectionIntegrationTest'
APP_METHODS = ['testMP10PreservingHTTPSAdoptionNeverReturnsNativeEnginesToHTTP',
    'testMP04AdvancingAVPlayerRecoversThroughTheSelectorWithTheSameListen',
    'testMP04LegacyTranscodeRecoversWithAnAdvertisedOffsetAndAbsoluteMediaTime',
    'testMP04PausedLegacyTranscodeTryAgainPreservesTheCapabilityAwareRecovery',
    'testMP05CutExplicitAndAutomaticURLSessionDownloadsRestartWithTheSameIDsAndExactHashes',
    'testMP05RemovedRouteAndLateOldNativeDeliveryCannotPromoteOverItsReplacement',
    'testMP07BrowseAlbumLostAcknowledgementExpandsRetentionAndPlaysOffline']

CONTROLS_CLASS = 'DulcetMyLibraryUITests'
CONTROLS_METHODS = ['testMP09ConnectionsMatchAuthenticatedReceiptsAndRemoveReaddWithoutReplacingTheAccount',
    'testMP09UpgradeAndDifferentServerRefusalKeepTheSavedOwnershipAnchor']


def run(command, *, env=None, log=None):
    command = [str(value) for value in command]
    print('+ ' + shlex.join(command), flush=True)
    if log is None:
        subprocess.run(command, cwd=ROOT, env=env, check=True)
        return
    with Path(log).open('w') as output:
        process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True)
        try:
            for line in process.stdout:
                print(line, end='', flush=True)
                output.write(line)
            if process.wait():
                raise subprocess.CalledProcessError(process.returncode, command)
        except BaseException:
            process.terminate()
            process.wait(timeout=20)
            raise


SYSTEM_KEYCHAIN = '/Library/Keychains/System.keychain'
SECURITY_TIMEOUT_SECONDS = 30


def require_hosted_runner():
    if os.environ.get('GITHUB_ACTIONS') != 'true' or os.environ.get('RUNNER_ENVIRONMENT') != 'github-hosted' or sys.platform != 'darwin':
        raise SystemExit('Fixture trust requires an ephemeral GitHub-hosted macOS runner; local/shared Mac execution is refused')


def security_command(*arguments):
    command = ['sudo', '-n', 'security', *map(str, arguments)]
    print('+ ' + shlex.join(command), flush=True)
    return subprocess.run(command, check=True, timeout=SECURITY_TIMEOUT_SECONDS)


@contextmanager
def fixture_trust(ca, simulator=None):
    require_hosted_runner()
    # Hash the exact fresh certificate, never a common name shared with another fixture.
    der = ssl.PEM_cert_to_DER_cert(ca.read_text())
    fingerprint = hashlib.sha1(der).hexdigest().upper()
    try:
        # Installed security(1): -d selects the admin trust domain; -k selects certificate
        # storage. Noninteractive sudo avoids the user-domain SecurityAgent prompt.
        security_command('add-trusted-cert', '-d', '-r', 'trustRoot', '-k', SYSTEM_KEYCHAIN, ca)
        if simulator:
            subprocess.run(['xcrun', 'simctl', 'keychain', simulator, 'add-root-cert', str(ca)],
                           check=True, timeout=SECURITY_TIMEOUT_SECONDS)
        yield
    finally:
        active_failure = sys.exc_info()[0] is not None
        failures = []
        cleanup = []
        if simulator:
            cleanup.append(lambda: subprocess.run(['xcrun', 'simctl', 'keychain', simulator, 'reset'],
                                                 check=True, timeout=SECURITY_TIMEOUT_SECONDS))
        # Removing the last admin trust entry requires interactive authorization even
        # as root. Do not alter that protected macOS policy. Delete only this exact fresh
        # certificate here; the residual admin trust record lasts until job VM teardown.
        # GitHub provisions a fresh VM per hosted job and automatically decommissions it:
        # https://docs.github.com/en/actions/how-tos/manage-runners/github-hosted-runners/use-github-hosted-runners
        # The enclosing multipath-fixture finally stops its servers and deletes all of
        # its fresh signing keys. This helper must never run on a local/shared runner.
        print('CONNECTIONS APPLE trust lifecycle=job-vm; residual admin trust ends at GitHub VM decommission', flush=True)
        cleanup.append(lambda: security_command('delete-certificate', '-Z', fingerprint, SYSTEM_KEYCHAIN))
        for action in cleanup:
            try:
                action()
            except (OSError, subprocess.SubprocessError) as failure:
                failures.append(failure)
                print('CONNECTIONS APPLE trust cleanup failed=' + type(failure).__name__, flush=True)
        if failures and not active_failure:
            raise RuntimeError('Fixture trust cleanup failed') from failures[0]


def inject_manifest(node, values):
    count = 0
    if isinstance(node, dict):
        if 'TestBundlePath' in node:
            for key in ('EnvironmentVariables', 'TestHostEnvironmentVariables'):
                node.setdefault(key, {}).update(values)
            count += 1
        for value in node.values():
            count += inject_manifest(value, values)
    elif isinstance(node, list):
        for value in node:
            count += inject_manifest(value, values)
    return count


def execute(mode, simulator, env, work, manifest):
    if mode in ('core', 'core-ios', 'core-tvos'):
        task, property_name = {'core': ('macosArm64Test', None),
            'core-ios': ('iosSimulatorArm64Test', 'dulcet.iosSimulatorUdid'),
            'core-tvos': ('tvosSimulatorArm64Test', 'dulcet.tvosSimulatorUdid')}[mode]
        native_env = dict(env)
        if property_name:
            if not simulator: raise RuntimeError('A concrete native core simulator is required')
            for key in ('DULCET_MULTIPATH_MANIFEST', 'DULCET_CONNECTIONS_SEED'):
                native_env['SIMCTL_CHILD_' + key] = env[key]
        run([ROOT/'gradlew', '--no-daemon', '--no-configuration-cache', ':core:' + task,
             '--tests', CORE_CLASS, '--rerun-tasks',
             *([f'-P{property_name}={simulator}'] if property_name else [])],
            env=native_env, log=work/'core.log')
        run([sys.executable, ROOT/'tools/ci/verify-connection-results',
             ROOT/'core/build/test-results'/task, CORE_CLASS, *CORE_METHODS])
        return
    scheme, target, platform = {'mac': ('DulcetPlaybackIntegration', 'DulcetPlaybackIntegrationTests', 'macOS'),
        'ios': ('DulcetiOSDownloadIntegration', 'DulcetiOSDownloadIntegrationTests', 'iOS Simulator'),
        'tvos': ('DulcetTVConnectionIntegration', 'DulcetTVConnectionIntegrationTests', 'tvOS Simulator')}[mode]
    methods = [method for method in APP_METHODS if method.startswith('testMP04')] if mode == 'tvos' else APP_METHODS
    destination = 'platform=macOS' if mode == 'mac' else f'platform={platform},id={simulator}'
    derived = work/'DerivedData'
    common = ['-configuration', 'Debug', '-destination', destination,
              '-derivedDataPath', str(derived), '-parallel-testing-enabled', 'NO']
    run(['xcodebuild', 'build-for-testing', '-project', ROOT/'apple/Dulcet.xcodeproj',
         '-scheme', scheme, *common, 'CODE_SIGN_STYLE=Manual', 'CODE_SIGN_IDENTITY=-',
         'CODE_SIGN_ENTITLEMENTS=', 'DEVELOPMENT_TEAM=', 'PROVISIONING_PROFILE_SPECIFIER='],
        env=env, log=work/'build.log')
    manifests = list((derived/'Build/Products').glob('*.xctestrun'))
    if len(manifests) != 1:
        raise RuntimeError(f'Expected one fresh native test manifest, found {len(manifests)}')
    document = plistlib.loads(manifests[0].read_bytes())
    values = {'DULCET_MULTIPATH_MANIFEST': env['DULCET_MULTIPATH_MANIFEST'],
              'DULCET_MULTIPATH_MANIFEST_JSON': json.dumps(manifest, separators=(',', ':')),
              'DULCET_CONNECTIONS_SEED': env['DULCET_CONNECTIONS_SEED']}
    if inject_manifest(document, values) < 1:
        raise RuntimeError('No app-hosted test target found for fixture environment injection')
    # Keep it beside the original: xcodebuild resolves product paths relative to this file.
    launch = manifests[0].with_name('ConnectionsFixture.xctestrun')
    launch.write_bytes(plistlib.dumps(document))
    execute_transport_cases(mode, target, methods, destination, launch, env, work)
    if mode == 'mac':
        # Exercise the ordinary production factory as well as fixture-injected MP-04 requests.
        result = work/'production-origin.xcresult'
        identity = 'DulcetPlaybackIntegrationTests'
        method = 'testProductionPlaybackOmitsFixtureOriginUnlessExplicitlyInjected'
        run(['xcodebuild', 'test-without-building', '-xctestrun', launch,
             '-destination', destination, '-parallel-testing-enabled', 'NO',
             '-resultBundlePath', result, f'-only-testing:{target}/{identity}/{method}'],
            env=env, log=work/'production-origin-test.log')
        run([sys.executable, ROOT/'tools/swift-testing-junit', result,
             work/'junit/TEST-ProductionOrigin.xml', identity])
        run([sys.executable, ROOT/'tools/verify-xcode-test-execution', result,
             f'{target}.{identity}', method])


def execute_transport_cases(mode, target, methods, destination, launch, env, work):
    # The process-wide selector deliberately keys by ownership base and username. Most cases
    # enroll the same fixture account, while MP-10 needs its real pre-enrollment HTTP state.
    # A separate XCTest process isolates that legacy baseline without changing production state.
    legacy = 'testMP10PreservingHTTPSAdoptionNeverReturnsNativeEnginesToHTTP'
    if mode != 'tvos' and methods.count(legacy) != 1:
        raise RuntimeError('Native connection proof selection must contain exactly one MP-10 legacy baseline')
    groups = [('connections', methods)] if mode == 'tvos' else [
        ('connections-mp10', [legacy]),
        ('connections-main', [method for method in methods if method != legacy]),
    ]
    result = work/'connections.xcresult'
    failures = []
    bundles = []
    for name, selected in groups:
        bundle = work/(name + '.xcresult')
        bundles.append(bundle)
        try:
            run(['xcodebuild', 'test-without-building', '-xctestrun', launch,
                 '-destination', destination, '-parallel-testing-enabled', 'NO',
                 '-resultBundlePath', bundle,
                 '-test-timeouts-enabled', 'YES', '-default-test-execution-time-allowance', '300',
                 '-maximum-test-execution-time-allowance', '300',
                 *[f'-only-testing:{target}/{APP_CLASS}/{method}' for method in selected]],
                env=env, log=work/('test.log' if name == 'connections' else name + '-test.log'))
        except subprocess.CalledProcessError as failure:
            failures.append(failure)
    if len(bundles) > 1:
        # Merge the actual result bundles so the existing exact-test verifier and JUnit reader
        # still require all seven individual identities, counts and terminal results together.
        run(['xcrun', 'xcresulttool', 'merge', '--output-path', result, *bundles], log=work/'connections-merge.log')
    if result.exists():
        run(['xcrun', 'xcresulttool', 'get', 'test-results', 'summary', '--path', result],
            log=work/'connections-summary.json')
    run([sys.executable, ROOT/'tools/swift-testing-junit', result,
         work/'junit/TEST-AppleConnections.xml', APP_CLASS])
    run([sys.executable, ROOT/'tools/verify-xcode-test-execution', result,
         f'{target}.{APP_CLASS}', *methods])
    if failures:
        raise failures[0]


def execute_controls(mode, simulator, env, work, manifest):
    """Exercise the existing production UI targets, with the same isolated CA lifecycle."""
    scheme, target, platform = {
        'mac': ('DulcetMac', 'DulcetMacUITests', 'macOS'),
        'ios': ('DulcetiOS', 'DulcetiOSUITests', 'iOS Simulator'),
        'tvos': ('DulcetTV', 'DulcetTVUITests', 'tvOS Simulator'),
    }[mode]
    destination = 'platform=macOS' if mode == 'mac' else f'platform={platform},id={simulator}'
    derived = work/'ControlsDerivedData'
    selection = [f'-only-testing:{target}/{CONTROLS_CLASS}/{method}' for method in CONTROLS_METHODS]
    values = {'DULCET_MULTIPATH_MANIFEST_JSON': json.dumps(manifest, separators=(',', ':'))}
    # The runner and UI-launched app are different processes. xcodebuild's TEST_RUNNER prefix
    # reaches XCTest; xctestrun injection covers the per-target environment as well.
    ui_env = dict(env, **{'TEST_RUNNER_'+key: value for key, value in values.items()})
    common = ['-configuration', 'Debug', '-destination', destination,
              '-derivedDataPath', str(derived), '-parallel-testing-enabled', 'NO']
    run(['xcodebuild', 'build-for-testing', '-project', ROOT/'apple/Dulcet.xcodeproj',
         '-scheme', scheme, *common, *selection, 'CODE_SIGN_STYLE=Manual', 'CODE_SIGN_IDENTITY=-',
         'CODE_SIGN_ENTITLEMENTS=', 'DEVELOPMENT_TEAM=', 'PROVISIONING_PROFILE_SPECIFIER='],
        env=ui_env, log=work/'controls-build.log')
    manifests = list((derived/'Build/Products').glob('*.xctestrun'))
    if len(manifests) != 1:
        raise RuntimeError(f'Expected one fresh UI test manifest, found {len(manifests)}')
    document = plistlib.loads(manifests[0].read_bytes())
    if inject_manifest(document, values) < 1:
        raise RuntimeError('No UI test target found for fixture environment injection')
    launch = manifests[0].with_name('ConnectionsControlsFixture.xctestrun')
    launch.write_bytes(plistlib.dumps(document))
    result = work/'controls.xcresult'
    try:
        run(['xcodebuild', 'test-without-building', '-xctestrun', launch,
             '-destination', destination, '-parallel-testing-enabled', 'NO', '-resultBundlePath', result,
             '-test-timeouts-enabled', 'YES', '-default-test-execution-time-allowance', '300',
             '-maximum-test-execution-time-allowance', '300', *selection], env=ui_env, log=work/'controls-test.log')
    finally:
        if result.exists():
            run(['xcrun', 'xcresulttool', 'export', 'attachments', '--path', result,
                 '--output-path', work/'controls-captures'])
    run([sys.executable, ROOT/'tools/verify-xcode-test-execution', result,
         f'{target}.{CONTROLS_CLASS}', *CONTROLS_METHODS])
    run([sys.executable, ROOT/'tools/swift-testing-junit', result,
         work/'junit/TEST-AppleConnectionsControls.xml', CONTROLS_CLASS])
    print(f'CONNECTIONS APPLE MP-09 mode={mode} ui-tests={len(CONTROLS_METHODS)} skipped=0', flush=True)


def execute_required_proofs(mode, simulator, env, work, manifest):
    # Collect MP-09 even when a transport assertion fails, while keeping both mandatory.
    failures = []
    actions = [('transport', execute)] if mode.startswith('core') else [('transport', execute), ('controls', execute_controls)]
    for name, action in actions:
        try:
            action(mode, simulator, env, work, manifest)
        except subprocess.CalledProcessError as failure:
            failures.append(failure)
            print(f'CONNECTIONS APPLE required proof failed={name} exit={failure.returncode}', flush=True)
    if failures:
        raise failures[0]


def main():
    args = sys.argv[1:]
    if not args or args[0] not in ('core', 'core-ios', 'core-tvos', 'mac', 'ios', 'tvos') or len(args) != (2 if args[0] in ('ios', 'tvos', 'core-ios', 'core-tvos') else 1):
        raise SystemExit('usage: run-connection-apple-proofs core|core-ios|core-tvos|mac|ios|tvos [SIMULATOR_UDID]')
    require_hosted_runner()
    mode = args[0]
    simulator = args[1] if mode in ('ios', 'tvos', 'core-ios', 'core-tvos') else None
    runner = Path(os.environ['RUNNER_TEMP']).resolve()
    manifest_path = Path(os.environ['DULCET_MULTIPATH_MANIFEST']).resolve()
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('standard') != 'dulcet-multipath-fixture' or manifest.get('disposable') is not True or not manifest.get('nonce'):
        raise SystemExit('A validated disposable multipath fixture is required')
    from urllib.parse import urlparse
    for key in ('routeA', 'routeB'):
        value = urlparse(manifest[key])
        if value.scheme != 'https' or value.hostname != 'localhost':
            raise SystemExit('Fixture routes must be HTTPS localhost listeners')
    if manifest.get('phase') != 2:
        raise SystemExit('The phase-2 three-listener fixture is required')
    ca = Path(manifest['caPem']).resolve()
    if not ca.is_relative_to(manifest_path.parent) or not manifest_path.is_relative_to(runner) or not ca.is_file():
        raise SystemExit('The fresh fixture manifest and CA must live together under RUNNER_TEMP')
    work = Path(tempfile.mkdtemp(prefix=f'dulcet-connections-{mode}-', dir=runner))
    print(f'CONNECTIONS APPLE evidence={work}', flush=True)
    env = dict(os.environ, DULCET_CONNECTIONS_SEED=str(ROOT/'tools/migration-fixtures/v15'))
    with fixture_trust(ca, simulator):
        execute_required_proofs(mode, simulator, env, work, manifest)



if __name__ == '__main__':
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(SystemExit(143)))
    main()
