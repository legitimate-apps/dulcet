#!/usr/bin/env python3
"""Preserve one bounded thread snapshot if a CI Gradle invocation runs unusually long.

This observes, never retries or times out, the command. Only JVMs descended from that
command are eligible. The workflow's existing job deadline remains the execution limit.
"""
import argparse
from pathlib import Path
import signal
import subprocess
import sys
import threading


def descendants(root):
    rows = subprocess.check_output(["ps", "-eo", "pid=,ppid="], text=True, timeout=5)
    parents = {int(pid): int(parent) for pid, parent in (row.split() for row in rows.splitlines())}
    owned = {root}
    while True:
        expanded = owned | {pid for pid, parent in parents.items() if parent in owned}
        if expanded == owned:
            return owned
        owned = expanded


def observe(root, output, done, delay, tool_timeout):
    if done.wait(delay):
        return
    output.mkdir(parents=True, exist_ok=True)
    try:
        eligible = descendants(root)
        listing = subprocess.run(["jps", "-q"], text=True, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, timeout=tool_timeout)
        (output / "jps.txt").write_text(listing.stdout)
        if listing.returncode != 0:
            raise RuntimeError(f"jps exited {listing.returncode}")
        pids = sorted({int(line) for line in listing.stdout.splitlines() if line.isdigit()} & eligible)
        (output / "owned-jvm-pids.txt").write_text("\n".join(map(str, pids)) + "\n")
        for pid in pids:
            if done.is_set():
                break
            with (output / f"threads-{pid}.txt").open("w") as stream:
                try:
                    result = subprocess.run(["jcmd", str(pid), "Thread.print"], stdout=stream,
                                            stderr=subprocess.STDOUT, timeout=tool_timeout)
                    stream.write(f"\nDIAGNOSTIC exit={result.returncode}\n")
                except subprocess.TimeoutExpired:
                    stream.write("\nDIAGNOSTIC tool timed out; observed command remains untouched\n")
    except Exception as error:
        # A missing/failed diagnostic tool must not replace the build's actual exit status.
        (output / "capture-error.txt").write_text(f"{type(error).__name__}: {error}\n")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--after-seconds", type=float, default=480)
    parser.add_argument("--tool-timeout", type=float, default=10)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or args.after_seconds <= 0 or args.tool_timeout <= 0:
        parser.error("a command and positive diagnostic intervals are required")
    process = subprocess.Popen(command)
    done = threading.Event()
    worker = threading.Thread(target=observe, args=(process.pid, args.output, done,
                              args.after_seconds, args.tool_timeout), daemon=True)
    worker.start()
    # Let runner cancellation reach the observed command, then retain its exit status.
    def forward(signum, _frame):
        if process.poll() is None:
            process.send_signal(signum)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)
    try:
        result = process.wait()
    finally:
        done.set()
        worker.join()
    return result if result >= 0 else 128 - result


if __name__ == "__main__":
    sys.exit(main())
