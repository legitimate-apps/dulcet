#!/usr/bin/env python3
"""Experiment-only ref, not for merge: simulator apsd A/B/A, Refs #343. Never targets host launchd.

Equal idle A/B/A windows precede warm-up. Consecutive A/B/A comparisons run the
unchanged browse/relaunch/offline method against fresh fixtures. The original full
My Library suite follows with apsd restored. Comparisons never replace a failed proof.
No live log consumer is attached: persisted log replay happens after all idle windows.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import runpy
import signal
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
PRESSURE = runpy.run_path(str(HERE / 'host-pressure'))
ISOLATE = runpy.run_path(str(HERE / 'isolate-simulator'))
WINDOW_SECONDS = 60
POLL_SECONDS = 5


def emit(output: Path, **record) -> None:
    record = dict(wallTimeMillis=time.time_ns() // 1_000_000, **record)
    with (output / 'experiment.jsonl').open('a') as handle:
        handle.write(json.dumps(record, separators=(',', ':')) + '\n')
    print('APSD EXPERIMENT ' + json.dumps(record, separators=(',', ':')), flush=True)


def mark(name: str) -> None:
    if path := os.environ.get('DULCET_HOST_PRESSURE_LOG'):
        PRESSURE['mark'](path, name)


def simctl(*args) -> str:
    result = ISOLATE['simctl'](*args, timeout=120)
    result.check_returncode()
    return result.stdout.strip()


def identity(process: dict) -> tuple:
    return process['pid'], process['started'], process['executable']


def find_target(udid: str, witness=lambda **record: None) -> dict:
    # Device-scoped launchctl selects the PID. A runtime path alone would not distinguish
    # two simulators sharing a runtime. Neither a host PID nor a bare basename is accepted.
    if ISOLATE['booted'](ISOLATE['devices'](None)) != [udid]:
        raise RuntimeError('experiment requires exactly the selected simulator booted')
    rows = [line.split() for line in simctl('spawn', udid, 'launchctl', 'list').splitlines()]
    pids = [int(row[0]) for row in rows if len(row) == 3 and row[-1] == 'com.apple.apsd' and row[0].isdigit()]
    if len(pids) != 1:
        raise RuntimeError('selected simulator must have one running com.apple.apsd')
    root = simctl('getenv', udid, 'SIMULATOR_ROOT')
    if not root.startswith('/Library/Developer/CoreSimulator/') or not root.endswith('/RuntimeRoot'):
        raise RuntimeError('unrecognized simulator runtime root')
    expected = os.path.realpath(root + '/System/Library/PrivateFrameworks/ApplePushService.framework/apsd')
    matches = [p for p in PRESSURE['process_snapshot']() if p['pid'] == pids[0]]
    witness(udid=udid, servicePid=pids[0], runtimeRoot=root,
            expectedExecutable=expected, observedProcesses=matches)
    if len(matches) != 1 or os.path.realpath(matches[0]['executable']) != expected:
        raise RuntimeError('apsd PID does not have the selected runtime executable')
    if 'T' in matches[0]['state']:
        raise RuntimeError('apsd was already stopped; experiment does not own that suspension')
    return dict(udid=udid, runtimeRoot=root, process=matches[0], suspended=False)


def current(target: dict) -> dict | None:
    return next((p for p in PRESSURE['process_snapshot']()
                 if identity(p) == identity(target['process'])), None)


def save(path: Path, target: dict) -> None:
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(target) + '\n')
    temporary.replace(path)


def set_suspended(target: dict, state: Path, suspended: bool) -> None:
    process = current(target)
    if process is None:
        raise RuntimeError('apsd exited or changed identity; comparison is invalid')
    # Write intent before STOP so both the finally block and the always-run CI cleanup can
    # restore this exact launch if cancellation arrives immediately after the signal.
    if suspended:
        target['suspended'] = True
        save(state, target)
    os.kill(process['pid'], signal.SIGSTOP if suspended else signal.SIGCONT)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        process = current(target)
        if process is None:
            raise RuntimeError('apsd changed identity while signaling')
        if ('T' in process['state']) == suspended:
            target['suspended'] = suspended
            save(state, target)
            return
        time.sleep(.1)
    raise RuntimeError('apsd did not reach the requested stop/continue state')


def restore(state: Path) -> None:
    if not state.exists():
        return
    target = json.loads(state.read_text())
    if not target['suspended']:
        return
    if current(target) is None:
        # A dead or reused PID must never be signaled. Exit is safe cleanup, but main's
        # identity witnesses will fail the experiment rather than calling it an A/B/A.
        target.update(suspended=False, targetExitedBeforeRestore=True)
        save(state, target)
        return
    set_suspended(target, state, False)


def reading() -> dict:
    return dict(**PRESSURE['vm_stat'](), swapUsedMb=PRESSURE['swap_used_mb'](),
                load1=os.getloadavg()[0], **PRESSURE['cpu_snapshot'](),
                wallTimeMillis=time.time_ns() // 1_000_000)


def window(output: Path, target: dict, name: str, suspended: bool) -> dict:
    mark('apsd-idle-' + name)
    reads = [reading()]
    began = time.monotonic()
    while time.monotonic() - began < WINDOW_SECONDS:
        process = current(target)
        if process is None or ('T' in process['state']) != suspended:
            raise RuntimeError('apsd identity/state witness failed in idle window')
        time.sleep(min(POLL_SECONDS, max(0, WINDOW_SECONDS - (time.monotonic() - began))))
        reads.append(reading())
    seconds = (reads[-1]['wallTimeMillis'] - reads[0]['wallTimeMillis']) / 1000
    result = dict(event='idle-window', arm=name, suspended=suspended,
        startMillis=reads[0]['wallTimeMillis'], endMillis=reads[-1]['wallTimeMillis'],
        seconds=seconds, cpu=PRESSURE['cpu_deltas'](reads), readings=reads,
        cpuReadingsAvailable=all(r.get('cpuProcesses') for r in reads))
    # Full per-PID readings stay in the artifact, not a giant Actions console line.
    (output / f'idle-{name}.json').write_text(json.dumps(result) + '\n')
    emit(output, **{key: value for key, value in result.items() if key not in ('cpu', 'readings')},
         cpuFile=f'idle-{name}.json')
    return result


def replay(output: Path, target: dict, result: dict) -> dict:
    def date(millis):
        return datetime.fromtimestamp(millis / 1000, timezone.utc).strftime('%Y-%m-%d %H:%M:%S+0000')
    arm = result['arm']
    path = output / f'idle-{arm}-apsd.ndjson'
    # CLI bounds round outward to whole seconds; filter event timestamps back to the
    # recorded window below. Counts are a persisted subset, not all emitted events. Keep the raw bounded replay, errors and loss records for interpreting a zero.
    with path.open('w') as out, (output / f'idle-{arm}-replay.stderr').open('w') as error:
        proc = subprocess.run(['xcrun', 'simctl', 'spawn', target['udid'], 'log', 'show',
            '--style', 'ndjson', '--info', '--debug', '--loss', '--timezone', 'UTC',
            '--start', date(result['startMillis']), '--end', date(result['endMillis'] + 999),
            '--predicate', 'process == "apsd"'], stdout=out, stderr=error, timeout=180)
    count = aborts = loss = decoded = outside = malformed = 0
    with path.open() as handle:
        for line in handle:
            try:
                event = json.loads(line)
            except ValueError:
                continue  # log show may print a filtering banner; raw file preserves it
            if not isinstance(event, dict):
                continue
            decoded += 1
            loss += event.get('eventType') == 'lossEvent'
            if event.get('processID') != target['process']['pid']:
                continue
            try:
                stamp = datetime.fromisoformat(event['timestamp']).timestamp() * 1000
            except (KeyError, TypeError, ValueError):
                malformed += 1
                continue
            if not result['startMillis'] <= stamp < result['endMillis']:
                outside += 1
                continue
            count += 1
            message = event.get('eventMessage', '').lower()
            aborts += 'cert' in message and ('abort' in message or 'identity' in message)
    record = dict(event='persisted-log-rate', arm=arm, exit=proc.returncode, decoded=decoded,
        apsdEvents=count, certificateAbortOrIdentityEvents=aborts, lossRecords=loss,
        eventsPerSecond=count / result['seconds'], persistedSubset=True,
        endpointPrecisionSeconds=1, windowFilterPrecisionMillis=1, source=path.name,
        outsideWindowEvents=outside, unparsedTargetTimestamps=malformed,
        valid=proc.returncode == 0 and not malformed and (arm == 'b' or count > 0))
    emit(output, **record)
    return record


def run_command(command: list[str], output: Path, target: dict, arm: str,
                timeout: float | None = None, env: dict | None = None) -> int:
    mark('apsd-proof-' + arm)
    start = time.monotonic()
    process = current(target)
    if process is None or ('T' in process['state']) != (arm == 'b'):
        raise RuntimeError('apsd state before proof is wrong')
    # A separate group contains only this finite command and its fixture children. It lets
    # timeouts/cancellation reap the comparison without targeting other runner processes.
    child = subprocess.Popen(command, env=env, start_new_session=True)
    try:
        code = child.wait(timeout=timeout)
    finally:
        status = child.poll()
        if status is None or status < 0:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait()
    if code < 0:
        raise RuntimeError('fixture wrapper was interrupted; comparison aborted')
    process = current(target)
    valid = process is not None and ('T' in process['state']) == (arm == 'b')
    emit(output, event='proof-arm', arm=arm, suspended=arm == 'b', exit=code,
         seconds=time.monotonic() - start, identityAndStateValid=valid)
    if not valid:
        raise RuntimeError('apsd changed identity/state during proof; comparison invalid')
    return code


def experiment(args, output: Path, state: Path) -> int:
    udid = os.environ.get('IPAD_UDID') if args.device == 'ipad' else ISOLATE['resolve_name'](
        ISOLATE['devices'](None), 'iPhone 17 Pro')
    if not udid:
        raise RuntimeError('iPad experiment requires the build destination IPAD_UDID')
    subprocess.run([sys.executable, str(HERE / 'isolate-simulator'), '--phase', 'apsd-boot',
        '--keep', udid, '--settle', '--require-settle', '--require-isolation'], check=True)
    target = find_target(udid, witness=lambda **record: emit(output, event='target-check', **record))
    save(state, target)
    emit(output, event='target', **target)
    windows = []
    for arm, suspended in [('a1', False), ('b', True), ('a2', False)]:
        set_suspended(target, state, suspended)
        emit(output, event='transition', arm=arm, suspended=suspended)
        windows.append(window(output, target, arm, suspended))
    mark('apsd-idle-log-replay')
    rates = [replay(output, target, result) for result in windows]
    emit(output, event='idle-comparison', eventsPerSecond=[r['eventsPerSecond'] for r in rates],
         interpretation='Compare B with both A arms; monotone decay alone is not attribution')

    def fixture(root, command):
        return [str(HERE / 'with-my-library-fixture'), '--root', str(root), '--music', str(args.music),
                '--ffmpeg', args.ffmpeg, '--ffprobe', args.ffprobe, '--', *command]
    # Warm exactly the existing in-memory connect fixture and require the existing quiet
    # window before any comparison clock. Keep the three equal workloads consecutive;
    # interposing the rest of the suite would favor B through extra post-boot decay.
    derived = 'DulcetiPadOSDerivedData' if args.device == 'ipad' else 'DulcetiOSDerivedData'
    app = Path(os.environ['RUNNER_TEMP']) / derived / 'Build/Products/Debug-iphonesimulator/Dulcet DEV.app'
    subprocess.run([sys.executable, str(HERE / 'isolate-simulator'), '--phase', 'apsd-probe-ready',
        '--keep', udid, '--settle', '--require-settle', '--settle-pressure', '--require-isolation',
        '--warmup-app', str(app)], check=True)
    codes = []
    for arm, suspended in [('a1', False), ('b', True), ('a2', False)]:
        set_suspended(target, state, suspended)
        emit(output, event='transition', arm=arm, suspended=suspended)
        env = dict(os.environ, DULCET_APSD_PROBE_ARM=arm, DULCET_APSD_PROBE_UDID=udid,
                   DULCET_APSD_PROBE_OUTPUT=str(output / arm))
        (output / arm).mkdir()
        try:
            code = run_command(fixture(args.root.with_name(args.root.name + '-apsd-' + arm),
                [str(HERE / 'run-my-library-proofs'), args.device]), output, target, arm,
                timeout=900, env=env)
        except subprocess.TimeoutExpired as error:
            emit(output, event='proof-arm-timeout', arm=arm, timeoutSeconds=900)
            raise RuntimeError('comparison timed out; restoration required before further proofs') from error
        codes.append(code)
    # Required suite still has its original warm-up, pressure admission, test selection,
    # allowances and parity paths, against a fourth fresh fixture. Comparison failures are
    # retained, even if this full restored suite passes. No arm acts as a retry.
    codes.append(run_command(fixture(args.root, [str(HERE / 'run-my-library-proofs'), args.device]),
                             output, target, 'canonical'))
    measurement_valid = all(r['valid'] for r in rates) and all(w['cpuReadingsAvailable'] for w in windows)
    emit(output, event='result', arms=['a1', 'b', 'a2', 'canonical'], exits=codes,
         baselineNeverReplaced=True, measurementValid=measurement_valid)
    return int(any(codes) or not measurement_valid)


def legacy_nodes(value):
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from legacy_nodes(child)
    elif isinstance(value, list):
        for child in value:
            yield from legacy_nodes(child)


def activity_metrics(detail: dict) -> dict:
    activities = []
    for node in legacy_nodes(detail):
        if node.get('_type', {}).get('_name') != 'ActionTestActivitySummary':
            continue
        if not all(key in node for key in ('start', 'finish', 'title')):
            continue
        start, end = (datetime.fromisoformat(node[key]['_value']).timestamp()
                      for key in ('start', 'finish'))
        activities.append(dict(title=node['title']['_value'], start=start, finish=end,
                               seconds=round(end - start, 6)))
    if not activities:
        raise ValueError('no timed XCTest activities')
    began = min(row['start'] for row in activities)
    automation = [row['start'] for row in activities if row['title'] == 'Setting up automation session']
    queries = [row for row in activities if row['title'].startswith(
        ('Find ', 'Checking existence of ', 'Get number of matches'))]
    return dict(testSeconds=float(detail['duration']['_value']),
        testStatus=detail['testStatus']['_value'],
        firstAutomationSeconds=round(min(automation) - began, 6) if automation else None,
        queryMaxSeconds=max((row['seconds'] for row in queries), default=None),
        queryActivities=queries, activities=activities,
        nestedActivities=True)  # durations overlap; never sum them


def collect_activity_evidence(output: Path, device: str) -> None:
    """Read after restoration and all comparisons. Legacy objects retain exact finish times."""
    for arm in ('a1', 'b', 'a2'):
        bundle = output / arm / 'my-library.xcresult'
        folder = output / arm
        folder.mkdir(exist_ok=True)
        def get_object(ref=None):
            command = ['xcrun', 'xcresulttool', 'get', 'object', '--legacy', '--format', 'json',
                       '--path', str(bundle)]
            if ref:
                command += ['--id', ref]
            return json.loads(subprocess.run(command, capture_output=True, text=True,
                                            check=True, timeout=30).stdout)
        try:
            root = get_object()
            matches = []
            for action in root['actions']['_values']:
                ref = action.get('actionResult', {}).get('testsRef', {}).get('id', {}).get('_value')
                if ref:
                    tree = get_object(ref)
                    matches += [node for node in legacy_nodes(tree)
                        if node.get('identifier', {}).get('_value') ==
                        'DulcetMyLibraryUITests/testBrowseAddRemoveRelaunchAndOfflineReplay()'
                        and 'summaryRef' in node]
            if len(matches) != 1:
                raise ValueError('expected exactly one browse test result, never a retry')
            detail = get_object(matches[0]['summaryRef']['id']['_value'])
            (folder / 'browse-activities-legacy.json').write_text(json.dumps(detail) + '\n')
            metrics = activity_metrics(detail)
            (folder / 'browse-metrics.json').write_text(json.dumps(metrics) + '\n')
            emit(output, event='browse-metrics', arm=arm,
                 **{k: v for k, v in metrics.items() if k not in ('activities', 'queryActivities')},
                 queryCount=len(metrics['queryActivities']), source=arm + '/browse-metrics.json')
        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            emit(output, event='browse-metrics-unavailable', arm=arm, type=type(error).__name__)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--restore', type=Path)
    parser.add_argument('--device', choices=['iphone', 'ipad'])
    parser.add_argument('--root', type=Path)
    parser.add_argument('--music', type=Path)
    parser.add_argument('--ffmpeg')
    parser.add_argument('--ffprobe')
    args = parser.parse_args()
    if args.restore:
        restore(args.restore)
        return 0
    if not all([args.device, args.root, args.music, args.ffmpeg, args.ffprobe]):
        parser.error('experiment requires device, root, music, ffmpeg and ffprobe')
    if os.environ.get('GITHUB_EVENT_NAME') != 'workflow_dispatch' or os.environ.get('DULCET_APSD_EXPERIMENT') != 'true':
        parser.error('experiment requires explicit workflow_dispatch opt-in')
    output = Path(os.environ['RUNNER_TEMP']) / 'dulcet-apsd-experiment'
    output.mkdir()
    state = output / 'restore.json'
    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        return experiment(args, output, state)
    except Exception as error:
        emit(output, event='error', type=type(error).__name__, message=str(error))
        return 1
    finally:
        restore(state)
        mark('apsd-result-export')
        collect_activity_evidence(output, args.device)
        saved = json.loads(state.read_text()) if state.exists() else {}
        emit(output, event='cleanup', suspended=saved.get('suspended'),
             targetExited=saved.get('targetExitedBeforeRestore', False))
        mark('apsd-experiment-finished')


if __name__ == '__main__':
    raise SystemExit(main())
