#!/usr/bin/env python3
"""Extract the pinned Linux Navidrome binary for a finite loopback fixture."""
import json
import os
from pathlib import Path
import subprocess
import tarfile
import tempfile

repo=Path(__file__).resolve().parents[2]
pins=json.loads((repo/'tools/conformance-env/pins.json').read_text())
image=pins['navidrome']['linux']['image']
output=Path(os.environ['RUNNER_TEMP'])/'discover-bin';output.mkdir(exist_ok=True)
subprocess.run(['docker','pull',image],check=True)
container=subprocess.check_output(['docker','create',image],text=True).strip()
try:
    with tempfile.TemporaryFile() as exported:
        subprocess.run(['docker','export',container],stdout=exported,check=True);exported.seek(0)
        with tarfile.open(fileobj=exported) as archive:
            member=next(m for m in archive if m.isfile() and Path(m.name).name=='navidrome')
            (output/'navidrome').write_bytes(archive.extractfile(member).read())
finally:subprocess.run(['docker','rm',container],check=True)
(output/'navidrome').chmod(0o755)
version=subprocess.check_output([str(output/'navidrome'),'--version'],text=True)
if pins['navidrome']['version'] not in version:raise SystemExit('Navidrome version mismatch')
with open(os.environ['GITHUB_ENV'],'a') as env:env.write('DULCET_DISCOVER_NAVIDROME_BIN='+str(output/'navidrome')+'\n')
# Also expose to later commands within the same setup step through a stable report.
print(version)
