#!/usr/bin/env python3
"""Run native transport and production Connections controls on an owned disposable emulator."""
import argparse
from contextlib import contextmanager
import signal
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import urllib.parse
import uuid
import xml.etree.ElementTree as ET

REPO = Path(__file__).resolve().parents[2]
CLASS = 'com.legitimateapps.dulcet.core.AndroidConnectionOwnershipDeviceTest'
METHODS = {'mp02FactoryRouteChangeKeepsExplicitAndAutomaticFilesAndAllRows',
           'mp10PreservingHttpsEnrollmentNeverDialsHttpInPlayerDownloadArtwork'}
PHASE2_METHODS = {'mp03ReaderCacheAndQueuedValuesSurviveHeldOldPagesAndLostAcknowledgement',
    'mp02AutomaticSelectorKeepsExplicitAutomaticFilesAndAllRowsAcrossThreeListeners',
    'mp04AdvancingNativeDecoderRecoversOnAnAlternateWithoutChangingTheListen',
    'mp04LegacyTranscodeRecoversWithAnAdvertisedOffsetAndAbsoluteMediaTime',
    'mp05CutExplicitAndAutomaticTransfersRestartUnderTheSameIdsAfterRelaunch',
    'mp07BrowseAlbumAddLostAcknowledgementExpandsRetentionAndPlaysOffline'}

CONTROLS_METHODS = {'mp09CurrentReceiptRemovalOfflineCacheAndExplicitReadd',
    'mp09PreservingUpgradeCancelAndDifferentServerRefusal'}


def run(argv, **kwargs):
    return subprocess.run(argv, check=True, **kwargs)



@contextmanager
def fixture_apk_trust(ca):
    """Embed exactly this fresh CA in the test APK, without root or device trust changes."""
    resources = REPO/'core/src/androidDeviceTest/res'
    config = resources/'xml/connection_fixture_network_security.xml'
    original = config.read_bytes()
    document = ET.fromstring(original)
    user_roots = document.findall("./base-config/trust-anchors/certificates[@src='user']")
    if len(user_roots) != 1:
        raise RuntimeError('expected one test-only user trust entry to replace with the fresh fixture CA')
    raw = resources/'raw/connection_fixture_ca.pem'
    if raw.exists():
        raise RuntimeError('a generated fixture CA resource already has an owner; use a fresh checkout')
    raw.parent.mkdir(parents=True, exist_ok=True)
    try:
        with raw.open('xb') as output: output.write(ca.read_bytes())
        user_roots[0].set('src', '@raw/connection_fixture_ca')
        config.write_bytes(ET.tostring(document, encoding='utf-8', xml_declaration=True))
        print('CONNECTIONS ANDROID trust=fresh-test-APK-root device-root=unchanged hostname-verification=required', flush=True)
        yield
    finally:
        config.write_bytes(original)
        raw.unlink(missing_ok=True)
        try: raw.parent.rmdir()
        except OSError: pass


@contextmanager
def fixture_app_trust(ca, module):
    """Exact fresh localhost root in an ephemeral DEBUG target app, never a release/user root."""
    if module not in ('app', 'tv'):
        raise ValueError('controls trust requires the phone or TV application module')
    debug = REPO/'android'/module/'src/debug'
    manifest = debug/'AndroidManifest.xml'
    config = debug/'res/xml/connection_controls_network_security.xml'
    raw = debug/'res/raw/connection_controls_ca.pem'
    files = (manifest, config, raw)
    if any(path.exists() for path in files):
        raise RuntimeError('generated controls trust has an existing owner; use a fresh checkout')
    manifest_xml = b'<manifest xmlns:android="http://schemas.android.com/apk/res/android"><application android:networkSecurityConfig="@xml/connection_controls_network_security" /></manifest>'
    config_xml = b'<network-security-config><base-config><trust-anchors><certificates src="system" /></trust-anchors></base-config><domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">localhost</domain><trust-anchors><certificates src="system" /><certificates src="@raw/connection_controls_ca" /></trust-anchors></domain-config><domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">127.0.0.1</domain><domain includeSubdomains="false">::1</domain></domain-config></network-security-config>'
    created = []
    try:
        for path, data in ((manifest, manifest_xml), (config, config_xml), (raw, ca.read_bytes())):
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.open('xb') as output: output.write(data)
            created.append(path)
        print('CONNECTIONS ANDROID controls-trust=exact-fresh-localhost-DEBUG-root release-and-device-trust=unchanged hostname-verification=required', flush=True)
        yield
    finally:
        for path in reversed(created): path.unlink()
        # Remove only empty generated directories; retain all unrelated resources.
        for directory in (raw.parent, config.parent, debug/'res', debug):
            try: directory.rmdir()
            except OSError: pass


def require_results(results, class_name, methods, returncode):
    cases = [case for path in results.rglob('TEST-*.xml') for case in ET.parse(path).getroot().iter('testcase')
             if case.get('classname') == class_name]
    observed = {case.get('name') for case in cases}
    if returncode or observed != methods or len(cases) != len(methods) or any(
            case.find(tag) is not None for case in cases for tag in ('failure', 'error', 'skipped')):
        raise RuntimeError('native connections proofs require every named method exactly once, passed with zero skips')
    return len(cases)


def export_controls_captures(adb, package, evidence, nonce):
    device_directory = 'files/connection-controls/'+str(uuid.UUID(nonce))
    result = subprocess.run(adb+['shell', 'run-as', package, 'ls', device_directory], capture_output=True)
    if result.returncode:
        return 0
    directory = evidence/'controls-captures'; directory.mkdir(exist_ok=True)
    names = result.stdout.decode().splitlines()
    for name in names:
        # Names come from the app's fixed scenario labels. No app-provided path may escape.
        if not name or any(character not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.' for character in name) or not name.endswith(('.jpg', '.txt')):
            raise RuntimeError('unexpected controls capture name')
        with (directory/name).open('wb') as output:
            subprocess.run(adb+['exec-out', 'run-as', package, 'cat', device_directory+'/'+name], stdout=output, check=True)
    return len([name for name in names if name.endswith('.jpg') and 'failure' not in name])


def controls_configuration(adb):
    features = subprocess.check_output(adb+['shell', 'pm', 'list', 'features'], text=True)
    return ('tv', 'Debug', 'com.legitimateapps.dulcet.tv',
        'com.legitimateapps.dulcet.tv.AndroidTvEmulatorAccountConnectProofTest') if 'feature:android.software.leanback' in features.splitlines() else (
        'app', 'DevDebug', 'com.legitimateapps.dulcet.dev', 'com.legitimateapps.dulcet.AndroidEmulatorAccountConnectProofTest')


def compile_controls(adb, serial, ca):
    # Compile both concrete APKs before any core runtime scenario can fail. Build is not UI evidence.
    module, variant, _, _ = controls_configuration(adb)
    with fixture_app_trust(ca, module):
        run([str(REPO/'tools/run-gradle-exclusive'), '--no-daemon', '--max-workers=2',
             f':android:{module}:assemble{variant}', f':android:{module}:assemble{variant}AndroidTest'],
            cwd=REPO, env=dict(os.environ, ANDROID_SERIAL=serial))
    print(f'CONNECTIONS ANDROID controls-apk-build=passed surface={module} ui-execution=not-started', flush=True)


def execute_controls(adb, serial, manifest, ca, evidence):
    module, variant, package, class_name = controls_configuration(adb)
    command = [str(REPO/'tools/run-gradle-exclusive'), '--no-daemon', '--max-workers=2',
        f':android:{module}:connected{variant}AndroidTest',
        '-Pandroid.testInstrumentationRunnerArguments.class='+','.join(class_name+'#'+method for method in sorted(CONTROLS_METHODS)),
        '-Pandroid.testInstrumentationRunnerArguments.DULCET_MULTIPATH_MANIFEST_JSON='+json.dumps(manifest, separators=(',', ':'))]
    env = dict(os.environ, ANDROID_SERIAL=serial)
    results = REPO/'android'/module/'build/outputs/androidTest-results/connected'
    # These are generated outputs in this runner-owned checkout. Old XML cannot prove a new run.
    if results.exists(): shutil.rmtree(results)
    with fixture_app_trust(ca, module):
        try:
            result = subprocess.run(command, cwd=REPO, env=env)
        finally:
            captures = export_controls_captures(adb, package, evidence, manifest['nonce'])
    copied = evidence/'results/controls'
    if results.exists(): shutil.copytree(results, copied)
    count = require_results(copied, class_name, CONTROLS_METHODS, result.returncode)
    if captures < 7:
        raise RuntimeError('both controls methods must produce all seven labelled native JPEG capture scenarios')
    print(f'CONNECTIONS ANDROID MP-09 surface={"tv" if module == "tv" else "phone"} ui-tests={count} skipped=0 captures={captures}', flush=True)


def select_emulator(serial):
    if serial is None:
        lines = subprocess.check_output(['adb','devices'], text=True).splitlines()[1:]
        devices = [line.split()[0] for line in lines if line.split()[1:] == ['device']]
        if len(devices) != 1: raise RuntimeError('name exactly one owned disposable emulator with --serial')
        serial = devices[0]
    if not serial.startswith('emulator-'): raise RuntimeError('physical devices are outside this fixture runner')
    if subprocess.check_output(['adb','-s',serial,'shell','getprop','ro.kernel.qemu'], text=True).strip() != '1':
        raise RuntimeError('the selected device is not an emulator')
    return serial


def inside(args):
    manifest_path = Path(os.environ['DULCET_MULTIPATH_MANIFEST']).resolve()
    manifest = json.loads(manifest_path.read_text())
    if manifest.get('standard') != 'dulcet-multipath-fixture' or manifest.get('disposable') is not True:
        raise RuntimeError('a fresh local disposable manifest is required before device or network work')
    nonce = str(uuid.UUID(manifest['nonce']))
    if (manifest_path.parent/'.owned-multipath-fixture').read_text().strip() != nonce:
        raise RuntimeError('manifest ownership marker mismatch')
    methods = PHASE2_METHODS if args.phase2 else METHODS
    if args.phase2 and manifest.get('phase') != 2: raise RuntimeError('phase-2 proofs require their three-listener fixture')
    ports = set()
    for value in [*manifest['routes'].values(), manifest['controlBase']]:
        url = urllib.parse.urlsplit(value)
        if url.hostname != 'localhost' or not url.port or url.scheme not in ('http','https') or url.username or url.query or url.fragment:
            raise RuntimeError('only the fresh fixture localhost routes can be forwarded')
        ports.add(url.port)
    serial = select_emulator(args.serial)
    adb = ['adb','-s',serial]
    ca = Path(manifest['caPem']).resolve()
    if ca.parent != manifest_path.parent or not ca.is_file(): raise RuntimeError('CA does not belong to this fixture')
    seed = REPO/'tools/migration-fixtures/v15'
    if not (seed/'database.db').is_file(): raise RuntimeError('the public v15 ownership seed is absent')
    evidence = args.evidence or manifest_path.parent/'android-evidence'; evidence.mkdir(parents=True, exist_ok=False)
    device_root = '/data/local/tmp/dulcet-connections-'+nonce
    reversed_ports = []
    try:
        run(adb+['shell','mkdir','-p',device_root])
        device_manifest = dict(manifest); device_manifest['caPem'] = device_root+'/ca.pem'
        local_manifest = evidence/'manifest-device.json'; local_manifest.write_text(json.dumps(device_manifest)); local_manifest.chmod(0o600)
        run(adb+['push',str(local_manifest),device_root+'/manifest.json'], stdout=subprocess.PIPE)
        run(adb+['shell','chmod','644',device_root+'/manifest.json'])
        run(adb+['push',str(ca),device_root+'/ca.pem'], stdout=subprocess.PIPE)
        run(adb+['push',str(seed),device_root+'/seed'], stdout=subprocess.PIPE)
        existing = subprocess.check_output(adb+['reverse','--list'],text=True)
        for port in sorted(ports):
            if 'tcp:'+str(port) in existing: raise RuntimeError('a fixture port already has an adb reverse owner')
            run(adb+['reverse','tcp:'+str(port),'tcp:'+str(port)]); reversed_ports.append(port)
        if args.phase2:
            compile_controls(adb, serial, ca)
        command = [str(REPO/'tools/run-gradle-exclusive'),'--no-daemon','--max-workers=2',':core:connectedAndroidDeviceTest',
            '-Pandroid.testInstrumentationRunnerArguments.class='+','.join(CLASS+'#'+method for method in sorted(methods)),
            '-Pandroid.testInstrumentationRunnerArguments.DULCET_MULTIPATH_MANIFEST='+device_root+'/manifest.json',
            '-Pandroid.testInstrumentationRunnerArguments.DULCET_CONNECTIONS_SEED='+device_root+'/seed']
        env = os.environ.copy(); env['ANDROID_SERIAL'] = serial
        with fixture_apk_trust(ca):
            result = subprocess.run(command, cwd=REPO, env=env)
        results = REPO/'core/build/outputs/androidTest-results/connected'
        if results.exists(): shutil.copytree(results,evidence/'results')
        finish_native_proofs(args.phase2, adb, serial, manifest, ca, evidence, methods, result.returncode)
        return 0
    finally:
        for port in reversed_ports: subprocess.run(adb+['reverse','--remove','tcp:'+str(port)],check=False)
        subprocess.run(adb+['shell','rm','-rf',device_root],check=False)


def finish_native_proofs(phase2, adb, serial, manifest, ca, evidence, methods, returncode):
    # Independent native controls must execute even when transport proof fails. Both remain
    # mandatory: collecting one suite never converts the other's failure into success.
    failures = []
    try:
        count = require_results(evidence/'results', CLASS, methods, returncode)
        print(('CONNECTIONS ANDROID PHASE2 MP-02=passed' if phase2 else 'CONNECTIONS ANDROID MP-02=passed MP-10=passed')+f' native-tests={count} skipped=0', flush=True)
    except RuntimeError as error:
        failures.append(error)
    if phase2:
        try:
            execute_controls(adb, serial, manifest, ca, evidence)
        except (RuntimeError, subprocess.CalledProcessError) as error:
            failures.append(error)
    if failures:
        raise RuntimeError('Native connection proof failed in '+str(len(failures))+' required suite(s)') from failures[0]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root',type=Path)
    parser.add_argument('--serial')
    parser.add_argument('--evidence',type=Path)
    parser.add_argument('--phase2',action='store_true')
    parser.add_argument('--inside',action='store_true',help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.inside: return inside(args)
    serial = select_emulator(args.serial)
    root = args.root or Path(os.environ.get('RUNNER_TEMP','/tmp'))/('dulcet-connections-'+str(uuid.uuid4()))
    command = [sys.executable,str(REPO/'tools/conformance-env/multipath-fixture'),'--root',str(root)]
    if args.phase2: command += ['--phase2']
    command += ['--',sys.executable,__file__,'--inside','--serial',serial]
    if args.phase2: command += ['--phase2']
    if args.evidence: command += ['--evidence',str(args.evidence)]
    return subprocess.run(command,cwd=REPO).returncode


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(SystemExit(143)))
    sys.exit(main())
