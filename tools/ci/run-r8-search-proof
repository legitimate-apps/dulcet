#!/usr/bin/env bash
set -euo pipefail
out=$1
udid=$2
dd=$3
mkdir -p "$out"
root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/r8-search-fixture.XXXXXX")
server_pid= proxy_pid=
cleanup() {
  [[ -z "$proxy_pid" ]] || kill "$proxy_pid" 2>/dev/null || true
  [[ -z "$server_pid" ]] || kill "$server_pid" 2>/dev/null || true
  for shot in "$out"/*.png; do
    [[ -f "$shot" ]] || continue
    sips -s format jpeg -Z 800 -s formatOptions 55 "$shot" --out "${shot%.png}.jpg" >/dev/null
  done
  cp "$root/server.log" "$root/proxy.log" "$out/" 2>/dev/null || true
}
trap cleanup EXIT
ffmpeg=$(command -v ffmpeg)
server=server/build/install/dulcet-server/bin/dulcet-server
python_bin=${DULCET_SEARCH_PROOF_PYTHON:-python3}
server_port=$("$python_bin" -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
origin="http://127.0.0.1:$server_port"
mkdir -p "$root/music/studio" "$root/music/cover"
"$ffmpeg" -hide_banner -loglevel error -f lavfi -i 'color=c=0x145589:s=256x256,drawbox=x=36:y=100:w=184:h=56:color=cyan:t=fill' \
  -frames:v 1 -threads 1 "$root/music/studio/cover.png"
make_song() {
  local location=$1 artist=$2 album=$3
  "$ffmpeg" -hide_banner -loglevel error -f lavfi -i 'sine=frequency=440:duration=40' -threads 1 \
    -metadata "title=Harbor Signal" -metadata "album=$album" -metadata "artist=$artist" \
    -metadata "album_artist=$artist" -metadata "track=1" "$root/music/$location/song.flac"
}
make_song studio 'Original Artist' 'Harbor Studio Album'
make_song cover 'Cover Artist' 'Harbor Signal (triple j Like a Version)'
settings=(--music="$root/music" --data="$root/data" --bind=127.0.0.1 --port="$server_port" --scan-on-start=false
  --lrclib=off --ffmpeg="$ffmpeg" --ffprobe="$(command -v ffprobe)")
"$server" user add search-fixture search-fixture-password --admin "${settings[@]}"
"$server" scan "${settings[@]}"
"$server" serve "${settings[@]}" > "$root/server.log" 2>&1 &
server_pid=$!
"$python_bin" tools/conformance-env/lyrics-fault-proxy --port 0 --upstream "$origin" > "$root/proxy.log" 2>&1 &
proxy_pid=$!
for ((i=0; i<150; i++)); do
  proxy_port=$(sed -n 's/^LYRICS FAULT PROXY listening port=\([0-9]*\).*/\1/p' "$root/proxy.log")
  [[ -n "$proxy_port" ]] && break
  kill -0 "$proxy_pid"
  sleep .1
done
[[ -n "$proxy_port" ]]
"$python_bin" - "$server_pid" "$server_port" "$origin" <<'PY'
import json, subprocess, sys, time, urllib.parse, urllib.request
pid, port, origin = sys.argv[1:]
def rest(endpoint, **params):
    query = urllib.parse.urlencode(dict(u="search-fixture",p="search-fixture-password",v="1.16.1",c="search-proof",f="json", **params))
    with urllib.request.urlopen(f"{origin}/rest/{endpoint}?{query}", timeout=5) as response:
        data = json.load(response)["subsonic-response"]
    assert data["status"] == "ok", endpoint
    return data
for _ in range(120):
    owned = subprocess.run(["lsof","-nP","-a","-p",pid,f"-iTCP:{port}","-sTCP:LISTEN"],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode == 0
    if owned:
        try:
            rest("ping")
            break
        except OSError:
            pass
    time.sleep(.2)
else:
    raise SystemExit("Disposable server did not become ready")
def songs():
    return {s["artist"]: s for s in rest("search3",query="Harbor Signal",artistCount=0,albumCount=0)["searchResult3"]["song"]}
initial = songs()
assert set(initial) == {"Original Artist", "Cover Artist"}, list(initial)
for artist, count in [("Original Artist",2), ("Cover Artist",3)]:
    for i in range(count):
        rest("scrobble",id=initial[artist]["id"],submission="true",time=int(time.time()*1000)+i)
assert {artist: song["playCount"] for artist, song in songs().items()} == {"Original Artist":2, "Cover Artist":3}
print("OBSERVED fixture: Original Artist 2 plays; Cover Artist 3 plays")
PY
export TEST_RUNNER_DULCET_SEARCH_STABILITY_PROOF=1
export TEST_RUNNER_DULCET_UI_TEST_SERVER_URL="http://127.0.0.1:$proxy_port"
export TEST_RUNNER_DULCET_UI_TEST_USERNAME=search-fixture
export TEST_RUNNER_DULCET_UI_TEST_PASSWORD=search-fixture-password
export TEST_RUNNER_DULCET_DESIGN_TOUR_OUT="$out"
case "${DULCET_SEARCH_PROOF_PREBUILT:-0}" in 1) action=test-without-building;; *) action=test;; esac
xcodebuild "$action" -project apple/Dulcet.xcodeproj -scheme DulcetiOS -configuration Debug \
  -destination "id=$udid" -derivedDataPath "$dd" -resultBundlePath "$root/proof.xcresult" \
  -parallel-testing-enabled NO \
  -only-testing:DulcetiOSUITests/DulcetDesignTourUITests/testSearchKeepsTheOriginalBeforeAndAfterTheServerAnswer 2>&1 | tee "$out/xcode.log"
python3 tools/verify-xcode-test-execution "$root/proof.xcresult" DulcetiOSUITests.DulcetDesignTourUITests testSearchKeepsTheOriginalBeforeAndAfterTheServerAnswer
xcrun xcresulttool get test-results summary --path "$root/proof.xcresult" > "$out/test-summary.json"
