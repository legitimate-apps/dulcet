#!/usr/bin/env python3
"""Retry only SQLDelight's SchemaCrawler table-constraint comparator crash, at most twice.

Usage: retry-sqldelight-migration -- COMMAND [ARGS...]
       retry-sqldelight-migration --self-test

Run only the migration verifier here, with plain console output. All output is streamed, and the
last attempt's status is preserved. Keep this command inside run-with-thread-dump: children share
its process group, so the same deadline and JVM dumps cover every attempt.
"""
import re
import subprocess
import sys

MAX_ATTEMPTS = 3
TASK = ":core:verifyCommonMainDulcetDatabaseMigration"


def is_schemacrawler_race(output):
    # Require the originating scheduler task, its exception and the relevant stack frames
    # together. A comparator error in application code or another SchemaCrawler task is different.
    trace = re.search(
        r"^Exception running <[0-9:.]+ - <match_table_constraints>> on thread "
        r"<pool-\d+-thread-\d+>: Comparison method violates its general contract!\n"
        r"java\.lang\.IllegalArgumentException: Comparison method violates its general contract!\n"
        r"(?:\s+at [^\n]+\n)*?"
        r"\s+at schemacrawler\.crawl\.NamedObjectList\.values\(NamedObjectList\.java:\d+\)\n"
        r"\s+at schemacrawler\.crawl\.NamedObjectList\.iterator\(NamedObjectList\.java:\d+\)\n"
        r"\s+at schemacrawler\.crawl\.TableConstraintRetriever\.matchTableConstraints"
        r"\(TableConstraintRetriever\.java:\d+\)",
        output, re.MULTILINE,
    )
    # The isolated verifier must be the only failing Gradle task, and its terminal cause must be
    # this comparator crash. In particular, a schema mismatch after a logged race is not retried.
    failed_tasks = re.findall(r"^> Task (\S+) FAILED$", output, re.MULTILINE)
    failures = re.findall(r"^Execution failed for task '([^']+)'", output, re.MULTILINE)
    cause = re.search(
        r"^> A failure occurred while executing "
        r"app\.cash\.sqldelight\.gradle\.VerifyMigrationTask\$VerifyMigrationAction\n"
        r"   > Comparison method violates its general contract!$", output, re.MULTILINE,
    )
    return bool(trace and cause and failed_tasks == [TASK] and failures == [TASK])


def run(command):
    for attempt in range(1, MAX_ATTEMPTS + 1):
        output = []
        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              text=True, errors="replace") as process:
            for line in process.stdout:
                sys.stdout.write(line)
                sys.stdout.flush()
                output.append(line)
            status = process.wait()
        if status != 1 or not is_schemacrawler_race("".join(output)):
            return status
        if attempt == MAX_ATTEMPTS:
            print(f"SQLDELIGHT_MIGRATION_RETRY_EXHAUSTED attempts={attempt}: "
                  "SchemaCrawler match_table_constraints comparator crash persists", flush=True)
            return status
        print(f"SQLDELIGHT_MIGRATION_RETRY attempt={attempt + 1}/{MAX_ATTEMPTS}: "
              "SchemaCrawler match_table_constraints comparator crash; retrying verifier", flush=True)


def self_test():
    import json
    import os
    import tempfile

    # Shape of the unprefixed Gradle output in core-build job 121912458280 (2026-10-26).
    race = """Exception running <00:00:00.000 - <match_table_constraints>> on thread <pool-17-thread-6>: Comparison method violates its general contract!
java.lang.IllegalArgumentException: Comparison method violates its general contract!
\tat java.base/java.util.TimSort.mergeLo(TimSort.java:781)
\tat schemacrawler.crawl.NamedObjectList.values(NamedObjectList.java:192)
\tat schemacrawler.crawl.NamedObjectList.iterator(NamedObjectList.java:128)
\tat schemacrawler.crawl.TableConstraintRetriever.matchTableConstraints(TableConstraintRetriever.java:79)
> Task :core:verifyCommonMainDulcetDatabaseMigration FAILED
Execution failed for task ':core:verifyCommonMainDulcetDatabaseMigration' (registered by plugin 'app.cash.sqldelight').
> A failure occurred while executing app.cash.sqldelight.gradle.VerifyMigrationTask$VerifyMigrationAction
   > Comparison method violates its general contract!
"""
    mismatch = """> Task :core:verifyCommonMainDulcetDatabaseMigration FAILED
Execution failed for task ':core:verifyCommonMainDulcetDatabaseMigration'.
> A failure occurred while executing app.cash.sqldelight.gradle.VerifyMigrationTask$VerifyMigrationAction
   > Migration files do not produce the current schema: columns[cache_playlist.readonly] - ADDED
"""
    cases = [
        ("race then success passes and logs one retry", [(race, 1), ("BUILD SUCCESSFUL\n", 0)], 0, 2, 1),
        ("persistent race fails after three attempts", [(race, 1)] * 4, 1, 3, 2),
        ("schema mismatch fails without retry", [(mismatch, 1)], 1, 1, 0),
        ("clean first run logs no retry", [("BUILD SUCCESSFUL\n", 0)], 0, 1, 0),
        ("comparator error without SchemaCrawler frames is not retried",
         [(race.replace("schemacrawler.crawl.", "example.application."), 1)], 1, 1, 0),
        ("another failed task prevents retry", [(race + "> Task :core:jvmTest FAILED\n", 1)], 1, 1, 0),
        ("a mismatch following a logged race is not retried", [(race + mismatch, 1)], 1, 1, 0),
        ("schema mismatch on second attempt stops immediately", [(race, 1), (mismatch, 1)], 1, 2, 1),
        ("termination status prevents retry even with a race log", [(race, 143)], 143, 1, 0),
    ]
    failures = []
    with tempfile.TemporaryDirectory() as directory:
        fake = os.path.join(directory, "verifier.py")
        with open(fake, "w") as handle:
            handle.write("""import json, pathlib, sys
plan = json.loads(pathlib.Path(sys.argv[1]).read_text())
counter = pathlib.Path(sys.argv[2])
attempt = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(attempt + 1))
output, status = plan[min(attempt, len(plan) - 1)]
sys.stderr.write(output)
sys.exit(status)
""")
        for index, (name, plan, status, attempts, retries) in enumerate(cases):
            plan_path = os.path.join(directory, f"plan-{index}.json")
            count_path = os.path.join(directory, f"count-{index}")
            with open(plan_path, "w") as handle:
                json.dump(plan, handle)
            result = subprocess.run(
                [sys.executable, os.path.abspath(__file__), "--", sys.executable, fake,
                 plan_path, count_path], capture_output=True, text=True, timeout=30,
            )
            with open(count_path) as handle:
                observed_attempts = int(handle.read())
            retry_lines = re.findall(r"^SQLDELIGHT_MIGRATION_RETRY attempt=.*$",
                                    result.stdout, re.MULTILINE)
            ok = (result.returncode == status and observed_attempts == attempts
                  and len(retry_lines) == retries
                  and ("SQLDELIGHT_MIGRATION_RETRY_EXHAUSTED" in result.stdout)
                  == (name == "persistent race fails after three attempts")
                  and all(output in result.stdout for output, _ in plan[:attempts]))
            print(f"{'PASS' if ok else 'FAIL'} {name}: status={result.returncode} "
                  f"attempts={observed_attempts} retries={len(retry_lines)}", flush=True)
            for line in retry_lines:
                # Keep synthetic retries out of counts of real retry markers in CI logs.
                print(f"SELF TEST observed: {line}", flush=True)
            if not ok:
                failures.append(name)
                print(result.stdout + result.stderr)
    print(f"SELF TEST {'FAILED' if failures else 'PASSED'}: "
          f"{len(cases) - len(failures)}/{len(cases)} cases", flush=True)
    return 1 if failures else 0


def main(argv):
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) < 2 or argv[0] != "--":
        print(__doc__, file=sys.stderr)
        return 2
    return run(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
