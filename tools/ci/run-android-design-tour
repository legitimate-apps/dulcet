#!/usr/bin/env python3
"""Capture one already-booted hosted emulator, keeping failures and continuing independent tours.

  tools/ci/run-android-design-tour phone|tv OUTPUT

The caller builds APKs and :server:installDist and provisions the pinned fixture binary. This
command never boots a device or touches a remote server. A failed tour fails the command after
collecting the remaining independent tours, so partial artifacts remain reviewable.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('surface', choices=['phone', 'tv'])
p.add_argument('output', type=Path)
a = p.parse_args()
a.output.mkdir(parents=True, exist_ok=True)
env = dict(os.environ)
env['ANDROID_SERIAL'] = 'emulator-5554'
env['DULCET_DESIGN_TOUR_'+a.surface.upper()+'_SERIAL'] = env['ANDROID_SERIAL']
env['DULCET_DESIGN_TOUR_WORK'] = str(a.output/'runtime')
env['DULCET_DESIGN_TOUR_NAVIDROME'] = env['DULCET_DISCOVER_NAVIDROME_BIN']
results = []

def run(name, command):
    with (a.output/(name+'.log')).open('w') as log:
        try:
            result = subprocess.run(command, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=2400)
            code = result.returncode
        except subprocess.TimeoutExpired:
            code = 124
    results.append(dict(tour=name, exitCode=code))
    print(f'DESIGN TOUR {name}: exit={code}', flush=True)
    (a.output/'results.json').write_text(json.dumps(results, indent=2)+'\n')

run('main', ['tools/design-tour-android', str(a.output/'main'), '--device', a.surface, '--skip-build'])
if a.surface == 'phone':
    run('supplement', ['tools/design-tour-android', str(a.output/'supplement'), '--device', 'phone',
                       '--skip-build', '--method', 'supplementalTour'])
    run('dulcet', ['tools/ci/with-discover-wishlist-fixture', '--evidence', str(a.output/'fixture'),
                   '--', 'tools/design-tour-android-discover', str(a.output/'dulcet')])
raise SystemExit(int(any(r['exitCode'] for r in results)))
