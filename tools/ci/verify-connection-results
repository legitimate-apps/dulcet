#!/usr/bin/env python3
"""Require each named native connection proof to execute once and pass, never skip."""
from pathlib import Path
import argparse
import sys
import xml.etree.ElementTree as ET

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--native-target', choices=('macosArm64', 'iosSimulatorArm64', 'tvosSimulatorArm64'), default='macosArm64')
parser.add_argument('root')
parser.add_argument('expected_class')
parser.add_argument('expected_methods', nargs='+')
args = parser.parse_args()
root, expected_class, expected_methods = args.root, args.expected_class, args.expected_methods
if not expected_methods or len(set(expected_methods)) != len(expected_methods):
    raise SystemExit('usage: verify-connection-results RESULTS CLASS METHOD [METHOD ...]')
cases = [case for path in Path(root).rglob('*.xml')
         for case in ET.parse(path).getroot().iter('testcase')
         if case.get('classname', '') in (expected_class, args.native_target + 'Test.' + expected_class)]
observed = [case.get('name', '').removesuffix('[' + args.native_target + ']') for case in cases]
if sorted(observed) != sorted(expected_methods):
    raise SystemExit(f'Connection proofs missing or duplicated: expected={expected_methods} observed={observed}')
for case in cases:
    if any(case.find(terminal) is not None for terminal in ('failure', 'error', 'skipped')):
        raise SystemExit(ET.tostring(case, encoding='unicode'))
print(f'CONNECTIONS NATIVE class={expected_class} executed={len(cases)} passed={len(cases)} skipped=0')
