#!/usr/bin/env python3
"""Record host memory and CPU pressure across apple-ci phases, so a stall can be attributed.

Why this exists. The dominant apple-ci failure family is a stall that every tool reports in its
own words (`kind=timeout`, `Failed(error=Timeout)`, `cache search transport error`, an
observation GET that times out). On 2026-09-22 (run 35796782723) the proxy fixture's own access
log showed it answered in 985 ms a request it answers in 0.28 ms on the macOS pass, the request
reached it 5.04 s after the client sent it, and in-process work in the test binary (building an
HTTP client object) took 3656 ms instead of 35 ms. A 100x slowdown of purely in-process work is
what paging looks like, not what a busy CPU looks like -- but nothing in the job measured memory,
so that reading was ASSUMED. This tool turns it into a measurement.

Subcommands:
  sample  --output FILE [--interval SECONDS]   append one JSON sample per interval until killed
  mark    FILE NAME                            append a phase boundary (with booted-simulator count)
  summarize FILE                               print one line per phase: deltas and peaks

Samples are cumulative kernel counters (vm_stat) plus swap use and load average; every
sample also lists the largest processes by resident memory, summed by command name, so a phase
that swaps names what held the memory (`HOST PRESSURE TOP`), and the same sample names what held
the CPU (`HOST PRESSURE CPU`, from the phase's highest-load sample), so a load of hundreds on three
cores is attributed to a process rather than guessed at. Two consecutive readings at >=90%
for the same Dulcet app process trigger a three-second stack sample, with a ten-second timeout
and at most three captures per job (one per process launch). A phase's
pressure is the DELTA of the counters between its mark and the next one, so the sampler can run
for the whole job without any phase needing to know about it. Stdlib only.
"""
import json
from pathlib import Path
import os
import re
import subprocess
import sys
import time

COUNTERS = {
    "Pageins": "pageins",
    "Pageouts": "pageouts",
    "Swapins": "swapins",
    "Swapouts": "swapouts",
    "Compressions": "compressions",
    "Decompressions": "decompressions",
    "Pages free": "free_pages",
    "Pages occupied by compressor": "compressor_pages",
}
CUMULATIVE = ("pageins", "pageouts", "swapins", "swapouts", "compressions", "decompressions")


def vm_stat() -> dict:
    out = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=10).stdout
    page = re.search(r"page size of (\d+) bytes", out)
    values = {"page_bytes": int(page.group(1)) if page else 0}
    for line in out.splitlines():
        key, _, raw = line.partition(":")
        name = COUNTERS.get(key.strip().strip('"'))
        if name:
            values[name] = int(raw.strip().rstrip("."))
    return values


def swap_used_mb() -> float | None:
    out = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True,
                         timeout=10).stdout
    match = re.search(r"used = ([0-9.]+)M", out)
    return float(match.group(1)) if match else None


def booted_simulators() -> int | None:
    try:
        out = subprocess.run(["xcrun", "simctl", "list", "devices", "booted", "-j"],
                             capture_output=True, text=True, timeout=60).stdout
        return sum(len(devices) for devices in json.loads(out)["devices"].values())
    except Exception:  # noqa: BLE001 -- a failed count is recorded as unknown, never as zero
        return None


def process_snapshot() -> list[dict]:
    """Keep PID identity and unaggregated CPU for stack triggers, plus names for summaries."""
    out = subprocess.run(["ps", "-axo", "pid=,rss=,%cpu=,lstart=,comm="],
                         capture_output=True, text=True, timeout=10, check=True).stdout
    processes = []
    for line in out.splitlines():
        fields = line.strip().split(None, 8)
        if len(fields) != 9:
            continue
        try:
            processes.append(dict(pid=int(fields[0]), rss=int(fields[1]),
                                  cpu=float(fields[2].replace(",", ".")),
                                  started=" ".join(fields[3:8]), name=os.path.basename(fields[8])))
        except ValueError:
            continue
    return processes


def top_processes(processes: list[dict], limit: int = 8) -> tuple[list[list], list[list]]:
    memory: dict[str, int] = {}
    cpu: dict[str, float] = {}
    for process in processes:
        name = process["name"]
        memory[name] = memory.get(name, 0) + process["rss"]
        cpu[name] = cpu.get(name, 0.0) + process["cpu"]
    by_memory = sorted(memory.items(), key=lambda item: item[1], reverse=True)[:limit]
    by_cpu = sorted(cpu.items(), key=lambda item: item[1], reverse=True)[:limit]
    return [[name, kib // 1024] for name, kib in by_memory], [[name, round(p, 1)] for name, p in by_cpu]


class HotAppCapture:
    """One worker at a time, at most three captures in this job, never wait in the sample loop.

    Each worker has its own timeout even if the parent sampler is stopped. PID plus process start
    time prevents two different launches (or two sub-threshold processes' summed CPU) triggering.
    Stack logs sit beside the pressure log, in the existing failure-diagnostics upload glob.
    """
    def __init__(self, path: str, limit: int = 3):
        self.path = path
        self.limit = limit
        self.count = 0
        self.previous: set[tuple] = set()
        self.captured: set[tuple] = set()
        self.worker = None

    def observe(self, processes: list[dict]) -> None:
        hot = {(p["pid"], p["started"]) for p in processes
               if p["name"] in ("Dulcet", "Dulcet DEV") and p["cpu"] >= 90.0}
        eligible = hot & self.previous - self.captured
        self.previous = hot
        if self.worker is not None:
            if self.worker.poll() is None:
                return
            self.worker = None
        if self.count >= self.limit or not eligible:
            return
        pid, started = sorted(eligible)[0]
        self.count += 1
        self.captured.add((pid, started))
        output = str(Path(self.path).with_name(f"dulcet-hot-app-{self.count}-pid-{pid}.log"))
        try:
            self.worker = subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                "capture", str(pid), started, output, self.path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            append(self.path, dict(event="stack-capture-start", pid=pid, started=started,
                                   output=os.path.basename(output), capture=self.count))
        except OSError as error:
            append(self.path, dict(event="stack-capture-error", pid=pid, error=type(error).__name__))


def capture_stack(pid: int, started: str, output: str, pressure: str,
                  command: str = "/usr/bin/sample", timeout: float = 10) -> int:
    # Recheck in the worker before attaching: launches can exit while this worker starts.
    if not any(p["pid"] == pid and p["started"] == started and
               p["name"] in ("Dulcet", "Dulcet DEV") for p in process_snapshot()):
        append(pressure, dict(event="stack-capture-exited", pid=pid))
        return 0
    status = "error"
    try:
        with open(output + ".stderr.log", "w", encoding="utf-8") as log:
            result = subprocess.run([command, str(pid), "3", "-file", output],
                                    stdout=log, stderr=subprocess.STDOUT, timeout=timeout)
        status = "complete" if result.returncode == 0 else "error"
    except subprocess.TimeoutExpired:
        status = "timeout"
    except OSError:
        status = "unavailable"
    append(pressure, dict(event="stack-capture-end", pid=pid, status=status,
                          output=os.path.basename(output)))
    return 0


def append(path: str, record: dict) -> None:
    record = {"wallTimeMillis": time.time_ns() // 1_000_000, **record}
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, separators=(",", ":")) + "\n")


def sample(path: str, interval: float) -> int:
    append(path, {"event": "sampler-start", "pid": os.getpid(), "intervalSeconds": interval,
                  "memBytes": int(subprocess.run(["sysctl", "-n", "hw.memsize"],
                                                 capture_output=True, text=True).stdout or 0),
                  "cpus": os.cpu_count()})
    captures = HotAppCapture(path)
    while True:
        try:
            record = {"event": "sample", **vm_stat(), "swapUsedMb": swap_used_mb(),
                      "load1": os.getloadavg()[0]}
            processes = process_snapshot()
            record["top"], record["cpuTop"] = top_processes(processes)
            append(path, record)
            captures.observe(processes)
        except Exception as error:  # noqa: BLE001 -- keep sampling; record why one sample failed
            captures.previous.clear()
            append(path, {"event": "sample-error", "error": type(error).__name__})
        time.sleep(interval)


def mark(path: str, name: str) -> int:
    append(path, {"event": "phase", "name": name, "bootedSimulators": booted_simulators()})
    return 0


def summarize(path: str) -> int:
    records = [json.loads(line) for line in open(path, encoding="utf-8") if line.strip()]
    samples = [r for r in records if r.get("event") == "sample"]
    phases = [r for r in records if r.get("event") == "phase"]
    start = next((r for r in records if r.get("event") == "sampler-start"), {})
    if not samples or not phases:
        # A summary with nothing in it must not read as "no pressure".
        print(f"HOST PRESSURE UNAVAILABLE samples={len(samples)} phases={len(phases)}")
        return 1
    page_mb = (samples[0].get("page_bytes") or 16384) / 1_048_576
    print(f"HOST PRESSURE memBytes={start.get('memBytes')} cpus={start.get('cpus')} "
          f"samples={len(samples)} phases={len(phases)}")
    end_time = samples[-1]["wallTimeMillis"]
    for index, phase in enumerate(phases):
        begin = phase["wallTimeMillis"]
        end = phases[index + 1]["wallTimeMillis"] if index + 1 < len(phases) else end_time
        window = [s for s in samples if begin <= s["wallTimeMillis"] <= end]
        before = [s for s in samples if s["wallTimeMillis"] <= begin]
        base = before[-1] if before else (window[0] if window else None)
        if base is None or not window:
            print(f"HOST PRESSURE phase={phase['name']} samples=0")
            continue
        last = window[-1]
        deltas = {k: last.get(k, 0) - base.get(k, 0) for k in CUMULATIVE}
        swap = [s["swapUsedMb"] for s in window if s.get("swapUsedMb") is not None]
        compressor = [s.get("compressor_pages", 0) * page_mb for s in window]
        print(
            f"HOST PRESSURE phase={phase['name']} seconds={(end - begin) / 1000:.0f} "
            f"booted_simulators={phase.get('bootedSimulators')} samples={len(window)} "
            f"pageouts_mb={deltas['pageouts'] * page_mb:.0f} "
            f"swapouts_mb={deltas['swapouts'] * page_mb:.0f} "
            f"swapins_mb={deltas['swapins'] * page_mb:.0f} "
            f"pageins_mb={deltas['pageins'] * page_mb:.0f} "
            f"swap_used_max_mb={max(swap) if swap else 'unknown'} "
            f"compressor_max_mb={max(compressor):.0f} "
            f"load1_max={max(s.get('load1', 0) for s in window):.1f}"
        )
        # The process list from the phase's most swapped sample that carries one: what held the
        # memory when the phase was under the most pressure.
        listed = [s for s in window if s.get("top")]
        if listed:
            worst = max(listed, key=lambda s: (s.get("swapUsedMb") or 0, s.get("compressor_pages", 0)))
            print(f"HOST PRESSURE TOP phase={phase['name']} swap_used_mb={worst.get('swapUsedMb')} "
                  + ",".join(f"{name}:{mb}" for name, mb in worst["top"]))
        busy = [s for s in listed if s.get("cpuTop")]
        if busy:
            loaded = max(busy, key=lambda s: s.get("load1", 0))
            print(f"HOST PRESSURE CPU phase={phase['name']} load1={loaded.get('load1', 0):.1f} "
                  + ",".join(f"{name}:{percent}" for name, percent in loaded["cpuTop"]))
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 5 and argv[0] == "capture":
        return capture_stack(int(argv[1]), argv[2], argv[3], argv[4])
    if len(argv) >= 2 and argv[0] == "sample":
        output = argv[argv.index("--output") + 1]
        interval = float(argv[argv.index("--interval") + 1]) if "--interval" in argv else 5.0
        return sample(output, interval)
    if len(argv) == 3 and argv[0] == "mark":
        return mark(argv[1], argv[2])
    if len(argv) == 2 and argv[0] == "summarize":
        return summarize(argv[1])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
