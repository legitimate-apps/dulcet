#!/bin/bash
# Run the production home against the already-running disposable REST fixture.
# Called after each platform's first app proof, so it reuses its built products and simulator.
set -euo pipefail
: "${RUNNER_TEMP:?RUNNER_TEMP must be set}"
mode="${1:-}"
case "$mode" in
    iphone) scheme=DulcetiOS; destination='platform=iOS Simulator,name=iPhone 18 Pro,OS=latest'; derived=DulcetiOSDerivedData;;
    ipados) scheme=DulcetiOS; destination="${2:?iPad simulator destination required}"; derived=DulcetiPadOSDerivedData;;
    tvos) scheme=DulcetTV; destination='platform=tvOS Simulator,name=Apple TV 4K (3rd generation),OS=latest'; derived=DulcetTVDerivedData;;
    macos) scheme=DulcetMac; destination='platform=macOS'; derived=DulcetMacAppTestDerivedData ;;
    *) echo 'run-home-proof: mode must be iphone, ipados, tvos or macos' >&2; exit 2 ;;
esac
export TEST_RUNNER_DULCET_HOME_PROOF=1 TEST_RUNNER_DULCET_HOME_IDIOM="$mode"
export TEST_RUNNER_DULCET_DESIGN_TOUR=1 TEST_RUNNER_DULCET_DESIGN_TOUR_PHASE=home
export TEST_RUNNER_DULCET_UI_TEST_SERVER_URL=http://127.0.0.1:4533
export TEST_RUNNER_DULCET_UI_TEST_USERNAME=dulcet-admin
export TEST_RUNNER_DULCET_UI_TEST_PASSWORD=dulcet-ci-canary-password
result="$RUNNER_TEMP/dulcet-$mode-home.xcresult"
shots="$RUNNER_TEMP/dulcet-$mode-home-shots"
mkdir -p "$shots"
export TEST_RUNNER_DULCET_DESIGN_TOUR_OUT="$shots"
# The Mac test asks the owning shell to photograph only its hosted window. Simulator tests
# attach their own screenshots. A denied screen capture is explicitly logged as a view render.
serve_mac_captures() {
    local request stem window_id
    while kill -0 "$1" 2>/dev/null; do
        for request in "$shots"/*.request; do
            [ -f "$request" ] || continue
            stem="${request%.request}"
            window_id="$(cat "$request")"
            if [[ "$window_id" =~ ^[0-9]+$ ]] && screencapture -x -o -l"$window_id" "$stem.tmp.png" 2>/dev/null; then
                mv "$stem.tmp.png" "$stem.png"
            else
                touch "$stem.fallback"
            fi
            rm -f "$request"
        done
        sleep 0.2
    done
}
# Literal selectors and JUnit classes keep the CI source policy able to associate each
# evidence citation with the test actually invoked. The execution guard runs before emission.
run_home() {
    xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme "$scheme" -configuration Debug \
        -destination "$destination" -derivedDataPath "$RUNNER_TEMP/$derived" \
        -resultBundlePath "$result" -parallel-testing-enabled NO \
        -test-timeouts-enabled YES -default-test-execution-time-allowance 180 -maximum-test-execution-time-allowance 180 \
        "$1" 2>&1 | tee "$RUNNER_TEMP/dulcet-$mode-home.log" &
    proof_pid=$!
    if [ "$mode" = macos ]; then serve_mac_captures "$proof_pid"; fi
    wait "$proof_pid"
    if [ "$mode" = macos ]; then
        # The general design-tour test returns early unless opted in. Require actual Home
        # markers so an environment forwarding mistake cannot look green.
        grep -Fq 'DULCET DESIGN TOUR screen=listen-now reached=true' "$RUNNER_TEMP/dulcet-$mode-home.log"
        grep -Fq 'DULCET DESIGN TOUR screen=listen-now-return reached=true' "$RUNNER_TEMP/dulcet-$mode-home.log"
    fi
    python3 tools/verify-xcode-test-execution "$result" "$2" "$3"
}
case "$mode" in
macos)
    run_home -only-testing:DulcetMacTests/DulcetMacDesignTourTest/testDesignTour \
        DulcetMacTests.DulcetMacDesignTourTest testDesignTour
    python3 tools/swift-testing-junit \
        "$result" \
        "$RUNNER_TEMP/dulcet-macos-home-junit/TEST-ListenNow.xml" \
        DulcetMacDesignTourTest
    ;;
iphone)
    run_home -only-testing:DulcetiOSUITests/DulcetDesignTourUITests/testListenNowLaunchAlbumAndRelaunch \
        DulcetiOSUITests.DulcetDesignTourUITests testListenNowLaunchAlbumAndRelaunch
    python3 tools/swift-testing-junit \
        "$result" \
        "$RUNNER_TEMP/dulcet-iphone-home-junit/TEST-ListenNow.xml" \
        DulcetDesignTourUITests
    ;;
ipados)
    run_home -only-testing:DulcetiOSUITests/DulcetDesignTourUITests/testListenNowLaunchAlbumAndRelaunch \
        DulcetiOSUITests.DulcetDesignTourUITests testListenNowLaunchAlbumAndRelaunch
    python3 tools/swift-testing-junit \
        "$result" \
        "$RUNNER_TEMP/dulcet-ipados-home-junit/TEST-ListenNow.xml" \
        DulcetDesignTourUITests
    ;;
tvos)
    run_home -only-testing:DulcetTVUITests/DulcetTVUITests/testListenNowLaunchAlbumAndRelaunch \
        DulcetTVUITests.DulcetTVUITests testListenNowLaunchAlbumAndRelaunch
    python3 tools/swift-testing-junit \
        "$result" \
        "$RUNNER_TEMP/dulcet-tvos-home-junit/TEST-ListenNow.xml" \
        DulcetTVUITests
    ;;
esac
if [ "$mode" = iphone ] || [ "$mode" = ipados ]; then
    run_offline_settings() (
        # Keep the actual input/persistence receipts even when XCTest or the pipe fails.
        # The subshell's exit status remains the proof's original failure.
        app_log_name="dulcet-$mode-offline-settings"
        trap 'proof_status=$?; python3 tools/ci/app-log stop "$app_log_name" || true; exit "$proof_status"' EXIT
        python3 tools/ci/app-log start "$app_log_name" || true
    TEST_RUNNER_DULCET_OFFLINE_PROOF=1 TEST_RUNNER_DULCET_OFFLINE_IDIOM="$mode" \
        xcodebuild test-without-building \
        -project apple/Dulcet.xcodeproj -scheme "$scheme" -configuration Debug \
        -destination "$destination" -derivedDataPath "$RUNNER_TEMP/$derived" \
        -resultBundlePath "$RUNNER_TEMP/dulcet-$mode-offline-settings.xcresult" \
        -parallel-testing-enabled NO -test-timeouts-enabled YES \
        -default-test-execution-time-allowance 180 -maximum-test-execution-time-allowance 180 \
        -only-testing:DulcetiOSUITests/DulcetDesignTourUITests/testOfflineMusicSettingsPersistAcrossRelaunch \
        2>&1 | tee "$RUNNER_TEMP/dulcet-$mode-offline-settings.log"
    python3 tools/verify-xcode-test-execution \
        "$RUNNER_TEMP/dulcet-$mode-offline-settings.xcresult" \
        DulcetiOSUITests.DulcetDesignTourUITests testOfflineMusicSettingsPersistAcrossRelaunch
    python3 tools/swift-testing-junit "$RUNNER_TEMP/dulcet-$mode-offline-settings.xcresult" \
        "$RUNNER_TEMP/dulcet-$mode-home-junit/TEST-OfflineSettings.xml" DulcetDesignTourUITests
    )
    run_offline_settings
fi
