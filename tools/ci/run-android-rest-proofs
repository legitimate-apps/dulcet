#!/usr/bin/env python3
"""Run ordinary REST device controls and retain Home photos before the emulator shuts down."""
from pathlib import Path
import os
import subprocess
import sys

task, surface = sys.argv[1:]
package = 'com.legitimateapps.dulcet.tv' if surface == 'tv' else 'com.legitimateapps.dulcet.dev'
fixture_class = (f'{package}.AndroidTvMyLibraryProofTest' if surface == 'tv'
                 else 'com.legitimateapps.dulcet.AndroidEmulatorMyLibraryProofTest')
# This method requires dulcetLibrary. Exclude it entirely from the ordinary REST
# invocation so parity evidence contains no skipped duplicate before its real fixture run.
fixture_only = f'{fixture_class}#automaticLibraryRetentionAndSameResponseCachePlayOffline'
try:
    subprocess.run(['./gradlew', '--no-daemon', '--max-workers=2', task,
                    '-Pandroid.testInstrumentationRunnerArguments.dulcetServerUrl=http://10.0.2.2:4533',
                    '-Pandroid.testInstrumentationRunnerArguments.dulcetServerDisposable=true',
                    f'-Pandroid.testInstrumentationRunnerArguments.notClass={fixture_only}'], check=True)
finally:
    subprocess.run(['adb', '-s', 'emulator-5554', 'pull',
                    f'/data/local/tmp/dulcet-listen-now-{package}',
                    str(Path(os.environ['RUNNER_TEMP']) / 'listen-now-fallback-shots')], check=True)
    photos = list((Path(os.environ['RUNNER_TEMP']) / 'listen-now-fallback-shots').rglob('listen-now-*.jpg'))
    assert len(photos) >= 3, f'Expected retained Home photographs, observed {len(photos)}'
