#!/usr/bin/env python3
"""Compile the actual Swift trace and leave stderr unread to simulate log backpressure."""
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
(root / 'build').mkdir(exist_ok=True)
source = (root / 'apple/DulcetPlaybackIntegrationTests/DulcetAppleDownloadIntegrationTest.swift').read_text()
start = source.index('private final class DownloadBrowseTrace:')
end = source.index('\n\n\n/// Two bounded', start)
with tempfile.TemporaryDirectory(prefix='browse-trace-', dir=root / 'build') as tmp:
    tmp = Path(tmp)
    control = tmp / 'Trace.swift'
    control.write_text('import Foundation\n' + source[start:end] + '''
private let trace = DownloadBrowseTrace()
DispatchQueue.concurrentPerform(iterations: 4096) { index in
    trace.mark("request=\\(index) headers-received")
    trace.mark("request=\\(index) body-completed hop=0")
}
precondition(trace.observedHTTPCompletion)
let summary = trace.summary
precondition(summary.components(separatedBy: "; ").count == 128)
precondition(summary.contains("LIBRARY BROWSE elapsed="))
print("trace returned and summary remained available with unread stderr")
''')
    binary = tmp / 'trace'
    subprocess.run(['xcrun', 'swiftc', '-swift-version', '6', str(control), '-o', str(binary)], check=True)
    process = subprocess.Popen([str(binary)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        # Do not drain stderr until the process exits. A synchronous writer fills the pipe.
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        process.kill()
        process.communicate()
        raise AssertionError('trace blocked while stderr was backpressured') from None
    stdout, stderr = process.communicate()
    assert process.returncode == 0, stderr.decode()
    print(stdout.decode(), end='')
