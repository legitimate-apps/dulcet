#!/usr/bin/env python3

"""Mutation-sensitive control for the final Darwin bottle hash/install boundary.

The property under test is that the artifact whose checksum is verified is the artifact Homebrew
pours. A by-name install never names a path, so that property holds only while the hash is taken
from the path Homebrew itself reports for the formula and bottle tag it is about to install. The
`cache-corrupt` scenario is the one that fails if verification is ever re-pointed somewhere else:
it corrupts the file Homebrew would pour and leaves a pristine copy of the pinned bytes elsewhere,
so a checksum aimed at any other copy passes and reaches an install it should have refused.
"""

import hashlib
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import sys
import tempfile


sys.path.insert(0, str(Path(__file__).parent / "conformance-env"))
installer = SourceFileLoader(
    "install_darwin_ffmpeg_integrity_gate",
    str(Path(__file__).parent / "conformance-env" / "install-darwin-ffmpeg"),
).load_module()


PAYLOAD = b"known pinned bottle bytes"
CORRUPT_PAYLOAD = b"corrupt bytes in the artifact Homebrew would pour"
BOTTLE_BASENAME = "negative-control--1.0.arm64_tahoe.bottle.tar.gz"


class InstallObserved(Exception):
    """Stop the stubbed installer immediately after observing its install attempt."""


def pinned_entry(payload: bytes) -> dict:
    digest = hashlib.sha256(payload).hexdigest()
    return {
        "formula": "negative-control",
        "version": "1.0",
        "revision": 0,
        "version_scheme": 0,
        "dependencies": [],
        "bottle_tag": "arm64_tahoe",
        "bottle_rebuild": 0,
        "url": (
            f"https://ghcr.io/v2/homebrew/core/negative-control/blobs/sha256:{digest}"
        ),
        "sha256": digest,
    }


def resolver_document(entry: dict) -> str:
    return json.dumps(
        {
            "formulae": [
                {
                    "name": entry["formula"],
                    "versions": {
                        "stable": entry["version"],
                        "version_scheme": entry["version_scheme"],
                    },
                    "revision": entry["revision"],
                    "version_scheme": entry["version_scheme"],
                    "dependencies": entry["dependencies"],
                    "bottle": {
                        "stable": {
                            "rebuild": entry["bottle_rebuild"],
                            "files": {
                                entry["bottle_tag"]: {
                                    "url": entry["url"],
                                    "sha256": entry["sha256"],
                                }
                            },
                        }
                    },
                }
            ],
            "casks": [],
        }
    )


def write_pins(path: Path, entry: dict) -> None:
    path.write_text(
        json.dumps(
            {
                "ffmpeg": {
                    "darwin": {
                        "formula": entry["formula"],
                        "version": entry["version"],
                        "path": "/stub/ffmpeg",
                        "required_encoders": [],
                        "closure": [entry],
                    }
                }
            }
        )
    )


def exercise_receipt_helpers(root: Path) -> dict[str, bool]:
    entry = pinned_entry(PAYLOAD)
    receipt_path = root / "INSTALL_RECEIPT.json"
    receipt_path.write_text(
        json.dumps(
            {
                "source": {"versions": {"stable": "1.0", "version_scheme": 0}},
                "built_as_bottle": True,
                "poured_from_bottle": True,
                "runtime_dependencies": [{"full_name": "live-drift"}],
            }
        )
    )
    normalized = installer.normalize_runtime_receipt(
        receipt_path, entry, {entry["formula"]: entry}
    )
    installer.assert_receipt_shape(
        normalized,
        entry,
        {entry["formula"]: entry},
        context="negative-control installed keg",
        require_poured=True,
    )
    receipt_drift_replaced = normalized["runtime_dependencies"] == []
    if not receipt_drift_replaced:
        raise SystemExit(f"live receipt drift survived normalization: {normalized}")
    return {"receipt_drift_replaced": receipt_drift_replaced}


class Scenario:
    """One stubbed Homebrew, recording what was asked for and what was verified."""

    def __init__(self, root: Path, name: str, *, tamper_after_shape: bool, corrupt_cache: bool):
        self.entry = pinned_entry(PAYLOAD)
        self.name = name
        self.tamper_after_shape = tamper_after_shape
        self.corrupt_cache = corrupt_cache
        self.events: list[str] = []
        self.cache_query_paths: list[str] = []
        self.verified_paths: list[Path] = []
        self.install_arguments: list[list[str]] = []

        self.brew_cache = root / f"{name}-brew-cache"
        self.brew_cache.mkdir()
        self.cache_path = self.brew_cache / BOTTLE_BASENAME

        # The pristine pinned bytes in a directory Homebrew never consults, at the location a
        # separately-managed bottle cache would occupy. A checksum aimed at any copy other than
        # the one Homebrew reports is satisfied by this file instead.
        self.decoy_directory = self.brew_cache / "dulcet" / "darwin-conformance-bottles"
        self.decoy_directory.mkdir(parents=True)
        (self.decoy_directory / BOTTLE_BASENAME).write_bytes(PAYLOAD)

        self.pins_path = root / f"{name}-pins.json"
        write_pins(self.pins_path, self.entry)

    def stub_run(self, arguments: list[str], **_kwargs) -> str:
        name = self.entry["formula"]
        tag = self.entry["bottle_tag"]
        if arguments == ["brew", "update"]:
            self.events.append("brew-update")
            return ""
        if arguments == ["brew", "info", "--json=v2", name]:
            self.events.append("brew-info")
            return resolver_document(self.entry)
        if arguments == ["brew", "fetch", "--force", "--force-bottle", name]:
            self.events.append("brew-fetch")
            self.cache_path.write_bytes(
                CORRUPT_PAYLOAD if self.corrupt_cache else PAYLOAD
            )
            return ""
        if arguments == ["brew", "--cache", f"--bottle-tag={tag}", name]:
            self.events.append("brew-cache-path")
            self.cache_query_paths.append(str(self.cache_path))
            return str(self.cache_path)
        if arguments == ["brew", "--cellar"]:
            self.events.append("brew-cellar")
            return str(self.brew_cache.parent / f"{self.name}-cellar")
        if arguments == ["brew", "--prefix"]:
            self.events.append("brew-prefix")
            return str(self.brew_cache.parent / f"{self.name}-prefix")
        if arguments[:2] == ["brew", "install"]:
            self.events.append("brew-install")
            self.install_arguments.append(arguments)
            raise InstallObserved
        raise AssertionError(f"unexpected command before install observation: {arguments}")

    def stub_archive_shape(self, _path: Path, _entry: dict) -> int:
        self.events.append("archive-metadata")
        if self.tamper_after_shape:
            self.cache_path.write_bytes(PAYLOAD + b"\ntampered after archive-metadata check")
            self.events.append("tamper")
        return 0

    def recorded_verify(self, path: Path, expected: dict) -> str:
        self.events.append("final-hash-start")
        self.verified_paths.append(Path(path))
        observed = self.original_verify(path, expected)
        self.events.append("final-hash-pass")
        return observed

    def run(self) -> str:
        originals = {
            "run": installer.run,
            "assert_bottle_archive_shape": installer.assert_bottle_archive_shape,
            "advise_live_shape": installer.advise_live_shape,
            "installed_formula_versions": installer.installed_formula_versions,
            "observe_keg": installer.observe_keg,
            "verify_bottle_checksum": installer.verify_bottle_checksum,
            "platform_system": installer.platform.system,
            "platform_machine": installer.platform.machine,
        }
        self.original_verify = originals["verify_bottle_checksum"]

        def stub_advisory(_closure: list[dict]) -> tuple[str, list[dict]]:
            self.events.append("live-shape-advisory")
            return "unavailable", []

        def stub_installed_versions(_name: str) -> list[str]:
            self.events.append("installed-versions")
            return []

        def stub_observe_keg(_path: Path) -> None:
            self.events.append("observe-keg")
            return None

        try:
            installer.run = self.stub_run
            installer.assert_bottle_archive_shape = self.stub_archive_shape
            installer.advise_live_shape = stub_advisory
            installer.installed_formula_versions = stub_installed_versions
            installer.observe_keg = stub_observe_keg
            installer.verify_bottle_checksum = self.recorded_verify
            installer.platform.system = lambda: "Darwin"
            installer.platform.machine = lambda: "arm64"
            try:
                installer.main(self.pins_path)
            except InstallObserved:
                return "install-observed"
            except SystemExit as error:
                return str(error)
            raise SystemExit("stubbed main returned before reaching or rejecting brew install")
        finally:
            installer.run = originals["run"]
            installer.assert_bottle_archive_shape = originals["assert_bottle_archive_shape"]
            installer.advise_live_shape = originals["advise_live_shape"]
            installer.installed_formula_versions = originals["installed_formula_versions"]
            installer.observe_keg = originals["observe_keg"]
            installer.verify_bottle_checksum = originals["verify_bottle_checksum"]
            installer.platform.system = originals["platform_system"]
            installer.platform.machine = originals["platform_machine"]


def main() -> None:
    with tempfile.TemporaryDirectory() as temporary_directory:
        root = Path(temporary_directory)
        helper = exercise_receipt_helpers(root)

        authentic = Scenario(root, "authentic", tamper_after_shape=False, corrupt_cache=False)
        authentic_outcome = authentic.run()
        expected_suffix = ["final-hash-start", "final-hash-pass", "brew-install"]
        if authentic_outcome != "install-observed" or authentic.events[-3:] != expected_suffix:
            raise SystemExit(
                "main did not bind the final successful hash to the next brew install attempt: "
                f"outcome={authentic_outcome!r} events={authentic.events}"
            )

        # The property, asserted from what was recorded rather than from reading the source: the
        # path that was hashed is the path Homebrew reported, and the install names that formula.
        queried = [Path(path) for path in authentic.cache_query_paths]
        verified_path_is_brew_cache_path = queried == authentic.verified_paths and len(queried) == 1
        if not verified_path_is_brew_cache_path:
            raise SystemExit(
                "the verified artifact is not the artifact Homebrew was asked to pour: "
                f"brew_cache_query={authentic.cache_query_paths} "
                f"verified={[str(path) for path in authentic.verified_paths]}"
            )
        expected_install = ["brew", "install", "--force-bottle", authentic.entry["formula"]]
        if authentic.install_arguments != [expected_install]:
            raise SystemExit(
                "install did not name the formula whose cached artifact was verified: "
                f"expected={[expected_install]} observed={authentic.install_arguments}"
            )

        tampered = Scenario(root, "tampered", tamper_after_shape=True, corrupt_cache=False)
        tampered_outcome = tampered.run()
        if "pinned bottle checksum mismatch for negative-control" not in tampered_outcome:
            raise SystemExit(
                "main did not reject a bottle changed after its archive-metadata check: "
                f"outcome={tampered_outcome!r} events={tampered.events}"
            )
        if tampered.events.count("final-hash-start") != 1:
            raise SystemExit(
                f"tampered scenario did not reach exactly one final hash: {tampered.events}"
            )
        if "final-hash-pass" in tampered.events or "brew-install" in tampered.events:
            raise SystemExit(
                f"tampered bottle reached a successful hash or install: {tampered.events}"
            )

        # Corrupt only what Homebrew would pour. A pristine copy of the pinned bytes sits in a
        # directory Homebrew never reads, so this run fails ONLY while the checksum follows the
        # artifact Homebrew reported. Verifying any other copy passes and reaches the install.
        corrupt = Scenario(root, "cache-corrupt", tamper_after_shape=False, corrupt_cache=True)
        corrupt_outcome = corrupt.run()
        if "pinned bottle checksum mismatch for negative-control" not in corrupt_outcome:
            raise SystemExit(
                "the checksum did not follow the artifact Homebrew would pour: a corrupt cached "
                "bottle was accepted while a pristine copy existed elsewhere. "
                f"outcome={corrupt_outcome!r} events={corrupt.events} "
                f"brew_cache_query={corrupt.cache_query_paths} "
                f"verified={[str(path) for path in corrupt.verified_paths]}"
            )
        if "brew-install" in corrupt.events:
            raise SystemExit(
                f"corrupt cached bottle reached an install: {corrupt.events}"
            )
        if corrupt.verified_paths != [corrupt.cache_path]:
            raise SystemExit(
                "the rejected checksum was not taken from the artifact Homebrew reported: "
                f"verified={[str(path) for path in corrupt.verified_paths]} "
                f"brew_cache_query={corrupt.cache_query_paths}"
            )

        print(
            "NEGATIVE CONTROL PASS darwin_bottle_integrity "
            f"authentic_final_hash_calls={authentic.events.count('final-hash-start')} "
            f"authentic_install_attempts={authentic.events.count('brew-install')} "
            f"verified_path_is_brew_cache_path={str(verified_path_is_brew_cache_path).lower()} "
            f"tampered_final_hash_calls={tampered.events.count('final-hash-start')} "
            f"tampered_install_attempts={tampered.events.count('brew-install')} "
            f"cache_corrupt_install_attempts={corrupt.events.count('brew-install')} "
            "cache_corrupt_rejected=true "
            f"receipt_drift_replaced={str(helper['receipt_drift_replaced']).lower()} "
            f"authentic_events={','.join(authentic.events)} "
            f"tampered_events={','.join(tampered.events)} "
            f"cache_corrupt_events={','.join(corrupt.events)}"
        )


if __name__ == "__main__":
    main()
