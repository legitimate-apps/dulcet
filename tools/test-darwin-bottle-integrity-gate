#!/usr/bin/env python3

"""Negative control proving a tampered cached Darwin bottle is rejected before use."""

import hashlib
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import sys
import tempfile


sys.path.insert(0, str(Path(__file__).parent / "conformance-env"))
installer = SourceFileLoader(
    "install_darwin_ffmpeg_integrity_gate",
    str(Path(__file__).parent / "conformance-env" / "install-darwin-ffmpeg"),
).load_module()


def main() -> None:
    original = b"known pinned bottle bytes"
    expected_sha256 = hashlib.sha256(original).hexdigest()
    entry = {
        "formula": "negative-control",
        "version": "1.0",
        "revision": 0,
        "version_scheme": 0,
        "dependencies": [],
        "bottle_tag": "arm64_tahoe",
        "bottle_rebuild": 0,
        "url": (
            "https://ghcr.io/v2/homebrew/core/negative-control/blobs/"
            f"sha256:{expected_sha256}"
        ),
        "sha256": expected_sha256,
    }

    with tempfile.TemporaryDirectory() as temporary_directory:
        cache_directory = Path(temporary_directory)
        bottle = cache_directory / installer.bottle_cache_filename(entry)

        def reject_network_attempt(_: str) -> str:
            raise AssertionError("cache hit attempted GHCR authentication")

        installer.ghcr_pull_token = reject_network_attempt
        bottle.write_bytes(original)
        cached_path, observed_sha256, cache_hit = installer.fetch_pinned_bottle(
            entry, cache_directory
        )
        if cached_path != bottle or observed_sha256 != expected_sha256 or cache_hit is not True:
            raise SystemExit(
                "authentic cached bottle was not accepted as an offline cache hit: "
                f"path={cached_path} sha256={observed_sha256} cache_hit={cache_hit}"
            )

        bottle.write_bytes(original + b"\ntampered")
        observed_tampered_sha256 = installer.file_sha256(bottle)
        expected_detail = (
            "pinned bottle checksum mismatch for negative-control: "
            f"expected {expected_sha256}, observed {observed_tampered_sha256}"
        )
        try:
            installer.fetch_pinned_bottle(entry, cache_directory)
        except SystemExit as error:
            observed_detail = str(error)
            if observed_detail != expected_detail:
                raise SystemExit(
                    "bottle integrity negative control rejected for the wrong reason: "
                    f"expected_detail={expected_detail!r} observed_detail={observed_detail!r}"
                ) from error
        else:
            raise SystemExit("bottle integrity negative control failed open")

        receipt_path = cache_directory / "INSTALL_RECEIPT.json"
        receipt_path.write_text(
            json.dumps(
                {
                    "source": {"versions": {"stable": "1.0", "version_scheme": 0}},
                    "built_as_bottle": True,
                    "poured_from_bottle": True,
                    "runtime_dependencies": [{"full_name": "live-drift"}],
                }
            )
        )
        normalized = installer.normalize_runtime_receipt(
            receipt_path, entry, {entry["formula"]: entry}
        )
        installer.assert_receipt_shape(
            normalized,
            entry,
            {entry["formula"]: entry},
            context="negative-control installed keg",
            require_poured=True,
        )

        print(
            "NEGATIVE CONTROL PASS darwin_bottle_integrity "
            "authentic_blob_accepted=true tampered_blob_rejected=true "
            "network_attempted=false install_attempted=false "
            "live_receipt_drift_replaced_from_pin=true "
            f"expected_sha256={expected_sha256} observed_tampered_sha256={observed_tampered_sha256}"
        )


if __name__ == "__main__":
    main()
