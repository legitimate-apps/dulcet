#!/usr/bin/env python3
"""Offline controls for the opt-in experiment. No simulator, fixture server or Xcode run."""
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch
import json
import os
import runpy
import signal
import subprocess
import tempfile

REPO = Path(__file__).resolve().parent.parent
m = runpy.run_path(str(REPO / 'tools/ci/apsd-experiment'))
g = m['find_target'].__globals__
# Exact runtime layout retained by both device artifacts of run 40261216579.
root = '/Library/Developer/CoreSimulator/Volumes/iOS_23F77/Library/Developer/CoreSimulator/Profiles/Runtimes/iOS 26.5.simruntime/Contents/Resources/RuntimeRoot'
process = dict(pid=123, started='launch-1', executable=root + '/System/Library/PrivateFrameworks/ApplePushService.framework/apsd', state='S')
target = dict(udid='selected-device', runtimeRoot=root, process=process, suspended=False)

def simctl(*args):
    if args == ('spawn', 'selected-device', 'launchctl', 'list'):
        return 'PID\tStatus\tLabel\n123\t0\tcom.apple.apsd\n124\t0\tcom.apple.other'
    assert args == ('getenv', 'selected-device', 'SIMULATOR_ROOT'), args
    return root

with patch.dict(g, simctl=simctl), patch.dict(m['ISOLATE'], devices=lambda _: {}, booted=lambda _: ['selected-device']):
    with patch.dict(m['PRESSURE'], process_snapshot=lambda: [process]):
        witnesses = []
        assert m['find_target']('selected-device', witness=lambda **r: witnesses.append(r))['process'] == process
        assert witnesses[0]['servicePid'] == 123
        assert witnesses[0]['expectedExecutable'] == process['executable']
        assert witnesses[0]['observedProcesses'] == [process]
    for invalid in [dict(process, executable='/usr/libexec/apsd'), dict(process, state='T'),
                    dict(process, executable=process['executable'].replace('iOS_23F77', 'iOS_other')),
                    dict(process, executable=process['executable'] + '-other'), dict(process, pid=999)]:
        with patch.dict(m['PRESSURE'], process_snapshot=lambda: [invalid]):
            try:
                m['find_target']('selected-device')
            except RuntimeError:
                pass
            else:
                raise AssertionError('host/wrong runtime/wrong executable/wrong PID or prior suspension accepted')
    with patch.dict(m['ISOLATE'], booted=lambda _: ['selected-device', 'other-device']):
        try:
            m['find_target']('selected-device')
        except RuntimeError:
            pass
        else:
            raise AssertionError('multiple booted devices accepted')
print('TARGET CONTROL PASS scoped launchctl, runtime path, one device, prior suspension refused')

with tempfile.TemporaryDirectory() as tmp:
    state = Path(tmp) / 'restore.json'
    changing = dict(process)
    def kill(pid, sig):
        assert pid == 123
        # Intent must be durable BEFORE STOP, including the cancellation race.
        if sig == signal.SIGSTOP:
            assert json.loads(state.read_text())['suspended'] is True
        changing['state'] = 'T' if sig == signal.SIGSTOP else 'S'
    owned = dict(target)
    with patch.dict(m['PRESSURE'], process_snapshot=lambda: [changing]), patch('os.kill', side_effect=kill) as signals:
        m['set_suspended'](owned, state, True)
        assert owned['suspended'] and changing['state'] == 'T'
        m['restore'](state)
        assert not json.loads(state.read_text())['suspended'] and changing['state'] == 'S'
        assert signals.call_count == 2
        m['restore'](state)
        assert signals.call_count == 2  # idempotent
    for replacement in [dict(process, started='launch-2'), dict(process, executable='/usr/libexec/apsd')]:
        m['save'](state, dict(target, suspended=True))
        with patch.dict(m['PRESSURE'], process_snapshot=lambda: [replacement]), patch('os.kill') as signals:
            m['restore'](state)
            signals.assert_not_called()
            assert json.loads(state.read_text())['targetExitedBeforeRestore']
    print('RESTORE CONTROL PASS intent, STOP/CONT, repeated cleanup and PID/path reuse guards')

    # Exercise real kernel suspension/resumption ONLY on our own disposable host child.
    child = subprocess.Popen(['/bin/sleep', '20'])
    try:
        launch = next(p for p in m['PRESSURE']['process_snapshot']() if p['pid'] == child.pid)
        owned = dict(target, process=launch)
        m['set_suspended'](owned, state, True)
        assert 'T' in m['current'](owned)['state']
        m['restore'](state)
        assert 'T' not in m['current'](owned)['state']
    finally:
        child.terminate()
        child.wait(timeout=5)
    print('SIGNAL CONTROL PASS actual disposable host child stopped, witnessed and resumed')

    # A persisted positive, unrelated PID and a loss event. Never attach a live stream.
    output = Path(tmp)
    def replay_command(command, **kwargs):
        assert command[:5] == ['xcrun', 'simctl', 'spawn', 'selected-device', 'log']
        assert 'show' in command and 'stream' not in command
        assert '--start' in command and '--end' in command
        for row in [dict(processID=123, timestamp='1970-01-01 00:02:00.123+0000', eventMessage='Abort getting client certificate identity'),
                    dict(processID=123, timestamp='1970-01-01 00:01:39.999+0000'),
                    dict(processID=123, timestamp='1970-01-01 00:02:40.001+0000'),
                    dict(processID=999, eventMessage='unrelated'), dict(eventType='lossEvent')]:
            kwargs['stdout'].write(json.dumps(row) + '\n')
        return SimpleNamespace(returncode=0)
    result = dict(arm='a1', startMillis=100000, endMillis=160000, seconds=60)
    with patch('subprocess.run', side_effect=replay_command):
        rate = m['replay'](output, target, result)
    assert rate['apsdEvents'] == 1 and rate['certificateAbortOrIdentityEvents'] == 1
    assert rate['eventsPerSecond'] == 1 / 60 and rate['lossRecords'] == 1
    assert rate['outsideWindowEvents'] == 2 and rate['unparsedTargetTimestamps'] == 0
    with patch('subprocess.run', return_value=SimpleNamespace(returncode=0)):
        assert not m['replay'](output, target, result)['valid'], 'missing positive is invalid, never quiet'
        assert m['replay'](output, target, dict(result, arm='b'))['apsdEvents'] == 0
    print('RATE CONTROL PASS bounded offline replay, exact PID, loss record, positive required')

# Orchestration: even a failed baseline must execute B/A2, keep unique fixture roots and fail.
for failing_arm in (None, 'a1', 'b', 'a2', 'canonical'):
    with tempfile.TemporaryDirectory() as tmp:
        output = Path(tmp)
        args = SimpleNamespace(device='iphone', root=output / 'fixture', music=output / 'music',
                               ffmpeg='ffmpeg', ffprobe='ffprobe')
        arms, fixtures, transitions = [], [], []
        def command(argv, output, target, arm, **kwargs):
            arms.append(arm)
            fixtures.append(argv[argv.index('--root') + 1])
            if arm != 'canonical':
                assert kwargs['env']['DULCET_APSD_PROBE_ARM'] == arm
            return 65 if arm == failing_arm else 0
        with patch.dict(os.environ, RUNNER_TEMP=tmp), patch.dict(g, simctl=simctl, mark=lambda _: None, find_target=lambda _, **kwargs: dict(target),
            set_suspended=lambda t, s, stop: transitions.append(stop), window=lambda o, t, a, s: dict(arm=a, cpuReadingsAvailable=True),
            replay=lambda o, t, r: dict(eventsPerSecond=0 if r['arm'] == 'b' else 10, valid=True),
            run_command=command), patch.dict(m['ISOLATE'], devices=lambda _: {}, resolve_name=lambda *_: 'selected-device'), patch('subprocess.run'):
            code = m['experiment'](args, output, output / 'restore.json')
        assert code == int(failing_arm is not None), (failing_arm, code)
        assert arms == ['a1', 'b', 'a2', 'canonical'] and len(set(fixtures)) == 4
        assert transitions == [False, True, False, False, True, False]
print('ORCHESTRATION CONTROL PASS A/B/A, fresh fixtures, failed baseline never replaced')

# Subprocess cancellation must reap its exact group before main's restoration.
with tempfile.TemporaryDirectory() as tmp:
    fake = SimpleNamespace(pid=123456, poll=lambda: None)
    waits = iter([KeyboardInterrupt(), 0])
    def wait(**kwargs):
        value = next(waits)
        if isinstance(value, BaseException):
            raise value
        return value
    fake.wait = wait
    with patch.dict(g, mark=lambda _: None, current=lambda _: process), patch('subprocess.Popen', return_value=fake), patch('os.killpg') as group:
        try:
            m['run_command'](['fixture-command'], Path(tmp), target, 'a1')
        except KeyboardInterrupt:
            pass
        else:
            raise AssertionError('interruption swallowed')
        group.assert_called_once_with(123456, signal.SIGTERM)
print('CANCELLATION CONTROL PASS exact fixture group terminated, interruption propagated')

# The comparison entry point shares the required device allowance and one test selector.
script = (REPO / 'tools/ci/run-my-library-proofs').read_text()
probe = script.split('if [ -n "${DULCET_APSD_PROBE_ARM:-}" ]; then', 1)[1].split('\nfi', 1)[0]
assert probe.count('-only-testing:') == 1 and 'testBrowseAddRemoveRelaunchAndOfflineReplay' in probe
assert '"$device_test_allowance"' in probe
assert script.count('-maximum-test-execution-time-allowance "$device_test_allowance"') == 3
assert 'isolate-simulator' not in probe
print('PROBE CONTROL PASS same allowance and unchanged method, separate bundle, no selected quiet window')

# Main restores even when a signal interrupts immediately after the suspension intent.
with tempfile.TemporaryDirectory() as tmp:
    output = Path(tmp) / 'dulcet-apsd-experiment'
    def interrupted_experiment(args, out, state):
        m['save'](state, dict(target, suspended=True))
        raise SystemExit(143)
    restored = []
    def record_restore(state):
        saved = json.loads(state.read_text())
        restored.append(saved)
        m['save'](state, dict(saved, suspended=False))
    with patch.dict(os.environ, RUNNER_TEMP=tmp, GITHUB_EVENT_NAME='workflow_dispatch', DULCET_APSD_EXPERIMENT='true'), patch('sys.argv', ['apsd-experiment', '--device', 'iphone', '--root', 'fixture', '--music', 'music', '--ffmpeg', 'ffmpeg', '--ffprobe', 'ffprobe']), patch.dict(g, experiment=interrupted_experiment, restore=record_restore, mark=lambda _: None, collect_activity_evidence=lambda *_: None):
        previous = {s: signal.getsignal(s) for s in (signal.SIGINT, signal.SIGTERM)}
        try:
            try:
                m['main']()
            except SystemExit as error:
                assert error.code == 143
            else:
                raise AssertionError('signal did not propagate')
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)
    assert len(restored) == 1 and restored[0]['suspended'] is True
print('MAIN CLEANUP CONTROL PASS interrupted experiment always invokes exact-launch restoration')

# Exact activity finish times distinguish an actual query from the enclosing 20-second wait.
def val(value):
    return dict(_value=value)
def activity(title, start, finish):
    return dict(_type=dict(_name='ActionTestActivitySummary'), title=val(title),
                start=val('2026-10-25T00:00:' + start + '+0000'),
                finish=val('2026-10-25T00:00:' + finish + '+0000'))
detail = dict(duration=val('30.5'), testStatus=val('Failure'), activities=[
    activity('Start Test', '00.000', '00.100'),
    activity('Setting up automation session', '07.500', '10.000'),
    activity('Wait 20 seconds', '10.000', '30.000'),
    activity('Find the Button', '10.100', '29.400')])
metrics = m['activity_metrics'](detail)
assert metrics['testSeconds'] == 30.5 and metrics['firstAutomationSeconds'] == 7.5
assert metrics['queryMaxSeconds'] == 19.3 and len(metrics['queryActivities']) == 1
assert metrics['testStatus'] == 'Failure' and metrics['nestedActivities'] is True
print('ACTIVITY CONTROL PASS exact query duration, automation offset and failed test retained')
