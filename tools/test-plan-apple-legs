def control(label, edit, original=responses):
    documents = copy.deepcopy(original)
    edit(documents)
    actual = replay(documents)
    expect(actual[:2] == (True, True), f"{label} wrongly skipped: {actual}")
    print(f"PROOF FALLBACK PASS: {label}: {actual[2]}")


def run_edit(path, key, value):
    def edit(documents):
        documents[path][key] = value
    return edit


def job_edit(path, name, key, value):
    def edit(documents):
        next(job for job in documents[path]["jobs"] if job["name"] == name)[key] = value
    return edit


