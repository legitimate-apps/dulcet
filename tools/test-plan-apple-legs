import importlib.util
from pathlib import Path
import os
import copy
import json
import re
from unittest.mock import patch
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
TOOL = Path(os.environ.get("PLAN_APPLE_LEGS_UNDER_TEST", ROOT / "tools/ci/plan-apple-legs"))
_spec = importlib.util.spec_from_loader("plan_apple_legs", SourceFileLoader("plan_apple_legs", str(TOOL)))
planner = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(planner)
checks = 0


def expect(condition: bool, message: str) -> None:
    global checks
    if not condition:
        raise AssertionError(message)
    checks += 1


