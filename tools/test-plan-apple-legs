# Synthetic future descendants test the bounded walk and receipt equality, anchored on the real full run.
def child_of(record, index):
    result = copy.deepcopy(record)
    parent_sha = record["sha"]
    child_sha = f"{index:040x}"
    parent_proof = parent_replay(record)
    expect(parent_proof[:2] == (False, False), "test chain parent must actually qualify")
    run_id = 50000000000 + index
    rp = f"/repos/{repository}/actions/runs/{run_id}"
    run = dict(record["responses"][parent_run], id=run_id, head_sha=parent_sha)
    result["responses"][rp] = run
    result["responses"][f"/repos/{repository}/actions/workflows/341254656/runs?head_sha={parent_sha}&per_page=100&page=1"] = {
        "total_count": 1, "workflow_runs": [run]}
    jobs = []
    proof_api = planner.GitHub("", str(parent_fixture)); proof_api.responses = record["responses"]
    extra_jobs = planner.discover_jobs_at(proof_api, repository, record["parent"])
    for i, name in enumerate(("apple-plan", "apple-ci", "apple-platform", "apple-conformance-core", "apple-conformance-${{ matrix.device }}") + tuple(sorted(extra_jobs))):
        jobs.append({"id": run_id + 100 + i, "name": name, "run_id": run_id, "run_attempt": 1,
                     "head_sha": parent_sha, "status": "completed", "conclusion": "success" if i < 2 else "skipped"})
    result["responses"][rp + "/attempts/1/jobs?per_page=100&page=1"] = {"total_count": len(jobs), "jobs": jobs}
    result["responses"][f'/repos/{repository}/actions/jobs/{jobs[0]["id"]}/logs'] = (
        "2026-10-26T00:00:00Z APPLE LEG PLAN platform=false conformance=false: " + parent_proof[2] + "\n")
    compare = copy.deepcopy(parent_record["responses"][parent_compare])
    compare["base_commit"]["sha"] = parent_sha; compare["merge_base_commit"]["sha"] = parent_sha
    compare["commits"] = [{"sha": child_sha, "parents": [{"sha": parent_sha}]}]
    result["responses"][f"/repos/{repository}/compare/{parent_sha}...{child_sha}"] = compare
    workflow_key = f"/repos/{repository}/contents/{planner.WORKFLOW_PATH}?ref="
    result["responses"][workflow_key + parent_sha] = copy.deepcopy(record["responses"][workflow_key + record["parent"]])
    result["sha"] = child_sha
    result["push"] = {**record["push"], "before": parent_sha, "after": child_sha}
    return result

