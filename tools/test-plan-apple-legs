# Execute the real aggregator shell with the plan's outputs and Actions' skipped job results.
# This verifies the integration that turns a no-leg plan into a successful required check.
workflow = (ROOT / ".github/workflows/apple-ci.yml").read_text()
def workflow_shell(name):
    match = re.search(r"      - name: " + re.escape(name) + r"\n        run: \|\n((?:          .*\n|\n)+)",
                      workflow)
    expect(match is not None, f"workflow step {name} must be executable by this control")
    return "\n".join(line[10:] for line in match[1].splitlines())

with tempfile.TemporaryDirectory() as directory:
    summary = Path(directory) / "summary"
    env = {**os.environ, "APPLE_PLAN_RESULT": "success", "RUN_APPLE_PLATFORM": "false",
           "RUN_APPLE_CONFORMANCE": "false", "RUN_APPLE_DISCOVER": "false",
           "DISCOVER_MACOS_RESULT": "skipped", "DISCOVER_IPHONE_RESULT": "skipped",
           "DISCOVER_IPAD_RESULT": "skipped", "APPLE_PLATFORM_RESULT": "skipped",
           "APPLE_CONFORMANCE_CORE_RESULT": "skipped",
           "APPLE_CONFORMANCE_IPAD_IPHONE_RESULT": "skipped", "GITHUB_STEP_SUMMARY": str(summary)}
    shell = workflow_shell("Require every planned Apple leg")
    result = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT, env=env,
                            capture_output=True, text=True)
    expect(result.returncode == 0 and "APPLE CI LEGS PASS" in result.stdout,
           f"real aggregator must accept planned skips: {result.stdout} {result.stderr}")
    for key, value in (("APPLE_PLAN_RESULT", "failure"), ("RUN_APPLE_PLATFORM", ""),
                       ("APPLE_CONFORMANCE_CORE_RESULT", "failure"),
                       ("DISCOVER_IPAD_RESULT", "failure"), ("RUN_APPLE_DISCOVER", "true")):
        bad = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                             env={**env, key: value}, capture_output=True, text=True)
        expect(bad.returncode != 0, f"aggregator must refuse {key}={value!r}")
    discover_results = ("DISCOVER_MACOS_RESULT", "DISCOVER_IPHONE_RESULT", "DISCOVER_IPAD_RESULT")
    for planned in (False, True):
        planned_env = {**env, "RUN_APPLE_DISCOVER": str(planned).lower(),
                       **dict.fromkeys(discover_results, "success" if planned else "skipped")}
        good = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                              env=planned_env, capture_output=True, text=True)
        expect(good.returncode == 0, f"aggregator must accept Discover planned={planned}")
        for key in discover_results:
            for value in ("success", "skipped", "failure", "cancelled", ""):
                if value == ("success" if planned else "skipped"):
                    continue
                bad = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                                     env={**planned_env, key: value}, capture_output=True, text=True)
                expect(bad.returncode != 0, f"aggregator must refuse Discover planned={planned} {key}={value!r}")
    subprocess.run(["bash", "-e", "-o", "pipefail", "-c",
                    workflow_shell("Report whether this run resolves evidence")],
