#!/usr/bin/env python3
"""Prove tools/ci/plan-apple-legs plans conservatively and its leg check fails closed (spec §21.6)."""

from __future__ import annotations

from importlib.machinery import SourceFileLoader
import importlib.util
from pathlib import Path
import os
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
TOOL = Path(os.environ.get("PLAN_APPLE_LEGS_UNDER_TEST", ROOT / "tools/ci/plan-apple-legs"))
_spec = importlib.util.spec_from_loader("plan_apple_legs", SourceFileLoader("plan_apple_legs", str(TOOL)))
planner = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(planner)
checks = 0


def expect(condition: bool, message: str) -> None:
    global checks
    if not condition:
        raise AssertionError(message)
    checks += 1


# --- Classification. Positive and negative cases side by side, so a planner that answers the same
# thing for every path cannot pass.
APPLE = (
    "apple/DulcetKit/Sources/DulcetKit/Player.swift",
    "core/src/commonMain/kotlin/com/legitimateapps/dulcet/Queue.kt",
    "core-conformance/src/commonTest/kotlin/X.kt",
    "core/src/appleMain/kotlin/X.kt",
    "core/src/appleTest/kotlin/X.kt",
    "core/src/commonTest/kotlin/X.kt",
    "core-conformance/src/macosArm64Test/kotlin/X.kt",
    "core-conformance/src/appleTest/kotlin/X.kt",
    "core/src/commonMain/sqldelight/com/legitimateapps/dulcet/core/db/8.sqm",
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "gradle/libs.versions.toml",
    "gradlew",
    "android/app/build.gradle.kts",
    ".github/workflows/apple-ci.yml",
    "tools/ci/plan-apple-legs",
    "tools/ci/isolate-simulator",
    "tools/seed-corpus",
    "tools/conformance-env/prepare-darwin",
    "tools/swift-testing-junit",
    "tools/run-gradle-exclusive",
    "a-directory-nobody-has-classified-yet/file.txt",
)
NOT_APPLE = (
    "docs/superpowers/specs/2026-08-18-dulcet-design.md",
    "CLAUDE.md",
    "CORPUS.md",
    "FEATURES.yml",
    "android/app/src/main/kotlin/com/legitimateapps/dulcet/android/Player.kt",
    "android/tv/src/main/res/values/strings.xml",
    "core/src/androidMain/kotlin/X.kt",
    "core/src/androidHostTest/kotlin/X.kt",
    "core/src/jvmMain/kotlin/X.kt",
    "core/src/jvmTest/kotlin/X.kt",
    "core-conformance/src/jvmTest/kotlin/X.kt",
    "core-conformance/src/androidDeviceTest/kotlin/X.kt",
    "core-conformance/src/androidHostTest/kotlin/X.kt",
    ".github/workflows/core-ci.yml",
    ".github/workflows/release.yml",
    ".github/required-checks.json",
    "tools/verify_ci_policy.py",
    "tools/test-verify-ci-policy",
    "tools/release_plan.py",
)
for path in APPLE:
    expect(planner.apple_affecting(path), f"{path} must be Apple-affecting")
for path in NOT_APPLE:
    expect(not planner.apple_affecting(path), f"{path} must not be Apple-affecting")

# --- Plans by event. The nightly schedule and a plain dispatch are the full runs; a pull request and
# a push to main are the merge gate, planned from their diff and never running conformance.
for event in ("workflow_dispatch", "schedule", "merge_group", ""):
    expect(planner.plan(event, ["docs/a.md"])[:2] == (True, True),
           f"event {event!r} must run every leg")
expect(planner.plan("workflow_dispatch", None, True)[:2] == (False, True),
       "a conformance-only dispatch skips only the platform leg")
for event in ("schedule", "merge_group", ""):
    expect(planner.plan(event, None, True)[:2] == (True, True),
           f"conformance-only cannot change event {event!r}")
for event in ("pull_request", "push"):
    expect(planner.plan(event, ["docs/a.md", "android/app/src/X.kt"])[:2] == (False, False),
           f"a docs and Android {event} runs no Apple leg")
    expect(planner.plan(event, ["docs/a.md", "core/src/X.kt"])[:2] == (True, False),
           f"one Apple-affecting path in a {event} runs the platform leg")
    expect(planner.plan(event, None)[:2] == (True, False),
           f"an unreadable {event} diff runs the platform leg")
    expect(planner.plan(event, [])[:2] == (True, False),
           f"an empty {event} diff runs the platform leg")
    for changed in (["core/X.kt"], ["docs/a.md"], None, []):
        expect(planner.plan(event, changed)[1] is False,
               f"a {event} never runs the conformance legs")
        expect(planner.plan(event, changed, True) == planner.plan(event, changed),
               f"conformance-only cannot change a {event}'s plan")

# A Discover-only dispatch is diagnostic. Automatic events cannot use it to reduce their plan.
expect(planner.plan("workflow_dispatch", None, discover_only=True)[:2] == (False, False),
       "Discover-only dispatch skips baseline jobs")
for event in ("push", "pull_request", "schedule", "merge_group", ""):
    expect(planner.plan(event, ["apple/project.yml"], discover_only=True) ==
           planner.plan(event, ["apple/project.yml"]),
           f"Discover-only input cannot suppress automatic event {event!r}")

# --- require-leg: exactly two accepted pairs, everything else refused.
ACCEPTED = {("true", "success"), ("false", "skipped")}
for planned in ("true", "false", "", "TRUE", "1", "True"):
    for result in ("success", "skipped", "failure", "cancelled", ""):
        code = subprocess.run([sys.executable, str(TOOL), "require-leg", planned, result],
                              capture_output=True, text=True, check=False).returncode
        expect((code == 0) == ((planned, result) in ACCEPTED),
               f"require-leg {planned!r} {result!r} exited {code}")

# --- The CLI's step outputs, end to end.
with tempfile.TemporaryDirectory() as directory:
    listing = Path(directory) / "changed"
    cases = (
        ("PR without Apple inputs", "pull_request", "docs/a.md\nCLAUDE.md\n", [], False, False),
        ("PR with Apple inputs", "pull_request", "apple/project.yml\n", [], True, False),
        ("push without Apple inputs", "push", "docs/a.md\n", [], False, False),
        ("push with Apple inputs", "push", "core/src/commonMain/X.kt\n", [], True, False),
        ("push with an empty diff", "push", "", [], True, False),
        ("plain dispatch", "workflow_dispatch", "", [], True, True),
        ("explicit full dispatch", "workflow_dispatch", "", ["--conformance-only", "false"], True, True),
        ("conformance-only dispatch", "workflow_dispatch", "", ["--conformance-only", "true"], False, True),
        ("Discover-only dispatch", "workflow_dispatch", "", ["--discover-only", "true"], False, False),
        ("push ignores Discover-only", "push", "apple/project.yml\n", ["--discover-only", "true"], True, False),
        ("PR ignores Discover-only", "pull_request", "apple/project.yml\n", ["--discover-only", "true"], True, False),
        ("push ignores dispatch input", "push", "apple/project.yml\n", ["--conformance-only", "true"], True, False),
    )
    for label, event, changed, options, platform, conformance in cases:
        listing.write_text(changed)
        result = subprocess.run([sys.executable, str(TOOL), "plan", "--event", event,
                                 "--changed-files", str(listing), *options],
                                capture_output=True, text=True, check=True)
        discover = conformance or (event == "workflow_dispatch" and options == ["--discover-only", "true"])
        expected = f"platform={str(platform).lower()}\nconformance={str(conformance).lower()}\ndiscover={str(discover).lower()}\n"
        expect(result.stdout == expected, f"{label} outputs: {result.stdout!r}")
        print(f"CLI EXECUTED {label}: {result.stdout.strip().replace(chr(10), ' ')}")
    for option in ("--conformance-only", "--discover-only"):
        for value in ("TRUE", "1", "yes", ""):
            result = subprocess.run([sys.executable, str(TOOL), "plan", "--event", "workflow_dispatch",
                                     option, value], capture_output=True, text=True)
            expect(result.returncode != 0 and not result.stdout,
                   f"invalid {option} input {value!r} must fail closed")

# --- The diff read from a real merge commit, and the fail-safe on a checkout that is not one.
with tempfile.TemporaryDirectory() as directory:
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@example.invalid",
           "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@example.invalid"}

    def git(*args: str) -> None:
        subprocess.run(["git", "-C", directory, *args], check=True, capture_output=True, env=env)

    def plan_here() -> str:
        return subprocess.run([sys.executable, str(TOOL), "plan", "--event", "pull_request"],
                              cwd=directory, capture_output=True, text=True, check=True).stdout

    git("init", "-q", "-b", "main")
    (Path(directory) / "README.md").write_text("base\n")
    git("add", ".")
    git("commit", "-q", "-m", "base")
    expect(plan_here() == "platform=true\nconformance=false\ndiscover=false\n",
           "a checkout that is not a merge commit must run the platform leg")
    git("checkout", "-q", "-b", "topic")
    (Path(directory) / "docs").mkdir()
    (Path(directory) / "docs" / "note.md").write_text("docs\n")
    git("add", ".")
    git("commit", "-q", "-m", "docs")
    git("checkout", "-q", "main")
    (Path(directory) / "LICENSE").write_text("moved on\n")
    git("add", ".")
    git("commit", "-q", "-m", "main moved")
    git("merge", "-q", "--no-ff", "-m", "merge", "topic")
    expect(planner.merge_diff is not None, "merge_diff exists")
    expect(plan_here() == "platform=false\nconformance=false\ndiscover=false\n",
           "a docs-only merge commit runs no Apple leg")
    (Path(directory) / "core").mkdir()
    (Path(directory) / "core" / "X.kt").write_text("x\n")
    git("checkout", "-q", "topic")
    git("add", ".")
    git("commit", "-q", "-m", "core")
    git("checkout", "-q", "main")
    git("merge", "-q", "--no-ff", "-m", "merge 2", "topic")
    expect(plan_here() == "platform=true\nconformance=false\ndiscover=false\n",
           "a merge commit carrying a core change runs the platform leg")

# --- The diff read from a real push: one commit over `before`, and the fail-safe on anything else.
with tempfile.TemporaryDirectory() as directory:
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@example.invalid",
           "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@example.invalid"}

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", directory, *args], check=True, capture_output=True,
                              text=True, env=env).stdout.strip()

    def push_here(before: str) -> str:
        return subprocess.run([sys.executable, str(TOOL), "plan", "--event", "push",
                               "--push-before", before],
                              cwd=directory, capture_output=True, text=True, check=True).stdout

    git("init", "-q", "-b", "main")
    (Path(directory) / "README.md").write_text("base\n")
    git("add", ".")
    git("commit", "-q", "-m", "base")
    base = git("rev-parse", "HEAD")
    (Path(directory) / "docs").mkdir()
    (Path(directory) / "docs" / "note.md").write_text("docs\n")
    git("add", ".")
    git("commit", "-q", "-m", "docs")
    docs = git("rev-parse", "HEAD")
    expect(push_here(base) == "platform=false\nconformance=false\ndiscover=false\n",
           "a docs-only push of one commit runs no Apple leg")
    for label, before in (("missing", ""), ("all-zero (new branch)", "0" * 40),
                          ("unrelated", "1" * 40), ("current", docs)):
        expect(push_here(before) == "platform=true\nconformance=false\ndiscover=false\n",
               f"a push whose before SHA is {label} must run the platform leg")
    (Path(directory) / "core").mkdir()
    (Path(directory) / "core" / "X.kt").write_text("x\n")
    git("add", ".")
    git("commit", "-q", "-m", "core")
    expect(push_here(docs) == "platform=true\nconformance=false\ndiscover=false\n",
           "a push carrying a core change runs the platform leg")
    expect(push_here(base) == "platform=true\nconformance=false\ndiscover=false\n",
           "a push of two commits is not read as a diff and runs the platform leg")
    git("checkout", "-q", "-b", "topic", base)
    (Path(directory) / "LICENSE").write_text("topic\n")
    git("add", ".")
    git("commit", "-q", "-m", "topic")
    git("checkout", "-q", "main")
    git("merge", "-q", "--no-ff", "-m", "merge", "topic")
    expect(push_here(git("rev-parse", "HEAD^1")) == "platform=true\nconformance=false\ndiscover=false\n",
           "a merge-commit push is not read as a diff and runs the platform leg")
print("PUSH DIFF PASS: one commit over before is read; anything else runs the platform leg")

# Execute the real aggregator shell with the plan's outputs and Actions' skipped job results.
# This verifies the integration that turns a no-leg plan into a successful required check.
workflow = (ROOT / ".github/workflows/apple-ci.yml").read_text()
def workflow_shell(name):
    match = re.search(r"      - name: " + re.escape(name) + r"\n        run: \|\n((?:          .*\n|\n)+)",
                      workflow)
    expect(match is not None, f"workflow step {name} must be executable by this control")
    return "\n".join(line[10:] for line in match[1].splitlines())

with tempfile.TemporaryDirectory() as directory:
    summary = Path(directory) / "summary"
    env = {**os.environ, "APPLE_PLAN_RESULT": "success", "RUN_APPLE_PLATFORM": "false",
           "RUN_APPLE_CONFORMANCE": "false", "RUN_APPLE_DISCOVER": "false",
           "DISCOVER_MACOS_RESULT": "skipped", "DISCOVER_IPHONE_RESULT": "skipped",
           "DISCOVER_IPAD_RESULT": "skipped", "APPLE_PLATFORM_RESULT": "skipped",
           "APPLE_CONFORMANCE_CORE_RESULT": "skipped",
           "APPLE_CONFORMANCE_CONNECTIONS_RESULT": "skipped",
           "APPLE_CONNECTIONS_IPHONE_RESULT": "skipped",
           "APPLE_CONNECTIONS_IPAD_RESULT": "skipped",
           "APPLE_CONNECTIONS_TVOS_RESULT": "skipped",
           "APPLE_CONFORMANCE_IPAD_IPHONE_RESULT": "skipped", "GITHUB_STEP_SUMMARY": str(summary)}
    shell = workflow_shell("Require every planned Apple leg")
    result = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT, env=env,
                            capture_output=True, text=True)
    expect(result.returncode == 0 and "APPLE CI LEGS PASS" in result.stdout,
           f"real aggregator must accept planned skips: {result.stdout} {result.stderr}")
    for key, value in (("APPLE_PLAN_RESULT", "failure"), ("RUN_APPLE_PLATFORM", ""),
                       ("APPLE_CONFORMANCE_CORE_RESULT", "failure"),
                       ("APPLE_CONFORMANCE_CONNECTIONS_RESULT", "failure"),
                       *(("APPLE_CONNECTIONS_" + surface + "_RESULT", "failure") for surface in ("IPHONE", "IPAD", "TVOS")),
                       ("DISCOVER_IPAD_RESULT", "failure"), ("RUN_APPLE_DISCOVER", "true")):
        bad = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                             env={**env, key: value}, capture_output=True, text=True)
        expect(bad.returncode != 0, f"aggregator must refuse {key}={value!r}")
    discover_results = ("DISCOVER_MACOS_RESULT", "DISCOVER_IPHONE_RESULT", "DISCOVER_IPAD_RESULT")
    for planned in (False, True):
        planned_env = {**env, "RUN_APPLE_DISCOVER": str(planned).lower(),
                       **dict.fromkeys(discover_results, "success" if planned else "skipped")}
        good = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                              env=planned_env, capture_output=True, text=True)
        expect(good.returncode == 0, f"aggregator must accept Discover planned={planned}")
        for key in discover_results:
            for value in ("success", "skipped", "failure", "cancelled", ""):
                if value == ("success" if planned else "skipped"):
                    continue
                bad = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                                     env={**planned_env, key: value}, capture_output=True, text=True)
                expect(bad.returncode != 0, f"aggregator must refuse Discover planned={planned} {key}={value!r}")
    subprocess.run(["bash", "-e", "-o", "pipefail", "-c",
                    workflow_shell("Report whether this run resolves evidence")],
                   cwd=ROOT, env=env, check=True, capture_output=True, text=True)
    expect("EVIDENCE not resolved on this run" in summary.read_text(),
           "skipped run summary must explicitly disclaim FEATURES resolution")
    # The merge gate's shape: the platform leg ran and every conformance and Discover leg skipped.
    gate = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                          env={**env, "RUN_APPLE_PLATFORM": "true", "APPLE_PLATFORM_RESULT": "success"},
                          capture_output=True, text=True)
    expect(gate.returncode == 0, f"aggregator must accept the merge gate's plan: {gate.stderr}")
    for value in ("skipped", "failure", "cancelled", ""):
        bad = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", shell], cwd=ROOT,
                             env={**env, "RUN_APPLE_PLATFORM": "true", "APPLE_PLATFORM_RESULT": value},
                             capture_output=True, text=True)
        expect(bad.returncode != 0, f"aggregator must refuse a planned platform leg that reports {value!r}")
print("PROOF AGGREGATOR PASS: real workflow shell accepts planned skips and rejects bad results")

# --- Closure: no excluded tool is named by anything the Apple legs read. An excluded tool that an
# Apple-affecting file mentions in code (by path, file name or module stem) would let a pull request change
# an Apple input without running the Apple legs.
tracked = subprocess.run(["git", "-C", str(ROOT), "ls-files"], capture_output=True, text=True,
                         check=True).stdout.splitlines()
# The planner names exclusions as data, not as executable dependencies, so it is not a reader.
readers = [path for path in tracked
           if planner.apple_affecting(path) and path != "tools/ci/plan-apple-legs"]
texts: dict[str, str] = {}
for path in readers:
    try:
        # A comment cannot make a file read a tool, so only code lines count. Several Apple files
        # explain that a release or policy tool checks them, which is not a dependency.
        texts[path] = "\n".join(
            line for line in (ROOT / path).read_text(encoding="utf-8").splitlines()
            if not line.lstrip().startswith(("#", "//", "*", "/*")))
    except (UnicodeDecodeError, OSError):
        continue
expect(".github/workflows/apple-ci.yml" in texts, "apple-ci.yml must be scanned")
expect(len(texts) > 100, f"only {len(texts)} Apple-affecting files were read")
for tool in planner.NOT_APPLE_TOOLS:
    expect((ROOT / tool).is_file(), f"{tool} is excluded but does not exist; drop it from the list")
    name = Path(tool).name
    stem = name[:-3] if name.endswith(".py") else name
    for path, text in texts.items():
        expect(stem not in text,
               f"{path} names {stem!r}, so {tool} is an Apple input and must not be excluded")
# The scan's positive control: a tool the Apple legs DO read is found by the same search.
expect(any("seed-corpus" in text for text in texts.values()),
       "the closure scan cannot find a tool apple-ci is known to name")

print(f"plan-apple-legs control passed: {checks} checks over {len(texts)} Apple-affecting files")
