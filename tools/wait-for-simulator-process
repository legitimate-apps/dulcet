#!/usr/bin/env python3
"""Wait until a booted simulator can run a process, or fail at an absolute deadline.

`simctl bootstatus -b` proves that CoreSimulator considers boot complete. It does not prove that
the device bootstrap is accepting process launches yet. This probe closes that gap without
launching the product under test: by default it runs the runtime's `launchctl print system` through
the device PATH and requires a successful exit.

The deadline covers every in-flight `simctl spawn`, not just the sleeps between attempts. A wedged
spawn therefore cannot turn this bounded prerequisite into another unbounded wait.
"""

from __future__ import annotations

import argparse
import os
import shlex
import signal
import subprocess
import sys
import time

DEFAULT_DEADLINE_SECONDS = 60.0
DEFAULT_POLL_INTERVAL_SECONDS = 2.0
DEFAULT_PROBE_COMMAND = ("launchctl", "print", "system")


def positive_seconds(value: str) -> float:
    parsed = float(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return parsed


def display_seconds(value: float) -> str:
    return f"{value:g}"


def run_attempt(command: list[str], timeout: float) -> tuple[int | None, str]:
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            start_new_session=True,
        )
    except OSError as error:
        return 126, f"could not start simctl spawn: {error}"
    try:
        _stdout, stderr = process.communicate(timeout=timeout)
        return process.returncode, (stderr or "").strip()
    except subprocess.TimeoutExpired:
        # Kill the process group so an xcrun child cannot survive the deadline after its parent is
        # terminated. SIGKILL is intentional here: there is no grace period outside the budget.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        _stdout, stderr = process.communicate()
        diagnostic = (stderr or "").strip()
        return None, diagnostic or "simctl spawn did not return before the deadline"


def last_line(value: str) -> str:
    lines = [line.strip() for line in value.splitlines() if line.strip()]
    return lines[-1] if lines else "(no diagnostic output)"


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--udid", required=True, help="UDID of a simulator that passed bootstatus")
    parser.add_argument(
        "--deadline-seconds",
        type=positive_seconds,
        default=DEFAULT_DEADLINE_SECONDS,
        help=f"absolute process-readiness budget (default: {DEFAULT_DEADLINE_SECONDS:g})",
    )
    parser.add_argument(
        "--poll-interval-seconds",
        type=positive_seconds,
        default=DEFAULT_POLL_INTERVAL_SECONDS,
        help=f"delay between failed attempts (default: {DEFAULT_POLL_INTERVAL_SECONDS:g})",
    )
    parser.add_argument(
        "probe_command",
        nargs=argparse.REMAINDER,
        help="command passed to simctl spawn (default: launchctl print system)",
    )
    args = parser.parse_args()

    probe_command = args.probe_command
    if probe_command[:1] == ["--"]:
        probe_command = probe_command[1:]
    if not probe_command:
        probe_command = list(DEFAULT_PROBE_COMMAND)

    started = time.monotonic()
    deadline = started + args.deadline_seconds
    attempts = 0
    last_diagnostic = "probe was not attempted"
    rendered_command = shlex.join(probe_command)

    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        attempts += 1
        status, diagnostic = run_attempt(
            ["xcrun", "simctl", "spawn", args.udid, *probe_command],
            timeout=remaining,
        )
        elapsed = time.monotonic() - started
        if status == 0:
            print(
                "IPADOS SIMULATOR PROCESS READY "
                f"attempts={attempts} elapsed_seconds={elapsed:.2f} command={rendered_command!r}"
            )
            return

        last_diagnostic = diagnostic
        rendered_status = "attempt-timeout" if status is None else str(status)
        print(
            "IPADOS SIMULATOR PROCESS WAIT "
            f"attempt={attempts} elapsed_seconds={elapsed:.2f} status={rendered_status} "
            f"diagnostic={last_line(diagnostic)!r}",
            file=sys.stderr,
        )
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(min(args.poll_interval_seconds, remaining))

    elapsed = time.monotonic() - started
    budget = display_seconds(args.deadline_seconds)
    print(
        "::error title=iPadOS simulator prerequisite failed::"
        f"The booted simulator could not run the process-readiness probe within {budget} seconds; "
        "the layout test did not run",
        file=sys.stderr,
    )
    print(
        "IPADOS SIMULATOR PROCESS NOT READY "
        f"attempts={attempts} elapsed_seconds={elapsed:.2f} command={rendered_command!r} "
        f"last_diagnostic={last_line(last_diagnostic)!r}",
        file=sys.stderr,
    )
    raise SystemExit(1)


if __name__ == "__main__":
    main()
