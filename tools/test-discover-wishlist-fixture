    def test_scenariosWitnessDelayStaleOfflineAndFutureMetadata(self):
        f=self.fixture;url=f.urls['controlUrl']
        ack=f.scenario('delayed-old-query');started=time.monotonic()
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
            pending=pool.submit(f.rest,'searchDulcetDiscover',kind='song',query='old')
            deadline=time.monotonic()+10
            while not any(e.get('held') for e in call(url,'/control/state')['effects']):
                self.assertLess(time.monotonic(),deadline);time.sleep(.02)
            self.assertFalse(pending.done())
            new=f.rest('searchDulcetDiscover',kind='song',query='Fixture')['dulcetDiscover']['item']
            old=pending.result(timeout=5)['dulcetDiscover']['item']
        self.assertGreaterEqual(time.monotonic()-started,.6)
        payloads=[e['payload'] for e in call(url,'/control/state')['effects'] if e.get('response')]
        self.assertEqual(['new','old'],payloads,'new response must precede obsolete response')
        self.assertNotEqual([r['title'] for r in old],[r['title'] for r in new])
        self.assertTrue(all(r['title'].startswith('Obsolete old query · ') for r in old))
        self.assertTrue(all(not r['title'].startswith('Obsolete old query · ') for r in new))
        self.assertEqual({'old','new'},{e.get('payload') for e in call(url,'/control/state')['effects'] if e.get('response')})
        self.assertEqual(ack['revision'],call(url,'/control/state')['effects'][-1]['revision'])
        f.scenario('stale-answer');page=f.rest('searchDulcetDiscover',kind='song',query='stale')['dulcetDiscover']
        self.assertTrue(page['stale']);self.assertEqual(7200,page['ageSeconds'])
        f.scenario('future-metadata');page=f.rest('searchDulcetDiscover',kind='song',query='future')['dulcetDiscover']
        self.assertEqual('future',page['item'][0]['kind']);self.assertFalse(page['item'][0]['wishable'])
        f.scenario('offline')
        with self.assertRaises((OSError,urllib.error.URLError)):f.rest('ping')
        self.assertGreater(call(url,'/control/state')['hits'],0)
