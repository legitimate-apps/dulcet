    def test_fixtureModuleLoadsDoNotWriteBytecode(self):
        # Copy only our fixture sources: an existing cache cannot hide a write or force
        # cleanup of somebody else's checkout. run_path itself does not cache its input.
        with tempfile.TemporaryDirectory() as directory:
            root=Path(directory)
            for relative in ['tools/test-discover-wishlist-fixture','tools/ci/with-discover-wishlist-fixture','tools/ci/discover_process_owner.py','tools/discover-wishlist-ui-proxy','tools/discover-wishlist-fixtures/fixture.py']:
                target=root/relative;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(REPO/relative,target)
            code="""
import importlib.machinery, importlib.util, runpy, sys
from pathlib import Path
