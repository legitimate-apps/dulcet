#!/usr/bin/env python3
"""Loopback error fixtures for the opt-in Apple photograph tour, never a personal server."""
import argparse
import json
from pathlib import Path
import runpy
import ssl
import subprocess
import threading
from http.server import ThreadingHTTPServer


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--upstream', required=True)
    parser.add_argument('--work', required=True)
    args = parser.parse_args()
    work = Path(args.work)
    work.mkdir(parents=True, exist_ok=True)
    proxy_type = runpy.run_path(str(Path(__file__).parent / 'conformance-env/lyrics-fault-proxy'))['ProxyServer']
    proxy = proxy_type(0, args.upstream)
    cert, key = work / 'localhost.crt', work / 'localhost.key'
    subprocess.run(['openssl', 'req', '-config', str(Path(__file__).parent / 'conformance-env/untrusted-tls-openssl.cnf'), '-x509', '-newkey', 'rsa:2048', '-nodes', '-days', '1',
                    '-subj', '/CN=localhost', '-keyout', str(key), '-out', str(cert)],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)

    handler = runpy.run_path(str(Path(__file__).parent / 'conformance-env/untrusted-tls-server'))['Handler']
    tls = ThreadingHTTPServer(('127.0.0.1', 0), handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(cert, key)
    tls.socket = context.wrap_socket(tls.socket, server_side=True)
    threading.Thread(target=tls.serve_forever, daemon=True).start()
    (work / 'endpoints.json').write_text(json.dumps({
        'proxy': f'http://127.0.0.1:{proxy.server_port}',
        'bad_tls': f'https://127.0.0.1:{tls.server_port}',
    }))
    proxy.serve_forever()


if __name__ == '__main__':
    main()
