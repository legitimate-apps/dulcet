#!/usr/bin/env python3
"""Prove the transcode cache probe reports a stalled server as a timeout, not as an ffmpeg fault.

A cold transcode makes Navidrome withhold every response header until ffmpeg produces output, so a
slow runner used to surface as a bare `TimeoutError` traceback from urllib -- and Navidrome, whose
reader had just vanished, logged `Transcoding returned empty output, ffmpeg may have failed.` The
two together read as a damning transcoder failure while actually describing a client that gave up.
This control pins the corrected behaviour: the stalled case must name itself and must not traceback,
and the healthy case must still pass and report the latency it measured.
"""

from __future__ import annotations

import json
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from tempfile import TemporaryDirectory

ROOT = Path(__file__).resolve().parent
PROBE = ROOT / "conformance-env" / "observe-transcode-cache"
# The tool refuses any base URL but the disposable loopback one, so the stub must answer there.
PORT = 4533
STREAM_LINE = (
    'time="2026-08-30T00:00:00Z" level=info msg="Streaming file" '
    'title="Dulcet Health Probe" format=mp3 cached=false transcoding=true'
)


def make_handler(*, stall: bool, log_file: Path):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):  # keep the control's output readable
            pass

        def do_GET(self):
            if self.path.startswith("/rest/search3"):
                body = json.dumps(
                    {
                        "subsonic-response": {
                            "searchResult3": {
                                "song": [{"id": "probe-id", "title": "Dulcet Health Probe"}]
                            }
                        }
                    }
                ).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            if stall:
                # Withhold the status line exactly as Navidrome does while ffmpeg is still starting.
                time.sleep(30)
                return
            log_file.write_text(log_file.read_text() + STREAM_LINE + "\n")
            body = b"\xff\xfbaudio-bytes"
            self.send_response(200)
            self.send_header("Content-Type", "audio/mpeg")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    return Handler


def run_probe(*, stall: bool) -> subprocess.CompletedProcess:
    with TemporaryDirectory() as tmp:
        log_file = Path(tmp) / "navidrome.log"
        log_file.write_text("")
        server = HTTPServer(("127.0.0.1", PORT), make_handler(stall=stall, log_file=log_file))
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            return subprocess.run(
                [sys.executable, str(PROBE), "--log-file", str(log_file), "--expect-cached", "false"],
                text=True,
                capture_output=True,
                env={
                    "PATH": "/usr/bin:/bin",
                    "DULCET_CONFORMANCE_DISPOSABLE": "true",
                    "DULCET_CONFORMANCE_BASE_URL": f"http://127.0.0.1:{PORT}",
                    "DULCET_TRANSCODE_PROBE_TIMEOUT_SECONDS": "1",
                },
                check=False,
            )
        finally:
            server.shutdown()
            server.server_close()


def main() -> None:
    stalled = run_probe(stall=True)
    combined = stalled.stdout + stalled.stderr
    if stalled.returncode == 0:
        raise SystemExit("NEGATIVE CONTROL FAILED: a stalled transcode was accepted")
    if "Traceback" in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: a stalled transcode still surfaces as a traceback:\n" + combined
        )
    if "timed out" not in combined or "not an ffmpeg fault" not in combined:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: the stall diagnostic does not name its own cause:\n" + combined
        )
    print("NEGATIVE CONTROL PASS stalled_probe_reports_timeout=true traceback=false")

    healthy = run_probe(stall=False)
    if healthy.returncode != 0:
        raise SystemExit(
            "POSITIVE CONTROL FAILED: a healthy probe was rejected:\n"
            + healthy.stdout
            + healthy.stderr
        )
    if "first_response_seconds=" not in healthy.stdout:
        raise SystemExit(
            "POSITIVE CONTROL FAILED: a healthy probe does not report its latency:\n" + healthy.stdout
        )
    print("POSITIVE CONTROL PASS " + healthy.stdout.strip().splitlines()[-1])


if __name__ == "__main__":
    main()
