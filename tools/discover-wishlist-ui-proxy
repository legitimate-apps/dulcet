    def baseline(self):
        base=self.config['navidrome']
        login=rest(base,'ping')['status']=='ok';albums=rest(base,'getAlbumList2',type='alphabeticalByName',size='1')['albumList2'].get('album',[])
        extensions=rest(base,'getOpenSubsonicExtensions')['openSubsonicExtensions'];names={e['name'] for e in extensions}
        # The same positive requests go through the observed proxy; absence has a known witness.
        for endpoint,parameters in [('ping',{}),('getAlbumList2',{'type':'alphabeticalByName','size':'1'}),('getOpenSubsonicExtensions',{})]:
            from fixture import rest_url
            request(rest_url(self.config['proxy']+'/navidrome',endpoint,**parameters))
        if not login or not albums or names.intersection({'dulcetDiscover','dulcetWishlist'}):raise ValueError('unhealthy Navidrome baseline')
        return dict(login=True,albums=len(albums),discoverAdvertised=False,wishlistAdvertised=False)
    def populate_personal(self):
        """Real user writes on the finite fixture, shared by phone and Mac capture tours."""
        base = self.config['server']
        albums = rest(base, 'getAlbumList2', type='alphabeticalByName', size='2')['albumList2']['album']
        songs = rest(base, 'getAlbum', id=albums[0]['id'])['album']['song']
        rest(base, 'addToDulcetLibrary', id=songs[0]['id'])
        rest(base, 'addToDulcetLibrary', artistId=songs[0]['artistId'])
        for album in albums:
            rest(base, 'star', albumId=album['id'])
        rest(base, 'star', artistId=songs[0]['artistId'])
        rest(base, 'star', id=songs[0]['id'])
        starred = rest(base, 'getStarred2')['starred2']
        if not all(starred.get(kind) for kind in ['song', 'album', 'artist']):
            raise ValueError('personal capture seed did not persist all favorite kinds')
        return dict(populated=True, favoriteSongs=len(starred['song']), favoriteAlbums=len(starred['album']),
                    favoriteArtists=len(starred['artist']), personalSong=songs[0]['title'])
    def restore(self):
        self.api('/admin/test/checkpoints/'+self.config['checkpoint']+'/restore',{},'POST')
        # The artwork override is in-memory and reset by restore/restart.
        self.api('/admin/test/settings',{'discoverArtworkAllowLoopback':True},'PUT')
        for path in Path(self.config['music']).glob('arrival*.flac'):path.unlink()
        return request(self.config['server']+'/.well-known/dulcet')['server']
    def scenario(self,name,reset=False):
        if name not in self.scenarios:raise ValueError('unknown scenario')
        with self.lock:
            self.detail_release.set();self.query_release.set()
            self.detail_release=threading.Event();self.query_release=threading.Event()
            self.revision+=1;self.name=name;self.hits=0;self.effects=[];self.lost=False;self.remove_seen.clear()
            ack=self.state()
        if reset or name=='identity-replacement':ack.update(identity=self.restore(),reset=reset)
        if name=='scan-arrival':
            shutil.copyfile(self.config['arrival'],str(Path(self.config['music'])/'arrival.flac'))
            rest(self.config['server'],'startScan',user=self.config['admin'])
            deadline=time.monotonic()+30
            while time.monotonic()<deadline:
                scan=rest(self.config['server'],'getScanStatus',user=self.config['admin'])['scanStatus']
                wishes=rest(self.config['server'],'getDulcetWishlist',size='100')['dulcetWishlist']['wish']
                candidate=[w for w in wishes if w['externalIds'].get('musicbrainzRecordingId')==IDS['arrival']]
                if not scan.get('scanning') and (not candidate or candidate[0]['state']=='fulfilled'):break
                time.sleep(.1)
            else:raise ValueError('scan/arrival deadline')
            self.effect('startScan',ack['revision'],name,completed=True)
            ack['scan']={'completed':True,'count':scan.get('count')}
        return ack

class Handler(BaseHTTPRequestHandler):
