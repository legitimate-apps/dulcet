        self.scenarios=json.loads((Path(__file__).parent/'discover-wishlist-fixtures/scenarios.json').read_text())['scenarios']
    def state(self):
        with self.lock:return dict(scenario=self.name,revision=self.revision,armed=True,hits=self.hits,effects=list(self.effects),healthy=True)
