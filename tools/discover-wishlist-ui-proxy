                if target.path.startswith('/release-group/') and target.path.endswith('/front-250'):
                    return self.reply(307,b'',{'Location':'/images/front.png'})
                if target.path=='/images/front.png':return self.reply(200,png(),{'Content-Type':'image/png'})
                return self.reply(200,upstream(target.path,q))
            state=self.server.fixture
            if target.path.startswith('/control/'):
                if target.path=='/control/state':return self.reply(200,state.state())
                if target.path=='/control/requests':
                    since=int(q.get('since',['0'])[0])
                    with state.lock:return self.reply(200,{'requests':state.requests[since:],'next':len(state.requests)})
                if target.path=='/control/baseline':return self.reply(200,state.baseline())
                if target.path=='/control/populate-personal' and self.command=='POST':return self.reply(200,state.populate_personal())
                if target.path=='/control/scenario' and self.command=='POST':return self.reply(200,state.scenario(json.loads(body)['name']))
                if target.path in {'/control/release-detail','/control/release-read'} and self.command=='POST':
                    state.detail_release.set()
                    return self.reply(200,dict(released=True,revision=state.revision))
                if target.path=='/control/reset'  and self.command=='POST':return self.reply(200,state.scenario('normal',reset=True))
                return self.reply(404,{'error':'unknown control'})
            nav=target.path.startswith('/navidrome/');path=self.path.removeprefix('/navidrome') if nav else self.path
            if not (path.startswith('/rest/') or path.startswith('/.well-known/dulcet')):return self.reply(404,{'error':'fixture path refused'})
            params={**q,**parse_qs(body.decode() if body else '')};endpoint=urlsplit(path).path.rsplit('/',1)[-1].removesuffix('.view')
            with state.lock:
                name=state.name;revision=state.revision;query_release=state.query_release
                state.requests.append({'sequence':len(state.requests)+1,'channel':'navidrome' if nav else 'dulcet','endpoint':endpoint,'revision':revision})
            query=params.get('query',[''])[0].strip().lower()
            query_role='old' if query=='old' else 'new' if query in {'new','fixture'} else 'other'
            if not nav:
                if name=='offline':state.effect(endpoint,revision,name);return self.disconnect()
                if name=='delayed-old-query' and endpoint=='searchDulcetDiscover' and query_role=='old':
                    state.effect(endpoint,revision,name,held=True)
                    if not query_release.wait(90):
                        state.effect(endpoint,revision,name,expired=True)
                        return self.reply(504,{'error':'new query did not release old query'})
                    time.sleep(.75)
                if (name=='held-detail' and endpoint in {'getDulcetDiscoverAlbum','getDulcetDiscoverArtist'}) or (name=='held-wishlist' and endpoint=='getDulcetWishlist'):
                    with state.lock:release=state.detail_release
                    state.effect(endpoint,revision,name,held=True)
                    released=release.wait(90)
                    state.effect(endpoint,revision,name,released=released)
                    if not released:return self.reply(504,{'error':'fixture detail hold expired'})
                if name=='rate-limit-120'  and endpoint=='searchDulcetDiscover':
                    state.effect(endpoint,revision,name);return self.reply(429,{'error':'fixture rate limit'},{'Retry-After':'120','Content-Type':'application/json'})
                if name=='remove-before-add':
