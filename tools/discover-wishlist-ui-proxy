                if not nav and name=='remove-before-add' and endpoint in {'addToDulcetWishlist','removeFromDulcetWishlist'}:
                    if json.loads(data)['subsonic-response']['status']!='ok':raise ValueError('race mutation was not delivered')
                    state.effect(endpoint,revision,name,delivered=True)
                    # The held add may proceed only after removal has committed upstream.
