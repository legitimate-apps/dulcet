def wish_replay_parameters(params):
    # Preserve the exact idempotency fingerprint, excluding transport credentials.
    fields=('kind','mbid','title','artist','year','artworkId','sourceType','sourceId','operationId','actionTime')
    return {key:params[key][0] for key in fields if key in params}

class LoopbackFixtureServer(ThreadingHTTPServer):
    def server_bind(self):
        # Both fixture listeners advertise numeric loopback URLs. Avoid HTTPServer's
        # otherwise unnecessary reverse DNS, which can stall hosted startup.
        from socketserver import TCPServer
        TCPServer.server_bind(self)
        self.server_name,self.server_port=self.server_address

