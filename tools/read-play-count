#!/usr/bin/env python3

"""Assert a song's server-side play count, for the workflow step's before/after evidence.

The XCUITest deliberately never reads a play count: a test that could call `/rest/scrobble` itself
cannot evidence that the *app* scrobbled. So the play-count half is asserted here, outside the test,
either side of the run:

    read-play-count --title 'UI Playback Canary' --expect 0
    <run the XCUITest>
    read-play-count --title 'UI Playback Canary' --expect 1

Both halves are required and neither is sufficient. Progressing media time alone does not show a
scrobble was delivered; a count change alone does not show *our app* caused it.

An expectation is MANDATORY. There is no read-only mode: a run that asserted nothing must never be
able to print a line that reads like a pass.

Fails closed. Zero matches, more than one match, a missing id, an HTTP error and an unreachable
server all exit non-zero -- a reader that cannot find its track must never be mistaken for a track
with no plays.
"""

from __future__ import annotations

import argparse
import hashlib
import http.client
import json
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# Matches tools/conformance-env/await-library-ready. This is the disposable conformance server's
# canary account, not a credential: it is generated by the CI environment and thrown away with it.
ADMIN_USER = "dulcet-admin"
ADMIN_PASSWORD = "dulcet-ci-canary-password"


def call(base_url: str, endpoint: str, **parameters: str) -> dict:
    """One authenticated Subsonic call.

    Never lets the URL escape: the query string carries the auth token, and this step's log is
    published as a public artifact on a failing run. Every exception path below is converted to a
    message naming only the endpoint -- including the ones that are NOT URLError (a malformed
    base URL raises ValueError or http.client.InvalidURL, whose messages embed the whole URL).
    """
    salt = secrets.token_hex(16)
    token = hashlib.md5((ADMIN_PASSWORD + salt).encode()).hexdigest()
    query = {
        "u": ADMIN_USER, "t": token, "s": salt,
        "v": "1.16.1", "c": "dulcet-read-play-count", "f": "json",
    }
    query.update(parameters)
    url = f"{base_url}/rest/{endpoint}?" + urllib.parse.urlencode(query)
    try:
        with urllib.request.urlopen(url, timeout=15) as response:
            document = json.load(response)
    except urllib.error.HTTPError as error:
        # HTTPError subclasses URLError, so it must be caught FIRST or an authentication failure is
        # reported as a connection failure and sends the reader after ports and process lifetimes.
        raise SystemExit(f"/rest/{endpoint} returned HTTP {error.code}")
    except urllib.error.URLError as error:
        raise SystemExit(f"conformance server unreachable for /rest/{endpoint}: {error.reason}")
    except (ValueError, http.client.InvalidURL):
        raise SystemExit(f"malformed base URL for /rest/{endpoint} (URL withheld: it carries a token)")
    except json.JSONDecodeError:
        raise SystemExit(f"/rest/{endpoint} did not return JSON")
    payload = document.get("subsonic-response")
    if not isinstance(payload, dict):
        raise SystemExit(f"/rest/{endpoint} returned no subsonic-response envelope")
    if payload.get("status") != "ok":
        error = payload.get("error") or {}
        raise SystemExit(
            f"/rest/{endpoint} failed: code={error.get('code')} message={error.get('message')!r}"
        )
    return payload


def select_song(payload: dict, title: str) -> dict:
    """Exactly one song must carry this title. Zero or many destroys the attribution."""
    songs = ((payload.get("searchResult3") or {}).get("song")) or []
    if not isinstance(songs, list):
        raise SystemExit("searchResult3.song is not a list")
    matches = [song for song in songs if song.get("title") == title]
    if not matches:
        observed = sorted({str(song.get("title")) for song in songs})
        raise SystemExit(
            f"no song titled {title!r} on the server, so its play count cannot be read. "
            f"search3 returned {len(songs)} songs: {observed[:10]}"
        )
    if len(matches) > 1:
        raise SystemExit(
            f"{len(matches)} songs are titled {title!r}; an ambiguous canary cannot attribute a "
            "play to one run. Give the canary a unique title."
        )
    song = matches[0]
    if not song.get("id"):
        raise SystemExit(f"song titled {title!r} has no id")
    return song


def play_count(song: dict) -> int:
    """Subsonic omits playCount when it is zero; absent means 0, matching the conformance client."""
    value = song.get("playCount", 0)
    if isinstance(value, bool) or not isinstance(value, int):
        raise SystemExit(f"playCount is not an integer: observed {value!r}")
    if value < 0:
        raise SystemExit(f"playCount is negative: observed {value!r}")
    return value


def observe(arguments) -> tuple[dict, int]:
    if arguments.search_json:
        with open(arguments.search_json) as handle:
            payload = json.load(handle)["subsonic-response"]
        if payload.get("status") != "ok":
            raise SystemExit("fixture envelope status is not ok")
    else:
        payload = call(
            arguments.base_url, "search3",
            query=arguments.title, songCount="500", albumCount="0", artistCount="0",
        )
    song = select_song(payload, arguments.title)
    return song, play_count(song)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", required=True)
    parser.add_argument("--title", required=True, help="exact song title of the canary")
    parser.add_argument(
        "--expect", type=int, required=True,
        help="required play count. Exact, never 'at least': a higher count means something other "
             "than the app under test also scrobbled, and the attribution is gone.",
    )
    parser.add_argument(
        "--await-seconds", type=float, default=0.0,
        help="poll up to this long for the expected count before failing. Scrobble delivery is "
             "asynchronous and at-least-once, so the count is not visible the instant the app "
             "crosses the threshold. Use 0 for a baseline read, which must be true immediately.",
    )
    parser.add_argument("--search-json", help=argparse.SUPPRESS)  # controls only; see test-read-play-count
    arguments = parser.parse_args()

    deadline = time.monotonic() + max(arguments.await_seconds, 0.0)
    attempts = 0
    while True:
        attempts += 1
        song, observed = observe(arguments)
        if observed == arguments.expect or time.monotonic() >= deadline:
            break
        time.sleep(0.25)

    print(
        f"PLAY COUNT title={arguments.title!r} id={song['id']} observed={observed} "
        f"expected={arguments.expect} attempts={attempts} played={song.get('played')!r}"
    )
    if observed != arguments.expect:
        if observed < arguments.expect:
            detail = ("fewer than expected: the app recorded no play, or the scrobble had not "
                      f"been delivered within --await-seconds {arguments.await_seconds}")
        else:
            detail = ("more than expected: something other than the app under test scrobbled this "
                      "track, so the play cannot be attributed to this run")
        raise SystemExit(
            f"play count mismatch for {arguments.title!r}: expected {arguments.expect}, "
            f"observed {observed} -- {detail}"
        )
    print(f"PLAY COUNT ASSERTION PASS title={arguments.title!r} expected={arguments.expect}")


if __name__ == "__main__":
    main()
