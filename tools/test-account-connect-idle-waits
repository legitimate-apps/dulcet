                                       'covered-target', 'reversed-drag', 'unbounded-drag'])
args = parser.parse_args()
proof_path = 'apple/DulcetiOSUITests/DulcetAccountConnectStatesUITests.swift'
source = (subprocess.check_output(['git', 'show', f'{args.source_ref}:{proof_path}'], cwd=ROOT, text=True)
          if args.source_ref else (args.source or ROOT / proof_path).read_text())
assert not (args.clip_case and args.dock_case), 'Choose one focused control family per invocation'

def declaration(marker, source=source):
    start = source.index(marker)
    opening = source.index('{', start)
    depth = 1
    end = opening + 1
    while depth:
        depth += (source[end] == '{') - (source[end] == '}')
        end += 1
    return source[start:end].replace('private func', 'func', 1).replace('private enum', 'enum', 1)

def method(name):
    return declaration('    private func ' + name + '(')

scope = method('withoutIdleWaits')
