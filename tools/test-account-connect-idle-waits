    assert delta in scroll
    scroll = scroll.replace(delta, '-(' + delta + ')' if args.mutant == 'reversed-drag' else 'viewport.midY - targetY')
if args.mutant == 'moving-target':
    calls = (['waitForStableHitTarget(element, matching: target, in: window, timeout: 5)',
              'waitForStableHitTarget(element, matching: target, in: window, timeout: 5, application: app)']
             if snapshot_polling else ['waitForStableHitTarget(element, in: window, timeout: 5)'])
    matches = [call for call in calls if call in scroll]
    assert len(matches) == 1 and scroll.count(matches[0]) == 1, 'moving-target must mutate exactly one actual wait call'
    scroll = scroll.replace(matches[0], 'element.isHittable', 1)
if args.mutant == 'confirmation-once':
    start = sign_out.index('        let confirmationDeadline')
    end = sign_out.index('        guard primary.waitForExistence', start)
    sign_out = sign_out[:start] + '        confirm.tap()\n' + sign_out[end:]
if args.mutant in ('before-only', 'after-only'):
    scope = scope.replace('perform(app, selector, 3, body)',
                          'perform(app, selector, ' + ('1' if args.mutant == 'before-only' else '2') + ', body)')
if args.mutant == 'no-scope':
    proof = proof.replace('withoutIdleWaits(app)', 'runPlainly(app)')

