#!/usr/bin/env python3
"""Prove the iPad destination resolver never hands back a non-iPad and never invents one.

The regular-width layout proof is only as trustworthy as the device it runs on. A resolver that
quietly fell back to an iPhone would keep CI green while proving nothing, and the UI test's width
guard would then fail with a confusing message instead of a clear one. These controls pin the two
properties that matter: an iPad-less image must fail loudly, and a device that merely mentions iPad
must not be mistaken for one.
"""

from __future__ import annotations

import json
import io
import os
import runpy
import subprocess
import sys
from pathlib import Path
from tempfile import TemporaryDirectory
from unittest.mock import patch
from contextlib import redirect_stdout, redirect_stderr

RESOLVER = Path(__file__).resolve().parent / "resolve-ipad-destination"
IOS = "com.apple.CoreSimulator.SimRuntime.iOS-26-5"
OLD_IOS = "com.apple.CoreSimulator.SimRuntime.iOS-26-2"


def destinations(*ids: str) -> str:
    return 'Available destinations for the "DulcetiOS" scheme:\n' + "\n".join(
        f"  {{ platform:iOS Simulator, arch:arm64, id:{udid}, OS:26.5, name:iPad }}"
        for udid in ids
    )


def run(payload: dict, transcript: str | None = None, field: str = "name") -> subprocess.CompletedProcess:
    with TemporaryDirectory() as tmp:
        path = Path(tmp) / "devices.json"
        path.write_text(json.dumps(payload))
        accepted = Path(tmp) / "destinations.txt"
        accepted.write_text(transcript if transcript is not None else destinations(
            *(d["udid"] for devices in payload["devices"].values() for d in devices)
        ))
        return subprocess.run(
            [sys.executable, str(RESOLVER), "--devices-json", str(path),
             "--destinations-file", str(accepted), "--discovery-timeout", "0.1", "--print", field],
            # Fixtures must be sufficient: neither Apple executable can be found in these controls.
            env={**os.environ, "PATH": ""},
            text=True,
            capture_output=True,
            check=False,
        )


def device(name: str, udid: str, available: bool = True) -> dict:
    return {"name": name, "udid": udid, "isAvailable": available}


def discovery_fixture(transcripts: list[str], query_duration: float = 0) -> dict:
    """Drive main with a query sequence and a virtual monotonic clock, without Apple tools."""
    resolver = runpy.run_path(str(RESOLVER))
    elapsed = 0.0
    timeouts, sleeps = [], []
    stdout, stderr = io.StringIO(), io.StringIO()

    def query(path, project, scheme, timeout):
        nonlocal elapsed
        timeouts.append(timeout)
        elapsed += min(query_duration, timeout)
        return transcripts[min(len(timeouts) - 1, len(transcripts) - 1)]

    def sleep(seconds):
        nonlocal elapsed
        sleeps.append(seconds)
        elapsed += seconds

    with (patch.dict(resolver["main"].__globals__, {
              "load_devices": lambda _: {"devices": {IOS: [device("iPad Pro 13-inch (M5)", "EEE")]}},
              "load_destinations": query,
          }), patch("time.monotonic", side_effect=lambda: elapsed),
          patch("time.sleep", side_effect=sleep),
          patch.object(sys, "argv", [str(RESOLVER), "--print", "udid"]),
          redirect_stdout(stdout), redirect_stderr(stderr)):
        status = 0
        try:
            resolver["main"]()
        except SystemExit as error:
            status = 1
            print(error, file=sys.stderr)
    return {"status": status, "stdout": stdout.getvalue(), "stderr": stderr.getvalue(),
            "elapsed": elapsed, "attempts": len(timeouts), "timeouts": timeouts, "sleeps": sleeps}


def main() -> None:
    # 1. An image with no iPad at all must fail, and must say what it looked for.
    iphones_only = run({"devices": {IOS: [device("iPhone 17 Pro", "AAA")]}})
    if iphones_only.returncode == 0:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: an iPad-less device list resolved to "
            f"{iphones_only.stdout.strip()!r}"
        )
    if "no available iPad simulator" not in iphones_only.stderr:
        raise SystemExit(
            "NEGATIVE CONTROL FAILED: the iPad-less failure does not name its own cause:\n"
            + iphones_only.stderr
        )
    print("NEGATIVE CONTROL PASS ipad_less_image_rejected=true")

    # 2. A name that merely CONTAINS "iPad" is not an iPad. This is the silent-wrong-device case.
    decoy = run({"devices": {IOS: [device("iPhone iPad-sized Simulator", "BBB")]}})
    if decoy.returncode == 0:
        raise SystemExit(
            f"NEGATIVE CONTROL FAILED: a non-iPad named {decoy.stdout.strip()!r} was accepted"
        )
    print("NEGATIVE CONTROL PASS non_ipad_named_device_rejected=true")

    # 3. An unavailable iPad is not a usable iPad.
    unavailable = run({"devices": {IOS: [device("iPad Pro 13-inch (M5)", "CCC", available=False)]}})
    if unavailable.returncode == 0:
        raise SystemExit("NEGATIVE CONTROL FAILED: an unavailable iPad was accepted")
    print("NEGATIVE CONTROL PASS unavailable_ipad_rejected=true")

    # 4. Given a choice, the widest iPad wins -- an iPad mini's portrait width sits closest to the
    #    regular-width boundary the proof depends on, so picking it is a latent flake.
    mixed = run({
        "devices": {
            IOS: [device("iPad mini (A17 Pro)", "DDD"), device("iPad Pro 13-inch (M5)", "EEE")],
            OLD_IOS: [device("iPad Pro 13-inch (M5)", "FFF")],
        }
    })
    if mixed.returncode != 0:
        raise SystemExit("POSITIVE CONTROL FAILED: a valid mixed image did not resolve:\n" + mixed.stderr)
    chosen = mixed.stdout.strip()
    if chosen != "iPad Pro 13-inch (M5)":
        raise SystemExit(f"POSITIVE CONTROL FAILED: expected the widest iPad, chose {chosen!r}")
    print(f"POSITIVE CONTROL PASS widest_ipad_preferred={chosen!r}")

    # 5. Determinism: the same payload must resolve identically twice.
    again = run({
        "devices": {
            IOS: [device("iPad mini (A17 Pro)", "DDD"), device("iPad Pro 13-inch (M5)", "EEE")],
            OLD_IOS: [device("iPad Pro 13-inch (M5)", "FFF")],
        }
    })
    if again.stdout.strip() != chosen:
        raise SystemExit(
            f"POSITIVE CONTROL FAILED: resolution is not deterministic ({chosen!r} then {again.stdout.strip()!r})"
        )
    print("POSITIVE CONTROL PASS deterministic=true")

    # Mutate only Xcode's accepted set, leaving simctl and the ranking unchanged.
    inventory = {"devices": {
        IOS: [device("iPad Pro 13-inch (M5)", "EEE")],
        OLD_IOS: [device("iPad Pro 13-inch (M5)", "FFF")],
    }}
    for label, transcript, expected in (
        ("top_excluded", destinations("FFF"), "FFF"),
        ("top_included", destinations("FFF", "EEE"), "EEE"),
    ):
        result = run(inventory, transcript, "udid")
        if result.returncode != 0 or result.stdout.strip() != expected:
            raise SystemExit(f"MUTATION CONTROL FAILED {label}: {result.stdout}{result.stderr}")
        print(f"MUTATION CONTROL PASS {label} stdout={result.stdout.strip()!r} stderr={result.stderr.strip()!r}")

    for label, transcript in (
        ("empty_intersection", destinations("UNRELATED")),
        ("placeholders_only", destinations("dvtdevice-DVTiOSDeviceSimulatorPlaceholder")),
        ("ineligible_only", destinations() + '\nIneligible destinations for the "DulcetiOS" scheme:\n'
         '  { platform:iOS Simulator, id:EEE, name:iPad, error:unavailable }'),
        ("wrong_platform", 'Available destinations for the "DulcetiOS" scheme:\n'
         '  { platform:iOS, id:EEE, name:iPad }'),
        ("row_error", destinations("EEE").replace("name:iPad", "name:iPad, error:unavailable")),
        ("malformed_output", "not a destinations listing"),
        ("wrong_scheme", destinations("EEE").replace("DulcetiOS", "OtherScheme")),
    ):
        result = run(inventory, transcript, "udid")
        if (result.returncode == 0 or result.stdout or "simctl offered:" not in result.stderr
                or "xcodebuild accepts" not in result.stderr or "EEE" not in result.stderr
                or transcript not in result.stderr):
            raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: {result.stdout}{result.stderr}")
        print(f"NEGATIVE CONTROL PASS {label}_rejected=true both_inventories=true stdout_empty=true")

    # Exercise the real query wrapper with a mocked process boundary, never an Apple executable.
    resolver = runpy.run_path(str(RESOLVER))
    query = resolver["load_destinations"]
    command = ["xcrun", "xcodebuild", "-showdestinations", "-project", "test.xcodeproj",
               "-scheme", "TestScheme", "-configuration", "Debug"]
    for label, returned, thrown, expected in (
        ("query_nonzero", subprocess.CompletedProcess(command, 70, "partial", "query failed"), None, "exited 70"),
        ("query_timeout", None, subprocess.TimeoutExpired(command, 60, b"partial", b"timeout detail"), "timed out after 60s"),
    ):
        with patch("subprocess.run", return_value=returned, side_effect=thrown) as process:
            try:
                query(None, "test.xcodeproj", "TestScheme")
            except ValueError as error:
                if expected not in str(error) or "partial" not in str(error) or "UNKNOWN" not in str(error):
                    raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: {error}")
            else:
                raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: query did not fail")
            process.assert_called_once_with(command, capture_output=True, text=True, timeout=60, check=False)
        print(f"NEGATIVE CONTROL PASS {label}_rejected=true query_timeout_seconds=60")

    for label, error in (
        ("failed_query_diagnostic", ValueError("query exited 70; accepted set UNKNOWN")),
        ("timed_out_query_diagnostic", ValueError("query timed out; accepted set UNKNOWN")),
        ("missing_query_executable", FileNotFoundError("xcrun unavailable")),
    ):
        stdout, stderr = io.StringIO(), io.StringIO()
        # Invoke main itself so no failure can accidentally fall back to simctl's first iPad.
        with (patch.dict(resolver["main"].__globals__, {
                  "load_devices": lambda _: inventory,
                  "load_destinations": lambda *args: (_ for _ in ()).throw(error),
              }), patch.object(sys, "argv", [str(RESOLVER)]),
              redirect_stdout(stdout), redirect_stderr(stderr)):
            try:
                resolver["main"]()
            except SystemExit as failure:
                message = str(failure)
                if ("simctl offered:" not in message or "EEE" not in message
                        or "xcodebuild accepts" not in message or str(error) not in message):
                    raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: {message}")
            else:
                raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: resolver did not fail")
        if stdout.getvalue():
            raise SystemExit(f"NEGATIVE CONTROL FAILED {label}: resolver returned a destination")
        print(f"NEGATIVE CONTROL PASS {label}=true both_inventories=true stdout_empty=true")

    private_device = {
        **device("iPad Pro 13-inch (M5)", "AAAA"),
        "dataPath": "/Users/SOMEUSER/Library/Developer/CoreSimulator/Devices/AAAA",
        "logPath": "/Users/SOMEUSER/Library/Logs/CoreSimulator/AAAA",
        "futurePrivateField": "/Users/SOMEUSER/private",
    }
    for label, transcript in (
        ("no_eligible_ipad", destinations("UNRELATED")),
        ("query_failure", "not a destinations listing"),
    ):
        result = run({"devices": {IOS: [private_device]}}, transcript, "udid")
        output = result.stdout + result.stderr
        if any(value in output for value in ("/Users/", "SOMEUSER", "dataPath", "logPath", "futurePrivateField")):
            raise SystemExit(f"LEAK CONTROL FAILED {label}: private simctl fields reached output")
        if (result.returncode == 0 or result.stdout or "simctl offered:" not in result.stderr
                or "xcodebuild accepts" not in result.stderr or transcript not in result.stderr):
            raise SystemExit(f"LEAK CONTROL FAILED {label}: failure lost inventory diagnostics")
        offered = next(line.removeprefix("simctl offered: ") for line in result.stderr.splitlines()
                       if line.startswith("simctl offered: "))
        if json.loads(offered) != [{"name": private_device["name"], "udid": "AAAA",
                                   "runtime": IOS, "isAvailable": True}]:
            raise SystemExit(f"LEAK CONTROL FAILED {label}: identifying fields changed")
        print(f"LEAK CONTROL PASS {label} home_paths_absent=true identifying_fields_only=true both_inventories=true stdout_empty=true")

    empty = destinations("dvtdevice-DVTiOSDeviceSimulatorPlaceholder")
    populated = discovery_fixture([empty] * 4 + [destinations("EEE")])
    if (populated["status"] != 0 or populated["stdout"] != "EEE\n"
            or populated["attempts"] != 5 or "query_attempts=5" not in populated["stderr"]):
        raise SystemExit(f"RETRY CONTROL FAILED empty_then_populated: {populated}")
    print(f"RETRY CONTROL PASS empty_then_populated exit_code=0 attempts=5 virtual_elapsed={populated['elapsed']:.3f}s deadline=120s stdout={populated['stdout'].strip()!r}")
    print(populated["stderr"].strip())

    empty_forever = discovery_fixture([empty])
    if (empty_forever["status"] != 1 or empty_forever["stdout"]
            or empty_forever["elapsed"] != 120 or empty_forever["attempts"] != 24
            or "attempts=24 elapsed=120.000s deadline=120s" not in empty_forever["stderr"]
            or "simctl offered:" not in empty_forever["stderr"]
            or "xcodebuild accepts" not in empty_forever["stderr"] or empty not in empty_forever["stderr"]):
        raise SystemExit(f"RETRY CONTROL FAILED empty_throughout: {empty_forever}")
    print("RETRY CONTROL PASS empty_throughout exit_code=1 attempts=24 virtual_elapsed=120.000s deadline=120s both_inventories=true last_query_present=true stdout_empty=true")

    mismatch = discovery_fixture([destinations("IPHONE")])
    if (mismatch["status"] != 1 or mismatch["stdout"] or mismatch["attempts"] != 1
            or mismatch["elapsed"] != 0 or mismatch["sleeps"]
            or "simctl offered:" not in mismatch["stderr"]
            or "['IPHONE']" not in mismatch["stderr"]):
        raise SystemExit(f"RETRY CONTROL FAILED concrete_mismatch: {mismatch}")
    print("RETRY CONTROL PASS concrete_mismatch exit_code=1 attempts=1 virtual_elapsed=0.000s deadline=120s sleeps=0 both_inventories=true stdout_empty=true")

    slow = discovery_fixture([empty], query_duration=59)
    if slow["status"] != 1 or slow["stdout"] or slow["elapsed"] != 120 or slow["timeouts"] != [60, 56]:
        raise SystemExit(f"RETRY CONTROL FAILED remaining_budget: {slow}")
    print("RETRY CONTROL PASS remaining_budget exit_code=1 query_timeouts=[60,56] virtual_elapsed=120.000s deadline=120s stdout_empty=true")


if __name__ == "__main__":
    main()
