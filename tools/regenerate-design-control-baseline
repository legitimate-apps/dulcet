#!/usr/bin/env bash

set -euo pipefail

if [[ "$#" -ne 1 ]]; then
  echo "usage: tools/regenerate-design-control-baseline <new-candidate-directory>" >&2
  exit 2
fi

candidate_directory=$1
if [[ -e "$candidate_directory" ]]; then
  echo "candidate directory must not exist: $candidate_directory" >&2
  exit 2
fi

repository_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repository_root"

swift run --package-path apple/DulcetKit DulcetCapture \
  --output "$candidate_directory" \
  --generate-control-candidates

for appearance in light dark; do
  filename="macos-CONTROL-DELIBERATELY-BAD-library-browse-${appearance}.jpg"
  pinned="apple/DulcetKit/Sources/DulcetCapture/Resources/PinnedControls/$filename"
  candidate="$candidate_directory/$filename"
  pinned_hash=$(shasum -a 256 "$pinned" | awk '{print $1}')
  candidate_hash=$(shasum -a 256 "$candidate" | awk '{print $1}')
  status=CHANGED
  if [[ "$pinned_hash" == "$candidate_hash" ]]; then
    status=UNCHANGED
  fi
  echo "CONTROL BASELINE CANDIDATE appearance=$appearance status=$status pinned=$pinned_hash candidate=$candidate_hash"
done

echo "Candidates only: this command did not modify the pinned resources."
