#!/usr/bin/env python3
"""Real-socket controls for transparent forwarding and redacted connection receipts."""
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import threading
import time
import unittest

CANARY = 'private-query-and-header-canary'

class Upstream(BaseHTTPRequestHandler):
    def log_message(self, *_): pass
    def do_GET(self):
        self.server.seen.append((self.path, self.headers.get('Authorization')))
        if self.path.startswith('/rest/getArtist'):
            self.connection.shutdown(socket.SHUT_RDWR)
            self.connection.close()
            return
        self.send_response(206)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Range', 'bytes 0-1/2')
        self.end_headers()
        self.wfile.write(b'{}')

class ProxyTest(unittest.TestCase):
    def test_forwarding_and_offline_receipts_omit_authenticated_urls(self):
        upstream = ThreadingHTTPServer(('127.0.0.1', 0), Upstream)
        upstream.seen = []
        thread = threading.Thread(target=upstream.serve_forever, daemon=True)
        thread.start()
        with socket.socket() as probe:
            probe.bind(('127.0.0.1', 0))
            port = probe.getsockname()[1]
        with tempfile.NamedTemporaryFile(mode='w+') as log:
            child = subprocess.Popen([sys.executable, str(Path(__file__).parent / 'my-library-ui-proxy'),
                '--port', str(port), '--upstream-port', str(upstream.server_port)], stdout=log, stderr=log)
            def request(path):
                connection = http.client.HTTPConnection('127.0.0.1', port, timeout=2)
                try:
                    connection.request('GET', path, headers={'Authorization': CANARY})
                    answer = connection.getresponse()
                    return answer.status, dict(answer.getheaders()), answer.read()
                finally:
                    connection.close()
            try:
                deadline = time.monotonic() + 5
                while True:
                    try:
                        request('/fixture/network?offline=0')
                        break
                    except OSError:
                        if time.monotonic() >= deadline: raise
                        time.sleep(.02)
                path = '/rest/ping.view?u=' + CANARY + '&t=' + CANARY
                status, headers, body = request(path)
                self.assertEqual((status, body), (206, b'{}'))
                self.assertEqual(headers['Content-Range'], 'bytes 0-1/2')
                self.assertEqual(upstream.seen, [(path, CANARY)])
                request('/fixture/network?offline=1')
                with self.assertRaises(http.client.RemoteDisconnected):
                    request('/rest/getAlbum?u=' + CANARY)
                self.assertEqual(len(upstream.seen), 1, 'offline requests cannot reach the upstream')
                request('/fixture/network?offline=0')
                with self.assertRaises(http.client.RemoteDisconnected):
                    request('/rest/getArtist?u=' + CANARY)
                # Receipt writes follow socket writes. Witness the terminal records before
                # stopping the child, rather than racing its stdout against SIGTERM.
                deadline = time.monotonic() + 2
                while True:
                    output = Path(log.name).read_text()
                    complete = []
                    for line in output.splitlines():
                        if not line.startswith('MY LIBRARY REQUEST '): continue
                        try: complete.append(json.loads(line.removeprefix('MY LIBRARY REQUEST ')))
                        except json.JSONDecodeError: pass  # A write may still be in progress.
                    if any(r['endpoint'] == 'ping' and r['phase'] == 'delivered' for r in complete) and any(
                        r['endpoint'] == 'getArtist' and r['phase'] == 'failed' for r in complete):
                        break
                    if time.monotonic() >= deadline:
                        self.fail('The proxy must finish its delivery and failure receipts')
                    time.sleep(.01)
            finally:
                child.terminate()
                child.wait(timeout=5)
                upstream.shutdown()
                upstream.server_close()
            output = Path(log.name).read_text()
        self.assertNotIn(CANARY, output)
        records = [json.loads(line.removeprefix('MY LIBRARY REQUEST '))
                   for line in output.splitlines() if line.startswith('MY LIBRARY REQUEST ')]
        ping = [record for record in records if record['endpoint'] == 'ping']
        self.assertEqual([r['phase'] for r in ping], ['received', 'upstream', 'delivered'])
        self.assertEqual(ping[-1]['status'], 206)
        self.assertTrue(all(r['wallTimeMillis'] > 0 and r['elapsedMillis'] >= 0 for r in ping))
        self.assertEqual(len({r['request'] for r in ping}), 1)
        album = [r for r in records if r['endpoint'] == 'getAlbum']
        self.assertEqual([r['phase'] for r in album], ['received', 'offline'])
        failed = [r for r in records if r['endpoint'] == 'getArtist']
        self.assertEqual([r['phase'] for r in failed], ['received', 'failed'])
        self.assertEqual(failed[-1]['error'], 'RemoteDisconnected')

if __name__ == '__main__': unittest.main()
