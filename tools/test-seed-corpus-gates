#!/usr/bin/env python3

"""Negative controls for the corpus evidence gates."""

from pathlib import Path
import sys


def _load_source(name, path):
    """Imports a tool that has no .py suffix. Loaders no longer offer load_module() on the
    Python that hosted macOS runners now run (apple-ci run 38680055395), so exec_module()
    runs it, registered first as load_module() did."""
    import importlib.machinery
    import importlib.util
    import sys
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    sys.modules[name] = module
    loader.exec_module(module)
    return module


seed_corpus = _load_source("seed_corpus", str(Path(__file__).with_name("seed-corpus")))
sys.path.insert(0, str(Path(__file__).with_name("conformance-env")))
health_check = _load_source("health_check", str(Path(__file__).with_name("conformance-env") / "health-check"))


class ProbeTools:
    def __init__(self, probe: dict):
        self.probe = probe

    def ffprobe_json(self, path: Path) -> dict:
        return self.probe


def require_rejection(
    label: str,
    probe: dict,
    expected_detail: str,
    *,
    absent_tags: tuple[str, ...] = (),
) -> None:
    expected_rejected = True
    observed_rejected = False
    observed_detail = ""
    try:
        seed_corpus.assert_media(
            ProbeTools(probe),
            Path("forged.flac"),
            expected_tags={},
            absent_tags=absent_tags,
            duration=1.0,
        )
    except SystemExit as error:
        observed_rejected = True
        observed_detail = str(error)
        if observed_detail != expected_detail:
            raise SystemExit(
                f"negative control rejected for the wrong reason: {label}: "
                f"expected_detail={expected_detail!r} observed_detail={observed_detail!r}"
            ) from error
    if observed_rejected != expected_rejected:
        raise SystemExit(f"negative control failed open: {label}")
    print(
        f"NEGATIVE CONTROL PASS control={label} "
        f"expected_rejected={str(expected_rejected).lower()} "
        f"observed_rejected={str(observed_rejected).lower()} detail={observed_detail}"
    )


def main() -> None:
    class CorpusClient:
        def __init__(self, songs):
            self.songs = songs

        def subsonic(self, endpoint, *, parameters):
            if endpoint == "getSong":
                return {"song": next(song for song in self.songs if song.get("id") == parameters["id"])}
            assert endpoint == "search3"
            start = int(parameters["songOffset"])
            return {"searchResult3": {"song": self.songs[start:start + 200]}}

    # All pages must carry real durations, including the page after a full first page.
    songs = [{"id": str(index), "duration": 2} for index in range(201)]
    assert health_check.require_playback_durations(CorpusClient(songs), 201) == 201
    for duration in (None, 0):
        invalid = songs[:-1] + [{"id": "last", **({"duration": duration} if duration is not None else {})}]
        try:
            health_check.require_playback_durations(CorpusClient(invalid), 201)
        except SystemExit as error:
            assert "no positive server duration: last" in str(error), str(error)
        else:
            raise SystemExit("playback corpus duration gate accepted a broken positive second-page fixture")
    fixture = {"title": "Durationless Playback Canary", "album": "Durationless"}
    canary = {"id": "durationless", **fixture}
    assert health_check.require_playback_durations(
        CorpusClient([*songs, canary]), 202, durationless_fixture=fixture,
    ) == 201

    def require_durationless_rejection(client, expected_count, detail):
        try:
            health_check.require_playback_durations(client, expected_count, durationless_fixture=fixture)
        except SystemExit as error:
            assert detail in str(error), str(error)
        else:
            raise SystemExit(f"durationless playback control failed open: {detail}")

    for duration in (None, 0, 1):
        require_durationless_rejection(
            CorpusClient([*songs, {**canary, "duration": duration}]), 202,
            "durationless playback fixture has a server duration field",
        )
    require_durationless_rejection(
        CorpusClient(songs), 201, "durationless playback fixture count mismatch: expected 1, observed 0",
    )
    require_durationless_rejection(
        CorpusClient([*songs, canary, {**canary, "id": "duplicate"}]), 203,
        "durationless playback fixture count mismatch: expected 1, observed 2",
    )
    require_durationless_rejection(
        CorpusClient([*songs[:-1], {"id": "last"}, canary]), 202,
        "no positive server duration: last",
    )

    class ChangedGetSongClient(CorpusClient):
        def subsonic(self, endpoint, *, parameters):
            response = super().subsonic(endpoint, parameters=parameters)
            if endpoint == "getSong":
                return {"song": {**response["song"], "duration": 1}}
            return response

    require_durationless_rejection(
        ChangedGetSongClient([*songs, canary]), 202,
        "durationless playback fixture getSong has a server duration field",
    )
    print("PLAYBACK CORPUS CONTROL PASS known=201 missing-duration=rejected zero-duration=rejected "
          "durationless=accepted missing-canary=rejected duplicate-canary=rejected "
          "canary-duration-null-zero-positive=rejected getSong-duration=rejected")
    require_rejection(
        "mislabeled_container",
        {"format": {"format_name": "wav", "duration": "1.0", "tags": {}}, "streams": []},
        "ffprobe container mismatch for forged.flac: expected 'flac', observed 'wav'",
    )
    require_rejection(
        "present_empty_tags",
        {
            "format": {
                "format_name": "flac",
                "duration": "1.0",
                "tags": {"album": "", "album_artist": ""},
            },
            "streams": [],
        },
        "ffprobe found forbidden tags for forged.flac: {'album': '', 'albumartist': ''}",
        absent_tags=("album", "albumartist"),
    )
    _, _, observed_format_name = seed_corpus.assert_media(
        ProbeTools(
            {
                "format": {
                    "format_name": "wav, flac",
                    "duration": "1.0",
                    "tags": {},
                },
                "streams": [],
            }
        ),
        Path("forged.flac"),
        expected_tags={},
        duration=1.0,
    )
    expected_format_token = seed_corpus.PROBED_FORMAT_BY_SUFFIX[".flac"]
    expected_retained_format_name = "wav,flac"
    if observed_format_name != expected_retained_format_name:
        raise SystemExit(
            "format-name provenance control smoothed the observation: "
            f"expected {expected_retained_format_name!r}, observed {observed_format_name!r}"
        )
    print(
        f"PROVENANCE CONTROL PASS expected_format_token={expected_format_token} "
        f"expected_retained_format_name={expected_retained_format_name} "
        f"observed_format_name={observed_format_name}"
    )


if __name__ == "__main__":
    main()
