#!/usr/bin/env python3
"""Run destructive diagnostic mutations in temporary copies, leaving the working probe intact.

A control that a deleted check still passes is not a control. Each mutation below removes exactly
one property `diagnose_loopback` claims -- a probe, an elapsed-time classification, the redactor,
the shared wall-clock allowance, the order the two failure facts are printed in -- and the run fails
unless `tools/test-cache-loopback-diagnostic` rejects it with an ASSERTION, not merely a nonzero
exit. The working probe is never edited: every mutant is compiled into a temporary copy selected
through DULCET_TEST_CACHE_PROBE.
"""
import ast
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory

ROOT = Path(__file__).resolve().parent
SOURCE = ROOT / "conformance-env/observe-transcode-cache"
source = SOURCE.read_text()


def replace(old, new):
    assert source.count(old) == 1, old
    return source.replace(old, new)


def body(name, replacement):
    tree = ast.parse(source)
    node = next(node for node in ast.walk(tree) if isinstance(node, ast.FunctionDef) and node.name == name)
    lines = source.splitlines(keepends=True)
    return "".join(lines[:node.body[0].lineno - 1]) + " " * node.body[0].col_offset + replacement + "\n" + "".join(lines[node.end_lineno:])


mutations = [
    ("constant-verdict", body("diagnose_loopback", 'return "loopback diagnosis=server-answering"'), "branches"),
    ("delete-raw-probe", body("raw_connect", "pass"), "branches"),
    ("delete-http-probe", body("bare_ping", "pass"), "branches"),
    ("delete-authenticated-probe", body("subsonic_ping", "pass"), "branches"),
    ("delete-connect-elapsed-classification", replace("connect_s >= STALLED or ", ""), "branches"),
    ("delete-http-elapsed-classification", replace("ping_s >= STALLED or ", ""), "branches"),
    ("delete-rest-elapsed-classification", replace("rest_s >= STALLED or ", ""), "branches"),
    ("delete-anomaly-reporting", replace("    if anomalies:\n", "    if False:\n"), "branches"),
    ("delete-envelope-validation", replace('        if status != "ok":', '        if False:'), "branches"),
    ("delete-redactor", body("safe", 'return f"{type(error).__name__}: {error}"'), "branches"),
    ("word-only-redactor", body("safe", 'return re.sub(r"[?]u=\\w[^ ]*", "?<redacted>", f"{type(error).__name__}: {error}")'), "branches"),
    ("delete-wall-timer", replace("        signal.setitimer(signal.ITIMER_REAL, remaining)", "        pass  # timer deleted"), "ping-drip"),
    ("fresh-budget-per-layer", replace("        remaining = deadline - start", "        remaining = budget"), "shared-rest-drip"),
]
# Recreate diagnosis-before-primary without changing the rest of the failure path.
line = '        print(diagnose_loopback(base_url), file=sys.stderr, flush=True)\n'
mutations.append(("diagnose-before-primary", source.replace(line, "").replace('        # Publish the cause', line + '        # Publish the cause'), "ping-stall"))

with TemporaryDirectory() as tmp:
    probe = Path(tmp) / SOURCE.name
    (Path(tmp) / "readiness_transport.py").write_text((SOURCE.parent / "readiness_transport.py").read_text())
    for name, mutant, case in mutations:
        assert mutant != source, f"mutation {name} did not change the source"
        compile(mutant, name, "exec")
        probe.write_text(mutant)
        result = subprocess.run([sys.executable, str(ROOT / "test-cache-loopback-diagnostic"), "--case", case], env={**os.environ, "DULCET_TEST_CACHE_PROBE": str(probe)}, text=True, capture_output=True, timeout=45)
        output = result.stdout + result.stderr
        assert result.returncode != 0, f"SURVIVED {name}:\n{output}"
        assert "AssertionError:" in output, f"mutation did not fail an assertion {name}:\n{output}"
        failure = next(line for line in reversed(output.splitlines()) if line.startswith("AssertionError:"))
        print(f"KILLED {name} exit={result.returncode} {failure}", flush=True)
