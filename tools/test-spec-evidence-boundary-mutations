#!/usr/bin/env python3
"""Mutation tests proving the spec evidence-boundary checker rejects regressions."""

from pathlib import Path
import json
import re
import shutil
import subprocess
import sys
import tempfile


REPOSITORY = Path(__file__).resolve().parent.parent


def materialize(root: Path) -> None:
    for relative in (
        "tools/test-spec-evidence-boundaries",
        "tools/verify_promotion_conditions.py",
        "tools/feature_json.py",
        "FEATURES.yml",
        "core/src/commonMain/kotlin/com/legitimateapps/dulcet/core/AccountConnection.kt",
        "docs/superpowers/specs/2026-08-18-dulcet-design.md",
        ".github/workflows/parity-gate.yml",
        ".github/workflows/branch-protection-drift.yml",
        # Listen Now promotion conditions name the native and shared validation workflows.
        ".github/workflows/apple-ci.yml",
        ".github/workflows/core-ci.yml",
        # The macOS account.connect promotion target must resolve in the copy too.
        ".github/workflows/signed-mac-account-connect.yml",
        "apple/DulcetSignedMacTests/DulcetSignedMacAccountConnectTests.swift",
    ):
        source = REPOSITORY / relative
        target = root / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)


def invoke(root: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, "tools/test-spec-evidence-boundaries"],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


with tempfile.TemporaryDirectory(prefix="dulcet-spec-boundary-") as directory:
    root = Path(directory)
    materialize(root)
    baseline = invoke(root)
    if baseline.returncode != 0:
        raise AssertionError(f"valid specification rejected: {baseline.stdout}")

    spec_path = root / "docs/superpowers/specs/2026-08-18-dulcet-design.md"
    spec = spec_path.read_text()
    boundary_start = "**Apple implementation boundary:**"
    boundary_end = "account-setup claim for any platform."
    before, separator, remainder = spec.partition(boundary_start)
    if not separator:
        raise AssertionError("account-setup implementation boundary fixture is missing")
    _boundary, separator, after = remainder.partition(boundary_end)
    if not separator:
        raise AssertionError("account-setup implementation boundary terminator is missing")
    mutated = before + "Account setup is available where supported." + after
    mutated = mutated.replace(
        "required Apple presentation",
        "UI",
        1,
    )
    spec_path.write_text(mutated)

    result = invoke(root)
    expected = "account-setup implementation boundary"
    if result.returncode == 0 or expected not in result.stdout:
        raise AssertionError(
            "removed account-setup implementation boundary was accepted: "
            f"returncode={result.returncode}, output={result.stdout!r}"
        )

with tempfile.TemporaryDirectory(prefix="dulcet-spec-revision-header-") as directory:
    root = Path(directory)
    materialize(root)
    spec_path = root / "docs/superpowers/specs/2026-08-18-dulcet-design.md"
    spec = spec_path.read_text()
    declaration = re.search(r"^\*\*Revision:\*\*.*$", spec, re.MULTILINE)
    if declaration is None:
        raise AssertionError("derived revision header fixture is missing")
    mutated = spec[: declaration.start()] + "**Revision:** 80" + spec[declaration.end() :]
    spec_path.write_text(mutated)

    result = invoke(root)
    expected = "must derive from the highest dated §28 record"
    if result.returncode == 0 or expected not in result.stdout:
        raise AssertionError(
            "hand-maintained revision declaration was accepted: "
            f"returncode={result.returncode}, output={result.stdout!r}"
        )

