#!/usr/bin/env python3
"""Discriminating controls for report_main_health.py."""

from __future__ import annotations

from collections.abc import Callable
import contextlib
import io
import json
import os
from pathlib import Path
import sys
import unittest
from unittest.mock import patch
import urllib.parse


TOOLS = Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS))

import report_main_health as reporter  # noqa: E402


SHA = "0123456789abcdef0123456789abcdef01234567"
NEWER_SHA = "fedcba9876543210fedcba9876543210fedcba98"
REPOSITORY = "owner/repo"
REQUIRED = ("apple-ci", "core-ci", "parity-gate")
ACTIONS_APP_ID = 15368
FULL = {
    "GITHUB_TOKEN": "not-a-real-token",
    "GITHUB_REPOSITORY": REPOSITORY,
    "RUN_WORKFLOW": "apple-ci",
    "RUN_CONCLUSION": "success",
    "RUN_URL": "https://example.invalid/actions/runs/101",
    "RUN_HEAD_SHA": SHA,
    "RUN_ID": "101",
}
ENV_KEYS = tuple(FULL)


def check_run(
    name: str,
    conclusion: str | None,
    identifier: int,
    *,
    sha: str = SHA,
    status: str = "completed",
    app_id: int = ACTIONS_APP_ID,
) -> dict[str, object]:
    return {
        "id": identifier,
        "name": name,
        "head_sha": sha,
        "status": status,
        "conclusion": conclusion,
        "app": {"id": app_id, "slug": "github-actions"},
        "html_url": f"https://example.invalid/check-runs/{identifier}",
    }


def green_checks() -> list[dict[str, object]]:
    return [check_run(name, "success", 201 + index) for index, name in enumerate(REQUIRED)]


def commit_status(
    context: str,
    state: str,
    identifier: int,
    *,
    sha: str = SHA,
) -> dict[str, object]:
    return {
        "id": identifier,
        "context": context,
        "state": state,
        "sha": sha,
        "target_url": f"https://example.invalid/statuses/{identifier}",
    }


class FakeGitHub:
    def __init__(
        self,
        checks: list[dict[str, object]] | None = None,
        *,
        statuses: list[dict[str, object]] | None = None,
        issue_number: int | None = 52,
        current_heads: list[str] | None = None,
        on_branch_read: Callable[["FakeGitHub", int], None] | None = None,
    ):
        self.checks = checks or []
        self.statuses = statuses or []
        self.issue_number = issue_number
        self.current_heads = current_heads or [SHA]
        self.on_branch_read = on_branch_read
        self.branch_reads = 0
        self.calls: list[tuple[str, str, dict | None]] = []

    def __call__(
        self, method: str, path: str, _token: str, body: dict | None = None
    ) -> object:
        self.calls.append((method, path, body))
        if method == "GET" and path.startswith("/search/issues?"):
            items = [] if self.issue_number is None else [{"number": self.issue_number}]
            return {"items": items}
        if method == "GET" and f"/commits/{SHA}/check-runs?" in path:
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(path).query)
            page = int(query.get("page", ["1"])[0])
            batch = self.checks if page == 1 else []
            return {"total_count": len(self.checks), "check_runs": batch}
        if method == "GET" and f"/commits/{SHA}/status?" in path:
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(path).query)
            page = int(query.get("page", ["1"])[0])
            batch = self.statuses if page == 1 else []
            return {"sha": SHA, "statuses": batch}
        if method == "GET" and path == f"/repos/{REPOSITORY}/branches/main":
            read = self.branch_reads
            response_sha = self.current_heads[min(read, len(self.current_heads) - 1)]
            self.branch_reads += 1
            if self.on_branch_read is not None:
                self.on_branch_read(self, read)
            return {"name": "main", "commit": {"sha": response_sha}}
        if method == "POST" and path.endswith("/comments"):
            return {"id": 901}
        if method == "PATCH" and path == f"/repos/{REPOSITORY}/issues/{self.issue_number}":
            closed_number = self.issue_number
            self.issue_number = None
            return {"number": closed_number, "state": "closed"}
        if method == "POST" and path == f"/repos/{REPOSITORY}/issues":
            return {"number": 53}
        raise AssertionError(f"unexpected API call: {method} {path} body={body!r}")


def invoke(env: dict[str, str], api: FakeGitHub) -> str:
    clean = {key: value for key, value in os.environ.items() if key not in ENV_KEYS}
    clean.update(env)
    output = io.StringIO()
    with patch.dict(os.environ, clean, clear=True), patch.object(reporter, "call", api):
        with contextlib.redirect_stdout(output):
            reporter.main()
    return output.getvalue()


def mutations(api: FakeGitHub) -> list[tuple[str, str, dict | None]]:
    return [call for call in api.calls if call[0] in {"POST", "PATCH"}]


class MainHealthControls(unittest.TestCase):
    def test_partial_green_same_sha_stays_open(self) -> None:
        checks = green_checks()
        checks[1] = check_run("core-ci", "failure", 202)
        api = FakeGitHub(checks)

        invoke(FULL, api)

        self.assertTrue(any("/check-runs?" in path for _method, path, _body in api.calls))
        self.assertEqual(mutations(api), [])

    def test_all_required_contexts_green_on_exact_sha_close_with_audit_comment(self) -> None:
        api = FakeGitHub(green_checks(), current_heads=[SHA, SHA])

        invoke(FULL, api)

        comments = [call for call in api.calls if call[0] == "POST" and call[1].endswith("/comments")]
        closes = [call for call in api.calls if call[0] == "PATCH"]
        self.assertEqual(len(comments), 1)
        self.assertEqual(len(closes), 1)
        comment = comments[0][2]["body"]
        self.assertIn(SHA, comment)
        self.assertIn("later required workflow fails", comment)
        for identifier in (201, 202, 203):
            self.assertIn(str(identifier), comment)
        branch_read_indices = [
            index for index, call in enumerate(api.calls) if call[1].endswith("/branches/main")
        ]
        self.assertEqual(len(branch_read_indices), 2)
        self.assertLess(api.calls.index(comments[0]), branch_read_indices[-1])
        self.assertLess(branch_read_indices[-1], api.calls.index(closes[0]))

    def test_missing_required_check_context_cannot_close_even_when_workflow_succeeds(self) -> None:
        checks = [item for item in green_checks() if item["name"] != "parity-gate"]
        api = FakeGitHub(checks)

        invoke(FULL, api)

        self.assertTrue(any("/check-runs?" in path for _method, path, _body in api.calls))
        self.assertTrue(any("/status?" in path for _method, path, _body in api.calls))
        self.assertEqual(mutations(api), [])

    def test_green_then_newer_failure_aborts_close_when_head_moves(self) -> None:
        def report_newer_failure(api: FakeGitHub, read: int) -> None:
            if read == 0:
                api.calls.append(
                    (
                        "POST",
                        f"/repos/{REPOSITORY}/issues/{api.issue_number}/comments",
                        {"body": f"Still red on {NEWER_SHA}."},
                    )
                )

        api = FakeGitHub(
            green_checks(),
            current_heads=[SHA, NEWER_SHA],
            on_branch_read=report_newer_failure,
        )

        invoke(FULL, api)

        self.assertEqual(api.branch_reads, 2)
        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_later_failure_opens_fresh_alarm_after_successful_close(self) -> None:
        api = FakeGitHub(green_checks(), current_heads=[SHA, SHA])

        invoke(FULL, api)
        invoke(
            dict(
                FULL,
                RUN_CONCLUSION="failure",
                RUN_HEAD_SHA=NEWER_SHA,
                RUN_ID="301",
                RUN_URL="https://example.invalid/actions/runs/301",
            ),
            api,
        )

        self.assertTrue(any(method == "PATCH" for method, _path, _body in api.calls))
        creates = [
            call
            for call in api.calls
            if call[0] == "POST" and call[1] == f"/repos/{REPOSITORY}/issues"
        ]
        self.assertEqual(len(creates), 1)
        self.assertIn(NEWER_SHA[:8], creates[0][2]["body"])

    def test_cancelled_event_changes_nothing(self) -> None:
        api = FakeGitHub()

        invoke(dict(FULL, RUN_CONCLUSION="cancelled"), api)

        self.assertEqual(api.calls, [])

    def test_newer_cancelled_check_does_not_hide_prior_failure(self) -> None:
        checks = green_checks()
        checks[1] = check_run("core-ci", "failure", 202)
        checks.append(check_run("core-ci", "cancelled", 302))
        api = FakeGitHub(checks)

        invoke(FULL, api)

        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_wrong_sha_in_check_response_fails_loud_without_close(self) -> None:
        checks = green_checks()
        checks[1] = check_run("core-ci", "success", 202, sha=NEWER_SHA)
        api = FakeGitHub(checks)

        with self.assertRaisesRegex(SystemExit, "different head SHA"):
            invoke(FULL, api)

        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_wrong_app_cannot_supply_required_context(self) -> None:
        checks = green_checks()
        checks[1] = check_run("core-ci", "success", 202, app_id=999)
        api = FakeGitHub(checks)

        invoke(FULL, api)

        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_malformed_check_response_fails_loud_without_close(self) -> None:
        class MalformedChecks(FakeGitHub):
            def __call__(
                self, method: str, path: str, token: str, body: dict | None = None
            ) -> object:
                if method == "GET" and "/check-runs?" in path:
                    self.calls.append((method, path, body))
                    return {"total_count": 3, "check_runs": "not-a-list"}
                return super().__call__(method, path, token, body)

        api = MalformedChecks(green_checks())

        with self.assertRaisesRegex(SystemExit, "malformed"):
            invoke(FULL, api)

        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_classic_status_collision_is_ambiguous_and_stays_open(self) -> None:
        api = FakeGitHub(
            green_checks(),
            statuses=[commit_status("core-ci", "success", 401)],
        )

        invoke(FULL, api)

        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_failure_appends_to_existing_alarm(self) -> None:
        api = FakeGitHub()

        invoke(dict(FULL, RUN_CONCLUSION="failure"), api)

        comments = [call for call in api.calls if call[0] == "POST" and call[1].endswith("/comments")]
        self.assertEqual(len(comments), 1)
        self.assertIn("Still red", comments[0][2]["body"])
        self.assertFalse(any("/check-runs?" in path for _method, path, _body in api.calls))
        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_branch_protection_drift_failure_appends_to_alarm(self) -> None:
        api = FakeGitHub()
        drifted = dict(FULL, RUN_WORKFLOW="branch-protection-drift", RUN_CONCLUSION="failure")

        invoke(drifted, api)

        comments = [call for call in api.calls if call[0] == "POST" and call[1].endswith("/comments")]
        self.assertEqual(len(comments), 1)
        self.assertIn("branch-protection-drift", comments[0][2]["body"])

    def test_timeout_opens_fresh_alarm_when_none_exists(self) -> None:
        api = FakeGitHub(issue_number=None)

        invoke(dict(FULL, RUN_CONCLUSION="timed_out"), api)

        creates = [
            call
            for call in api.calls
            if call[0] == "POST" and call[1] == f"/repos/{REPOSITORY}/issues"
        ]
        self.assertEqual(len(creates), 1)
        self.assertIn("timed_out", creates[0][2]["body"])
        self.assertIn(SHA[:8], creates[0][2]["body"])

    def test_success_without_open_alarm_does_not_query_checks(self) -> None:
        api = FakeGitHub(green_checks(), issue_number=None)

        invoke(FULL, api)

        self.assertEqual(len(api.calls), 1)
        self.assertIn("/search/issues?", api.calls[0][1])

    def test_green_superseded_sha_cannot_close_current_main_alarm(self) -> None:
        api = FakeGitHub(green_checks(), current_heads=[NEWER_SHA])

        invoke(FULL, api)

        self.assertEqual(api.branch_reads, 1)
        self.assertFalse(any(method == "PATCH" for method, _path, _body in api.calls))

    def test_missing_required_environment_is_refused(self) -> None:
        for missing in FULL:
            with self.subTest(missing=missing):
                api = FakeGitHub()
                with self.assertRaisesRegex(SystemExit, "missing required environment"):
                    invoke({key: value for key, value in FULL.items() if key != missing}, api)
                self.assertEqual(api.calls, [])

    def test_api_failure_is_loud(self) -> None:
        def unavailable(*_args: object, **_kwargs: object) -> object:
            raise SystemExit("GET /search/issues failed: 503 Service Unavailable")

        clean = {key: value for key, value in os.environ.items() if key not in ENV_KEYS}
        clean.update(dict(FULL, RUN_CONCLUSION="failure"))
        with patch.dict(os.environ, clean, clear=True), patch.object(reporter, "call", unavailable):
            with self.assertRaisesRegex(SystemExit, "503 Service Unavailable"):
                reporter.main()

    def test_marker_and_required_workflows_are_stable(self) -> None:
        source = (TOOLS / "report_main_health.py").read_text()
        manifest = json.loads((TOOLS.parent / ".github/required-checks.json").read_text())
        self.assertEqual(source.count('MARKER = "<!-- dulcet-main-health -->"'), 1)
        self.assertEqual(set(manifest["contexts"]), set(REQUIRED))
        self.assertIn("load_required_checks(MANIFEST)", source)

    def test_workflow_filters_main_and_allows_success_reconciliation(self) -> None:
        workflow = (TOOLS.parent / ".github/workflows/main-health.yml").read_text()
        self.assertIn("branches: [main]", workflow)
        self.assertIn("workflow_run.conclusion != 'cancelled'", workflow)
        self.assertIn("branch-protection-drift", workflow)
        self.assertIn("workflow_run.conclusion == 'success'", workflow)
        self.assertIn("checks: read", workflow)
        self.assertIn("statuses: read", workflow)


if __name__ == "__main__":
    unittest.main(verbosity=2)
