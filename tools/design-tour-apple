#!/usr/bin/env bash
# design-tour-apple -- photograph the real Apple app's key screens for design review.
#
# USAGE
#   tools/design-tour-apple <out-dir> [--device iphone|ipad|mac|tvos|all] [--keep-server] [--keep-simulator]
#
#   Starts (or reuses) a local disposable Navidrome seeded with the conformance corpus
#   (tools/design-tour-server), builds the app and its tour once (incrementally after the first
#   run), then runs one tour per device and writes compressed JPEGs, about 1000 px on the long
#   edge, to:
#       <out-dir>/<device>-<nn>-<screen>.jpg
#   where <device> is iphone-light, iphone-dark, ipad, mac or tvos. A screen the tour could not reach is
#   still written, as <nn>-<screen>-UNREACHED.jpg, and the command exits 1 naming it.
#   <out-dir>/tour-summary.txt lists every shot and the result of each device's run.
#
# SCREENS
#   iPhone and iPad (apple/DulcetiOSUITests/DulcetDesignTourUITests.swift): Library root, the
#   Albums section beside the sidebar (iPad only), an album, an artist, Now Playing while playing,
#   the lyrics panel, Up Next, Playlists, a playlist, Search with results.
#   Mac (apple/DulcetMacTests/DulcetMacDesignTourTest.swift): the same places in the production
#   root view in a 1280x800 window of the hosted app, captured with screencapture (the terminal
#   running this tool needs the Screen Recording permission; without it the shot falls back to
#   the view hierarchy drawn into an image, which leaves translucent materials out).
#   Apple TV (apple/DulcetTVUITests/DulcetTVDesignTourUITests.swift), by the remote alone: Library
#   root with its launch focus, an album, Now Playing while playing with focus on Play/Pause, the
#   same with focus on the third star and then on the heart (focused, never pressed), the lyrics
#   panel while playing, Search with results, and Settings with focus on streaming quality.
#
# RUNTIME (measured on an Apple Silicon laptop)
#   cold: first build ~80 s (iOS) + ~40 s (Mac), plus the first boot of a newly created simulator,
#   which took ~10 min once. warm (simulators reused, nothing changed): ~2 min per iOS tour,
#   ~2.5 min for iPad, ~25 s for Mac, ~7 min for all four. An edit rebuilds incrementally (~10 s).
#   tvOS: first build ~130 s and a first tour ~3 min on a newly created simulator; warm, ~70 s.
#
# ENVIRONMENT (all optional)
#   DULCET_DESIGN_TOUR_WORK          server root, result bundles and logs
#                                    (default ~/Library/Caches/dulcet-design-tour)
#   DULCET_DESIGN_TOUR_DERIVED_DATA  build products; keep it on the internal disk, because an
#                                    xcodebuild test run from an external volume can execute
#                                    zero tests (default $WORK/DerivedData)
#   DULCET_DESIGN_TOUR_IPHONE_UDID   use this booted-or-bootable iPhone simulator
#   DULCET_DESIGN_TOUR_IPAD_UDID     use this iPad simulator
#   DULCET_DESIGN_TOUR_TVOS_UDID     use this Apple TV simulator
#                                    Without them the tool creates, and afterwards reuses,
#                                    simulators named "Dulcet Design Tour iPhone"/"... iPad"/
#                                    "... Apple TV".
#   DULCET_DESIGN_TOUR_NAVIDROME     a Navidrome binary to use instead of fetching the pinned one
#   DULCET_DESIGN_TOUR_PORT          server port (default 4861)
#
# KNOWN LIMITS
#   - The corpus is synthetic: tones, placeholder artwork, fixture names. Layout, type, colour and
#     spacing are real; artwork-heavy screens look emptier than a real library.
#   - The server is reused only when this tool left it running (--keep-server); otherwise it is
#     stopped at the end. A simulator this tool booted is shut down at the end unless
#     --keep-simulator; for a quick edit-and-reshoot loop pass both flags, since a first boot of a
#     new simulator can take several minutes.
#   - The Mac window is the production root view hosted by the test in its own window. It is
#     never the key window, so it renders in the inactive style (grey selection and controls).
#   - Only the automated disposable server is ever used. Never point this at a personal server.
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[[ $# -ge 1 ]] || usage
OUT="$1"; shift
DEVICE=all
KEEP_SERVER=0
KEEP_SIMULATOR=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) DEVICE="${2:-}"; shift 2 ;;
    --keep-server) KEEP_SERVER=1; shift ;;
    --keep-simulator) KEEP_SIMULATOR=1; shift ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done
case "$DEVICE" in iphone|ipad|mac|tvos|all) ;; *) echo "--device must be iphone, ipad, mac, tvos or all" >&2; exit 2 ;; esac

REPO="$(cd "$(dirname "$0")/.." && pwd)"
WORK="${DULCET_DESIGN_TOUR_WORK:-$HOME/Library/Caches/dulcet-design-tour}"
DD="${DULCET_DESIGN_TOUR_DERIVED_DATA:-$WORK/DerivedData}"
PORT="${DULCET_DESIGN_TOUR_PORT:-4861}"
LOGS="$WORK/logs"; RESULTS="$WORK/results"
mkdir -p "$OUT" "$LOGS" "$RESULTS"
OUT="$(cd "$OUT" && pwd)"
SUMMARY="$OUT/tour-summary.txt"
: > "$SUMMARY"
START=$(date +%s)
note() { echo "design-tour: $*"; echo "$*" >> "$SUMMARY"; }

# ---- server ---------------------------------------------------------------------------------
SERVER_ARGS=(up --root "$WORK/server" --port "$PORT")
[[ -n "${DULCET_DESIGN_TOUR_NAVIDROME:-}" ]] && SERVER_ARGS+=(--navidrome "$DULCET_DESIGN_TOUR_NAVIDROME")
SERVER_LINE=$("$REPO/tools/design-tour-server" "${SERVER_ARGS[@]}" | tail -1)
SERVER_URL=$(sed -n 's/.*url=\([^ ]*\).*/\1/p' <<<"$SERVER_LINE")
[[ -n "$SERVER_URL" ]] || { echo "server did not start: $SERVER_LINE" >&2; exit 1; }
BOOTED_BY_US=()
XCB_PID=
cleanup() {
  [[ -n "$XCB_PID" ]] && kill "$XCB_PID" 2>/dev/null || true
  [[ $KEEP_SIMULATOR -eq 1 ]] || for udid in "${BOOTED_BY_US[@]:-}"; do
    [[ -n "$udid" ]] && xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
  done
  if [[ $KEEP_SERVER -eq 0 ]]; then "$REPO/tools/design-tour-server" down --root "$WORK/server" >/dev/null || true; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
note "server $SERVER_URL ($SERVER_LINE)"

# The published fixture account of the disposable server; never a real credential.
export TEST_RUNNER_DULCET_DESIGN_TOUR=1
export TEST_RUNNER_DULCET_UI_TEST_SERVER_URL="$SERVER_URL"
export TEST_RUNNER_DULCET_UI_TEST_USERNAME=dulcet-admin
export TEST_RUNNER_DULCET_UI_TEST_PASSWORD=dulcet-ci-canary-password

# ---- build ------------------------------------------------------------------------------------
# The simulator app keeps Xcode's default local signing: unsigned, it cannot save the account to
# the Keychain and the tour never leaves Connection. The Mac host is signed ad hoc without its
# sandbox entitlements, as apple-ci builds it for the hosted tests.
build() { # scheme destination [settings...]
  local scheme="$1" destination="$2" log="$LOGS/build-$1.log" t0; t0=$(date +%s); shift 2
  if ! (cd "$REPO/apple" && xcodebuild -project Dulcet.xcodeproj -scheme "$scheme" -destination "$destination" \
        -derivedDataPath "$DD" "$@" build-for-testing) > "$log" 2>&1; then
    tail -30 "$log" >&2; echo "build of $scheme failed; full log: $log" >&2; exit 1
  fi
  note "built $scheme in $(( $(date +%s) - t0 ))s"
}
want() { [[ "$DEVICE" == all || "$DEVICE" == "$1" ]]; }
if want iphone || want ipad; then build DulcetiOS "generic/platform=iOS Simulator"; fi
if want tvos; then build DulcetTV "generic/platform=tvOS Simulator"; fi
if want mac; then
  build DulcetMac "platform=macOS" CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- CODE_SIGN_ENTITLEMENTS= \
    DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER=
fi

# ---- run --------------------------------------------------------------------------------------
FAILED=0

# A copy of the built .xctestrun that keeps only the tour's own screenshots: no automatic screen
# recording or system screenshots, which otherwise leave xcodebuild finalizing its result bundle
# for minutes after the test has finished.
tour_xctestrun() { # pattern label
  local built copy="$WORK/$2.xctestrun"
  built=$(ls "$DD"/Build/Products/$1 2>/dev/null | head -1)
  [[ -n "$built" ]] || { echo "no built .xctestrun matching $1 in $DD" >&2; exit 1; }
  python3 - "$built" "$copy" <<'PY'
import plistlib, sys
plan = plistlib.load(open(sys.argv[1], "rb"))
for configuration in plan.get("TestConfigurations", []):
    for target in configuration.get("TestTargets", []):
        target["PreferredScreenCaptureFormat"] = "screenshots"
        target["SystemAttachmentLifetime"] = "keepNever"
plistlib.dump(plan, open(sys.argv[2], "wb"))
PY
  # xcodebuild resolves the products relative to the .xctestrun's own directory.
  sed -i '' "s|__TESTROOT__|$DD/Build/Products|g" "$copy"
  echo "$copy"
}

# The Mac tour asks for each shot by writing <name>.request holding its window number; the window
# is captured here, from this process, because the hosted test cannot capture the screen itself.
serve_capture_requests() { # shots-dir
  local request name
  for request in "$1"/*.request; do
    [[ -e "$request" ]] || continue
    name="${request%.request}"
    screencapture -x -o -l"$(cat "$request")" "$name.tmp.png" 2>/dev/null && mv "$name.tmp.png" "$name.png"
    rm -f "$request"
  done
}

# Runs one tour. The test writes each shot as a PNG into a directory of its own as it goes, so
# nothing waits on the result bundle; once the suite has reported, xcodebuild gets a minute to
# finish and is then stopped (it is this tool's own process). The result bundle may then be
# incomplete; the shots and the transcript are not.
run_tour() { # label xctestrun only-testing destination...
  local label="$1" xctestrun="$2" only="$3" shots="$WORK/shots/$1" log="$LOGS/$1.log" pid waited=0 t0
  shift 3; t0=$(date +%s)
  rm -rf "$shots" "$RESULTS/$label.xcresult"; mkdir -p "$shots"
  TEST_RUNNER_DULCET_DESIGN_TOUR_OUT="$shots" DULCET_DESIGN_TOUR_OUT="$shots" \
  DULCET_DESIGN_TOUR=1 DULCET_UI_TEST_SERVER_URL="$SERVER_URL" DULCET_UI_TEST_USERNAME=dulcet-admin \
  DULCET_UI_TEST_PASSWORD=dulcet-ci-canary-password \
    xcodebuild test-without-building -xctestrun "$xctestrun" "$@" -resultBundlePath "$RESULTS/$label.xcresult" \
      -parallel-testing-enabled NO "-only-testing:$only" > "$log" 2>&1 &
  pid=$!; XCB_PID=$pid
  while kill -0 "$pid" 2>/dev/null; do
    serve_capture_requests "$shots"
    if grep -qa "^Test Suite 'Selected tests' \(passed\|failed\)" "$log"; then
      waited=$((waited + 1)); [[ $waited -gt 60 ]] && { kill "$pid" 2>/dev/null || true; break; }
    fi
    sleep 0.3
  done
  wait "$pid" 2>/dev/null || true
  XCB_PID=
  local verdict
  verdict=$(grep -a "Executed 1 test" "$log" | tail -1 | sed 's/^[[:space:]]*//')
  note "$label: ${verdict:-no test executed; see $log}"
  [[ "$verdict" == "Executed 1 test, with 0 failures"* ]] || FAILED=1
  rm -f "$OUT/$label"-*.jpg
  local png count=0
  for png in "$shots"/*.png; do
    [[ -e "$png" ]] || continue
    sips -s format jpeg -s formatOptions 72 -Z 1000 "$png" --out "$OUT/$label-$(basename "$png" .png).jpg" >/dev/null
    echo "  $label-$(basename "$png" .png).jpg" >> "$SUMMARY"; count=$((count + 1))
  done
  note "$label: $count shots, $(ls "$shots" | grep -c UNREACHED || true) unreached, in $(( $(date +%s) - t0 ))s"
  [[ $count -gt 0 ]] || FAILED=1
}

# ---- iOS --------------------------------------------------------------------------------------
simulator() { # env-udid device-name device-type [runtime-platform]
  if [[ -n "$1" ]]; then echo "$1"; return; fi
  local udid platform="${4:-iOS}" runtime=
  udid=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
name, platform = sys.argv[1], sys.argv[2]
for runtime, devices in json.load(sys.stdin)["devices"].items():
    for d in devices:
        if d["name"] == name and "." + platform + "-" in runtime:
            print(d["udid"]); sys.exit()' "$2" "$platform")
  if [[ -z "$udid" && "$platform" != iOS ]]; then
    # simctl create picks the newest runtime of the device type's own platform only when told
    # which; without one it may choose an iOS runtime and refuse the device type.
    runtime=$(xcrun simctl list runtimes available -j | python3 -c '
import json, sys
found = [r["identifier"] for r in json.load(sys.stdin)["runtimes"] if r.get("platform") == sys.argv[1]]
print(found[-1] if found else "")' "$platform")
  fi
  [[ -n "$udid" ]] || udid=$(xcrun simctl create "$2" "$3" ${runtime:+"$runtime"})
  echo "$udid"
}

simulator_state() { # udid
  xcrun simctl list devices -j | python3 -c '
import json, sys
for ds in json.load(sys.stdin)["devices"].values():
    for d in ds:
        if d["udid"] == sys.argv[1]: print(d["state"])' "$1"
}

prepare_simulator() { # udid appearance
  local state tries=0
  state=$(simulator_state "$1")
  # A simulator another run is shutting down cannot be booted until it has stopped.
  while [[ "$state" == "Shutting Down" || "$state" == Creating ]] && [[ $tries -lt 120 ]]; do
    sleep 1; tries=$((tries + 1)); state=$(simulator_state "$1")
  done
  if [[ "$state" != Booted ]]; then
    xcrun simctl boot "$1"; BOOTED_BY_US+=("$1")
  fi
  xcrun simctl bootstatus "$1" -b >/dev/null
  # tvOS keeps its own appearance setting, which simctl cannot set; the tour shoots its default.
  [[ -z "$2" ]] || xcrun simctl ui "$1" appearance "$2"
  xcrun simctl status_bar "$1" override --time 9:41 --batteryState charged --batteryLevel 100 \
    --cellularBars 4 --wifiBars 3 --dataNetwork wifi >/dev/null 2>&1 || true
}

IOS_ONLY=DulcetiOSUITests/DulcetDesignTourUITests/testDesignTour
if want iphone; then
  IPHONE=$(simulator "${DULCET_DESIGN_TOUR_IPHONE_UDID:-}" "Dulcet Design Tour iPhone" "iPhone 17 Pro")
  RUN=$(tour_xctestrun 'DulcetiOS_iphonesimulator*.xctestrun' ios)
  for appearance in light dark; do
    prepare_simulator "$IPHONE" "$appearance"
    run_tour "iphone-$appearance" "$RUN" "$IOS_ONLY" -destination "id=$IPHONE"
  done
  xcrun simctl ui "$IPHONE" appearance light
fi
if want ipad; then
  IPAD=$(simulator "${DULCET_DESIGN_TOUR_IPAD_UDID:-}" "Dulcet Design Tour iPad" "iPad Pro 13-inch (M5)")
  RUN=$(tour_xctestrun 'DulcetiOS_iphonesimulator*.xctestrun' ios)
  prepare_simulator "$IPAD" light
  run_tour ipad "$RUN" "$IOS_ONLY" -destination "id=$IPAD"
fi

# ---- tvOS -------------------------------------------------------------------------------------
if want tvos; then
  TV=$(simulator "${DULCET_DESIGN_TOUR_TVOS_UDID:-}" "Dulcet Design Tour Apple TV" "Apple TV 4K (3rd generation)" tvOS)
  RUN=$(tour_xctestrun 'DulcetTV_appletvsimulator*.xctestrun' tvos)
  prepare_simulator "$TV" ""
  run_tour tvos "$RUN" DulcetTVUITests/DulcetTVDesignTourUITests/testDesignTour -destination "id=$TV"
fi

# ---- macOS ------------------------------------------------------------------------------------
if want mac; then
  RUN=$(tour_xctestrun 'DulcetMac_macosx*.xctestrun' mac)
  run_tour mac "$RUN" DulcetMacTests/DulcetMacDesignTourTest/testDesignTour -destination platform=macOS
fi

grep -q UNREACHED "$SUMMARY" && FAILED=1
note "total $(( $(date +%s) - START ))s; shots in $OUT"
exit $FAILED
