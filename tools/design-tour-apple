#!/usr/bin/env bash
# design-tour-apple -- photograph the real Apple app's key screens for design review.
#
# USAGE
#   tools/design-tour-apple <out-dir> [--device iphone|ipad|mac|tvos|all] [--keep-server] [--keep-simulator]
#
#   Starts (or reuses) a local disposable Navidrome seeded with the conformance corpus
#   (tools/design-tour-server), builds the app and its tour once (incrementally after the first
#   run), then runs one tour per device and writes compressed JPEGs, about 1000 px on the long
#   edge, to:
#       <out-dir>/<device>-<nn>-<screen>.jpg
#   where <device> includes appearance, text size (iPhone) and orientation (iPad). A screen the tour could not reach is
#   still written, as <nn>-<screen>-UNREACHED.jpg, and the command exits 1 naming it.
#   <out-dir>/tour-summary.txt lists every shot and the result of each device's run.
#   Labeled 1600px-wide JPEG contact sheets are grouped per screen in contact-sheets/ (Pillow).
#
# SCREENS
#   iPhone and iPad (apple/DulcetiOSUITests/DulcetDesignTourUITests.swift): Library root, the
#   Albums section beside the sidebar (iPad only), an album, an artist, Now Playing while playing,
#   the lyrics panel, Up Next, Playlists, a playlist, Search with results.
#   The opt-in account-state tour also photographs first run, filled Connection and each real
#   error family using loopback fixtures. Connected tours include all Library sections, playlist
#   prompts and streaming-quality settings. iPhone: light/dark at default, XXL and Accessibility L;
#   iPad: light/dark in portrait/landscape; Mac: light/dark. No standalone Songs or Downloads
#   destination exists in the current Apple shell; downloaded rows/device data are photographed.
#   Mac (apple/DulcetMacTests/DulcetMacDesignTourTest.swift): the same places in the production
#   root view in a 1280x800 window of the hosted app, captured with screencapture (the terminal
#   running this tool needs the Screen Recording permission; without it the shot falls back to
#   the view hierarchy drawn into an image, which leaves translucent materials out).
#   Apple TV (apple/DulcetTVUITests/DulcetTVDesignTourUITests.swift), by the remote alone: first
#   run and Connection/error states, Library and its full lists/sections, details and context
#   menus, playlist creation/deletion prompts, Now Playing with Play/Pause, star and heart focus,
#   lyrics, Search results, and inline streaming-quality choices.
#
# RUNTIME
#   Allow over an hour for the full appearance/text/orientation matrix. Each variant exercises
#   real account errors and connected navigation; products are built once per platform and reused
#   between variants. An optional DULCET_DESIGN_TOUR_VARIANT scopes an iOS edit-and-reshoot loop.
#
# ENVIRONMENT (all optional)
#   DULCET_DESIGN_TOUR_WORK          server root, result bundles and logs
#                                    (default ~/Library/Caches/dulcet-design-tour)
#   DULCET_DESIGN_TOUR_DERIVED_DATA  build products; keep it on the internal disk, because an
#                                    xcodebuild test run from an external volume can execute
#                                    zero tests (default $WORK/DerivedData)
#   DULCET_DESIGN_TOUR_IPHONE_UDID   use this booted-or-bootable iPhone simulator
#   DULCET_DESIGN_TOUR_IPAD_UDID     use this iPad simulator
#   DULCET_DESIGN_TOUR_TVOS_UDID     use this Apple TV simulator
#                                    Without them the tool creates, and afterwards reuses,
#                                    simulators named "Dulcet Design Tour iPhone"/"... iPad"/
#                                    "... Apple TV".
#   DULCET_DESIGN_TOUR_NAVIDROME     a Navidrome binary to use instead of fetching the pinned one
#   DULCET_DESIGN_TOUR_VARIANT       optional exact iOS variant label for an edit-and-reshoot loop
#   DULCET_DESIGN_TOUR_SKIP_VARIANTS space-separated iOS labels whose verified shots are preserved
#   DULCET_DESIGN_TOUR_PHASE         all (default), account or connected; account scopes all platforms
#   DULCET_DESIGN_TOUR_SCREENS       optional space-separated capture names; all state proofs still run
#                                    tv-reader-proof instead runs the two existing TV remote reader
#                                    proofs, capturing only after each successful endpoint.
#   DULCET_DESIGN_TOUR_PORT          server port (default 4861)
#
# KNOWN LIMITS
#   - The corpus is synthetic: tones, placeholder artwork, fixture names. Layout, type, colour and
#     spacing are real; artwork-heavy screens look emptier than a real library.
#   - The server is reused only when this tool left it running (--keep-server); otherwise it is
#     stopped at the end. A simulator this tool booted is shut down at the end unless
#     --keep-simulator; for a quick edit-and-reshoot loop pass both flags, since a first boot of a
#     new simulator can take several minutes.
#   - The Mac production root view is hosted in a test window that follows the requested
#     appearance and bridges its production toolbar.
#   - Only the automated disposable server is ever used. Never point this at a personal server.
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[[ $# -ge 1 ]] || usage
OUT="$1"; shift
DEVICE=all
VARIANT="${DULCET_DESIGN_TOUR_VARIANT:-}"
SKIP_VARIANTS="${DULCET_DESIGN_TOUR_SKIP_VARIANTS:-}"
PHASE="${DULCET_DESIGN_TOUR_PHASE:-all}"
case "$PHASE" in all|account|connected|foundation|settings-scene) ;; *) echo "DULCET_DESIGN_TOUR_PHASE must be all, account, connected, foundation or settings-scene" >&2; exit 2 ;; esac
KEEP_SERVER=0
KEEP_SIMULATOR=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) DEVICE="${2:-}"; shift 2 ;;
    --keep-server) KEEP_SERVER=1; shift ;;
    --keep-simulator) KEEP_SIMULATOR=1; shift ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done
case "$DEVICE" in iphone|ipad|mac|tvos|all) ;; *) echo "--device must be iphone, ipad, mac, tvos or all" >&2; exit 2 ;; esac

REPO="$(cd "$(dirname "$0")/.." && pwd)"
WORK="${DULCET_DESIGN_TOUR_WORK:-$HOME/Library/Caches/dulcet-design-tour}"
DD="${DULCET_DESIGN_TOUR_DERIVED_DATA:-$WORK/DerivedData}"
PORT="${DULCET_DESIGN_TOUR_PORT:-4861}"
LOGS="$WORK/logs"; RESULTS="$WORK/results"
mkdir -p "$OUT" "$LOGS" "$RESULTS"
OUT="$(cd "$OUT" && pwd)"
SUMMARY="$OUT/tour-summary.txt"
: > "$SUMMARY"
START=$(date +%s)
note() { echo "design-tour: $*"; echo "$*" >> "$SUMMARY"; }

# ---- server ---------------------------------------------------------------------------------
SERVER_ARGS=(up --root "$WORK/server" --port "$PORT")
[[ -n "${DULCET_DESIGN_TOUR_NAVIDROME:-}" ]] && SERVER_ARGS+=(--navidrome "$DULCET_DESIGN_TOUR_NAVIDROME")
if [[ "${DULCET_DESIGN_TOUR_SCREENS:-}" == tv-reader-proof ]]; then
  # These existing remote proofs require the conformance corpus's tied release years.
  # The ordinary screenshot tour adds a genre album without a year; use the unextended
  # corpus here so the proof's positive fixture assertions remain unchanged.
  "$REPO/tools/seed-corpus" --output "$WORK/tv-reader-corpus" --runtime native \
    --ffmpeg "${DULCET_FFMPEG:-/opt/homebrew/bin/ffmpeg}"
  SERVER_ARGS+=(--corpus "$WORK/tv-reader-corpus")
fi
SERVER_LINE=$("$REPO/tools/design-tour-server" "${SERVER_ARGS[@]}" | tail -1)
SERVER_URL=$(sed -n 's/.*url=\([^ ]*\).*/\1/p' <<<"$SERVER_LINE")
[[ -n "$SERVER_URL" ]] || { echo "server did not start: $SERVER_LINE" >&2; exit 1; }
BOOTED_BY_US=()
FAULT_PID=
XCB_PID=
cleanup() {
  [[ -z "$FAULT_PID" ]] || kill "$FAULT_PID" 2>/dev/null || true
  [[ -n "$XCB_PID" ]] && kill "$XCB_PID" 2>/dev/null || true
  [[ $KEEP_SIMULATOR -eq 1 ]] || for udid in "${BOOTED_BY_US[@]:-}"; do
    [[ -n "$udid" ]] && xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
  done
  if [[ $KEEP_SERVER -eq 0 ]]; then "$REPO/tools/design-tour-server" down --root "$WORK/server" >/dev/null || true; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
note "server $SERVER_URL ($SERVER_LINE)"

# Error fixtures use ephemeral loopback ports and an untrusted one-day local certificate.
rm -f "$WORK/faults/endpoints.json"
"$REPO/tools/design-tour-faults" --upstream "$SERVER_URL" --work "$WORK/faults" > "$LOGS/faults.log" 2>&1 &
FAULT_PID=$!
for _ in {1..600}; do
  [[ ! -f "$WORK/faults/endpoints.json" ]] || break
  kill -0 "$FAULT_PID" 2>/dev/null || { cat "$LOGS/faults.log" >&2; exit 1; }
  sleep 0.1
done
[[ -f "$WORK/faults/endpoints.json" ]] || {
  echo "fault fixture did not become ready within 60 seconds" >&2
  cat "$LOGS/faults.log" >&2
  exit 1
}
PROXY_URL=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["proxy"])' "$WORK/faults/endpoints.json")
TLS_URL=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["bad_tls"])' "$WORK/faults/endpoints.json")
export TEST_RUNNER_DULCET_UI_TEST_LYRICS_FAULT_PROXY_URL="$PROXY_URL" DULCET_UI_TEST_LYRICS_FAULT_PROXY_URL="$PROXY_URL"
export TEST_RUNNER_DULCET_DESIGN_TOUR_BAD_TLS_URL="$TLS_URL" DULCET_DESIGN_TOUR_BAD_TLS_URL="$TLS_URL"

# The published fixture account of the disposable server; never a real credential.
export TEST_RUNNER_DULCET_DESIGN_TOUR_PHASE="$PHASE" DULCET_DESIGN_TOUR_PHASE="$PHASE"
export TEST_RUNNER_DULCET_DESIGN_TOUR_SCREENS="${DULCET_DESIGN_TOUR_SCREENS:-}"
export TEST_RUNNER_DULCET_DESIGN_TOUR=1
export TEST_RUNNER_DULCET_UI_TEST_SERVER_URL="$SERVER_URL"
export TEST_RUNNER_DULCET_UI_TEST_USERNAME=dulcet-admin
export TEST_RUNNER_DULCET_UI_TEST_PASSWORD=dulcet-ci-canary-password

# ---- build ------------------------------------------------------------------------------------
# The simulator app keeps Xcode's default local signing: unsigned, it cannot save the account to
# the Keychain and the tour never leaves Connection. The Mac host is signed ad hoc without its
# sandbox entitlements, as apple-ci builds it for the hosted tests.
build() { # scheme destination [settings...]
  local scheme="$1" destination="$2" log="$LOGS/build-$1.log" t0; t0=$(date +%s); shift 2
  if ! (cd "$REPO/apple" && xcodebuild -project Dulcet.xcodeproj -scheme "$scheme" -destination "$destination" \
        -derivedDataPath "$DD" "$@" build-for-testing) > "$log" 2>&1; then
    tail -30 "$log" >&2; echo "build of $scheme failed; full log: $log" >&2; exit 1
  fi
  note "built $scheme in $(( $(date +%s) - t0 ))s"
}
want() { [[ "$DEVICE" == all || "$DEVICE" == "$1" ]]; }
if want iphone || want ipad; then build DulcetiOS "generic/platform=iOS Simulator"; fi
if want tvos; then build DulcetTV "generic/platform=tvOS Simulator"; fi
if want mac; then
  build DulcetMac "platform=macOS" CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- CODE_SIGN_ENTITLEMENTS= \
    DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER=
fi

# ---- run --------------------------------------------------------------------------------------
FAILED=0

# A copy of the built .xctestrun that keeps only the tour's own screenshots: no automatic screen
# recording or system screenshots, which otherwise leave xcodebuild finalizing its result bundle
# for minutes after the test has finished.
tour_xctestrun() { # pattern label
  local built copy="$WORK/$2.xctestrun"
  built=$(ls "$DD"/Build/Products/$1 2>/dev/null | head -1)
  [[ -n "$built" ]] || { echo "no built .xctestrun matching $1 in $DD" >&2; exit 1; }
  python3 - "$built" "$copy" "$2" <<'PY'
import plistlib, sys, uuid
plan = plistlib.load(open(sys.argv[1], "rb"))
targets = [value for key, value in plan.items()
           if key != "__xctestrun_metadata__" and isinstance(value, dict)]
for configuration in plan.get("TestConfigurations", []):
    targets.extend(configuration.get("TestTargets", []))
for target in targets:
    target["PreferredScreenCaptureFormat"] = "screenshots"
    target["SystemAttachmentLifetime"] = "keepNever"
    if sys.argv[3] == "mac":
        namespace = str(uuid.uuid4())
        target["CommandLineArguments"] = target.get("CommandLineArguments", []) + [
            "-dulcet-debug-account-fixture", namespace, "-dulcet-debug-download-handoff", namespace,
            "-dulcet-debug-capture-hide-diagnostics"]
plistlib.dump(plan, open(sys.argv[2], "wb"))
PY
  # xcodebuild resolves the products relative to the .xctestrun's own directory.
  sed -i '' "s|__TESTROOT__|$DD/Build/Products|g" "$copy"
  echo "$copy"
}

# The Mac tour writes <name>.request with a window number, or a numeric region for a native menu
# whose overlay is outside the window capture. Capture runs here because the hosted test cannot
# capture the screen itself. Region requests are bounded by the test's owned window/menu frames.
serve_capture_requests() { # shots-dir
  local request name target
  if [[ -f "$1/tour-host.activate" ]]; then
    python3 - "$1/tour-host.activate" "$DD" <<'PYTHON'
from pathlib import Path
import subprocess, sys
request = Path(sys.argv[1])
try:
    pid = int(request.read_text())
    command = subprocess.check_output(['ps', '-p', str(pid), '-o', 'comm='], text=True).strip()
    expected = str(Path(sys.argv[2]).resolve() / 'Build/Products/Debug/Dulcet DEV.app/Contents/MacOS/Dulcet DEV')
    if command == expected:
        script = f'tell application "System Events"\nset tourProcess to first process whose unix id is {pid}\nset frontmost of tourProcess to true\nend tell'
        subprocess.run(['osascript', '-e', script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
except (ValueError, FileNotFoundError, subprocess.CalledProcessError):
    pass
finally:
    request.unlink(missing_ok=True)
PYTHON
  fi
  for request in "$1"/*.request; do
    [[ -e "$request" ]] || continue
    name="${request%.request}"
    target=$(cat "$request")
    local capture_args=()
    if [[ "$target" =~ ^region=(-?[0-9]+,-?[0-9]+,[0-9]+,[0-9]+)$ ]]; then
      capture_args=(-R"${BASH_REMATCH[1]}")
    elif [[ "$target" =~ ^[0-9]+$ ]]; then
      capture_args=(-l"$target")
    else
      touch "$name.fallback"; rm -f "$request"; continue
    fi
    if screencapture -x -o "${capture_args[@]}" "$name.tmp.png" 2>/dev/null; then
      mv "$name.tmp.png" "$name.png"
    else
      rm -f "$name.tmp.png"
      touch "$name.fallback"
    fi
    rm -f "$request"
  done
}

# Xcode may orphan a ten-minute simulator diagnostic after a failed UI capture. Its output path
# ties it to this run; do not terminate diagnostics belonging to another test or session.
stop_owned_diagnostics() { # result-bundle
  python3 - "$1" <<'PY'
import os, signal, subprocess, sys
prefix = "--output=" + os.path.realpath(sys.argv[1]) + "/"
for line in subprocess.check_output(["ps", "-axo", "pid=,command="], text=True).splitlines():
    parts = line.strip().split(None, 1)
    command = parts[1].replace("--output=/tmp/", "--output=/private/tmp/") if len(parts) == 2 else ""
    if "/simctl diagnose " in command and prefix in command:
        try:
            os.kill(int(parts[0]), signal.SIGTERM)
            print("design-tour: stopped this run's simctl diagnose pid=" + parts[0])
        except ProcessLookupError:
            pass
PY
}

# Runs one tour. The test writes each shot as a PNG into a directory of its own as it goes, so
# nothing waits on the result bundle; once the suite has reported, xcodebuild gets a minute to
# finish and is then stopped (it is this tool's own process). The result bundle may then be
# incomplete; the shots and the transcript are not.
run_tour() { # label xctestrun only-testing destination...
  local label="$1" xctestrun="$2" only="$3" shots="$WORK/shots/$1" log="$LOGS/$1.log" pid waited=0 t0
  shift 3; t0=$(date +%s)
  rm -rf "$shots" "$RESULTS/$label.xcresult"; mkdir -p "$shots"
  TEST_RUNNER_DULCET_DESIGN_TOUR_OUT="$shots" DULCET_DESIGN_TOUR_OUT="$shots" \
  DULCET_DESIGN_TOUR=1 DULCET_UI_TEST_SERVER_URL="$SERVER_URL" DULCET_UI_TEST_USERNAME=dulcet-admin \
  DULCET_UI_TEST_PASSWORD=dulcet-ci-canary-password \
    xcodebuild test-without-building -xctestrun "$xctestrun" "$@" -resultBundlePath "$RESULTS/$label.xcresult" \
      -parallel-testing-enabled NO "-only-testing:$only" > "$log" 2>&1 &
  pid=$!; XCB_PID=$pid
  while kill -0 "$pid" 2>/dev/null; do
    serve_capture_requests "$shots"
    if grep -qa "^Test Suite 'Selected tests' \(passed\|failed\)" "$log"; then
      waited=$((waited + 1)); [[ $waited -gt 60 ]] && { kill "$pid" 2>/dev/null || true; break; }
    fi
    sleep 0.3
  done
  wait "$pid" 2>/dev/null || true
  XCB_PID=
  stop_owned_diagnostics "$RESULTS/$label.xcresult"
  local verdict
  verdict=$(grep -a "Executed 1 test" "$log" | tail -1 | sed 's/^[[:space:]]*//')
  note "$label: ${verdict:-no test executed; see $log}"
  [[ "$verdict" == "Executed 1 test, with 0 failures"* ]] || FAILED=1
  rm -f "$OUT/$label"-[0-9][0-9]-*.jpg
  local png count=0
  for png in "$shots"/*.png; do
    [[ -e "$png" ]] || continue
    sips -s format jpeg -s formatOptions 55 -Z 1000 "$png" --out "$OUT/$label-$(basename "$png" .png).jpg" >/dev/null
    echo "  $label-$(basename "$png" .png).jpg" >> "$SUMMARY"; count=$((count + 1))
  done
  note "$label: $count shots, $(ls "$shots" | grep -c UNREACHED || true) unreached, in $(( $(date +%s) - t0 ))s"
  [[ $count -gt 0 ]] || FAILED=1
  if [[ -n "${DULCET_DESIGN_TOUR_SCREENS:-}" ]]; then
    local requested_screens
    read -r -a requested_screens <<< "$DULCET_DESIGN_TOUR_SCREENS"
    if [[ $count -ne ${#requested_screens[@]} ]]; then
      note "$label: expected ${#requested_screens[@]} selected captures, got $count"
      FAILED=1
    fi
  fi
  # A stopped diagnostic can still be finishing an owned copy into the bundle. Retry that
  # short cleanup race after exporting the JPEGs instead of aborting the remaining variants.
  for _ in {1..5}; do
    rm -rf "$RESULTS/$label.xcresult" "$shots" 2>/dev/null && break
    sleep 0.5
  done
  if [[ -e "$RESULTS/$label.xcresult" ]]; then
    note "$label: result cleanup incomplete ($RESULTS/$label.xcresult)"
    FAILED=1
  fi

}

# ---- iOS --------------------------------------------------------------------------------------
simulator() { # env-udid device-name device-type [runtime-platform]
  if [[ -n "$1" ]]; then echo "$1"; return; fi
  local udid platform="${4:-iOS}" runtime=
  udid=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
name, platform = sys.argv[1], sys.argv[2]
for runtime, devices in json.load(sys.stdin)["devices"].items():
    for d in devices:
        if d["name"] == name and "." + platform + "-" in runtime:
            print(d["udid"]); sys.exit()' "$2" "$platform")
  if [[ -z "$udid" && "$platform" != iOS ]]; then
    # simctl create picks the newest runtime of the device type's own platform only when told
    # which; without one it may choose an iOS runtime and refuse the device type.
    runtime=$(xcrun simctl list runtimes available -j | python3 -c '
import json, sys
found = [r["identifier"] for r in json.load(sys.stdin)["runtimes"] if r.get("platform") == sys.argv[1]]
print(found[-1] if found else "")' "$platform")
  fi
  [[ -n "$udid" ]] || udid=$(xcrun simctl create "$2" "$3" ${runtime:+"$runtime"})
  echo "$udid"
}

simulator_state() { # udid
  xcrun simctl list devices -j | python3 -c '
import json, sys
for ds in json.load(sys.stdin)["devices"].values():
    for d in ds:
        if d["udid"] == sys.argv[1]: print(d["state"])' "$1"
}

prepare_simulator() { # udid appearance
  local state tries=0
  state=$(simulator_state "$1")
  # A simulator another run is shutting down cannot be booted until it has stopped.
  while [[ "$state" == "Shutting Down" || "$state" == Creating ]] && [[ $tries -lt 120 ]]; do
    sleep 1; tries=$((tries + 1)); state=$(simulator_state "$1")
  done
  if [[ "$state" != Booted ]]; then
    xcrun simctl boot "$1"; BOOTED_BY_US+=("$1")
  fi
  xcrun simctl bootstatus "$1" -b >/dev/null
  # tvOS keeps its own appearance setting, which simctl cannot set; the tour shoots its default.
  [[ -z "$2" ]] || xcrun simctl ui "$1" appearance "$2"
  xcrun simctl status_bar "$1" override --time 9:41 --batteryState charged --batteryLevel 100 \
    --cellularBars 4 --wifiBars 3 --dataNetwork wifi >/dev/null 2>&1 || true
}

IOS_ONLY=DulcetiOSUITests/DulcetDesignTourUITests/testDesignTour
ACCOUNT_ONLY=DulcetiOSUITests/DulcetAccountConnectStatesUITests/testDesignTourAccountStates
run_ios_variant() { # label destination appearance text-size orientation
  local label="$1" udid="$2" appearance="$3" size="$4" orientation="$5"
  [[ -z "$VARIANT" || "$VARIANT" == "$label" ]] || return 0
  [[ " $SKIP_VARIANTS " != *" $label "* ]] || { note "$label: preserved (requested skip)"; return 0; }
  prepare_simulator "$udid" "$appearance"
  if [[ "$label" == *increase-contrast ]]; then
    xcrun simctl ui "$udid" increase_contrast enabled
    note "accessibility $label increase_contrast=$(xcrun simctl ui "$udid" increase_contrast)"
  else
    xcrun simctl ui "$udid" increase_contrast disabled
  fi
  local increased=0
  [[ "$label" != *increase-contrast ]] || increased=1
  export TEST_RUNNER_DULCET_DESIGN_TOUR_VARIANT="$label" DULCET_DESIGN_TOUR_VARIANT="$label"
  export TEST_RUNNER_DULCET_DESIGN_TOUR_INCREASE_CONTRAST="$increased" DULCET_DESIGN_TOUR_INCREASE_CONTRAST="$increased"
  local reduce=0
  [[ "$label" != *reduce-transparency ]] || reduce=1
  export TEST_RUNNER_DULCET_DESIGN_TOUR_REDUCE_TRANSPARENCY="$reduce" DULCET_DESIGN_TOUR_REDUCE_TRANSPARENCY="$reduce"
  export TEST_RUNNER_DULCET_DESIGN_TOUR_TEXT_SIZE="$size" DULCET_DESIGN_TOUR_TEXT_SIZE="$size"
  export TEST_RUNNER_DULCET_DESIGN_TOUR_ORIENTATION="$orientation" DULCET_DESIGN_TOUR_ORIENTATION="$orientation"
  if [[ "$PHASE" != connected && "$PHASE" != foundation ]]; then run_tour "$label-account" "$RUN" "$ACCOUNT_ONLY" -destination "id=$udid"; fi
  if [[ "$PHASE" != account ]]; then run_tour "$label" "$RUN" "$IOS_ONLY" -destination "id=$udid"; fi
}
if want iphone; then
  IPHONE=$(simulator "${DULCET_DESIGN_TOUR_IPHONE_UDID:-}" "Dulcet Design Tour iPhone" "iPhone 17 Pro")
  RUN=$(tour_xctestrun 'DulcetiOS_iphonesimulator*.xctestrun' ios)
  for appearance in light dark; do
    for size in default xxl accessibility-l accessibility-xxxl; do
      case "$size" in
        default) category=UICTContentSizeCategoryL ;;
        xxl) category=UICTContentSizeCategoryXXL ;;
        accessibility-l) category=UICTContentSizeCategoryAccessibilityL ;;
        accessibility-xxxl) category=UICTContentSizeCategoryAccessibilityXXXL ;;
      esac
      run_ios_variant "iphone-$appearance-$size" "$IPHONE" "$appearance" "$category" portrait
    done
  done
  # Reduce Transparency is enabled through Settings and persists on this shared device.
  # Photograph contrast on its own first; transparency is the final phone variant.
  run_ios_variant iphone-light-increase-contrast "$IPHONE" light UICTContentSizeCategoryL portrait
  run_ios_variant iphone-light-reduce-transparency "$IPHONE" light UICTContentSizeCategoryL portrait
  [[ $KEEP_SIMULATOR -eq 1 ]] || xcrun simctl shutdown "$IPHONE"
fi
if want ipad; then
  IPAD=$(simulator "${DULCET_DESIGN_TOUR_IPAD_UDID:-}" "Dulcet Design Tour iPad" "iPad Pro 13-inch (M5)")
  RUN=$(tour_xctestrun 'DulcetiOS_iphonesimulator*.xctestrun' ios)
  for appearance in light dark; do
    for orientation in portrait landscape; do
      run_ios_variant "ipad-$appearance-$orientation" "$IPAD" "$appearance" UICTContentSizeCategoryL "$orientation"
    done
  done
  [[ $KEEP_SIMULATOR -eq 1 ]] || xcrun simctl shutdown "$IPAD"
fi
unset TEST_RUNNER_DULCET_DESIGN_TOUR_TEXT_SIZE DULCET_DESIGN_TOUR_TEXT_SIZE
unset TEST_RUNNER_DULCET_DESIGN_TOUR_ORIENTATION DULCET_DESIGN_TOUR_ORIENTATION

# ---- tvOS -------------------------------------------------------------------------------------
if want tvos; then
  TV=$(simulator "${DULCET_DESIGN_TOUR_TVOS_UDID:-}" "Dulcet Design Tour Apple TV" "Apple TV 4K (3rd generation)" tvOS)
  RUN=$(tour_xctestrun 'DulcetTV_appletvsimulator*.xctestrun' tvos)
  prepare_simulator "$TV" ""
  if [[ "${DULCET_DESIGN_TOUR_SCREENS:-}" == tv-reader-proof ]]; then
    run_tour tvos-reader-favorites "$RUN" DulcetTVUITests/DulcetTVUITests/testAlbumTrackRowAndArtistHeartsAreReachedAndPressedByRemote -destination "id=$TV"
    run_tour tvos-reader-back "$RUN" DulcetTVUITests/DulcetTVUITests/testTheLibraryIsBrowsedByRemoteAndBackReturnsToWhatOpenedIt -destination "id=$TV"
  else
  run_tour tvos "$RUN" DulcetTVUITests/DulcetTVDesignTourUITests/testDesignTour -destination "id=$TV"
  fi
fi

# ---- macOS ------------------------------------------------------------------------------------
if want mac; then
  RUN=$(tour_xctestrun 'DulcetMac_macosx*.xctestrun' mac)
  for appearance in light dark; do
    [[ -z "$VARIANT" || "$VARIANT" == "mac-$appearance" ]] || continue
    export DULCET_DESIGN_TOUR_APPEARANCE="$appearance" TEST_RUNNER_DULCET_DESIGN_TOUR_APPEARANCE="$appearance"
    run_tour "mac-$appearance" "$RUN" DulcetMacTests/DulcetMacDesignTourTest/testDesignTour -destination platform=macOS
  done
fi

grep -q UNREACHED "$SUMMARY" && FAILED=1
if command -v python3 >/dev/null && python3 -c 'import PIL' >/dev/null 2>&1; then
  "$REPO/tools/design-tour-contact-sheets" "$OUT" | tee -a "$SUMMARY"
else
  note "contact sheets need Pillow: install it, then run tools/design-tour-contact-sheets $OUT"
  FAILED=1
fi
note "total $(( $(date +%s) - START ))s; shots in $OUT"
exit $FAILED
