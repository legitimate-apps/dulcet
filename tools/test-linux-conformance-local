#!/usr/bin/env python3
"""Static and mutation controls for the shared Linux conformance lifecycle."""

from importlib.machinery import SourceFileLoader
from pathlib import Path
import json
import re
import shlex
import subprocess
import sys
import tempfile
from types import SimpleNamespace


ROOT = Path(__file__).resolve().parent.parent
TOOL = ROOT / "tools/conformance-env/linux-local"
RESET_TOOL = ROOT / "tools/conformance-env/reset-transcode-cache"
OBSERVE_TOOL = ROOT / "tools/conformance-env/observe-transcode-cache"
WORKFLOW = ROOT / ".github/workflows/core-ci.yml"
APPLE_WORKFLOW = ROOT / ".github/workflows/apple-ci.yml"
linux_local = SourceFileLoader("linux_conformance_local", str(TOOL)).load_module()


def declared_environment(root: Path) -> set[str]:
    result = subprocess.run(
        [sys.executable, str(TOOL), "--root", str(root), "env"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.returncode != 0:
        raise AssertionError(f"environment declaration failed: {result.stdout}")
    return set(result.stdout.splitlines())


with tempfile.TemporaryDirectory(prefix="dulcet-env-control-") as directory:
    env_root = Path(directory).resolve() / "root"
    env_root.mkdir()
    base_environment = {
        "export TZ=UTC",
        "export DULCET_CONFORMANCE_BASE_URL=http://127.0.0.1:4533",
        "export DULCET_REDIRECT_CONFORMANCE_ROOT=http://127.0.0.1:4540",
        "export DULCET_UNTRUSTED_TLS_URL=https://127.0.0.1:4542",
        "export DULCET_CONFORMANCE_DISPOSABLE=true",
        f"export DULCET_CONFORMANCE_MUSIC_DIR={shlex.quote(str(env_root / 'music'))}",
    }
    purge_default_environment = {
        "export DULCET_CONFORMANCE_PURGE_DEFAULT_BASE_URL=http://127.0.0.1:4534",
        "export DULCET_CONFORMANCE_PURGE_DEFAULT_MUSIC_DIR="
        f"{shlex.quote(str(env_root / 'purge-default' / 'music'))}",
    }
    # No `up` has run for this root, so the second server is not declared.
    observed = declared_environment(env_root)
    if observed != base_environment:
        raise AssertionError(f"local environment drifted without the second server: {observed!r}")
    # An `up` without --purge-default records None, and still declares no second server.
    (env_root / "state.json").write_text(json.dumps({"purge_default_container": None}))
    observed = declared_environment(env_root)
    if observed != base_environment:
        raise AssertionError(f"a plain `up` declared the second server: {observed!r}")
    # `up --purge-default` records the root's own second container, and only then is it declared.
    (env_root / "state.json").write_text(
        json.dumps({"purge_default_container": linux_local.purge_default_container_name(env_root)})
    )
    observed = declared_environment(env_root)
    if observed != base_environment | purge_default_environment:
        raise AssertionError(f"`up --purge-default` did not declare the second server: {observed!r}")

with tempfile.TemporaryDirectory(prefix="dulcet-nondisposable-") as directory:
    unsafe_root = Path(directory) / "not-declared"
    unsafe_root.mkdir()
    sentinel = unsafe_root / "must-survive"
    sentinel.write_text("negative-control\n")
    result = subprocess.run(
        [sys.executable, str(TOOL), "--root", str(unsafe_root), "down"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.returncode == 0 or "not a declared disposable conformance root" not in result.stdout:
        raise AssertionError(f"unmarked root was accepted: {result.stdout!r}")
    if sentinel.read_text() != "negative-control\n":
        raise AssertionError("unmarked-root negative control was modified")

with tempfile.TemporaryDirectory(prefix="dulcet-volume-control-") as directory:
    first_root = Path(directory) / "first"
    second_root = Path(directory) / "second"
    first_volume = linux_local.data_volume_name(first_root)
    second_volume = linux_local.data_volume_name(second_root)
    if first_volume != f"{linux_local.container_name(first_root)}-data":
        raise AssertionError("data volume does not derive its suffix from the root-scoped container")
    if first_volume == second_volume:
        raise AssertionError("distinct conformance roots share one data volume")

    commands: list[list[str]] = []

    def record_volume_command(command: list[str], **_kwargs: object) -> SimpleNamespace:
        commands.append(command)
        output = "true\n" if command[:3] == ["docker", "volume", "inspect"] else ""
        return SimpleNamespace(stdout=output)

    linux_local.volume_exists = lambda _name: True
    linux_local.run = record_volume_command
    linux_local.reset_data_volume(first_root, "pinned-image")
    if ["docker", "volume", "rm", first_volume] not in commands:
        raise AssertionError("data volume reset no longer removes the prior named volume")
    create = [
        "docker",
        "volume",
        "create",
        "--label",
        f"{linux_local.DISPOSABLE_LABEL}=true",
        first_volume,
    ]
    if create not in commands:
        raise AssertionError("data volume reset no longer creates a labelled named volume")
    helpers = [command for command in commands if command[:2] == ["docker", "run"]]
    if len(helpers) != 2:
        raise AssertionError(f"data volume ownership/write helpers drifted: {helpers!r}")
    owner, writer = helpers
    if owner[owner.index("--user") + 1] != "0:0" or not owner[-1].startswith("chown "):
        raise AssertionError(f"data volume is not initialized as root before Navidrome: {owner!r}")
    expected_user = f"{linux_local.os.getuid()}:{linux_local.os.getgid()}"
    if writer[writer.index("--user") + 1] != expected_user or ".dulcet-write-probe" not in writer[-1]:
        raise AssertionError(f"data volume is not write-probed as the Navidrome user: {writer!r}")

    commands.clear()
    linux_local.start_container(first_root, "pinned-image", "container")
    start = commands[0]
    expected_mount = f"type=volume,source={first_volume},target=/data"
    if start.count(expected_mount) != 1:
        raise AssertionError(f"Navidrome /data is not the root-scoped named volume: {start!r}")
    if f"{first_root / 'data'}:/data" in start:
        raise AssertionError("Navidrome /data regressed to a host bind mount")
    if f"{first_root / 'cache'}:/cache" not in start:
        raise AssertionError("Navidrome /cache must remain a host bind mount")

with tempfile.TemporaryDirectory(prefix="dulcet-up-control-") as directory:
    lifecycle_root = Path(directory) / "root"
    events: list[tuple[str, str]] = []
    linux_local.initialize_root = lambda root: root.mkdir(parents=True, exist_ok=True)
    linux_local.down = lambda _root: events.append(("down", ""))
    linux_local.require_available_loopback_ports = lambda purge_default: events.append(
        ("ports", str(purge_default))
    )
    linux_local.clear_directory = lambda _root, name: events.append(("clear", name))
    linux_local.pin = lambda name: {
        "navidrome.linux.image": "pinned-image",
        "navidrome.linux.architecture": "amd64",
    }[name]
    linux_local.reset_data_volume = lambda root, image, name=None: events.append(
        ("reset-data", f"{name or linux_local.data_volume_name(root)}:{image}")
    )
    linux_local.ensure_corpus = lambda _root, _image: events.append(("corpus", ""))
    linux_local.run = lambda _command, **_kwargs: SimpleNamespace(stdout="amd64\n")
    linux_local.render_configuration = lambda _root: events.append(("config", ""))
    linux_local.start_auxiliary = lambda _root: events.append(("auxiliary", ""))
    linux_local.wait_for_url = lambda url, **_kwargs: events.append(("wait", url))
    linux_local.start_container = lambda _root, _image, _name: events.append(("start", ""))
    linux_local.health_check = lambda _root, _name: events.append(("health", ""))
    linux_local.prepare_purge_default = lambda _root: events.append(("purge-default-prepare", ""))
    linux_local.start_purge_default_container = lambda _root, _image: events.append(
        ("purge-default-start", "")
    )
    linux_local.bootstrap_purge_default = lambda: events.append(("purge-default-bootstrap", ""))
    # A plain `up` -- the Android emulator jobs' -- starts no second server and needs no port 4534.
    linux_local.up(lifecycle_root)
    plain_purge_default = [event for event in events if event[0].startswith("purge-default")]
    if plain_purge_default or ("ports", "False") not in events:
        raise AssertionError(f"a plain `up` touched the second server: {events!r}")
    if json.loads((lifecycle_root / "state.json").read_text())["purge_default_container"] is not None:
        raise AssertionError("a plain `up` recorded a second server in its state")
    events.clear()
    linux_local.up(lifecycle_root, purge_default=True)
    if ("ports", "True") not in events:
        raise AssertionError(f"`up --purge-default` did not reserve the second server's port: {events!r}")
    if json.loads((lifecycle_root / "state.json").read_text())[
        "purge_default_container"
    ] != linux_local.purge_default_container_name(lifecycle_root):
        raise AssertionError("`up --purge-default` did not record its second server in its state")
    purge_default_reset = (
        "reset-data",
        f"{linux_local.purge_default_volume_name(lifecycle_root)}:pinned-image",
    )
    order = [
        ("corpus", ""),
        ("purge-default-prepare", ""),
        purge_default_reset,
        ("purge-default-start", ""),
        ("purge-default-bootstrap", ""),
    ]
    if any(event not in events for event in order) or [events.index(e) for e in order] != sorted(
        events.index(e) for e in order
    ):
        raise AssertionError(
            "up must prepare the purge-default music from the corpus, reset its own data volume, "
            f"start it, then bootstrap it: {events!r}"
        )
    if linux_local.purge_default_volume_name(lifecycle_root) == linux_local.data_volume_name(
        lifecycle_root
    ):
        raise AssertionError("the purge-default server shares the fixture's data volume")
    reset_event = (
        "reset-data",
        f"{linux_local.data_volume_name(lifecycle_root)}:pinned-image",
    )
    if reset_event not in events:
        raise AssertionError("up no longer resets the named data volume")
    if events.index(reset_event) > events.index(("start", "")):
        raise AssertionError("up resets the named data volume after Navidrome starts")
    if ("clear", "cache") not in events or ("clear", "data") in events:
        raise AssertionError(f"host cache/data reset contract drifted: {events!r}")

source = TOOL.read_text()
for required_source in (
    'pin("navidrome.linux.image")',
    'pin("navidrome.linux.architecture")',
    'pin("navidrome.version")',
    'pin("ffmpeg.linux.path")',
    'pin("ffmpeg.linux.version")',
    "require_running_container(name)",
    'binding != expected_binding',
    'REPOSITORY / "tools/seed-corpus"',
    'TOOLS / "health-check"',
    'TOOLS / "reset-transcode-cache"',
    '":core-conformance:macosArm64Test"',
    '":core-conformance:iosSimulatorArm64Test"',
    '":core-conformance:tvosSimulatorArm64Test"',
):
    if required_source not in source:
        raise AssertionError(f"shared lifecycle source is missing {required_source!r}")

workflow = WORKFLOW.read_text()
if "tools/conformance-env/linux-local --root \"$ROOT\" up" not in workflow:
    raise AssertionError("core-ci does not start the shared Linux lifecycle")
# Only the job whose JVM suite runs CONF-74 starts the second server; every other `up` leaves it
# out, so a failure of that server cannot fail a job that never uses it.
up_lines = [
    line.strip()
    for line in workflow.splitlines()
    if "tools/conformance-env/linux-local" in line
    and re.search(r"\bup\b", line)
    and not line.lstrip().startswith("#")
]
opted_in = [line for line in up_lines if line.endswith(" up --purge-default")]
if opted_in != ['tools/conformance-env/linux-local --root "$ROOT" up --purge-default']:
    raise AssertionError(f"exactly the conformance job must pass --purge-default: {up_lines!r}")
if len(up_lines) < 2 or any(
    not (line.endswith(" up") or line.endswith(" up --purge-default")) for line in up_lines
):
    raise AssertionError(f"an unexpected linux-local up form appeared: {up_lines!r}")
if "tools/conformance-env/linux-local --root \"$ROOT\" run --" not in workflow:
    raise AssertionError("core-ci does not run tests through the shared environment declaration")
if "deluan/navidrome@sha256:" in workflow or "/usr/bin/ffmpeg" in workflow:
    raise AssertionError("core-ci duplicates a conformance pin outside tools/conformance-env")

reset_source = RESET_TOOL.read_text()
for required_source in (
    'DULCET_CONFORMANCE_DISPOSABLE") != "true"',
    'observed_url != LOOPBACK_BASE_URL',
    'marker.read_text() != "isolated-root\\n"',
    'clear_transcode_entries(transcode_cache)',
    'require_server_stopped()',
):
    if required_source not in reset_source:
        raise AssertionError(f"cache reset source is missing {required_source!r}")

observe_source = OBSERVE_TOOL.read_text()
for required_source in ('source.add_argument("--log-file")', 'choices=("true", "false")'):
    if required_source not in observe_source:
        raise AssertionError(f"cache observation source is missing {required_source!r}")

apple_workflow = APPLE_WORKFLOW.read_text()
# The claim is "exactly once BEFORE each native run", so check the order, not just the count.
# Counting alone cannot tell three restarts placed correctly from three placed anywhere -- and this
# assertion is the only thing standing between a rearranged step and a native suite that runs
# against a warm transcode cache. The call takes arguments now (the sequencing experiment's arm),
# so match a call with any arguments; the definition line ends in `() {` and is excluded.
RESTART_CALL = re.compile(r"^ +restart_navidrome_cold(?: +\S+)*$")
NATIVE_TASK = re.compile(
    r":core-conformance:(macosArm64Test|iosSimulatorArm64Test|tvosSimulatorArm64Test)\b"
)
apple_sequence: list[str] = []
for apple_line in apple_workflow.splitlines():
    if apple_line.lstrip().startswith("#"):
        continue
    if RESTART_CALL.match(apple_line):
        apple_sequence.append("restart")
        continue
    native = NATIVE_TASK.search(apple_line)
    if native and "gradlew" in apple_line:
        apple_sequence.append(native.group(1))
expected_sequence = [
    "restart", "macosArm64Test",
    "restart", "iosSimulatorArm64Test",
    "restart", "tvosSimulatorArm64Test",
]
if apple_sequence != expected_sequence:
    raise AssertionError(
        "apple-ci must restart and observe cold exactly once before each native run; observed "
        f"{apple_sequence}, expected {expected_sequence}"
    )
# The second, default-PurgeMissing server lives only around the macOS conformance leg (CONF-74 is
# the only thing that uses it). Its files are prepared before any server starts, so a failed
# preparation cannot strand the fixture; it starts only AFTER that leg's baseline restart, so the
# restart experiment's baseline is unchanged; and it stops right after the leg, before the next
# restart and every later simulator phase. The trap's kill stays as a backstop.
# This pins the order of the lines it names, and nothing else. A new command that can fail,
# inserted between the fixture launch and `trap cleanup EXIT`, is not caught here: under `bash -e`
# it would exit the step with the fixture still running. Keep that span free of such commands.
PURGE_DEFAULT_LIFETIME = (
    ("prepare", "tools/conformance-env/purge-default-server prepare"),
    ("render", 'tools/conformance-env/render-config --output "$ROOT/purge-default/config/navidrome.toml"'),
    ("clear-pid", "purge_default_pid="),
    # `> "`, not `>> "`: the restart function relaunches the fixture appending to its log.
    ("fixture-launch", '"$ROOT/bin/navidrome" --configfile "$ROOT/config/navidrome.toml" > "'),
    ("trap", "trap cleanup EXIT"),
    ("baseline-restart", "restart_navidrome_cold macos baseline false"),
    ("launch", '"$ROOT/bin/navidrome" --configfile "$ROOT/purge-default/config/navidrome.toml"'),
    ("record-pid", "purge_default_pid=$!"),
    ("bootstrap", "tools/conformance-env/purge-default-server bootstrap --base-url http://127.0.0.1:4534"),
    ("macos-leg", "./gradlew --no-daemon :core-conformance:macosArm64Test"),
    ("stop", 'kill "$purge_default_pid" || {'),
    ("reap", 'wait "$purge_default_pid" 2>/dev/null || true; purge_default_pid='),
    ("next-restart", "restart_navidrome_cold ios resequenced false"),
)
apple_code = [line.strip() for line in apple_workflow.splitlines() if not line.lstrip().startswith("#")]
lifetime_positions = []
for event, text in PURGE_DEFAULT_LIFETIME:
    # A bare assignment must match whole lines, or it would also match `purge_default_pid=$!`.
    exact = text.endswith("=")
    hits = [
        index
        for index, line in enumerate(apple_code)
        if (line == text if exact else line.startswith(text))
    ]
    if len(hits) != 1:
        raise AssertionError(f"apple-ci second-server lifetime: {event} appears {len(hits)} times: {text!r}")
    lifetime_positions.append(hits[0])
if lifetime_positions != sorted(lifetime_positions):
    order = [event for _, event in sorted(zip(lifetime_positions, (e for e, _ in PURGE_DEFAULT_LIFETIME)))]
    raise AssertionError(f"apple-ci second-server lifetime is out of order: {order}")
if 'kill "$purge_default_pid" >/dev/null 2>&1 || true' not in apple_code:
    raise AssertionError("apple-ci cleanup lost its backstop kill of the second server")

for required_workflow in (
    'tools/conformance-env/reset-transcode-cache --root "$ROOT"',
    '--log-file "$ROOT/logs/navidrome.log" --expect-cached false',
):
    if required_workflow not in apple_workflow:
        raise AssertionError(f"apple-ci cold restart is missing {required_workflow!r}")

print(
    "The conformance lifecycle rejects an unmarked root, preserves its sentinel, exports the "
    "loopback disposable contract, gives each root a labelled/reset/write-probed named data "
    "volume while keeping cache host-mounted, shares every pin/corpus/health source with core-ci, "
    "and makes all three apple-ci and local native runs reset then require an observed cold transcode; "
    "the second server starts only for the runs that use it"
)
