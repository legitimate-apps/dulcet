#!/usr/bin/env python3
"""Prove `tools/run-gradle-exclusive` serialises concurrent Gradle build phases.

The property under test is an ABSENCE -- two invocations must not overlap -- so the suite carries a
negative control that runs the same two processes WITHOUT the wrapper and requires them to overlap.
Without it a broken overlap detector would report a pass while the wrapper did nothing.
"""

from __future__ import annotations

import os
import pathlib
import signal
import subprocess
import sys
import tempfile
import time

TOOL = pathlib.Path(__file__).resolve().parent / "run-gradle-exclusive"

FAKE_GRADLEW = """#!/usr/bin/env python3
# Like gradlew's final exec of Java, the workload stays in this PID.
import os
import time
with open(os.environ["INTERVALS"], "a") as log:
    log.write(f"start {os.getpid()} {time.monotonic()}\\n")
time.sleep(float(os.environ.get("HOLD_SECONDS", "1")))
with open(os.environ["INTERVALS"], "a") as log:
    log.write(f"end {os.getpid()} {time.monotonic()}\\n")
raise SystemExit(int(os.environ.get("FAKE_EXIT", "0")))
"""


failures: list[str] = []


def check(condition: bool, message: str) -> None:
    if condition:
        print(f"  PASS {message}")
    else:
        print(f"  FAIL {message}")
        failures.append(message)


def make_repo(directory: pathlib.Path, intervals: pathlib.Path) -> dict[str, str]:
    wrapper = directory / "gradlew"
    wrapper.write_text(FAKE_GRADLEW)
    wrapper.chmod(0o755)
    environment = dict(os.environ)
    environment["INTERVALS"] = str(intervals)
    environment["GRADLE_USER_HOME"] = str(directory / "gradle-home")
    return environment


def read_intervals(path: pathlib.Path) -> list[tuple[float, float]]:
    starts: dict[str, float] = {}
    spans: list[tuple[float, float]] = []
    for line in path.read_text().splitlines():
        kind, pid, stamp = line.split()
        if kind == "start":
            starts[pid] = float(stamp)
        else:
            spans.append((starts[pid], float(stamp)))
    return spans


def overlaps(spans: list[tuple[float, float]]) -> bool:
    ordered = sorted(spans)
    return any(b[0] < a[1] for a, b in zip(ordered, ordered[1:]))


def run_pair(command: list[str], environment: dict[str, str], cwd: pathlib.Path) -> None:
    processes = [
        subprocess.Popen(command, env=environment, cwd=cwd,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(2)
    ]
    for process in processes:
        process.wait()


def case_serialises() -> None:
    print("=== two wrapped invocations do not overlap ===")
    with tempfile.TemporaryDirectory() as raw:
        directory = pathlib.Path(raw)
        intervals = directory / "intervals"
        intervals.touch()
        environment = make_repo(directory, intervals)
        environment["HOLD_SECONDS"] = "1"
        run_pair([sys.executable, str(TOOL), ":core:embedAndSignAppleFrameworkForXcode"],
                 environment, directory)
        spans = read_intervals(intervals)
        check(len(spans) == 2, f"both invocations ran (observed {len(spans)})")
        check(not overlaps(spans), f"intervals are disjoint (observed {spans})")


def case_negative_control() -> None:
    print("=== NEGATIVE CONTROL: unwrapped invocations DO overlap ===")
    with tempfile.TemporaryDirectory() as raw:
        directory = pathlib.Path(raw)
        intervals = directory / "intervals"
        intervals.touch()
        environment = make_repo(directory, intervals)
        environment["HOLD_SECONDS"] = "1"
        run_pair([str(directory / "gradlew")], environment, directory)
        spans = read_intervals(intervals)
        check(len(spans) == 2, f"both invocations ran (observed {len(spans)})")
        check(overlaps(spans),
              "the overlap detector fires without the wrapper -- otherwise the case above "
              f"would pass vacuously (observed {spans})")


def case_killed_holder_releases() -> None:
    print("=== a killed holder does not wedge the next build ===")
    with tempfile.TemporaryDirectory() as raw:
        directory = pathlib.Path(raw)
        intervals = directory / "intervals"
        intervals.touch()
        environment = make_repo(directory, intervals)
        environment["HOLD_SECONDS"] = "30"
        holder = subprocess.Popen(
            [sys.executable, str(TOOL), ":core:embedAndSignAppleFrameworkForXcode"],
            env=environment, cwd=directory,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline and not intervals.read_text():
            time.sleep(0.05)
        check(bool(intervals.read_text()), "the holder started before it was killed")
        child_pid = int(intervals.read_text().split()[1])
        os.kill(holder.pid, signal.SIGKILL)
        holder.wait()
        try:
            os.kill(child_pid, 0)
        except ProcessLookupError:
            stopped = True
        else:
            stopped = False
        check(stopped, "the first Gradle workload actually stopped when its holder was killed")
        if not stopped:
            # Clean up the deliberately exposed orphan after recording the failure.
            os.kill(child_pid, signal.SIGKILL)
        environment["HOLD_SECONDS"] = "0"
        started = time.monotonic()
        second = subprocess.run(
            [sys.executable, str(TOOL), ":core:embedAndSignAppleFrameworkForXcode"],
            env=environment, cwd=directory, timeout=20,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elapsed = time.monotonic() - started
        check(second.returncode == 0, f"the next build ran (exit {second.returncode})")
        check(elapsed < 10, f"it did not wait on the dead holder's lock ({elapsed:.1f}s)")


def case_propagates_failure() -> None:
    print("=== a Gradle failure is propagated, never swallowed ===")
    with tempfile.TemporaryDirectory() as raw:
        directory = pathlib.Path(raw)
        intervals = directory / "intervals"
        intervals.touch()
        environment = make_repo(directory, intervals)
        environment["HOLD_SECONDS"] = "0"
        environment["FAKE_EXIT"] = "7"
        result = subprocess.run(
            [sys.executable, str(TOOL), ":core:embedAndSignAppleFrameworkForXcode"],
            env=environment, cwd=directory,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        check(result.returncode == 7, f"exit code preserved (observed {result.returncode})")


def case_refuses_bad_invocation() -> None:
    print("=== it refuses rather than guessing ===")
    with tempfile.TemporaryDirectory() as raw:
        directory = pathlib.Path(raw)
        intervals = directory / "intervals"
        intervals.touch()
        environment = make_repo(directory, intervals)
        no_arguments = subprocess.run([sys.executable, str(TOOL)], env=environment, cwd=directory,
                                      capture_output=True, text=True)
        check(no_arguments.returncode == 2, "no arguments is refused")
        elsewhere = pathlib.Path(raw) / "elsewhere"
        elsewhere.mkdir()
        missing = subprocess.run([sys.executable, str(TOOL), ":core:x"], env=environment,
                                 cwd=elsewhere, capture_output=True, text=True)
        check(missing.returncode == 2, "a directory with no ./gradlew is refused")
        check("repository root" in missing.stderr, "the refusal says why")


def main() -> int:
    case_serialises()
    case_negative_control()
    case_killed_holder_releases()
    case_propagates_failure()
    case_refuses_bad_invocation()
    print()
    if failures:
        print(f"RUN-GRADLE-EXCLUSIVE FAIL {len(failures)} check(s)")
        return 1
    print("RUN-GRADLE-EXCLUSIVE PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
