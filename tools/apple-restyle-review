#!/usr/bin/env python3
"""Package real design-tour JPEGs and expose missing page/variant coverage.

Example: tools/apple-restyle-review artifacts/baseline --revision <commit>
Writes review/manifest.json, coverage.json, compressed images and labeled page sheets.
No output from this tool is a visual review verdict. --require-complete rejects gaps.
"""
import argparse
import json
from pathlib import Path
import re
import sys

from PIL import Image, ImageDraw, ImageFont, ImageOps

ROOT = Path(__file__).resolve().parents[1]
SPEC = ROOT / "docs/superpowers/specs/2026-10-27-apple-native-restyle.md"
VARIANTS = ("iphone-light-default", "iphone-dark-default", "iphone-light-accessibility-xxxl",
            "ipad-light-landscape", "mac-light", "mac-dark", "tvos")
ALIASES = {
    "Listen Now": ["listen-now"], "Library root": ["library", "library-sidebar"],
    "Browse root": ["browse"], "Recently Added": ["recently-added", "recently-added-all"],
    "Recently Played": ["recently-played", "recently-played-all"],
    "Most Played": ["most-played", "most-played-all"], "Albums": ["albums", "all-albums", "sidebar-albums"],
    "Artists": ["artists", "all-artists"], "Genres": ["genres"], "Genre detail": ["genre"],
    "Songs": ["songs"], "Favourites": ["favourites", "favourites-populated"],
    "Album detail": ["album"], "Artist detail": ["artist"], "Playlists": ["playlists", "playlists-populated"],
    "Playlist detail": ["playlist"], "Playlist editor": ["playlist-edit"],
    "Playlist create/rename": ["playlist-create", "playlist-create-filled", "playlist-rename"],
    "Add to Playlist": ["playlist-add", "add-to-playlist"], "Delete Playlist": ["playlist-delete-confirmation"],
    "Search landing/recents": ["search-recents", "search-landing"], "Search results": ["search"],
    "Discover shelves": ["discover"], "Discover artist": ["discover-artist"],
    "Discover album/edition": ["discover-album", "discover-edition"], "Wishlist": ["wishlist"],
    "Wishlist detail/pending": ["wishlist-pending", "wishlist-detail"], "MiniPlayer": ["mini-player"],
    "Now Playing": ["now-playing", "now-playing-star", "now-playing-heart"], "Up Next": ["up-next"],
    "Lyrics": ["lyrics"], "Downloads": ["downloads-populated", "downloads-offline"],
    "Storage/device-only": ["device-only-library", "offline-settings-controls", "offline-settings-automatic-off"],
    "Connection/account": ["connection-empty", "connection-filled", "connection-connected", "connection-connecting"],
    "Connection errors": ["connection-error-input", "connection-error-authentication", "connection-error-transport",
                          "connection-error-security", "connection-error-protocol", "connection-error-server",
                          "connection-error-tls", "connection-error-persistence"],
    "Streaming quality": ["settings-quality", "streaming-quality", "quality-options"],
    "Context menus": ["album-menu", "artist-menu", "track-menu", "playlist-menu", "playlist-more", "album-sort"],
    "First run/empty player": ["first-run-library", "first-run-search", "now-playing-empty"],
    "Global offline/error/loading": ["offline-album", "connection-saved-disconnected", "loading", "offline-library"],
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", type=Path)
    parser.add_argument("--revision", required=True)
    parser.add_argument("--logs", type=Path, help="Tour logs, required to distinguish Mac compositor shots from view renders")
    parser.add_argument("--require-complete", action="store_true")
    args = parser.parse_args()
    output = args.directory / "review"
    (output / "images").mkdir(parents=True, exist_ok=True)
    (output / "sheets").mkdir(exist_ok=True)
    # Target prose and page census have one source, the reviewed specification table.
    table = SPEC.read_text().split("## Page and state targets\n", 1)[1].split("## Capture and review contract", 1)[0]
    pages = {parts[1].strip(): parts[2].strip() for line in table.splitlines()
             if line.startswith("| ") and (parts := line.split("|"))[1].strip() in ALIASES}
    if set(pages) != set(ALIASES):
        raise SystemExit("Specification page inventory changed; update the capture aliases")
    shots = []
    seen = set()
    for path in sorted(args.directory.rglob("*.jpg")):
        if "review" in path.relative_to(args.directory).parts or "contact-sheets" in path.parts:
            continue
        match = re.fullmatch(r"(.+)-(\d+)-(.+)\.jpg", path.name)
        if not match:
            continue
        variant, _, screen = match.groups()
        platform = next((p for p in ("iphone", "ipad", "mac", "tvos") if variant.startswith(p)), None)
        if platform is None:
            continue
        target = output / "images" / path.name
        if path.name in seen:
            raise SystemExit("Duplicate capture filename: " + path.name)
        seen.add(path.name)
        with Image.open(path) as source:
            image = ImageOps.exif_transpose(source).convert("RGB")
            image.thumbnail((1000, 1000))
            image.save(target, quality=55, optimize=True)
        mode = "screen" if platform != "mac" else "unknown"
        if platform == "mac" and args.logs:
            log = args.logs / (variant + ".log")
            if log.exists():
                modes = re.findall(r"capture=(screen|view-render) screen=" + re.escape(screen) + r"(?:\s|$)", log.read_text(errors="replace"))
                if modes:
                    mode = modes[-1]
        reached = not screen.endswith("-UNREACHED")
        shots.append(dict(platform=platform, variant=variant.removesuffix("-account"), screen=screen,
                          file=str(target.relative_to(output)), reached=reached, captureMode=mode,
                          eligibleForVisualReview=reached and mode == "screen"))
    manifest, coverage = [], []
    try:
        font = ImageFont.truetype("/System/Library/Fonts/Helvetica.ttc", 13)
    except OSError:
        font = ImageFont.load_default()
    for page, target in pages.items():
        found = [s for s in shots if s["screen"].removesuffix("-UNREACHED") in ALIASES[page]]
        missing = [v for v in VARIANTS if not any(s["variant"] == v and s["eligibleForVisualReview"] for s in found)]
        coverage.append(dict(page=page, missingVariants=missing, status="missing" if missing else "captured",
                             stateCoverage="requires-manual-census", review="pending"))
        for shot in found:
            manifest.append(dict(page=page, **shot, expected=target, revision=args.revision, review="pending"))
        if not found:
            continue
        # A page can have multiple menus/states. Split sheets to keep labels readable.
        slug = re.sub(r"[^a-z0-9]+", "-", page.lower()).strip("-")
        for offset in range(0, len(found), 8):
            batch = found[offset:offset + 8]
            columns = min(4, len(batch))
            rows = (len(batch) + columns - 1) // columns
            canvas = Image.new("RGB", (1000, 60 + rows * 440), "#202124")
            draw = ImageDraw.Draw(canvas)
            draw.text((12, 12), page + " | baseline, review pending", font=font, fill="white")
            for i, shot in enumerate(batch):
                x, y = i % columns * (1000 // columns), 60 + i // columns * 440
                draw.text((x + 6, y), shot["variant"], font=font, fill="white")
                draw.text((x + 6, y + 18), shot["screen"], font=font,
                          fill="white" if shot["reached"] else "#ffb4ab")
                with Image.open(output / shot["file"]) as image:
                    image = ImageOps.contain(image, (1000 // columns - 12, 390))
                    canvas.paste(image, (x + 6, y + 42))
            canvas.thumbnail((1000, 1000))
            canvas.save(output / "sheets" / f"{slug}-{offset // 8 + 1}.jpg", quality=55, optimize=True)
    (output / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    (output / "coverage.json").write_text(json.dumps(dict(revision=args.revision, pages=coverage,
        unmatched=[s for s in shots if not any(s["screen"].removesuffix("-UNREACHED") in a for a in ALIASES.values())]), indent=2) + "\n")
    gaps = sum(bool(p["missingVariants"]) for p in coverage)
    print(f"REVIEW PACKAGE pages={len(pages)} images={len(shots)} missingVariantPages={gaps} verdict=pending")
    return int(args.require_complete and (gaps > 0 or any(not s["reached"] for s in shots)))


if __name__ == "__main__":
    sys.exit(main())
