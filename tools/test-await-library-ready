#!/usr/bin/env python3
"""Pin current-process scan readiness against a deterministic Subsonic stub."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = Path(__file__).resolve().parent
TOOL = ROOT / "conformance-env" / "await-library-ready"
BASELINE = "2026-08-30T07:00:00Z"
ADVANCED = "2026-08-30T07:00:01Z"


class State:
    def __init__(self, statuses: list[dict]) -> None:
        self.statuses = statuses
        self.index = 0
        self.lock = threading.Lock()

    def next_status(self) -> dict:
        with self.lock:
            status = self.statuses[min(self.index, len(self.statuses) - 1)]
            self.index += 1
            return status


def run_tool(statuses: list[dict], *arguments: str) -> subprocess.CompletedProcess[str]:
    state = State(statuses)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_args) -> None:
            pass

        def do_GET(self) -> None:
            if self.path.startswith("/rest/getScanStatus"):
                response = {"scanStatus": state.next_status()}
            elif self.path.startswith("/rest/getAlbumList2"):
                response = {"albumList2": {"album": [{"id": "album"}]}}
            else:
                self.send_error(404)
                return
            body = json.dumps({"subsonic-response": response}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(
        target=server.serve_forever,
        kwargs={"poll_interval": 0.01},
        daemon=True,
    )
    thread.start()
    try:
        return subprocess.run(
            [
                sys.executable,
                str(TOOL),
                "--base-url",
                f"http://127.0.0.1:{server.server_port}",
                *arguments,
            ],
            text=True,
            capture_output=True,
            check=False,
        )
    finally:
        server.shutdown()
        server.server_close()


def status(*, scanning: bool, last_scan: str, error: str = "") -> dict:
    return {
        "scanning": scanning,
        "count": 314,
        "lastScan": last_scan,
        "error": error,
    }


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


snapshot = run_tool(
    [status(scanning=False, last_scan=BASELINE)],
    "--print-last-scan",
)
require(snapshot.returncode == 0, snapshot.stdout + snapshot.stderr)
require(snapshot.stdout.strip() == BASELINE, f"wrong baseline: {snapshot.stdout!r}")

stale = run_tool(
    [status(scanning=False, last_scan=BASELINE)],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "0.15",
    "--poll-interval-seconds",
    "0.01",
)
require(stale.returncode != 0, "stale persisted rows were accepted as current-process readiness")
require("advanced=false" in stale.stderr, stale.stdout + stale.stderr)
print("NEGATIVE CONTROL PASS stale_lastScan_rejected=true")

advanced = run_tool(
    [
        status(scanning=True, last_scan=BASELINE),
        status(scanning=False, last_scan=ADVANCED),
    ],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "1",
    "--poll-interval-seconds",
    "0.01",
)
require(advanced.returncode == 0, advanced.stdout + advanced.stderr)
require(f"lastScan={ADVANCED}" in advanced.stdout, advanced.stdout)
print("POSITIVE CONTROL PASS advanced_lastScan_accepted=true")

errored = run_tool(
    [status(scanning=False, last_scan=ADVANCED, error="scanner exploded")],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "0.15",
    "--poll-interval-seconds",
    "0.01",
)
require(errored.returncode != 0, "reported scan error was accepted")
require("scan status reported an error: scanner exploded" in errored.stderr, errored.stderr)
print("NEGATIVE CONTROL PASS reported_scan_error_rejected=true")
