#!/usr/bin/env python3
"""Pin current-process scan readiness against a deterministic Subsonic stub."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = Path(__file__).resolve().parent
TOOL = ROOT / "conformance-env" / "await-library-ready"
BASELINE = "2026-08-30T07:00:00Z"
ADVANCED = "2026-08-30T07:00:01Z"


class State:
    def __init__(self, statuses: list[dict]) -> None:
        self.statuses = statuses
        self.index = 0
        self.lock = threading.Lock()

    def next_status(self) -> dict:
        with self.lock:
            status = self.statuses[min(self.index, len(self.statuses) - 1)]
            self.index += 1
            return status


def run_tool(
    statuses: list[dict], *arguments: str, observed: dict | None = None
) -> subprocess.CompletedProcess[str]:
    """Run the tool against a stub and, via `observed`, report what the SERVER received.

    The request count has to come from the server end. A poll that quietly stops polling produces
    the same exit code and the same message as one that polls, so no assertion about the tool's own
    output can tell them apart.
    """

    state = State(statuses)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_args) -> None:
            pass

        def do_GET(self) -> None:
            if self.path.startswith("/rest/getScanStatus"):
                observed = state.next_status()
                if observed.get("stall"):
                    time.sleep(30)
                    return
                if observed.get("http_error"):
                    self.send_error(503)
                    return
                response = observed.get("envelope", {"scanStatus": observed})
            elif self.path.startswith("/rest/getAlbumList2"):
                response = {"albumList2": {"album": [{"id": "album"}]}}
            else:
                self.send_error(404)
                return
            body = json.dumps({"subsonic-response": response}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    thread = threading.Thread(
        target=server.serve_forever,
        kwargs={"poll_interval": 0.01},
        daemon=True,
    )
    thread.start()
    try:
        return subprocess.run(
            [
                sys.executable,
                str(TOOL),
                "--base-url",
                f"http://127.0.0.1:{server.server_port}",
                *arguments,
            ],
            text=True,
            capture_output=True,
            check=False,
            timeout=25,
        )
    finally:
        server.shutdown()
        server.server_close()
        if observed is not None:
            observed["scan_status_requests"] = state.index


def status(*, scanning: bool, last_scan: str, error: str = "") -> dict:
    return {
        "scanning": scanning,
        "count": 314,
        "lastScan": last_scan,
        "error": error,
    }


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


snapshot = run_tool(
    [status(scanning=False, last_scan=BASELINE)],
    "--print-last-scan",
)
require(snapshot.returncode == 0, snapshot.stdout + snapshot.stderr)
require(snapshot.stdout.strip() == BASELINE, f"wrong baseline: {snapshot.stdout!r}")

# A server that accepts the first connection without responding, then answers the retry.
observed: dict = {}
recovered = run_tool(
    [{"stall": True}, status(scanning=False, last_scan=BASELINE)],
    "--print-last-scan", "--timeout-seconds", "20", "--poll-interval-seconds", "0.01",
    "--request-timeout-seconds", "0.2",
    observed=observed,
)
require(recovered.returncode == 0, recovered.stdout + recovered.stderr)
require(
    "scan baseline transport error; retrying (attempt 1): timed out" in recovered.stderr,
    recovered.stderr,
)
require(recovered.stdout.strip() == BASELINE, recovered.stdout)
require(observed["scan_status_requests"] == 2, observed)
print(
    "POSITIVE CONTROL PASS unresponsive_then_responsive=true "
    f"server_observed_requests={observed['scan_status_requests']}"
)
print(recovered.stderr.strip())
print(recovered.stdout.strip())

# THE PROCESS CONTROL. Every assertion above and below verifies an outcome, and a one-attempt poll
# produces exactly the same outcomes. Only the server-observed request count separates them.
# With the per-request budget derived from the remaining deadline -- the shape this tool used to
# have, and the shape its sibling probe had -- this reads 1.
observed = {}
started = time.monotonic()
polled = run_tool(
    [{"stall": True}, {"stall": True}, {"stall": True}, status(scanning=False, last_scan=BASELINE)],
    "--print-last-scan", "--timeout-seconds", "6", "--poll-interval-seconds", "0.01",
    "--request-timeout-seconds", "0.2",
    observed=observed,
)
require(polled.returncode == 0, polled.stdout + polled.stderr)
require(
    observed["scan_status_requests"] == 4,
    f"the baseline poll made {observed.get('scan_status_requests')} server-observed request(s), "
    "not 4; a per-request budget that is not independent of the overall deadline produces 1\n"
    + polled.stdout + polled.stderr,
)
require(polled.stderr.count("scan baseline transport error; retrying") == 3, polled.stderr)
require(time.monotonic() - started < 6, "the baseline poll escaped its deadline")
print(
    "POSITIVE CONTROL PASS baseline_is_a_poll=true "
    f"server_observed_requests={observed['scan_status_requests']}"
)

observed = {}
started = time.monotonic()
unresponsive = run_tool(
    [{"stall": True}],
    "--print-last-scan", "--timeout-seconds", "1", "--poll-interval-seconds", "0.01",
    "--request-timeout-seconds", "0.2",
    observed=observed,
)
require(unresponsive.returncode != 0, "unresponsive endpoint was accepted")
require("scan baseline never answered within 1.0s" in unresponsive.stderr, unresponsive.stderr)
require("attempts=" in unresponsive.stderr, unresponsive.stderr)
require("Traceback" not in unresponsive.stderr, "exhaustion still surfaces as a traceback:\n"
        + unresponsive.stderr)
require(observed["scan_status_requests"] >= 3, observed)
require(time.monotonic() - started < 4, "baseline request escaped its deadline")
print(
    "NEGATIVE CONTROL PASS baseline_transport_deadline=true "
    f"server_observed_requests={observed['scan_status_requests']}"
)

# The numbers can drift back together; the guard cannot.
incoherent = run_tool(
    [status(scanning=False, last_scan=BASELINE)],
    "--print-last-scan", "--timeout-seconds", "5", "--request-timeout-seconds", "5",
)
require(incoherent.returncode != 0, "an unpollable budget was accepted")
require(
    "must be strictly smaller than --timeout-seconds" in incoherent.stderr, incoherent.stderr
)
print("NEGATIVE CONTROL PASS one_attempt_budget_refused=true")

# A non-finite budget is not a positive one. `nan` is the instructive case: before the guard it
# exited with "scan baseline never answered ... attempts=0" -- a verdict about the server produced
# without a single request. Every outcome-shaped assertion in this file passes on that, which is
# why the attempt count is asserted here too.
observed = {}
for label, overall, request in [
    ("infinite overall", "inf", "0.2"),
    ("nan overall", "nan", "0.2"),
    ("nan request", "5", "nan"),
]:
    observed.clear()
    started = time.monotonic()
    nonfinite = run_tool(
        [{"stall": True}],
        "--print-last-scan", "--timeout-seconds", overall, "--poll-interval-seconds", "0.01",
        "--request-timeout-seconds", request,
        observed=observed,
    )
    require(nonfinite.returncode != 0, f"{label} was accepted")
    require(
        "must be a finite number greater than zero" in nonfinite.stderr,
        f"{label} was not refused by the budget guard:\n" + nonfinite.stderr,
    )
    require(
        observed["scan_status_requests"] == 0,
        f"{label} reached the server before being refused: {observed}",
    )
    require(time.monotonic() - started < 5, f"{label} ran before the guard rejected it")
    print(f"NEGATIVE CONTROL PASS nonfinite_budget_refused={label.replace(' ', '_')}")

for invalid, message in [
    ({}, "scan status did not carry lastScan: None"),
    ({"envelope": {"status": "failed", "error": {"message": "denied"}}},
     "scan status did not carry lastScan: None"),
    ({"http_error": True}, "HTTP Error 503"),
    (status(scanning=False, last_scan=BASELINE, error="scanner exploded"),
     "library scan status reported an error: scanner exploded"),
]:
    rejected = run_tool(
        [invalid, status(scanning=False, last_scan=BASELINE)],
        "--print-last-scan", "--timeout-seconds", "1", "--poll-interval-seconds", "0.01",
        "--request-timeout-seconds", "0.2",
    )
    require(rejected.returncode != 0, f"logical failure was retried: {invalid}")
    require(message in rejected.stderr, rejected.stderr)
    require("retrying" not in rejected.stderr, rejected.stderr)
print("NEGATIVE CONTROL PASS baseline_logical_failures_not_retried=true")

stale = run_tool(
    [status(scanning=False, last_scan=BASELINE)],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "0.5",
    "--poll-interval-seconds",
    "0.01",
    "--request-timeout-seconds",
    "0.2",
)
require(stale.returncode != 0, "stale persisted rows were accepted as current-process readiness")
require("advanced=false" in stale.stderr, stale.stdout + stale.stderr)
print("NEGATIVE CONTROL PASS stale_lastScan_rejected=true")

advanced = run_tool(
    [
        status(scanning=True, last_scan=BASELINE),
        status(scanning=False, last_scan=ADVANCED),
    ],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "1",
    "--poll-interval-seconds",
    "0.01",
    "--request-timeout-seconds",
    "0.2",
)
require(advanced.returncode == 0, advanced.stdout + advanced.stderr)
require(f"lastScan={ADVANCED}" in advanced.stdout, advanced.stdout)
print("POSITIVE CONTROL PASS advanced_lastScan_accepted=true")

errored = run_tool(
    [status(scanning=False, last_scan=ADVANCED, error="scanner exploded")],
    "--after-last-scan",
    BASELINE,
    "--timeout-seconds",
    "0.5",
    "--poll-interval-seconds",
    "0.01",
    "--request-timeout-seconds",
    "0.2",
)
require(errored.returncode != 0, "reported scan error was accepted")
require("scan status reported an error: scanner exploded" in errored.stderr, errored.stderr)
print("NEGATIVE CONTROL PASS reported_scan_error_rejected=true")
