#!/usr/bin/env python3
"""Static backstops for the Apple download wiring and adversarial-review fixes."""

from pathlib import Path
import json


ROOT = Path(__file__).resolve().parent.parent
controller = (ROOT / "apple/DulcetAppleShared/DulcetCoreDownloads.swift").read_text()
mac_app = (ROOT / "apple/DulcetMac/DulcetMacApp.swift").read_text()
ios_app = (ROOT / "apple/DulcetiOS/DulcetiOSApp.swift").read_text()
production = (ROOT / "apple/DulcetAppleShared/DulcetAppleProduction.swift").read_text()
project = (ROOT / "apple/Dulcet.xcodeproj/project.pbxproj").read_text()
presentation = (
    ROOT / "apple/DulcetKit/Sources/DulcetKit/AccountConnectionPresentation.swift"
).read_text()
features = json.loads((ROOT / "FEATURES.yml").read_text())

assert "urlSessionDidFinishEvents(forBackgroundURLSession" in controller
assert controller.startswith("#if os(macOS) || os(iOS)")
assert ".backgroundTask(.urlSession(" in mac_app
assert ".backgroundTask(.urlSession(" in ios_app
assert "makeIOSComposition" in production
assert "DulcetiOSDownloadIntegrationTests" in project
assert "DulcetCore.framework in Embed Frameworks" not in project
assert "scheduleNextDownload" in controller
assert "removeAccountData" in presentation

resume_branch_start = controller.index("if rejectedResumeData {")
resume_branch_end = controller.index("} else if let resumeData", resume_branch_start)
resume_branch = controller[resume_branch_start:resume_branch_end]
assert "rejectResumeData" in resume_branch
assert "recordFailure" not in resume_branch
assert "scheduleNextDownload()" in resume_branch

downloads = next(feature for feature in features["features"] if feature["id"] == "downloads.offline")
handoff_tests = {
    "macos": "DulcetMacDownloadHandoffAppTest/aKilledAppsDownloadIsReconciledByTheReplacementProcessThroughTheHostedMacApp",
    "ios": "DulcetiOSUITests/testAKilledAppsDownloadIsReconciledByTheReplacementProcessOnIPhone",
    "ipados": "DulcetiOSUITests/testAKilledAppsDownloadIsReconciledByTheReplacementProcessOnIPadOS",
}
for platform, handoff in handoff_tests.items():
    cell = downloads["platforms"][platform]
    # Shipped on the killed-process handoff each platform proved for itself (2026-10-07).
    assert cell["status"] == "shipped", platform
    assert "promotion_condition" not in cell, platform
    conformance = {row["conformance"] for row in cell["evidence"] if "conformance" in row}
    assert conformance == {"CONF-51", "CONF-52"}, (platform, conformance)
    tests = {row["test"] for row in cell["evidence"]}
    assert handoff in tests, (platform, tests)
    # iPhone evidence never stands for the iPad, nor the reverse.
    for other, test in handoff_tests.items():
        if other != platform and test != handoff:
            assert test not in tests, (platform, test)
    assert all(row["workflow"] == "apple-ci" for row in cell["evidence"]), platform
    reason = cell["reason"]
    assert "replacement process" in reason, platform
    assert "SHA-256" in reason, platform
    assert "aRelaunchIntoASavedAccountReconcilesItsDownloadsBeforeAnyReconnect" in reason, platform

mac = downloads["platforms"]["macos"]
assert "DulcetMacDownloadRowAppTest/aRowsDownloadButtonDownloadsTheTrackAndTheRowFollowsItThroughTheHostedMacApp" in {
    row["test"] for row in mac["evidence"]
}
assert "macOS did not relaunch that killed copy for its background session" in mac["reason"]
for platform in ("ios", "ipados"):
    reason = downloads["platforms"][platform]["reason"]
    assert "exit()" in reason and "force quit" in reason, platform
    assert "ASSUMED: a real device's memory-pressure termination" in reason, platform
assert "DulcetiOSUITests/testASearchResultsMenuDownloadsTheTrackOnIPhone" in {
    row["test"] for row in downloads["platforms"]["ios"]["evidence"]
}

registry = (ROOT / "docs/download-background-blockers.md").read_text()
for blocker in (
    "killed-process-background-session-handoff",
    "os-initiated-background-session-delivery",
):
    assert f"## {blocker}" in registry
for test in handoff_tests.values():
    assert test in registry, test
assert "macOS: no unattended relaunch was observed in the proof's configuration" in registry
assert "ASSUMED: macOS relaunches" not in registry
assert "killed-process-" + "relaunch-harness" not in (ROOT / "FEATURES.yml").read_text()

# A launch into a saved account configures downloads, so the launch reconciles what the system
# finished while the app was gone (the defect the handoff proofs found).
restored_start = presentation.index("if let providerInstanceID, let restored = restoredForReader {")
restored_branch = presentation[restored_start:presentation.index("\n        }\n", restored_start)]
assert "downloadController?.configure(account:" in restored_branch

print("Apple downloads adversarial-review regression contracts valid")
