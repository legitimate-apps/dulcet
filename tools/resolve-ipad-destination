#!/usr/bin/env python3
"""Resolve an iPad in both simctl and the selected Xcode's scheme destinations.

The iPadOS proof used to pin `name=iPad Pro 13-inch (M4)`. Apple rotates the marketing model names in
the hosted image -- OBSERVED 2026-08-30, run 33316319093 failed because that image shipped only
`iPad Pro 11-inch (M5)` and `iPad Pro 13-inch (M5)` -- so a pinned model name is a scheduled outage,
not determinism.

Resolving at run time is sound here because the model was never the thing being proved. The UI test
asserts the regular-width layout itself and rejects anything narrower, so any genuine iPad is valid
evidence and a wrong device fails inside the test with its own message. What this resolver owes that
guard is the guarantee it never hands back a non-iPad: a silent fallback to an iPhone would turn a
layout proof into a lie.

The selected Xcode must also list the same device as an available iOS Simulator destination for
the scheme. An installed, bootable simulator alone does not establish that eligibility. Query
failures stop resolution; --destinations-file supplies a saved query transcript for offline controls.
"""

from __future__ import annotations

import argparse
import json
import math
import re
import subprocess
import sys
import time
from pathlib import Path
from tempfile import TemporaryDirectory

# Give slow discovery most of the budget; restarting a killed query discards its progress.
XCODE_QUERY_TIMEOUT = 180
DISCOVERY_TIMEOUT = 240
SIMCTL_PROBE_TIMEOUT = 5
DISCOVERY_RETRY_INTERVAL = 5


class DestinationQueryTimeout(ValueError):
    """The xcodebuild query never answered, so the accepted set is UNKNOWN.

    Distinct from a query that answered with nothing; only the latter establishes an empty set.
    """


def simulator_responsiveness() -> str:
    """A bounded service probe after Xcode times out, without emitting simctl's private paths."""
    started = time.monotonic()
    try:
        result = subprocess.run(["xcrun", "simctl", "list", "devices", "--json"],
                                capture_output=True, text=True, timeout=SIMCTL_PROBE_TIMEOUT,
                                check=False)
        status = f"exited-{result.returncode}"
        if result.returncode == 0:
            try:
                document = json.loads(result.stdout)
                count = sum(len(devices) for devices in document["devices"].values())
                status = f"responsive devices={count}"
            except (ValueError, KeyError, TypeError, AttributeError):
                status = "invalid-json"
    except subprocess.TimeoutExpired:
        status = "timed-out"
    except OSError:
        status = "unavailable"
    return f"simctl-probe={status} elapsed={time.monotonic() - started:.3f}s budget={SIMCTL_PROBE_TIMEOUT}s"


def load_destinations(path: str | None, project: str, scheme: str,
                      timeout: float = XCODE_QUERY_TIMEOUT) -> str:
    if path:
        return Path(path).read_text()
    command = ["xcrun", "xcodebuild", "-showdestinations", "-project", project,
               "-scheme", scheme, "-configuration", "Debug"]
    started = time.monotonic()
    try:
        with TemporaryDirectory(prefix="dulcet-destinations-") as derived:
            command += ["-derivedDataPath", derived]
            result = subprocess.run(command, capture_output=True, text=True,
                                    timeout=timeout, check=False)
    except subprocess.TimeoutExpired as error:
        def decoded(value):
            return value.decode(errors="replace") if isinstance(value, bytes) else value or ""
        elapsed = time.monotonic() - started
        print(f"XCODE DESTINATION QUERY status=timeout elapsed={elapsed:.3f}s budget={timeout:g}s", file=sys.stderr)
        probe = simulator_responsiveness()
        print(probe, file=sys.stderr)
        raise DestinationQueryTimeout(
            f"xcodebuild destination query timed out after {timeout:g}s (elapsed={elapsed:.3f}s); "
            f"accepted set UNKNOWN; {probe}; partial output:\n"
            + decoded(error.stdout) + decoded(error.stderr)
        ) from error
    print(f"XCODE DESTINATION QUERY status=exited-{result.returncode} "
          f"elapsed={time.monotonic() - started:.3f}s budget={timeout:g}s", file=sys.stderr)
    transcript = result.stdout + "\n" + result.stderr
    if result.returncode:
        raise ValueError(f"xcodebuild destination query exited {result.returncode}; "
                         f"accepted set UNKNOWN; output:\n{transcript}")
    return transcript


def accepted_ids(transcript: str, scheme: str) -> set[str]:
    """Only concrete available iOS Simulator rows count, never ineligible rows/placeholders."""
    # Xcode 27 renamed both sections to compatible/incompatible (run 40544160667).
    headers = {
        f'Available destinations for the "{scheme}" scheme:',
        f'Destinations compatible with the "{scheme}" scheme:',
    }
    active = False
    seen_header = False
    identifiers = set()
    for line in transcript.splitlines():
        line = line.strip()
        if line in headers:
            active = seen_header = True
            continue
        if not line:
            continue
        if not line.startswith("{"):
            active = False
            continue
        if not active:
            continue
        if not line.endswith("}"):
            raise ValueError("malformed xcodebuild destination row; accepted set UNKNOWN")
        fields = dict(re.findall(r"(?:^|,)\s*([^:,]+):\s*([^,]*)", line[1:-1]))
        fields = {key.strip(): value.strip() for key, value in fields.items()}
        identifier = fields.get("id", "")
        if (fields.get("platform") == "iOS Simulator" and identifier
                and "placeholder" not in identifier.lower() and "error" not in fields):
            identifiers.add(identifier.upper())
    if not seen_header:
        raise ValueError(f"missing compatible destinations section for {scheme!r}; accepted set UNKNOWN")
    return identifiers

RUNTIME_IOS = re.compile(r"com\.apple\.CoreSimulator\.SimRuntime\.iOS-(\d+)(?:-(\d+))?(?:-(\d+))?$")


def load_devices(path: str | None, timeout: float = XCODE_QUERY_TIMEOUT) -> dict:
    if path:
        with open(path) as handle:
            return json.load(handle)
    try:
        result = subprocess.run(
            ["xcrun", "simctl", "list", "devices", "available", "--json"],
            capture_output=True, text=True, check=False, timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise ValueError(f"simctl device inventory timed out after {timeout:g}s; inventory UNKNOWN") from error
    if result.returncode != 0:
        raise ValueError(f"could not list simulators: {result.stderr.strip()}")
    return json.loads(result.stdout)


def ipad_candidates(document: dict) -> list[tuple[tuple[int, int, int], str, str, str]]:
    found = []
    for runtime, devices in (document.get("devices") or {}).items():
        match = RUNTIME_IOS.search(runtime)
        if match is None:
            continue
        version = tuple(int(part) if part else 0 for part in match.groups())
        for device in devices:
            name = device.get("name") or ""
            # The name is the only reliable family marker in this payload; deviceTypeIdentifier is
            # absent on some runtimes. Require an explicit iPad prefix rather than a substring match,
            # so a future "iPhone ... iPad-something" cannot slip through.
            if not name.startswith("iPad"):
                continue
            if device.get("isAvailable") is False:
                continue
            udid = device.get("udid")
            if not udid:
                continue
            found.append((version, name, udid, runtime))
    return found


def family_rank(name: str) -> int:
    """Higher is preferred. The layout proof wants the widest iPad available, not merely an iPad."""
    if name.startswith("iPad Pro"):
        return 4
    if name.startswith("iPad Air"):
        return 3
    if name.startswith("iPad mini"):
        return 1
    return 2


def diagnostic_devices(document: dict) -> list[dict]:
    """Describe the offered inventory without simctl's private filesystem paths."""
    return [
        {"name": device.get("name"), "udid": device.get("udid"),
         "runtime": runtime, "isAvailable": device.get("isAvailable")}
        for runtime, devices in (document.get("devices") or {}).items()
        for device in devices
    ]


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--devices-json", help="read a simctl payload from a file instead of running simctl")
    parser.add_argument("--destinations-file", help="read xcodebuild -showdestinations output instead of running Xcode")
    parser.add_argument("--project", default="apple/Dulcet.xcodeproj")
    parser.add_argument("--scheme", default="DulcetiOS")
    parser.add_argument("--discovery-timeout", type=float, default=DISCOVERY_TIMEOUT,
                        help="overall inventory and Xcode discovery deadline in seconds (default: 240)")
    parser.add_argument("--query-timeout", type=float, default=XCODE_QUERY_TIMEOUT,
                        help="per inventory/Xcode query timeout in seconds (default: 180). "
                             "Each attempt receives the smaller of this value and the remaining "
                             "discovery budget, so a timed-out query leaves the rest of the "
                             "deadline available to later attempts. A timeout diagnostic runs a "
                             "separately bounded five-second simctl probe.")
    parser.add_argument("--print", dest="field", choices=("destination", "name", "udid"), default="destination")
    args = parser.parse_args()
    if not math.isfinite(args.discovery_timeout) or args.discovery_timeout <= 0:
        parser.error("--discovery-timeout must be finite and positive")
    if not math.isfinite(args.query_timeout) or args.query_timeout <= 0:
        parser.error("--query-timeout must be finite and positive")

    started = time.monotonic()
    deadline = started + args.discovery_timeout
    inventory_timeout = min(args.query_timeout, args.discovery_timeout)
    print(f"IPAD DISCOVERY phase=inventory-start timeout={inventory_timeout:g}s", file=sys.stderr, flush=True)
    try:
        document = load_devices(args.devices_json, timeout=inventory_timeout)
    except (OSError, ValueError) as error:
        raise SystemExit(f"cannot determine Xcode-drivable iPads: phase=inventory {error}; "
                         f"elapsed={time.monotonic() - started:.3f}s deadline={args.discovery_timeout:g}s") from error
    print(f"IPAD DISCOVERY phase=inventory-complete elapsed={time.monotonic() - started:.3f}s", file=sys.stderr, flush=True)
    candidates = ipad_candidates(document)
    transcript = "(query did not produce output)"
    timed_out: DestinationQueryTimeout | None = None
    attempts = 0
    try:
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                if timed_out is not None:
                    raise timed_out
                raise ValueError("Xcode discovery deadline expired with zero concrete iOS Simulator destinations")
            attempts += 1
            print(f"IPAD DISCOVERY phase=xcode-query-start attempt={attempts} "
                  f"timeout={min(args.query_timeout, remaining):g}s remaining={remaining:.3f}s",
                  file=sys.stderr, flush=True)
            try:
                transcript = load_destinations(args.destinations_file, args.project, args.scheme,
                                               min(args.query_timeout, remaining))
            except DestinationQueryTimeout as error:
                # Preserve UNKNOWN, and retry only if the long query left discovery budget.
                # The diagnostic simctl probe has its own five-second bound.
                timed_out = error
                print(f"IPAD DISCOVERY phase=xcode-query-timeout attempt={attempts} "
                      f"elapsed={time.monotonic() - started:.3f}s", file=sys.stderr, flush=True)
                continue
            timed_out = None
            accepted = accepted_ids(transcript, args.scheme)
            print(f"IPAD DISCOVERY phase=xcode-query-complete attempt={attempts} "
                  f"concrete={len(accepted)} elapsed={time.monotonic() - started:.3f}s",
                  file=sys.stderr, flush=True)
            if time.monotonic() >= deadline:
                raise ValueError("Xcode discovery deadline expired before destinations could be accepted")
            # A populated set is authoritative, including a genuine mismatch with simctl's iPads.
            # Only an entirely empty concrete simulator set is eligible for another query.
            if accepted:
                break
            time.sleep(max(0, min(DISCOVERY_RETRY_INTERVAL, deadline - time.monotonic())))
    except (OSError, ValueError) as error:
        raise SystemExit(
            f"cannot determine Xcode-drivable iPads: {error}\n"
            f"discovery attempts={attempts} elapsed={time.monotonic() - started:.3f}s "
            f"deadline={args.discovery_timeout:g}s\n"
            f"simctl offered: {json.dumps(diagnostic_devices(document), sort_keys=True)}\n"
            f"xcodebuild accepts (raw query):\n{transcript}"
        ) from error
    offered_count = len(candidates)
    candidates = [entry for entry in candidates if entry[2].upper() in accepted]
    if not candidates:
        raise SystemExit(
            "no available iPad simulator is accepted by Xcode, so the regular-width layout proof cannot run.\n"
            f"simctl offered: {json.dumps(diagnostic_devices(document), sort_keys=True)}\n"
            f"xcodebuild accepts concrete iOS Simulator IDs: {sorted(accepted)}\n"
            f"xcodebuild accepts (raw query):\n{transcript}"
        )
    # Deterministic AND widest-first. Sorting by name alone picked "iPad mini" over "iPad Pro"
    # (lowercase 'm' sorts above 'P'), and the mini is the one iPad whose portrait width sits closest
    # to the regular-width boundary this test depends on. Rank by family so the proof runs on the
    # roomiest device the image offers, then by runtime, then by name for a stable tie-break.
    candidates.sort(key=lambda entry: (family_rank(entry[1]), entry[0], entry[1]), reverse=True)
    version, name, udid, _runtime = candidates[0]
    if args.field == "name":
        print(name)
    elif args.field == "udid":
        print(udid)
    else:
        print(f"platform=iOS Simulator,id={udid}")
    print(
        f"RESOLVED IPAD name={name!r} ios={'.'.join(str(p) for p in version)} candidates={len(candidates)} simctl_ipads={offered_count} query_attempts={attempts}",
        file=sys.stderr,
    )


if __name__ == "__main__":
    main()
