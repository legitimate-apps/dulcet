#!/usr/bin/env python3
"""Mutation fixtures proving the app-hosted execution guard cannot accept non-execution."""

from __future__ import annotations

from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
VERIFY = ROOT / "tools/verify-xcode-test-execution"
FIXTURES = ROOT / "tools/fixtures/xcode-test-execution"
EXPECTED_CLASS = "DulcetMacTests.DulcetMacAccountConnectAppTest"
EXPECTED_METHOD = "connectSuccessCrossesLiveKotlinFacadeIntoPersistenceFailureState"


def invoke(fixture: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            sys.executable,
            str(VERIFY),
            str(FIXTURES / fixture),
            EXPECTED_CLASS,
            EXPECTED_METHOD,
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


passing = invoke("one-passing.log")
if passing.returncode != 0:
    raise AssertionError(f"valid one-test record rejected: {passing.stdout}")

for fixture, expected in (
    ("zero-tests.log", "expected exactly one terminal test record, observed 0"),
    ("wrong-test.log", "wrong test executed"),
    ("skipped-test.log", "terminated as skipped"),
    ("failed-test.log", "terminated as failed"),
    ("duplicate-test.log", "expected exactly one terminal test record, observed 2"),
):
    result = invoke(fixture)
    if result.returncode == 0 or expected not in result.stdout:
        raise AssertionError(
            f"{fixture} was not rejected with {expected!r}: "
            f"returncode={result.returncode}, output={result.stdout!r}"
        )

# The test host writes OSLog to this same stream from other threads, so a record can land inside an
# XCTest line and tear it in two. OBSERVED doing exactly that to a Swift Testing transcript on
# apple-ci 2026-08-28. The guard must still see the torn record -- and must not let that tolerance
# resurrect a record that never arrived, which the second fixture pins down.
torn = invoke("torn-by-host-log.log")
if torn.returncode != 0:
    raise AssertionError(f"a torn terminal record was not rejoined: {torn.stdout}")

absent = invoke("torn-but-absent.log")
if absent.returncode == 0 or "observed 0" not in absent.stdout:
    raise AssertionError(
        "interleaved host logging let a missing record pass: "
        f"returncode={absent.returncode}, output={absent.stdout!r}"
    )

print("xcode test execution guard rejects zero, wrong, skipped, failed, and duplicate controls")
print("xcode test execution guard survives interleaved host logging")
