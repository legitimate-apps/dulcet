#!/usr/bin/env python3
"""Convert a successful Swift Testing console transcript into JUnit evidence."""

from __future__ import annotations

from pathlib import Path
import re
import sys
import xml.etree.ElementTree as ET


ANSI_ESCAPE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
# The test host writes OSLog to the same stream as Swift Testing, unbuffered, from other threads.
# A line like this therefore lands *inside* a result line and splits it across two physical lines:
#     ✔ Test progressBeginsOnly2026-08-28 13:05:53.306820+0000 xctest[35549:96065] [player] ...
#     AfterMediaTimeAdvancesAndUsesMonotonicSamples() passed after 1.065 seconds.
# Deleting the injected record *including its newline* rejoins the torn line exactly. This must not
# become a way to tolerate a missing result: the count and uniqueness checks below still run, so a
# test that truly never reported still fails the guard. OBSERVED tearing this way on apple-ci
# 2026-08-28 once AVFoundation playback tests began emitting [player]/[AQ] chatter.
INTERLEAVED_HOST_LOG = re.compile(
    r"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+[+-]\d{4} \S+\[\d+:[0-9a-fx]+\][^\n]*\n?"
)
PASSED_TEST = re.compile(r"✔ Test ([A-Za-z_][A-Za-z0-9_]*)\(\) passed\b")
PASSED_RUN = re.compile(r"✔ Test run with (\d+) tests? in \d+ suites? passed\b")


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) != 4:
    fail("usage: swift-testing-junit <transcript> <output.xml> <class-name>")

transcript_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
class_name = sys.argv[3]
if not class_name or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.]*", class_name):
    fail(f"invalid JUnit class name: {class_name!r}")

try:
    transcript = ANSI_ESCAPE.sub("", transcript_path.read_text())
    transcript = INTERLEAVED_HOST_LOG.sub("", transcript)
except OSError as error:
    fail(f"cannot read Swift Testing transcript: {error}")

summaries = PASSED_RUN.findall(transcript)
if len(summaries) != 1:
    fail(f"expected one successful Swift Testing run summary, found {len(summaries)}")

tests = PASSED_TEST.findall(transcript)
if len(tests) != len(set(tests)):
    fail("Swift Testing transcript contains duplicate passed-test identities")
expected_count = int(summaries[0])
if len(tests) != expected_count:
    fail(
        "Swift Testing passed-test lines do not match its successful run summary: "
        f"summary={expected_count}, observed={len(tests)}"
    )

suite = ET.Element(
    "testsuite",
    name=class_name,
    tests=str(len(tests)),
    failures="0",
    errors="0",
    skipped="0",
)
for name in sorted(tests):
    ET.SubElement(suite, "testcase", classname=class_name, name=name)

output_path.parent.mkdir(parents=True, exist_ok=True)
ET.ElementTree(suite).write(output_path, encoding="utf-8", xml_declaration=True)
print(f"Swift Testing JUnit evidence written: class={class_name} tests={len(tests)}")
