#!/usr/bin/env python3
"""Convert individual Swift Testing results in an xcresult bundle into JUnit evidence."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from xcresult_test_evidence import EvidenceError, read_xcresult, write_junit


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


if len(sys.argv) != 4:
    fail("usage: swift-testing-junit <bundle.xcresult> <output.xml> <class-name>")

bundle_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])
class_name = sys.argv[3]
if not class_name or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.]*", class_name):
    fail(f"invalid JUnit class name: {class_name!r}")

try:
    cases = read_xcresult(bundle_path)
    write_junit(cases, output_path, class_name)
except EvidenceError as error:
    fail(str(error))
print(f"Swift Testing JUnit evidence written: class={class_name} tests={len(cases)}")
