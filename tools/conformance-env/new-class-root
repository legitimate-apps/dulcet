#!/usr/bin/env python3

import argparse
from pathlib import Path
import re
import uuid


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Create one fresh Navidrome root. The future conformance class runner must invoke this "
            "utility once per class; this utility cannot enforce its callers' lifecycle."
        )
    )
    parser.add_argument("--parent", required=True)
    parser.add_argument("--label", required=True)
    args = parser.parse_args()

    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,47}", args.label):
        raise SystemExit("label must match [a-z0-9][a-z0-9-]{0,47}")
    parent = Path(args.parent).resolve()
    if not parent.is_dir():
        raise SystemExit(f"parent does not exist: {parent}")

    root = parent / f"dulcet-{args.label}-{uuid.uuid4().hex}"
    root.mkdir(mode=0o700)
    for name in ("cache", "config", "data", "logs", "music"):
        (root / name).mkdir()
    (root / ".dulcet-conformance-root").write_text("isolated-root\n")
    print(root)


if __name__ == "__main__":
    main()
