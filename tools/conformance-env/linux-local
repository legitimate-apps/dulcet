#!/usr/bin/env python3
"""Lifecycle for the pinned, disposable Linux Navidrome conformance environment."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request


TOOLS = Path(__file__).resolve().parent
REPOSITORY = TOOLS.parent.parent
DEFAULT_ROOT = REPOSITORY / ".build/dulcet-linux-conformance"
MARKER = ".dulcet-conformance-root"
DISPOSABLE_LABEL = "com.legitimateapps.dulcet.conformance"


def run(command: list[str], *, capture: bool = False, environment: dict[str, str] | None = None):
    result = subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        check=False,
        env=environment,
    )
    if result.returncode != 0:
        detail = ""
        if capture:
            detail = f": {(result.stderr or result.stdout).strip()}"
        raise RuntimeError(f"command failed with exit {result.returncode}: {command}{detail}")
    return result


def pin(path: str) -> str:
    return run([str(TOOLS / "read-pin"), path], capture=True).stdout.strip()


def resolve_root(value: str | None) -> Path:
    root = Path(value).expanduser().resolve() if value else DEFAULT_ROOT.resolve()
    if root == Path("/") or root == Path.home().resolve() or root == REPOSITORY.resolve():
        raise RuntimeError(f"refusing unsafe conformance root: {root}")
    return root


def initialize_root(root: Path) -> None:
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    marker = root / MARKER
    if marker.exists() and marker.read_text() != "isolated-root\n":
        raise RuntimeError(f"invalid disposable-root marker: {marker}")
    marker.write_text("isolated-root\n")
    for name in ("cache", "config", "logs", "music"):
        (root / name).mkdir(exist_ok=True)


def require_root(root: Path) -> None:
    marker = root / MARKER
    if not root.is_dir() or not marker.is_file() or marker.read_text() != "isolated-root\n":
        raise RuntimeError(f"not a declared disposable conformance root: {root}")


def container_name(root: Path) -> str:
    suffix = hashlib.sha256(str(root).encode()).hexdigest()[:12]
    return f"dulcet-conformance-{suffix}"


def data_volume_name(root: Path) -> str:
    return f"{container_name(root)}-data"


def container_exists(name: str) -> bool:
    result = subprocess.run(
        ["docker", "inspect", "--type", "container", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def volume_exists(name: str) -> bool:
    result = subprocess.run(
        ["docker", "volume", "inspect", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def remove_data_volume(root: Path) -> None:
    name = data_volume_name(root)
    if not volume_exists(name):
        return
    observed_label = run(
        [
            "docker",
            "volume",
            "inspect",
            "--format",
            f'{{{{ index .Labels "{DISPOSABLE_LABEL}" }}}}',
            name,
        ],
        capture=True,
    ).stdout.strip()
    if observed_label != "true":
        raise RuntimeError(
            f"refusing to remove volume without {DISPOSABLE_LABEL}=true: {name}"
        )
    run(["docker", "volume", "rm", name])


def reset_data_volume(root: Path, image: str) -> None:
    name = data_volume_name(root)
    remove_data_volume(root)
    run(
        [
            "docker",
            "volume",
            "create",
            "--label",
            f"{DISPOSABLE_LABEL}=true",
            name,
        ]
    )
    uid = os.getuid()
    gid = os.getgid()
    run(
        [
            "docker",
            "run",
            "--rm",
            "--platform",
            "linux/amd64",
            "--user",
            "0:0",
            "--entrypoint",
            "/bin/sh",
            "--volume",
            f"{name}:/data",
            image,
            "-c",
            f"chown {uid}:{gid} /data",
        ]
    )
    run(
        [
            "docker",
            "run",
            "--rm",
            "--platform",
            "linux/amd64",
            "--user",
            f"{uid}:{gid}",
            "--entrypoint",
            "/bin/sh",
            "--volume",
            f"{name}:/data",
            image,
            "-c",
            "probe=/data/.dulcet-write-probe; : > \"$probe\" && rm \"$probe\"",
        ]
    )


def require_running_container(name: str) -> None:
    if not container_exists(name):
        raise RuntimeError("conformance environment is not running; invoke 'up' first")
    try:
        details = json.loads(run(["docker", "inspect", name], capture=True).stdout)[0]
    except (IndexError, KeyError, TypeError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot validate disposable container {name}: {error}") from error
    label = details.get("Config", {}).get("Labels", {}).get(DISPOSABLE_LABEL)
    running = details.get("State", {}).get("Running")
    binding = details.get("NetworkSettings", {}).get("Ports", {}).get("4533/tcp")
    expected_binding = [{"HostIp": "127.0.0.1", "HostPort": "4533"}]
    if label != "true" or running is not True or binding != expected_binding:
        raise RuntimeError(
            "declared disposable container failed its ownership/runtime check: "
            f"name={name} label={label!r} running={running!r} binding={binding!r}"
        )


def stop_container(name: str) -> None:
    if not container_exists(name):
        return
    observed_label = run(
        [
            "docker",
            "inspect",
            "--type",
            "container",
            "--format",
            f'{{{{ index .Config.Labels "{DISPOSABLE_LABEL}" }}}}',
            name,
        ],
        capture=True,
    ).stdout.strip()
    if observed_label != "true":
        raise RuntimeError(
            f"refusing to stop container without {DISPOSABLE_LABEL}=true: {name}"
        )
    subprocess.run(
        ["docker", "stop", "--timeout", "5", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    run(["docker", "rm", name])


def process_command(pid: int) -> str:
    result = subprocess.run(
        ["ps", "-p", str(pid), "-o", "command="],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def stop_auxiliary(root: Path) -> None:
    for name, expected in (
        ("redirect.pid", "redirect-server"),
        ("tls.pid", "untrusted-tls-server"),
        ("proxy.pid", "redirect-server"),
    ):
        path = root / "logs" / name
        if not path.is_file():
            continue
        try:
            pid = int(path.read_text().strip())
        except ValueError:
            path.unlink(missing_ok=True)
            continue
        command = process_command(pid)
        if expected in command:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            for _ in range(20):
                if not process_command(pid):
                    break
                time.sleep(0.05)
        path.unlink(missing_ok=True)


def down(root: Path) -> None:
    if not root.exists():
        print(f"conformance environment already down: root={root}")
        return
    require_root(root)
    stop_container(container_name(root))
    stop_auxiliary(root)
    print(f"conformance environment down: root={root}")


def clear_directory(root: Path, name: str) -> None:
    require_root(root)
    target = (root / name).resolve()
    if target.parent != root or target.name != name:
        raise RuntimeError(f"refusing unsafe disposable directory reset: {target}")
    if target.exists():
        shutil.rmtree(target)
    target.mkdir()


def require_available_loopback_ports() -> None:
    deadline = time.monotonic() + 5
    while True:
        occupied: list[int] = []
        reservations: list[socket.socket] = []
        try:
            for port in (4533, 4540, 4541, 4542, 4543):
                reservation = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                reservation.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                try:
                    reservation.bind(("127.0.0.1", port))
                except OSError:
                    reservation.close()
                    occupied.append(port)
                else:
                    reservations.append(reservation)
        finally:
            for reservation in reservations:
                reservation.close()
        if not occupied:
            return
        if time.monotonic() >= deadline:
            ports = ", ".join(str(port) for port in occupied)
            raise RuntimeError(
                f"required loopback port(s) already in use: {ports}; "
                "refusing to replace or attach to another service"
            )
        time.sleep(0.1)


def ensure_corpus(root: Path, image: str) -> None:
    manifest = root / "music/corpus-manifest.json"
    if manifest.is_file():
        print(f"reusing generated corpus: {manifest}")
        return
    clear_directory(root, "music")
    run(
        [
            str(REPOSITORY / "tools/seed-corpus"),
            "--output",
            str(root / "music"),
            "--runtime",
            "docker",
            "--image",
            image,
        ]
    )


def render_configuration(root: Path) -> None:
    run(
        [
            str(TOOLS / "render-config"),
            "--output",
            str(root / "config/navidrome.toml"),
            "--music-folder",
            "/music",
            "--data-folder",
            "/data",
            "--cache-folder",
            "/cache",
            "--address",
            "0.0.0.0",
            "--ffmpeg-path",
            pin("ffmpeg.linux.path"),
        ]
    )


def start_auxiliary(root: Path) -> None:
    run(
        [
            "openssl",
            "req",
            "-x509",
            "-newkey",
            "rsa:2048",
            "-sha256",
            "-days",
            "1",
            "-nodes",
            "-config",
            str(TOOLS / "untrusted-tls-openssl.cnf"),
            "-keyout",
            str(root / "untrusted-tls.key"),
            "-out",
            str(root / "untrusted-tls.crt"),
        ]
    )
    logs = root / "logs"
    redirect_log = (logs / "redirect.log").open("ab")
    redirect = subprocess.Popen(
        [
            sys.executable,
            str(TOOLS / "redirect-server"),
            "--port",
            "4540",
            "--target-port",
            "4541",
        ],
        stdout=redirect_log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    (logs / "redirect.pid").write_text(f"{redirect.pid}\n")
    tls_log = (logs / "tls.log").open("ab")
    tls = subprocess.Popen(
        [
            sys.executable,
            str(TOOLS / "untrusted-tls-server"),
            "--port",
            "4542",
            "--certificate",
            str(root / "untrusted-tls.crt"),
            "--key",
            str(root / "untrusted-tls.key"),
        ],
        stdout=tls_log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    (logs / "tls.pid").write_text(f"{tls.pid}\n")
    proxy_log = (logs / "proxy.log").open("ab")
    proxy = subprocess.Popen(
        [
            sys.executable,
            str(TOOLS / "redirect-server"),
            "--port",
            "4543",
            "--forward-proxy-auth",
        ],
        stdout=proxy_log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    (logs / "proxy.pid").write_text(f"{proxy.pid}\n")


def wait_for_url(url: str, *, insecure: bool = False) -> None:
    context = None
    if insecure:
        import ssl

        context = ssl._create_unverified_context()
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=1, context=context) as response:
                if response.status == 200:
                    return
        except (OSError, urllib.error.URLError):
            time.sleep(0.1)
    raise RuntimeError(f"service did not become healthy: {url}")


def start_container(root: Path, image: str, name: str) -> None:
    run(
        [
            "docker",
            "run",
            "--detach",
            "--name",
            name,
            "--platform",
            "linux/amd64",
            "--label",
            f"{DISPOSABLE_LABEL}=true",
            "--user",
            f"{os.getuid()}:{os.getgid()}",
            "--publish",
            "127.0.0.1:4533:4533",
            "--env",
            "ND_CONFIGFILE=/config/navidrome.toml",
            "--env",
            "TZ=UTC",
            "--volume",
            f"{root / 'config/navidrome.toml'}:/config/navidrome.toml:ro",
            "--volume",
            f"{root / 'music'}:/music:ro",
            "--mount",
            f"type=volume,source={data_volume_name(root)},target=/data",
            "--volume",
            f"{root / 'cache'}:/cache",
            image,
        ]
    )


def health_check(root: Path, name: str) -> None:
    environment = os.environ.copy()
    environment["TZ"] = "UTC"
    run(
        [
            str(TOOLS / "health-check"),
            "--base-url",
            "http://127.0.0.1:4533",
            "--runtime",
            "linux/amd64",
            "--runtime-command-json",
            json.dumps(["docker", "exec", name, "uname", "-s", "-m"]),
            "--expected-server-version",
            pin("navidrome.version"),
            "--expected-ffmpeg-version",
            pin("ffmpeg.linux.version"),
            "--ffmpeg-command-json",
            json.dumps(["docker", "exec", name, pin("ffmpeg.linux.path")]),
            "--corpus-manifest",
            str(root / "music/corpus-manifest.json"),
        ],
        environment=environment,
    )


def up(root: Path) -> None:
    initialize_root(root)
    down(root)
    require_available_loopback_ports()
    clear_directory(root, "cache")
    image = pin("navidrome.linux.image")
    reset_data_volume(root, image)
    ensure_corpus(root, image)
    architecture = run(
        ["docker", "image", "inspect", image, "--format", "{{.Architecture}}"],
        capture=True,
    ).stdout.strip()
    if architecture != pin("navidrome.linux.architecture"):
        raise RuntimeError(f"pinned image architecture mismatch: {architecture}")
    render_configuration(root)
    name = container_name(root)
    try:
        start_auxiliary(root)
        wait_for_url("http://127.0.0.1:4540/health")
        wait_for_url("https://127.0.0.1:4542/health", insecure=True)
        wait_for_url("http://127.0.0.1:4543/health")
        start_container(root, image, name)
        health_check(root, name)
    except Exception:
        stop_container(name)
        stop_auxiliary(root)
        raise
    state = {
        "schema": 1,
        "container": name,
        "image": image,
        "root": str(root),
        "cold_started_at": time.time(),
    }
    (root / "state.json").write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
    print(f"conformance environment up cold: root={root} container={name}")
    print("run tests: tools/conformance-env/linux-local run -- ./gradlew --no-daemon :core-conformance:jvmTest")


def conformance_environment() -> dict[str, str]:
    return {
        "TZ": "UTC",
        "DULCET_CONFORMANCE_BASE_URL": "http://127.0.0.1:4533",
        "DULCET_REDIRECT_CONFORMANCE_ROOT": "http://127.0.0.1:4540",
        "DULCET_UNTRUSTED_TLS_URL": "https://127.0.0.1:4542",
        "DULCET_CONFORMANCE_DISPOSABLE": "true",
    }


def run_test_command(root: Path, command: list[str]) -> int:
    require_root(root)
    name = container_name(root)
    require_running_container(name)
    if not command:
        raise RuntimeError("run requires a command after --")
    environment = os.environ.copy()
    environment.update(conformance_environment())
    return subprocess.run(command, env=environment, check=False).returncode


def print_environment() -> None:
    for key, value in conformance_environment().items():
        print(f"export {key}={value}")


def observe_transcode_cache(root: Path, *, expected_cached: bool | None = None) -> int:
    require_root(root)
    name = container_name(root)
    require_running_container(name)
    command = [str(TOOLS / "observe-transcode-cache"), "--container", name]
    if expected_cached is not None:
        command.extend(("--expect-cached", str(expected_cached).lower()))
    return subprocess.run(
        command,
        env={**os.environ, **conformance_environment()},
        check=False,
    ).returncode


def reset_transcode_cache(root: Path) -> int:
    require_root(root)
    name = container_name(root)
    require_running_container(name)
    subprocess.run(
        ["docker", "stop", "--timeout", "5", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    cleared = subprocess.run(
        [str(TOOLS / "reset-transcode-cache"), "--root", str(root)],
        env={**os.environ, **conformance_environment()},
        check=False,
    )
    if cleared.returncode != 0:
        return cleared.returncode
    run(["docker", "start", name])
    wait_for_url("http://127.0.0.1:4533/app/")
    return observe_transcode_cache(root, expected_cached=False)


def run_apple_conformance(root: Path, ios_simulator_udid: str, tvos_simulator_udid: str) -> int:
    require_root(root)
    name = container_name(root)
    require_running_container(name)
    environment = {**os.environ, **conformance_environment()}
    for key, value in conformance_environment().items():
        if key.startswith("DULCET_"):
            environment[f"SIMCTL_CHILD_{key}"] = value

    runs = (
        ("macosArm64", [":core-conformance:macosArm64Test"]),
        (
            "iosSimulatorArm64",
            [
                ":core-conformance:iosSimulatorArm64Test",
                f"-Pdulcet.iosSimulatorUdid={ios_simulator_udid}",
            ],
        ),
        (
            "tvosSimulatorArm64",
            [
                ":core-conformance:tvosSimulatorArm64Test",
                f"-Pdulcet.tvosSimulatorUdid={tvos_simulator_udid}",
            ],
        ),
    )
    for platform, arguments in runs:
        print(f"resetting transcode cache before {platform}", flush=True)
        if reset_transcode_cache(root) != 0:
            return 1
        result = subprocess.run(
            [str(REPOSITORY / "gradlew"), "--no-daemon", *arguments],
            cwd=REPOSITORY,
            env=environment,
            check=False,
        )
        if result.returncode != 0:
            return result.returncode
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", help=f"disposable root (default: {DEFAULT_ROOT})")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("up", help="start from cold data/cache, reusing the generated corpus")
    subparsers.add_parser(
        "reset",
        help="reset only the live transcode cache and prove the fixed probe reports cached=false",
    )
    subparsers.add_parser("down", help="stop the declared disposable instance")
    subparsers.add_parser("env", help="print the exact conformance environment")
    subparsers.add_parser(
        "probe-cache",
        help="run one fixed transcode request and report the server's cached=true/false observation",
    )
    run_parser = subparsers.add_parser("run", help="run a command with the exact conformance environment")
    run_parser.add_argument("test_command", nargs=argparse.REMAINDER)
    apple_parser = subparsers.add_parser(
        "run-apple",
        help="run macOS, iOS simulator, and tvOS simulator conformance cold against one instance",
    )
    apple_parser.add_argument("--ios-simulator-udid", required=True)
    apple_parser.add_argument("--tvos-simulator-udid", required=True)
    args = parser.parse_args()
    root = resolve_root(args.root)
    try:
        if args.command == "up":
            up(root)
        elif args.command == "reset":
            return reset_transcode_cache(root)
        elif args.command == "down":
            down(root)
        elif args.command == "env":
            print_environment()
        elif args.command == "probe-cache":
            return observe_transcode_cache(root)
        elif args.command == "run":
            command = args.test_command
            if command[:1] == ["--"]:
                command = command[1:]
            return run_test_command(root, command)
        elif args.command == "run-apple":
            return run_apple_conformance(
                root,
                args.ios_simulator_udid,
                args.tvos_simulator_udid,
            )
    except (OSError, RuntimeError) as error:
        print(f"linux conformance environment error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
