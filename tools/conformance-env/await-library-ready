#!/usr/bin/env python3
"""Block until a conformance Navidrome's library is actually queryable.

HTTP readiness is not library readiness. Navidrome answers /app/ within a second of starting and
then runs its scan asynchronously. Killing it for the next cold restart while that scan is in
flight produces `Scan failed error="library count: context canceled"` and leaves the following test
run against an empty library -- which surfaces as a dozen unrelated conformance failures rather
than as an environment fault. OBSERVED on apple-ci 2026-08-30.

Waiting on the scan boolean alone is not enough either: `scanning: false` is also true before a scan
has started. Navidrome 0.63.2 exposes the newest library's successful ScanEnd timestamp as
`scanStatus.lastScan`, so callers snapshot that field before restart and this tool requires it to
advance. It then requires a non-zero count and a query that actually returns rows, because a database
can report a completed scan and still fail every query (see V23).
"""

from __future__ import annotations

import argparse
from datetime import datetime
import hashlib
import secrets
import sys
import time
import urllib.error
import urllib.parse

from readiness_transport import TRANSPORT_ERRORS, read_json

ADMIN_USER = "dulcet-admin"
ADMIN_PASSWORD = "dulcet-ci-canary-password"
# One request's budget, shared by both modes. It is deliberately NOT derived from the remaining
# overall deadline: an attempt handed "whatever is left" spends the whole window, and a loop that
# makes one attempt is not a poll. `--timeout-seconds` bounds when a NEW attempt may start, so the
# worst case is the deadline plus one request.
#
# Neither budget is raised here. MEASURED, 167 apple-ci job logs 2026-09-02..2026-09-10: the widest
# restart-readiness window in the corpus is 90.9 s (`TRANSCODE CACHE CLEARED` ->
# `TRANSCODE CACHE OBSERVATION`, restart #2), and the 180 s default already covers it with room.
# What was wrong was the SHAPE of the budget and the diagnosis on exhaustion, not its size.
DEFAULT_REQUEST_TIMEOUT_SECONDS = 15.0


def call(
    base_url: str,
    endpoint: str,
    *,
    timeout_seconds: float = DEFAULT_REQUEST_TIMEOUT_SECONDS,
    **parameters: str,
) -> dict:
    salt = secrets.token_hex(16)
    token = hashlib.md5((ADMIN_PASSWORD + salt).encode()).hexdigest()
    query = {
        "u": ADMIN_USER, "t": token, "s": salt,
        "v": "1.16.1", "c": "dulcet-await-library", "f": "json",
    }
    query.update(parameters)
    url = f"{base_url}/rest/{endpoint}?" + urllib.parse.urlencode(query)
    return read_json(url, timeout_seconds)["subsonic-response"]


def parse_last_scan(value: object) -> tuple[str, datetime]:
    if not isinstance(value, str) or not value:
        raise ValueError(f"scan status did not carry lastScan: {value!r}")
    normalized = value[:-1] + "+00:00" if value.endswith("Z") else value
    parsed = datetime.fromisoformat(normalized)
    if parsed.tzinfo is None:
        raise ValueError(f"scan status lastScan is not timezone-aware: {value!r}")
    return value, parsed


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", required=True)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument(
        "--print-last-scan",
        action="store_true",
        help="print the current completed-scan timestamp for use as a restart baseline",
    )
    mode.add_argument(
        "--after-last-scan",
        help="wait for a successful completed-scan timestamp later than this baseline",
    )
    parser.add_argument("--timeout-seconds", type=float, default=180.0)
    parser.add_argument("--poll-interval-seconds", type=float, default=1.0)
    parser.add_argument(
        "--request-timeout-seconds",
        type=float,
        default=DEFAULT_REQUEST_TIMEOUT_SECONDS,
        help="budget for ONE request; must be strictly smaller than --timeout-seconds",
    )
    arguments = parser.parse_args()

    if arguments.timeout_seconds <= 0:
        parser.error("--timeout-seconds must be greater than zero")
    if arguments.poll_interval_seconds <= 0:
        parser.error("--poll-interval-seconds must be greater than zero")
    if arguments.request_timeout_seconds <= 0:
        parser.error("--request-timeout-seconds must be greater than zero")
    # A per-request budget at or above the overall one leaves no room for a second attempt, so the
    # loop degrades into a single request while still reading like a poll. Refuse the shape rather
    # than trusting the numbers to stay apart.
    if arguments.request_timeout_seconds >= arguments.timeout_seconds:
        parser.error(
            "--request-timeout-seconds must be strictly smaller than --timeout-seconds, or the "
            f"poll can only ever make one attempt: request={arguments.request_timeout_seconds}s "
            f"overall={arguments.timeout_seconds}s"
        )

    if arguments.print_last_scan:
        started = time.monotonic()
        deadline = started + arguments.timeout_seconds
        response = None
        attempts = 0
        last = "no observation"
        while time.monotonic() < deadline:
            attempts += 1
            try:
                response = call(
                    arguments.base_url, "getScanStatus",
                    timeout_seconds=arguments.request_timeout_seconds,
                )
                break
            except urllib.error.HTTPError:
                # HTTP responses are failures, not a missing transport response.
                raise
            except TRANSPORT_ERRORS as error:
                last = str(error) or type(error).__name__
                print(
                    f"scan baseline transport error; retrying (attempt {attempts}): {last}",
                    file=sys.stderr,
                )
                time.sleep(min(arguments.poll_interval_seconds, max(0, deadline - time.monotonic())))
        if response is None:
            # Match the sibling below: name what was being waited on and how hard it was tried. A
            # bare `TimeoutError: timed out` traceback says neither, and reads as a tool defect.
            print(
                f"scan baseline never answered within {arguments.timeout_seconds}s: "
                f"attempts={attempts} elapsed_seconds={time.monotonic() - started:.3f} "
                f"request_timeout_seconds={arguments.request_timeout_seconds} last={last}",
                file=sys.stderr,
            )
            raise SystemExit(1)
        status = response.get("scanStatus", {})
        if error := status.get("error"):
            raise SystemExit(f"library scan status reported an error: {error}")
        value, _ = parse_last_scan(status.get("lastScan"))
        print(value)
        return

    baseline_value, baseline = parse_last_scan(arguments.after_last_scan)

    started = time.monotonic()
    deadline = started + arguments.timeout_seconds
    last = "no observation"
    attempts = 0
    while time.monotonic() < deadline:
        attempts += 1
        try:
            status = call(
                arguments.base_url, "getScanStatus",
                timeout_seconds=arguments.request_timeout_seconds,
            ).get("scanStatus", {})
            scanning = bool(status.get("scanning"))
            count = int(status.get("count") or 0)
            if error := status.get("error"):
                raise SystemExit(f"library scan status reported an error: {error}")
            current_value, current = parse_last_scan(status.get("lastScan"))
            advanced = current > baseline
            if not scanning and advanced and count > 0:
                albums = call(
                    arguments.base_url, "getAlbumList2",
                    timeout_seconds=arguments.request_timeout_seconds,
                    type="alphabeticalByName", size="1",
                ).get("albumList2", {}).get("album", [])
                if albums:
                    print(
                        f"library ready: scanning=false lastScan={current_value} "
                        f"advanced_from={baseline_value} count={count} queryable_albums>=1 "
                        f"attempts={attempts} "
                        f"elapsed_seconds={time.monotonic() - started:.3f}"
                    )
                    return
                last = f"scan complete (count={count}) but getAlbumList2 returned no rows"
            else:
                last = (
                    f"scanning={scanning} lastScan={current_value} "
                    f"advanced={str(advanced).lower()} count={count}"
                )
        except Exception as error:  # noqa: BLE001 - report whatever the server did
            last = f"probe error: {error}"
        time.sleep(min(arguments.poll_interval_seconds, max(0, deadline - time.monotonic())))

    print(
        f"library never became queryable within {arguments.timeout_seconds}s: attempts={attempts} "
        f"elapsed_seconds={time.monotonic() - started:.3f} {last}",
        file=sys.stderr,
    )
    raise SystemExit(1)


if __name__ == "__main__":
    main()
