#!/usr/bin/env python3

import argparse
from pathlib import Path


TOKENS = {
    "@MUSIC_FOLDER@": "music_folder",
    "@DATA_FOLDER@": "data_folder",
    "@CACHE_FOLDER@": "cache_folder",
    "@ADDRESS@": "address",
    "@FFMPEG_PATH@": "ffmpeg_path",
    "@PORT@": "port",
}

# The fixture configuration purges missing files. Navidrome's own default keeps them, and a reader
# must hold its gone-ness rules under both (design spec §16.11), so the second configuration is the
# fixture with exactly this line removed -- never a separately maintained template that could drift.
PURGE_MISSING_ALWAYS = 'PurgeMissing = "always"\n'


def main() -> None:
    parser = argparse.ArgumentParser(description="Render the checked-in Navidrome configuration.")
    parser.add_argument("--output", required=True)
    parser.add_argument("--music-folder", required=True)
    parser.add_argument("--data-folder", required=True)
    parser.add_argument("--cache-folder", required=True)
    parser.add_argument("--address", required=True)
    parser.add_argument("--ffmpeg-path", required=True)
    parser.add_argument("--port", type=int, default=4533)
    parser.add_argument(
        "--purge-missing",
        choices=("always", "server-default"),
        default="always",
        help="'always' is the fixture; 'server-default' leaves PurgeMissing unset",
    )
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        raise SystemExit("port is outside the valid range")

    values = {key: str(value) for key, value in vars(args).items()}
    text = (Path(__file__).parent / "navidrome.toml.template").read_text()
    for token, argument in TOKENS.items():
        value = values[argument]
        if any(character in value for character in ('"', "\n", "\r")):
            raise SystemExit(f"unsafe value for {argument}")
        text = text.replace(token, value)
    if "@" in text:
        raise SystemExit("unresolved configuration token")
    if text.count(PURGE_MISSING_ALWAYS) != 1:
        raise SystemExit("template must set PurgeMissing exactly once")
    if args.purge_missing == "server-default":
        text = text.replace(PURGE_MISSING_ALWAYS, "")
        if "PurgeMissing" in text:
            raise SystemExit("server-default configuration still names PurgeMissing")

    output = Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(text)
    print(f"rendered deterministic Navidrome config: {output}")


if __name__ == "__main__":
    main()
