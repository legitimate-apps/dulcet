#!/usr/bin/env python3
"""A forwarding proxy in front of the disposable server that can fail one song's lyrics read.

It can also hold one playlist's reads -- see "Holding a playlist read" below --, drop every
request for a while -- see "An outage" below --, count, hold or fail the reader's requests --
see "Counting" below -- and lose one create's answer -- see "Losing a create's answer".

The Apple lyrics proofs need a lyrics read that fails, then succeeds when the person presses Try
Again (spec §18.4). The disposable server answers every lyrics read, and nothing about the corpus
can make one fail on demand, so this proxy sits in front of it for those proofs alone: every
request is forwarded unchanged to the upstream server, except `getLyricsBySongId` for a song a test
has armed, which is answered with HTTP 500 until the test disarms it.

A test drives it over plain HTTP on the same port, outside `/rest`:

    GET  /__dulcet/health                      {"ok": true}
    POST /__dulcet/lyrics-failure?song=<id>&state=on|off
    GET  /__dulcet/observations?song=<id>      {"armed": bool, "failed": n, "forwardedAfterDisarm": n}

`failed` counts the reads this proxy failed for the song since it was last armed, and
`forwardedAfterDisarm` the reads it forwarded for the song after the last disarm. Both start again
from zero, so each of several proofs sharing one proxy sees only its own reads. A proof can then
show it met the failure it handles and that its retry sent a new read -- not only that the screen
ended up right.

Holding a playlist read: the Apple playlist proofs need a playlist page whose own read lands at a
moment the test chooses -- after the playlist was deleted elsewhere and while the person is typing a
new name -- because the order of those two events decides which path reports the failed rename
(spec §18.6). A held `getPlaylist` for the armed id is kept waiting, unanswered and not yet sent
upstream, until the test releases it; then it is forwarded unchanged and the server answers it.
Every other request passes straight through, and a hold never outlives HOLD_LIMIT_SECONDS.

    POST /__dulcet/playlist-hold?playlist=<id>&state=on|off
    GET  /__dulcet/playlist-observations?playlist=<id>
         {"holding": bool, "held": n, "released": n, "timedOut": n}

`held` counts the reads that arrived while the hold was on, `released` those forwarded because the
test released them, and `timedOut` those forwarded only because the limit passed. Arming starts all
three from zero.

An outage: the Apple playlist pending-state proofs need the server to go away while the app is
open, and come back (spec §18.6). During an outage every `/rest` request is dropped -- its
connection reset with no answer, as a server that went away leaves it -- until the test ends it.
The controls keep answering throughout.

    POST /__dulcet/outage?state=on|off
    GET  /__dulcet/outage    {"outage": bool, "dropped": {endpoint: n}, "forwardedAfterOutage": {endpoint: n}}

`dropped` counts, by endpoint name, the requests dropped since the outage began, and
`forwardedAfterOutage` those forwarded since it last ended. Each switch starts its count from zero,
so a proof can show that its edit met the outage and was sent after it.

Counting: the Apple reader proofs (CONF-76, CONF-77, CONF-86) count what the app sends, in order,
and hold or fail chosen requests, as the Android app tests' counting proxy does. Every `/rest`
request is logged as its endpoint name (without `.view`), its `type` and `id` parameters when it has
them -- neither carries a credential --, whether it has been answered, and the status the app got
(0 for a request dropped unanswered).

    GET  /__dulcet/requests?since=<n>
         {"total": n, "requests": [{"endpoint": e, "type": t, "id": i, "answered": bool, "status": s}, ...]}
    POST /__dulcet/rule?action=hold|fail&state=on&endpoint=<e>[&type=<t>]
    POST /__dulcet/rule?action=hold|fail&state=off
         {"hold": {"endpoint": e, "type": t} | null, "fail": ... | null, "held": n}

`since` is an index into the whole log, so a proof marks the log's `total` and reads what came
after. A hold rule keeps every matching request unanswered until the rule is switched off (or the
hold limit passes); a fail rule answers every matching request with a 500 and no body, a server
error rather than an unreachable server. `type` narrows a rule to one `getAlbumList2` order. One rule
of each action at a time; switching it on again replaces it.

Losing a create's answer: the Apple proofs of a create in doubt need a `createPlaylist` the server
applies whose answer never reaches the app (spec §18.6), which no server does on demand. Armed for a
playlist name, the next `createPlaylist` of that name is forwarded upstream and the server's answer
read and dropped; the app is answered HTTP 502 with a gateway's HTML page instead, which proves
nothing about whether the create landed. One create is lost per arming, and the arming then ends.

    POST /__dulcet/create-answer-loss?name=<name>&state=on|off
    GET  /__dulcet/create-observations?name=<name>   {"armed": bool, "lost": n, "creates": n}

`lost` counts the answers dropped, and `creates` every `createPlaylist` of that name forwarded, lost
or not, since it was last armed; a proof shows from it that the app never sent the create again.

Requests carry credentials in their query strings, so nothing here ever prints a request line,
a query or a header: the base handler's request log is silenced, and the only output is the
listening line and the names of the endpoints that were failed.
"""

from __future__ import annotations

import argparse
import contextlib
import http.client
import json
import socket
import struct
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlsplit

LYRICS_ENDPOINTS = {"getLyricsBySongId", "getLyricsBySongId.view"}
PLAYLIST_ENDPOINTS = {"getPlaylist", "getPlaylist.view"}
CREATE_ENDPOINTS = {"createPlaylist", "createPlaylist.view"}
# Longer than any proof keeps a read waiting, shorter than the app's own request timeout.
HOLD_LIMIT_SECONDS = 45
# Hop-by-hop headers (RFC 9110 §7.6.1) are this connection's, never forwarded.
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer",
    "transfer-encoding", "upgrade", "proxy-connection",
}
CHUNK = 64 * 1024


class FaultState:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.armed: set[str] = set()
        self.failed: dict[str, int] = {}
        self.forwarded_after_disarm: dict[str, int] = {}
        self.holds: dict[str, threading.Event] = {}
        self.held: dict[str, int] = {}
        self.released: dict[str, int] = {}
        self.timed_out: dict[str, int] = {}
        self.losing: set[str] = set()
        self.lost: dict[str, int] = {}
        self.creates: dict[str, int] = {}
        self.outage = False
        self.dropped: dict[str, int] = {}
        self.forwarded_after_outage: dict[str, int] = {}
        self.log: list[dict[str, object]] = []
        self.rules: dict[str, tuple[str, str | None] | None] = {"hold": None, "fail": None}
        self.rule_gate = threading.Event()
        self.rule_held = 0

    def record(self, endpoint: str, fields: dict[str, list[str]]) -> dict[str, object]:
        """Logs a `/rest` request by its endpoint and its `type` and `id`, never anything else."""
        entry: dict[str, object] = {"endpoint": endpoint, "answered": False, "status": 0}
        for name in ("type", "id"):
            if fields.get(name):
                entry[name] = fields[name][0]
        with self.lock:
            self.log.append(entry)
        return entry

    def answered(self, entry: dict[str, object], status: int) -> None:
        with self.lock:
            entry["answered"] = True
            entry["status"] = status

    def requests(self, since: int) -> dict[str, object]:
        with self.lock:
            return {"total": len(self.log), "requests": [dict(entry) for entry in self.log[since:]]}

    def set_rule(self, action: str, endpoint: str | None, list_type: str | None) -> None:
        with self.lock:
            self.rules[action] = (endpoint, list_type) if endpoint else None
            if action == "hold":
                # Whatever the old rule held goes on; a new rule holds from now.
                self.rule_gate.set()
                self.rule_gate = threading.Event()
                if endpoint is not None:
                    self.rule_held = 0

    def matches(self, action: str, entry: dict[str, object]) -> bool:
        with self.lock:
            rule = self.rules[action]
        return rule is not None and entry["endpoint"] == rule[0] and (rule[1] is None or entry.get("type") == rule[1])

    def hold_gate(self, entry: dict[str, object]) -> threading.Event | None:
        if not self.matches("hold", entry):
            return None
        with self.lock:
            self.rule_held += 1
            return self.rule_gate

    def rule_observations(self) -> dict[str, object]:
        with self.lock:
            def shown(rule: tuple[str, str | None] | None) -> dict[str, object] | None:
                return None if rule is None else {"endpoint": rule[0], "type": rule[1]}
            return {"hold": shown(self.rules["hold"]), "fail": shown(self.rules["fail"]), "held": self.rule_held}

    def lose_create(self, name: str, on: bool) -> None:
        with self.lock:
            if on:
                self.losing.add(name)
                self.lost[name] = 0
                self.creates[name] = 0
            else:
                self.losing.discard(name)

    def create_forwarded(self, name: str | None) -> bool:
        """Counts a create of `name` and returns whether its answer is the one to lose."""
        with self.lock:
            if name is None or name not in self.creates:
                return False
            self.creates[name] += 1
            if name in self.losing:
                self.losing.discard(name)
                self.lost[name] += 1
                return True
            return False

    def create_observations(self, name: str) -> dict[str, object]:
        with self.lock:
            return {"armed": name in self.losing, "lost": self.lost.get(name, 0), "creates": self.creates.get(name, 0)}

    def set_outage(self, on: bool) -> None:
        with self.lock:
            self.outage = on
            if on:
                self.dropped = {}
            else:
                self.forwarded_after_outage = {}

    def admit(self, endpoint: str) -> bool:
        """Whether a `/rest` request for `endpoint` is forwarded; counted either way."""
        with self.lock:
            counts = self.dropped if self.outage else self.forwarded_after_outage
            counts[endpoint] = counts.get(endpoint, 0) + 1
            return not self.outage

    def outage_observations(self) -> dict[str, object]:
        with self.lock:
            return {
                "outage": self.outage,
                "dropped": dict(self.dropped),
                "forwardedAfterOutage": dict(self.forwarded_after_outage),
            }

    def hold(self, playlist: str, on: bool) -> None:
        with self.lock:
            if on:
                self.holds[playlist] = threading.Event()
                self.held[playlist] = 0
                self.released[playlist] = 0
                self.timed_out[playlist] = 0
            else:
                gate = self.holds.pop(playlist, None)
                if gate is not None:
                    gate.set()

    def gate(self, playlist: str | None) -> threading.Event | None:
        """The hold a read must wait on, counted as held; None when it is not held."""
        with self.lock:
            gate = self.holds.get(playlist) if playlist is not None else None
            if gate is not None:
                self.held[playlist] = self.held.get(playlist, 0) + 1
            return gate

    def passed(self, playlist: str, released: bool) -> None:
        with self.lock:
            counts = self.released if released else self.timed_out
            counts[playlist] = counts.get(playlist, 0) + 1

    def playlist_observations(self, playlist: str) -> dict[str, object]:
        with self.lock:
            return {
                "holding": playlist in self.holds,
                "held": self.held.get(playlist, 0),
                "released": self.released.get(playlist, 0),
                "timedOut": self.timed_out.get(playlist, 0),
            }

    def arm(self, song: str, on: bool) -> None:
        with self.lock:
            if on:
                self.armed.add(song)
                self.failed[song] = 0
            else:
                self.armed.discard(song)
                self.forwarded_after_disarm[song] = 0

    def should_fail(self, song: str | None) -> bool:
        with self.lock:
            if song is None:
                return False
            if song in self.armed:
                self.failed[song] = self.failed.get(song, 0) + 1
                return True
            if song in self.forwarded_after_disarm:
                self.forwarded_after_disarm[song] += 1
            return False

    def observations(self, song: str) -> dict[str, object]:
        with self.lock:
            return {
                "armed": song in self.armed,
                "failed": self.failed.get(song, 0),
                "forwardedAfterDisarm": self.forwarded_after_disarm.get(song, 0),
            }


def rest_endpoint(path: str) -> str:
    """The endpoint a `/rest` path names, without a `.view` suffix: `/rest/ping.view` is `ping`."""
    name = path[len("/rest/"):].split("/", 1)[0]
    return name[:-len(".view")] if name.endswith(".view") else name


def request_fields(query: str, body: bytes, content_type: str) -> dict[str, list[str]]:
    """A request's parameters, from its query and its form body."""
    fields = parse_qs(query)
    if content_type.split(";", 1)[0].strip().lower() == "application/x-www-form-urlencoded":
        for name, values in parse_qs(body.decode("utf-8", "replace")).items():
            fields.setdefault(name, []).extend(values)
    return fields


def lyrics_song(path: str, query: str, body: bytes, content_type: str) -> str | None:
    """The song id of a `getLyricsBySongId` request, from its query or its form body; else None."""
    return request_id(LYRICS_ENDPOINTS, path, query, body, content_type)


def playlist_read(path: str, query: str, body: bytes, content_type: str) -> str | None:
    """The playlist id of a `getPlaylist` request, from its query or its form body; else None."""
    return request_id(PLAYLIST_ENDPOINTS, path, query, body, content_type)


def create_name(path: str, query: str, body: bytes, content_type: str) -> str | None:
    """The new playlist's name of a `createPlaylist` request, from its query or form body; else None."""
    if not path.startswith("/rest/") or path[len("/rest/"):] not in CREATE_ENDPOINTS:
        return None
    names = request_fields(query, body, content_type).get("name") or []
    return names[0] if names else None


def request_id(endpoints: set[str], path: str, query: str, body: bytes, content_type: str) -> str | None:
    if not path.startswith("/rest/") or path[len("/rest/"):] not in endpoints:
        return None
    ids = request_fields(query, body, content_type).get("id") or []
    return ids[0] if ids else None


class ProxyHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server: "ProxyServer"

    def log_message(self, _format: str, *_args: object) -> None:
        # The base handler logs the request line, and the request line carries credentials.
        return

    def do_GET(self) -> None:  # noqa: N802
        self._handle()

    def do_POST(self) -> None:  # noqa: N802
        self._handle()

    def do_HEAD(self) -> None:  # noqa: N802
        self._handle()

    def _handle(self) -> None:
        parts = urlsplit(self.path)
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length > 0 else b""
        if parts.path.startswith("/__dulcet/"):
            self._control(parts.path, parse_qs(parts.query))
            return
        state = self.server.state
        entry = None
        if parts.path.startswith("/rest/"):
            endpoint = rest_endpoint(parts.path)
            entry = state.record(endpoint, request_fields(parts.query, body, self.headers.get("Content-Type", "")))
            if not state.admit(endpoint):
                state.answered(entry, 0)
                self._drop()
                return
            gate = state.hold_gate(entry)
            if gate is not None:
                gate.wait(HOLD_LIMIT_SECONDS)
            if state.matches("fail", entry):
                print(f"LYRICS FAULT PROXY failed {parts.path} by rule", flush=True)
                self._send_status(500)
                state.answered(entry, 500)
                return
        song = lyrics_song(parts.path, parts.query, body, self.headers.get("Content-Type", ""))
        if state.should_fail(song):
            print(f"LYRICS FAULT PROXY failed {parts.path}", flush=True)
            self._send_json(500, {"error": "lyrics read failed by the fault proxy"})
            if entry is not None:
                state.answered(entry, 500)
            return
        playlist = playlist_read(parts.path, parts.query, body, self.headers.get("Content-Type", ""))
        gate = self.server.state.gate(playlist)
        if gate is not None:
            released = gate.wait(HOLD_LIMIT_SECONDS)
            self.server.state.passed(playlist, released)
            print(f"LYRICS FAULT PROXY held {parts.path} until {'released' if released else 'the limit'}", flush=True)
        name = create_name(parts.path, parts.query, body, self.headers.get("Content-Type", ""))
        status = self._forward(body, lose_answer=self.server.state.create_forwarded(name))
        if entry is not None:
            state.answered(entry, status)

    def _control(self, path: str, query: dict[str, list[str]]) -> None:
        if path == "/__dulcet/health":
            self._send_json(200, {"ok": True})
            return
        if path in {"/__dulcet/playlist-hold", "/__dulcet/playlist-observations"}:
            self._playlist_control(path, query)
            return
        if path in {"/__dulcet/create-answer-loss", "/__dulcet/create-observations"}:
            self._create_control(path, query)
            return
        if path == "/__dulcet/requests":
            since = (query.get("since") or ["0"])[0]
            if not since.isdigit():
                self._send_json(400, {"error": "since must be a log index"})
                return
            self._send_json(200, self.server.state.requests(int(since)))
            return
        if path == "/__dulcet/rule":
            self._rule_control(query)
            return
        if path == "/__dulcet/outage":
            if self.command == "POST":
                state = (query.get("state") or [""])[0]
                if state not in {"on", "off"}:
                    self._send_json(400, {"error": "state must be on or off"})
                    return
                self.server.state.set_outage(state == "on")
                print(f"LYRICS FAULT PROXY outage {state}", flush=True)
            self._send_json(200, self.server.state.outage_observations())
            return
        song = (query.get("song") or [""])[0]
        if not song:
            self._send_json(400, {"error": "song is required"})
            return
        if path == "/__dulcet/lyrics-failure" and self.command == "POST":
            state = (query.get("state") or [""])[0]
            if state not in {"on", "off"}:
                self._send_json(400, {"error": "state must be on or off"})
                return
            self.server.state.arm(song, state == "on")
            self._send_json(200, self.server.state.observations(song))
            return
        if path == "/__dulcet/observations":
            self._send_json(200, self.server.state.observations(song))
            return
        self._send_json(404, {"error": "unknown control"})

    def _rule_control(self, query: dict[str, list[str]]) -> None:
        if self.command != "POST":
            self._send_json(404, {"error": "unknown control"})
            return
        action = (query.get("action") or [""])[0]
        state = (query.get("state") or [""])[0]
        endpoint = (query.get("endpoint") or [""])[0]
        if action not in {"hold", "fail"} or state not in {"on", "off"} or (state == "on") != bool(endpoint):
            self._send_json(400, {"error": "action must be hold or fail; state on needs an endpoint, state off takes none"})
            return
        list_type = (query.get("type") or [None])[0] if state == "on" else None
        self.server.state.set_rule(action, endpoint if state == "on" else None, list_type)
        print(f"LYRICS FAULT PROXY rule {action} {state}", flush=True)
        self._send_json(200, self.server.state.rule_observations())

    def _playlist_control(self, path: str, query: dict[str, list[str]]) -> None:
        playlist = (query.get("playlist") or [""])[0]
        if not playlist:
            self._send_json(400, {"error": "playlist is required"})
            return
        if path == "/__dulcet/playlist-hold":
            if self.command != "POST":
                self._send_json(404, {"error": "unknown control"})
                return
            state = (query.get("state") or [""])[0]
            if state not in {"on", "off"}:
                self._send_json(400, {"error": "state must be on or off"})
                return
            self.server.state.hold(playlist, state == "on")
        self._send_json(200, self.server.state.playlist_observations(playlist))

    def _create_control(self, path: str, query: dict[str, list[str]]) -> None:
        name = (query.get("name") or [""])[0]
        if not name:
            self._send_json(400, {"error": "name is required"})
            return
        if path == "/__dulcet/create-answer-loss":
            if self.command != "POST":
                self._send_json(404, {"error": "unknown control"})
                return
            state = (query.get("state") or [""])[0]
            if state not in {"on", "off"}:
                self._send_json(400, {"error": "state must be on or off"})
                return
            self.server.state.lose_create(name, state == "on")
        self._send_json(200, self.server.state.create_observations(name))

    def _forward(self, body: bytes, lose_answer: bool = False) -> int:
        """Forwards the request and relays the answer -- or, with `lose_answer`, a gateway's 502 in
        its place; returns the status the app got."""
        upstream = http.client.HTTPConnection(self.server.upstream_host, self.server.upstream_port, timeout=60)
        try:
            headers = {
                name: value for name, value in self.headers.items()
                if name.lower() not in HOP_BY_HOP and name.lower() != "host"
            }
            headers["Host"] = f"{self.server.upstream_host}:{self.server.upstream_port}"
            upstream.request(self.command, self.path, body=body or None, headers=headers)
            response = upstream.getresponse()
            if lose_answer:
                # The server has applied it; the app hears only that a gateway failed.
                response.read()
                print(f"LYRICS FAULT PROXY lost the answer to {urlsplit(self.path).path}", flush=True)
                page = b"<html><body>502 Bad Gateway</body></html>"
                self.send_response(502, "Bad Gateway")
                self.send_header("Content-Type", "text/html")
                self.send_header("Content-Length", str(len(page)))
                self.end_headers()
                if self.command != "HEAD":
                    self.wfile.write(page)
                return 502
            self.send_response(response.status, response.reason)
            length = response.getheader("Content-Length")
            for name, value in response.getheaders():
                if name.lower() not in HOP_BY_HOP:
                    self.send_header(name, value)
            # Without a length the body ends when the connection does.
            self.send_header("Connection", "keep-alive" if length is not None else "close")
            self.end_headers()
            if self.command != "HEAD":
                while True:
                    chunk = response.read(CHUNK)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            if length is None:
                self.close_connection = True
            return response.status
        except (OSError, http.client.HTTPException) as error:
            # The kind only: an exception's text can carry the request, and so its credentials.
            print(f"LYRICS FAULT PROXY upstream error {type(error).__name__}", flush=True)
            self.close_connection = True
            try:
                self._send_json(502, {"error": "upstream unavailable"})
            except OSError:
                pass
            return 502
        finally:
            upstream.close()

    def _drop(self) -> None:
        """Resets the connection with no answer: a zero linger makes the handler's close a reset."""
        self.close_connection = True
        with contextlib.suppress(OSError):
            self.connection.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))

    def _send_status(self, status: int) -> None:
        self.send_response(status)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def _send_json(self, status: int, value: object) -> None:
        data = json.dumps(value, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)


class ProxyServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, port: int, upstream: str) -> None:
        target = urlsplit(upstream)
        if target.scheme != "http" or target.hostname not in {"127.0.0.1", "localhost"} or target.path not in {"", "/"}:
            raise SystemExit("lyrics-fault-proxy: the upstream must be a loopback http origin")
        super().__init__(("127.0.0.1", port), ProxyHandler)
        self.upstream_host = target.hostname
        self.upstream_port = target.port or 80
        self.state = FaultState()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--upstream", required=True, help="the disposable server's origin, e.g. http://127.0.0.1:4533")
    args = parser.parse_args()
    server = ProxyServer(args.port, args.upstream)
    print(f"LYRICS FAULT PROXY listening port={server.server_port} upstream-port={server.upstream_port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
