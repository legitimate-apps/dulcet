#!/usr/bin/env python3
"""Issue one fixed transcode request and report Navidrome's cache decision from its own log."""

from __future__ import annotations

import argparse
import hashlib
import http.client
import os
from pathlib import Path
import re
import secrets
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

from readiness_transport import TRANSPORT_ERRORS, read_json


ADMIN_USER = "dulcet-admin"
ADMIN_PASSWORD = "dulcet-ci-canary-password"
CLIENT = "dulcet-cache-observation"
SUBSONIC_VERSION = "1.16.1"
STREAM_LOG = 'msg="Streaming file"'
# A true end-to-end request deadline, enforced by ITIMER_REAL rather than urllib's per-socket-
# operation timeout. Overridable so the controls can exercise both timeout phases quickly.
STREAM_TIMEOUT_SECONDS = float(os.environ.get("DULCET_TRANSCODE_PROBE_TIMEOUT_SECONDS", "180"))

# --- the search that finds the probe track --------------------------------------------------
# The per-attempt timeout and the total deadline are INDEPENDENT budgets. Deriving the per-attempt
# timeout from the remaining deadline -- `min(10, deadline - now)`, which is what this loop used to
# do -- spends the entire window on attempt one and turns a poll into a single request.
#
# MEASURED, 167 apple-ci job logs 2026-09-02..2026-09-10: every one of the five
# `cache search transport error` failures printed exactly ONE transport-error line and exited
# immediately, 11.5 / 13.0 / 20.1 / 42.3 / 44.9 s after the preceding `library ready:`. So the loop
# never ran a second attempt, and the nominal five-second total bounded nothing either.
#
# SEARCH_DEADLINE_SECONDS is sized from the window this call actually runs in. Same corpus, n=137
# successful observations, taking (`library ready:` -> `TRANSCODE CACHE OBSERVATION`) minus the
# stream's own reported total_request_seconds as an UPPER bound on the search phase, at the second
# of the three restarts where that window is worst: median 0.795 s, p90 9.50 s, p95 30.17 s,
# p99 60.40 s, max 79.52 s. Sixty seconds covers p99 of that measured range. It is deliberately not
# the max: a window above it still FAILS, and now fails naming a stall.
#
# SEARCH_ATTEMPT_TIMEOUT_SECONDS is sized from the server side instead. Navidrome's own log shows
# it answers this exact query in 150-710 ms once the request reaches its handler (OBSERVED in the
# two failing runs whose server-side evidence survives in the log tail), and in those runs it began
# handling the request one to two seconds AFTER the client had already given up. Ten seconds is
# more than an order of magnitude above the handling time, so an attempt that exceeds it is starved
# rather than slow, and retiring it to try again is the right response.
#
# An attempt already in flight is not cut short by the total deadline -- only starting a NEW one is
# gated -- so the worst-case search phase is deadline + one attempt.
SEARCH_DEADLINE_SECONDS = float(
    os.environ.get("DULCET_TRANSCODE_SEARCH_DEADLINE_SECONDS", "60")
)
SEARCH_ATTEMPT_TIMEOUT_SECONDS = float(
    os.environ.get("DULCET_TRANSCODE_SEARCH_ATTEMPT_SECONDS", "10")
)
# A responsive server that answers without the probe track is reporting on the corpus, not on the
# transport, so it gets the original short settling window rather than the transport budget. This
# keeps a genuine absence failing in seconds instead of a minute.
SEARCH_CORPUS_SETTLE_SECONDS = float(
    os.environ.get("DULCET_TRANSCODE_SEARCH_SETTLE_SECONDS", "5")
)
SEARCH_POLL_INTERVAL_SECONDS = 0.05
# A transport failure can also be instantaneous (connection refused while the server is still
# coming up). Re-asking every 50 ms for a minute would emit ~1200 stderr lines and bury the one
# fact worth reading, so failed attempts back off. A STARVED attempt already costs its full
# per-attempt timeout, which is the case this budget exists for, so the backoff barely moves it.
SEARCH_RETRY_BACKOFF_SECONDS = (0.25, 0.5, 1.0, 2.0)


class StreamDeadlineExceeded(TimeoutError):
    def __init__(self, phase: str, elapsed: float) -> None:
        super().__init__(phase)
        self.phase = phase
        self.elapsed = elapsed


def subsonic_url(base_url: str, endpoint: str, parameters: dict[str, str]) -> str:
    salt = secrets.token_hex(8)
    token = hashlib.md5(
        (ADMIN_PASSWORD + salt).encode(), usedforsecurity=False
    ).hexdigest()
    query = urllib.parse.urlencode(
        {
            "u": ADMIN_USER,
            "t": token,
            "s": salt,
            "v": SUBSONIC_VERSION,
            "c": CLIENT,
            "f": "json",
            **parameters,
        }
    )
    return f"{base_url}/rest/{endpoint}.view?{query}"


def docker_logs(container: str) -> list[str]:
    result = subprocess.run(
        ["docker", "logs", container],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cannot read disposable container logs: {result.stdout.strip()}")
    return result.stdout.splitlines()


def file_logs(path: str) -> list[str]:
    try:
        return Path(path).read_text(errors="replace").splitlines()
    except OSError as error:
        raise RuntimeError(f"cannot read disposable Navidrome log {path}: {error}") from error


def streaming_logs(*, container: str | None, log_file: str | None) -> list[str]:
    lines = docker_logs(container) if container is not None else file_logs(log_file or "")
    return [line for line in lines if STREAM_LOG in line]


def read_stream_with_deadline(url: str, budget: float) -> tuple[bytes, bool, float, float]:
    """Read one response under a wall-clock deadline and report header/body phase timings."""

    started = time.monotonic()
    phase = "response headers"
    response = None
    previous_handler = signal.getsignal(signal.SIGALRM)

    def deadline_expired(_signum, _frame) -> None:
        raise StreamDeadlineExceeded(phase, time.monotonic() - started)

    signal.signal(signal.SIGALRM, deadline_expired)
    signal.siginterrupt(signal.SIGALRM, True)
    signal.setitimer(signal.ITIMER_REAL, budget)
    try:
        try:
            response = urllib.request.urlopen(url, timeout=budget)
            first_response_elapsed = time.monotonic() - started
            phase = "response body"
            incomplete_read = False
            try:
                payload = response.read()
            except http.client.IncompleteRead as error:
                payload = error.partial
                incomplete_read = True
            total_elapsed = time.monotonic() - started
            return payload, incomplete_read, first_response_elapsed, total_elapsed
        except StreamDeadlineExceeded:
            raise
        except TimeoutError as error:
            raise StreamDeadlineExceeded(phase, time.monotonic() - started) from error
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if response is not None:
            response.close()


def timeout_diagnostic(error: StreamDeadlineExceeded, budget: float) -> str:
    prefix = (
        f"fixed transcode cache probe timed out after {error.elapsed:.1f}s "
        f"during {error.phase} (wall-clock budget {budget}s). "
    )
    if error.phase == "response headers":
        return prefix + (
            "The client closed the request before Navidrome returned a status line. A nearby "
            '"Transcoding returned empty output" log may be downstream of that disconnect, but '
            "that causal link is plausible, not established; this timeout alone neither proves nor "
            "exonerates ffmpeg. Compare correlated Navidrome/ffmpeg timestamps and runner load."
        )
    return prefix + (
        "Navidrome returned the status line and headers, then the audio body stopped completing. "
        "This can reflect a stalled or failed transcoder, a blocked server, transport trouble, or "
        "runner load; inspect the correlated Navidrome and ffmpeg logs."
    )


class CacheSearchStalled(SystemExit):
    """The search never got an answer, which is a different fact from an empty corpus."""


def find_probe_song(search_url: str) -> tuple[dict, int, float]:
    """Poll `search3` for the fixed probe track, retrying transport failures until the deadline.

    Returns (song, attempts, elapsed_seconds). Raises `CacheSearchStalled` when no attempt ever
    got an answer, and `SystemExit` naming an absent corpus when answers arrived without the track.
    """

    started = time.monotonic()
    transport_deadline = started + SEARCH_DEADLINE_SECONDS
    settle_deadline: float | None = None
    attempts = 0
    transport_errors = 0
    last_transport_error = ""
    while True:
        attempts += 1
        attempt_failed = False
        try:
            document = read_json(search_url, SEARCH_ATTEMPT_TIMEOUT_SECONDS)
        except urllib.error.HTTPError:
            # An HTTP response is an answer. Retrying it would only repeat the same refusal.
            raise
        except TRANSPORT_ERRORS as error:
            attempt_failed = True
            transport_errors += 1
            last_transport_error = str(error) or type(error).__name__
            print(
                f"cache search transport error (attempt {attempts}): {last_transport_error}",
                file=sys.stderr,
            )
        else:
            songs = document.get("subsonic-response", {}).get("searchResult3", {}).get("song", [])
            song = next(
                (value for value in songs if value.get("title") == "Dulcet Health Probe"), None
            )
            if song is not None and isinstance(song.get("id"), str):
                elapsed = time.monotonic() - started
                print(
                    f"TRANSCODE CACHE SEARCH attempts={attempts} "
                    f"transport_errors={transport_errors} elapsed_seconds={elapsed:.3f}"
                )
                return song, attempts, elapsed
            if settle_deadline is None:
                settle_deadline = time.monotonic() + SEARCH_CORPUS_SETTLE_SECONDS
        now = time.monotonic()
        if now >= transport_deadline:
            break
        if settle_deadline is not None and now >= settle_deadline:
            break
        delay = (
            SEARCH_RETRY_BACKOFF_SECONDS[
                min(transport_errors, len(SEARCH_RETRY_BACKOFF_SECONDS)) - 1
            ]
            if attempt_failed
            else SEARCH_POLL_INTERVAL_SECONDS
        )
        time.sleep(min(delay, max(0.0, transport_deadline - now)))

    elapsed = time.monotonic() - started
    census = (
        f"attempts={attempts} transport_errors={transport_errors} "
        f"elapsed_seconds={elapsed:.3f}"
    )
    if settle_deadline is None:
        # Not one attempt was answered. Reporting that as an empty corpus attributes a stall to the
        # fixture library and sends the next reader to look for a missing file that is present.
        raise CacheSearchStalled(
            "cache search never received an answer from the disposable server: "
            f"{census} last_error={last_transport_error!r} "
            f"attempt_timeout_seconds={SEARCH_ATTEMPT_TIMEOUT_SECONDS} "
            f"deadline_seconds={SEARCH_DEADLINE_SECONDS}. This is a stall, not an absent corpus "
            "item; the transcode cache state was never observed."
        )
    raise SystemExit(
        f"known transcode cache probe is absent from the disposable corpus: {census}"
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--container")
    source.add_argument("--log-file")
    parser.add_argument("--expect-cached", choices=("true", "false"))
    args = parser.parse_args()
    if STREAM_TIMEOUT_SECONDS <= 0:
        raise SystemExit("DULCET_TRANSCODE_PROBE_TIMEOUT_SECONDS must be greater than zero")
    if SEARCH_DEADLINE_SECONDS <= 0:
        raise SystemExit("DULCET_TRANSCODE_SEARCH_DEADLINE_SECONDS must be greater than zero")
    if SEARCH_ATTEMPT_TIMEOUT_SECONDS <= 0:
        raise SystemExit("DULCET_TRANSCODE_SEARCH_ATTEMPT_SECONDS must be greater than zero")
    if SEARCH_CORPUS_SETTLE_SECONDS <= 0:
        raise SystemExit("DULCET_TRANSCODE_SEARCH_SETTLE_SECONDS must be greater than zero")
    # Refusing the incoherent shape is the durable half of this fix. A per-attempt timeout at or
    # above the total deadline cannot leave room for a second attempt, so the loop degrades into a
    # single request while still reading like a poll -- and nothing downstream would report it.
    if SEARCH_ATTEMPT_TIMEOUT_SECONDS >= SEARCH_DEADLINE_SECONDS:
        raise SystemExit(
            "the cache search per-attempt timeout must be strictly smaller than its total "
            f"deadline, or the poll can only ever make one attempt: attempt="
            f"{SEARCH_ATTEMPT_TIMEOUT_SECONDS}s deadline={SEARCH_DEADLINE_SECONDS}s"
        )
    if os.environ.get("DULCET_CONFORMANCE_DISPOSABLE") != "true":
        raise SystemExit("cache observation requires DULCET_CONFORMANCE_DISPOSABLE=true")
    base_url = os.environ.get("DULCET_CONFORMANCE_BASE_URL")
    if base_url != "http://127.0.0.1:4533":
        raise SystemExit(f"cache observation is restricted to disposable loopback, observed: {base_url}")

    before = streaming_logs(container=args.container, log_file=args.log_file)
    search_url = subsonic_url(
        base_url,
        "search3",
        {"query": "Dulcet Health Probe", "songCount": "10"},
    )
    song, _search_attempts, _search_elapsed = find_probe_song(search_url)

    stream_url = subsonic_url(
        base_url,
        "stream",
        {
            "id": song["id"],
            "format": "mp3",
            "maxBitRate": "128",
            "timeOffset": "1",
            "estimateContentLength": "true",
        },
    )
    # A cold transcode must start ffmpeg before Navidrome can return response headers. On a loaded
    # runner that phase can be slow, so the request gets measured headroom under one absolute
    # wall-clock deadline. Header and body failures are diagnosed separately: a client disconnect is
    # one plausible explanation for a nearby empty-output server log, not proof of its cause, while a
    # body-phase timeout keeps a stalled or failed transcoder explicitly in scope.
    try:
        payload, incomplete_read, first_response_elapsed, total_elapsed = read_stream_with_deadline(
            stream_url,
            STREAM_TIMEOUT_SECONDS,
        )
    except StreamDeadlineExceeded as error:
        raise SystemExit(timeout_diagnostic(error, STREAM_TIMEOUT_SECONDS)) from None
    if not payload:
        raise SystemExit("fixed transcode cache probe returned no audio bytes")

    deadline = time.monotonic() + 5
    new_lines: list[str] = []
    while time.monotonic() < deadline:
        after = streaming_logs(container=args.container, log_file=args.log_file)
        new_lines = after[len(before) :]
        if new_lines:
            break
        time.sleep(0.05)
    if len(new_lines) != 1:
        raise SystemExit(
            f"expected one new Navidrome streaming observation, found {len(new_lines)}: {new_lines}"
        )
    line = new_lines[0]
    cached = re.search(r"\bcached=(true|false)\b", line)
    transcoding = re.search(r"\btranscoding=(true|false)\b", line)
    if cached is None or transcoding is None:
        raise SystemExit(f"Navidrome streaming observation is incomplete: {line}")
    if transcoding.group(1) != "true":
        raise SystemExit(f"fixed cache probe did not exercise transcoding: {line}")
    observation = (
        "TRANSCODE CACHE OBSERVATION "
        f"cached={cached.group(1)} transcoding=true bytes={len(payload)} "
        f"first_response_seconds={first_response_elapsed:.3f} "
        f"total_request_seconds={total_elapsed:.3f} "
        f"incomplete_read={str(incomplete_read).lower()} song=Dulcet-Health-Probe"
    )
    print(observation)
    if args.expect_cached is not None and cached.group(1) != args.expect_cached:
        raise SystemExit(
            "transcode cache observation disagreed with the required state: "
            f"expected cached={args.expect_cached}, observed cached={cached.group(1)}"
        )


if __name__ == "__main__":
    main()
