#!/usr/bin/env python3
"""Issue one fixed transcode request and report Navidrome's cache decision from its own log."""

from __future__ import annotations

import argparse
import hashlib
import http.client
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

from readiness_transport import TRANSPORT_ERRORS, read_json


ADMIN_USER = "dulcet-admin"
ADMIN_PASSWORD = "dulcet-ci-canary-password"
CLIENT = "dulcet-cache-observation"
SUBSONIC_VERSION = "1.16.1"
STREAM_LOG = 'msg="Streaming file"'
# A true end-to-end request deadline, enforced by ITIMER_REAL rather than urllib's per-socket-
# operation timeout. Overridable so the controls can exercise both timeout phases quickly.
STREAM_TIMEOUT_SECONDS = float(os.environ.get("DULCET_TRANSCODE_PROBE_TIMEOUT_SECONDS", "180"))
# Each search attempt is bounded independently of the total search budget. Handing an attempt
# "whatever is left" lets the first one consume the entire window, so the loop polls exactly once
# and one slow response becomes indistinguishable from a persistently unreachable server.
SEARCH_ATTEMPT_TIMEOUT_SECONDS = 1.0


class StreamDeadlineExceeded(TimeoutError):
    def __init__(self, phase: str, elapsed: float) -> None:
        super().__init__(phase)
        self.phase = phase
        self.elapsed = elapsed


def subsonic_url(base_url: str, endpoint: str, parameters: dict[str, str]) -> str:
    salt = secrets.token_hex(8)
    token = hashlib.md5(
        (ADMIN_PASSWORD + salt).encode(), usedforsecurity=False
    ).hexdigest()
    query = urllib.parse.urlencode(
        {
            "u": ADMIN_USER,
            "t": token,
            "s": salt,
            "v": SUBSONIC_VERSION,
            "c": CLIENT,
            "f": "json",
            **parameters,
        }
    )
    return f"{base_url}/rest/{endpoint}.view?{query}"


def docker_logs(container: str) -> list[str]:
    result = subprocess.run(
        ["docker", "logs", container],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cannot read disposable container logs: {result.stdout.strip()}")
    return result.stdout.splitlines()


def file_logs(path: str) -> list[str]:
    try:
        return Path(path).read_text(errors="replace").splitlines()
    except OSError as error:
        raise RuntimeError(f"cannot read disposable Navidrome log {path}: {error}") from error


def streaming_logs(*, container: str | None, log_file: str | None) -> list[str]:
    lines = docker_logs(container) if container is not None else file_logs(log_file or "")
    return [line for line in lines if STREAM_LOG in line]


def read_stream_with_deadline(url: str, budget: float) -> tuple[bytes, bool, float, float]:
    """Read one response under a wall-clock deadline and report header/body phase timings."""

    started = time.monotonic()
    phase = "response headers"
    response = None
    previous_handler = signal.getsignal(signal.SIGALRM)

    def deadline_expired(_signum, _frame) -> None:
        raise StreamDeadlineExceeded(phase, time.monotonic() - started)

    signal.signal(signal.SIGALRM, deadline_expired)
    signal.siginterrupt(signal.SIGALRM, True)
    signal.setitimer(signal.ITIMER_REAL, budget)
    try:
        try:
            response = urllib.request.urlopen(url, timeout=budget)
            first_response_elapsed = time.monotonic() - started
            phase = "response body"
            incomplete_read = False
            try:
                payload = response.read()
            except http.client.IncompleteRead as error:
                payload = error.partial
                incomplete_read = True
            total_elapsed = time.monotonic() - started
            return payload, incomplete_read, first_response_elapsed, total_elapsed
        except StreamDeadlineExceeded:
            raise
        except TimeoutError as error:
            raise StreamDeadlineExceeded(phase, time.monotonic() - started) from error
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if response is not None:
            response.close()


def timeout_diagnostic(error: StreamDeadlineExceeded, budget: float) -> str:
    prefix = (
        f"fixed transcode cache probe timed out after {error.elapsed:.1f}s "
        f"during {error.phase} (wall-clock budget {budget}s). "
    )
    if error.phase == "response headers":
        return prefix + (
            "The client closed the request before Navidrome returned a status line. A nearby "
            '"Transcoding returned empty output" log may be downstream of that disconnect, but '
            "that causal link is plausible, not established; this timeout alone neither proves nor "
            "exonerates ffmpeg. Compare correlated Navidrome/ffmpeg timestamps and runner load."
        )
    return prefix + (
        "Navidrome returned the status line and headers, then the audio body stopped completing. "
        "This can reflect a stalled or failed transcoder, a blocked server, transport trouble, or "
        "runner load; inspect the correlated Navidrome and ffmpeg logs."
    )


def diagnose_loopback(base_url: str, budget: float = 5.0) -> str:
    """Separate "nothing is accepting" from "accepting but not answering" from "the DB path is stuck".

    Every probe here is deliberately a DIFFERENT layer, because two probes through one stack are one
    probe run twice. A raw socket bypasses urllib entirely; /ping is HTTP that touches no database;
    /rest/ping.view is an authenticated query against a tiny indexed table. On a healthy server all
    three answer in under ~15 ms, and the stall this diagnoses runs to 30 s, so the separation is
    about three orders of magnitude and no threshold tuning is required.
    """
    parsed = urllib.parse.urlparse(base_url)
    host, port = parsed.hostname or "127.0.0.1", parsed.port or 4533

    def safe(error: object) -> str:
        """Never let a credentialed query string reach a diagnostic.

        `subsonic_url` puts `u`, `t` (token) and `s` (salt) in the query string, and this function
        prints whatever the probes raise. CANARY-TESTED 2026-09-08: no urllib exception type
        reachable here currently embeds the URL -- but that is an accident of their `__str__`, not a
        guarantee anyone maintains, and one malformed-URL path elsewhere in this repo was measured
        carrying a token-bearing path out through an uncaught traceback. Redact by construction, so
        the property holds no matter what a future exception decides to include.
        """
        text = f"{type(error).__name__}: {error}" if error is not None else "None"
        return re.sub(r"\?[^\s'\"]*", "?<redacted>", text)

    def timed(call):
        start = time.monotonic()
        try:
            call()
        except Exception as error:  # noqa: BLE001 - every failure mode is a datum here
            return time.monotonic() - start, error
        return time.monotonic() - start, None

    def raw_connect():
        with socket.create_connection((host, port), timeout=budget):
            pass

    def bare_ping():
        # No auth, no database. A plain 200 with a one-byte body.
        with urllib.request.urlopen(f"{base_url}/ping", timeout=budget) as response:
            response.read()

    def subsonic_ping():
        # `/rest` endpoints report failure INSIDE a 200 envelope, so the status code proves nothing.
        document = read_json(subsonic_url(base_url, "ping", {}), budget)
        status = document.get("subsonic-response", {}).get("status")
        if status != "ok":
            raise RuntimeError(f"envelope status={status}")

    # Classify on ELAPSED TIME, not on whether a call raised. A probe that fails in a millisecond
    # has been ANSWERED -- by an endpoint that is missing, or by a reply this probe cannot parse --
    # and answering fast is the opposite of blocked. Calling that "blocked" would repeat, inside the
    # diagnosis, the exact conflation this tool was changed to stop making. Healthy responses here
    # measure under 15 ms and the stall under investigation runs to 30 s, so the cut is not delicate.
    STALLED = 1.0
    connect_s, connect_error = timed(raw_connect)
    if connect_s >= STALLED or isinstance(connect_error, (TimeoutError, socket.timeout)):
        return (
            f"loopback diagnosis=nothing-accepting connect_seconds={connect_s:.3f} "
            f"connect_error={safe(connect_error)}"
        )
    if connect_error is not None:
        return (
            f"loopback diagnosis=connection-refused connect_seconds={connect_s:.3f} "
            f"connect_error={safe(connect_error)} detail=refused immediately, so the port is not listening"
        )
    ping_s, ping_error = timed(bare_ping)
    if ping_s >= STALLED:
        return (
            f"loopback diagnosis=http-blocked connect_seconds={connect_s:.3f} "
            f"ping_seconds={ping_s:.3f} ping_error={safe(ping_error)}"
        )
    rest_s, rest_error = timed(subsonic_ping)
    if rest_s >= STALLED:
        return (
            f"loopback diagnosis=database-path-blocked connect_seconds={connect_s:.3f} "
            f"ping_seconds={ping_s:.3f} rest_ping_seconds={rest_s:.3f} rest_error={safe(rest_error)}"
        )
    anomalies = [f"{name}={safe(error)}" for name, error in
                 (("ping", ping_error), ("rest_ping", rest_error)) if error is not None]
    detail = (
        "every layer answered promptly, so the stalled request is not explained by server "
        "availability"
    )
    if anomalies:
        detail = f"answered promptly but not as expected ({'; '.join(anomalies)})"
    return (
        f"loopback diagnosis=server-answering connect_seconds={connect_s:.3f} "
        f"ping_seconds={ping_s:.3f} rest_ping_seconds={rest_s:.3f} detail={detail}"
    )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--container")
    source.add_argument("--log-file")
    parser.add_argument("--expect-cached", choices=("true", "false"))
    args = parser.parse_args()
    if STREAM_TIMEOUT_SECONDS <= 0:
        raise SystemExit("DULCET_TRANSCODE_PROBE_TIMEOUT_SECONDS must be greater than zero")
    if os.environ.get("DULCET_CONFORMANCE_DISPOSABLE") != "true":
        raise SystemExit("cache observation requires DULCET_CONFORMANCE_DISPOSABLE=true")
    base_url = os.environ.get("DULCET_CONFORMANCE_BASE_URL")
    if base_url != "http://127.0.0.1:4533":
        raise SystemExit(f"cache observation is restricted to disposable loopback, observed: {base_url}")

    before = streaming_logs(container=args.container, log_file=args.log_file)
    search_url = subsonic_url(
        base_url,
        "search3",
        {"query": "Dulcet Health Probe", "songCount": "10"},
    )
    search_deadline = time.monotonic() + 5
    song = None
    attempts = 0
    completed = 0
    last_transport_error = None
    while time.monotonic() < search_deadline:
        remaining = max(0.0, search_deadline - time.monotonic())
        if remaining <= 0:
            break
        attempts += 1
        try:
            document = read_json(search_url, min(SEARCH_ATTEMPT_TIMEOUT_SECONDS, remaining))
        except urllib.error.HTTPError:
            raise
        except TRANSPORT_ERRORS as error:
            last_transport_error = error
            print(f"cache search transport error: {error}", file=sys.stderr)
        else:
            completed += 1
            songs = document.get("subsonic-response", {}).get("searchResult3", {}).get("song", [])
            song = next((value for value in songs if value.get("title") == "Dulcet Health Probe"), None)
            if song is not None:
                break
        time.sleep(min(0.05, max(0, search_deadline - time.monotonic())))
    print(f"cache search resolved attempts={attempts} completed={completed}", file=sys.stderr)
    if not song or not isinstance(song.get("id"), str):
        # A search that never completed says nothing about the corpus. Reporting absence here names
        # the wrong subsystem: it sends the reader to the corpus seeder, which the readiness gate
        # has already proven healthy, while the actual event was a transport failure.
        if completed == 0:
            # The search never got an answer, so the next question is WHICH layer stopped answering.
            # Diagnose before exiting: this failure has been observed from three different callers
            # and the server has always looked healthy moments earlier, so a verdict recorded at the
            # moment of failure is the only thing that separates the candidate causes.
            print(diagnose_loopback(base_url), file=sys.stderr)
            raise SystemExit(
                f"cache search never completed: attempts={attempts} "
                f"last_error={last_transport_error}"
            )
        raise SystemExit(
            "known transcode cache probe is absent from the disposable corpus "
            f"(attempts={attempts} completed={completed})"
        )

    stream_url = subsonic_url(
        base_url,
        "stream",
        {
            "id": song["id"],
            "format": "mp3",
            "maxBitRate": "128",
            "timeOffset": "1",
            "estimateContentLength": "true",
        },
    )
    # A cold transcode must start ffmpeg before Navidrome can return response headers. On a loaded
    # runner that phase can be slow, so the request gets measured headroom under one absolute
    # wall-clock deadline. Header and body failures are diagnosed separately: a client disconnect is
    # one plausible explanation for a nearby empty-output server log, not proof of its cause, while a
    # body-phase timeout keeps a stalled or failed transcoder explicitly in scope.
    try:
        payload, incomplete_read, first_response_elapsed, total_elapsed = read_stream_with_deadline(
            stream_url,
            STREAM_TIMEOUT_SECONDS,
        )
    except StreamDeadlineExceeded as error:
        raise SystemExit(timeout_diagnostic(error, STREAM_TIMEOUT_SECONDS)) from None
    if not payload:
        raise SystemExit("fixed transcode cache probe returned no audio bytes")

    deadline = time.monotonic() + 5
    new_lines: list[str] = []
    while time.monotonic() < deadline:
        after = streaming_logs(container=args.container, log_file=args.log_file)
        new_lines = after[len(before) :]
        if new_lines:
            break
        time.sleep(0.05)
    if len(new_lines) != 1:
        raise SystemExit(
            f"expected one new Navidrome streaming observation, found {len(new_lines)}: {new_lines}"
        )
    line = new_lines[0]
    cached = re.search(r"\bcached=(true|false)\b", line)
    transcoding = re.search(r"\btranscoding=(true|false)\b", line)
    if cached is None or transcoding is None:
        raise SystemExit(f"Navidrome streaming observation is incomplete: {line}")
    if transcoding.group(1) != "true":
        raise SystemExit(f"fixed cache probe did not exercise transcoding: {line}")
    observation = (
        "TRANSCODE CACHE OBSERVATION "
        f"cached={cached.group(1)} transcoding=true bytes={len(payload)} "
        f"first_response_seconds={first_response_elapsed:.3f} "
        f"total_request_seconds={total_elapsed:.3f} "
        f"incomplete_read={str(incomplete_read).lower()} song=Dulcet-Health-Probe"
    )
    print(observation)
    if args.expect_cached is not None and cached.group(1) != args.expect_cached:
        raise SystemExit(
            "transcode cache observation disagreed with the required state: "
            f"expected cached={args.expect_cached}, observed cached={cached.group(1)}"
        )


if __name__ == "__main__":
    main()
