#!/usr/bin/env python3

"""Build, or reuse a verified build of, the pinned Darwin conformance ffmpeg.

The Darwin leg's ffmpeg is compiled from three SHA-256-pinned upstream source tarballs (LAME, Opus,
FFmpeg) listed under `ffmpeg.darwin.sources` in pins.json. Nothing is resolved through a package
index, so upstream index movement cannot change or break it (docs/TRAPS.md trap 36).

    install-darwin-ffmpeg cache-key           print the key a CI cache entry is stored under
    install-darwin-ffmpeg [install]           reuse a matching install, else build; then verify
    install-darwin-ffmpeg verify              verify an existing install; never builds

Every pin is validated before any download. Each tarball is hashed after download and before it is
extracted, and the file that is hashed is the file that is extracted: there is one copy. The build runs
with a PATH of system directories only and with every autodetected external library disabled, so no
library installed on the host can leak in; the linkage check then requires every dynamic library the
binaries load to be a system one. Verification is the same whether the install was built now or
restored from a cache: exact version token for ffmpeg and ffprobe, every required encoder present,
system-only linkage, and a real encode through each required encoder.

A restored install is reused only when its build manifest names this exact build digest and every
file it lists hashes to the recorded value. Otherwise it is discarded and rebuilt from source. The
manifest detects a corrupt or partial restore; it is not an adversarial provenance check, because the
manifest travels with the cache entry it describes.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request


sys.path.insert(0, str(Path(__file__).parent))
from ffmpeg_version import require_ffmpeg_version  # noqa: E402


PINS = Path(__file__).parent / "pins.json"
MANIFEST_NAME = "DULCET-BUILD.json"
INSTALLED_FILES = ("bin/ffmpeg", "bin/ffprobe")
SOURCE_ORDER = ("lame", "opus", "ffmpeg")
SHA256 = re.compile(r"[0-9a-f]{64}")
# The only directories a pinned binary may load a dynamic library from.
SYSTEM_LIBRARY_PREFIXES = ("/usr/lib/", "/System/Library/")
# A build environment with no Homebrew, no /usr/local and no inherited compiler flags.
BUILD_PATH = "/usr/bin:/bin:/usr/sbin:/sbin"
INHERITED_BUILD_VARIABLES = (
    "CFLAGS", "CXXFLAGS", "CPPFLAGS", "LDFLAGS", "CPATH", "C_INCLUDE_PATH", "LIBRARY_PATH",
    "SDKROOT", "PKG_CONFIG", "PKG_CONFIG_PATH", "PKG_CONFIG_LIBDIR", "DYLD_LIBRARY_PATH", "DYLD_FALLBACK_LIBRARY_PATH",
)

# FFmpeg's configure needs pkg-config only for libopus, and LAME's configure refuses to run without
# one. This answers for the Opus build in the work directory and nothing else, so no host .pc file is
# ever consulted and LAME's optional mpg123 probe finds nothing. Paths are relative to the FFmpeg
# source directory, where configure and make both run, so a work directory whose path holds a space
# still builds. The shim itself lives in a space-free temporary directory, because autoconf invokes
# it by absolute path without quoting.
PKG_CONFIG_SHIM = """#!@PYTHON@
import os, sys
args = sys.argv[1:]
if args == ["--version"]:
    print("0.29.2")
    raise SystemExit(0)
if args and args[0] == "--atleast-pkgconfig-version":
    raise SystemExit(0)
packages = [a for a in args if not a.startswith("-")]
if packages != ["opus"]:
    if "--print-errors" in args:
        print(f"dulcet pkg-config shim: no package {' '.join(packages)}", file=sys.stderr)
    raise SystemExit(1)
deps = os.path.relpath(os.environ["DULCET_FFMPEG_DEPS"])
if "--exists" in args:
    raise SystemExit(0)
out = []
if "--cflags" in args or "--cflags-only-I" in args:
    out.append(f"-I{deps}/include/opus")
if "--libs" in args:
    out.extend([f"-L{deps}/lib", "-lopus"])
if "--variable=includedir" in args:
    out.append(f"{deps}/include")
print(" ".join(out))
"""


class PinError(SystemExit):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def load_pin() -> dict:
    return json.loads(PINS.read_text())["ffmpeg"]["darwin"]


def validate_pin(pin: dict) -> list[dict]:
    """Reject a malformed pin before any network request. Returns the sources in build order."""
    errors: list[str] = []
    version = pin.get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[0-9]+(\.[0-9]+)+", version or ""):
        errors.append(f"version must be a dotted release number, observed {version!r}")
    prefix = pin.get("prefix")
    if not isinstance(prefix, str) or not prefix.startswith("/") or " " in prefix:
        errors.append(f"prefix must be an absolute path without spaces, observed {prefix!r}")
    elif pin.get("path") != f"{prefix}/bin/ffmpeg":
        errors.append(f"path must be {prefix}/bin/ffmpeg, observed {pin.get('path')!r}")
    encoders = pin.get("required_encoders")
    if not isinstance(encoders, list) or not encoders or not all(isinstance(e, str) for e in encoders):
        errors.append("required_encoders must be a non-empty list of names")
    sources = pin.get("sources")
    by_name: dict[str, dict] = {}
    if not isinstance(sources, list):
        errors.append("sources must be a list")
        sources = []
    for index, source in enumerate(sources):
        label = f"sources[{index}]"
        if not isinstance(source, dict):
            errors.append(f"{label} must be an object")
            continue
        name = source.get("name")
        label = f"source {name!r}"
        if name not in SOURCE_ORDER:
            errors.append(f"{label}: name must be one of {', '.join(SOURCE_ORDER)}")
            continue
        if name in by_name:
            errors.append(f"{label}: duplicate")
        by_name[name] = source
        if not isinstance(source.get("version"), str) or not source["version"]:
            errors.append(f"{label}: version missing")
        if not SHA256.fullmatch(str(source.get("sha256", ""))):
            errors.append(f"{label}: sha256 must be 64 lowercase hex digits")
        archive = source.get("archive")
        if not isinstance(archive, str) or "/" in archive or not archive.endswith((".tar.gz", ".tar.xz")):
            errors.append(f"{label}: archive must be a bare .tar.gz or .tar.xz file name")
        urls = source.get("urls")
        if not isinstance(urls, list) or not urls:
            errors.append(f"{label}: urls must be a non-empty list")
        else:
            for url in urls:
                if not isinstance(url, str) or not url.startswith("https://"):
                    errors.append(f"{label}: url {url!r} is not https")
    for name in SOURCE_ORDER:
        if name not in by_name:
            errors.append(f"source {name!r} missing")
    if "ffmpeg" in by_name and by_name["ffmpeg"].get("version") != version:
        errors.append(
            f"source 'ffmpeg' version {by_name['ffmpeg'].get('version')!r} differs from pinned version {version!r}"
        )
    if errors:
        raise PinError("Darwin ffmpeg pin invalid; nothing downloaded:\n  " + "\n  ".join(errors))
    return [by_name[name] for name in SOURCE_ORDER]


def build_environment() -> dict:
    """The inherited environment minus compiler and pkg-config overrides, pinned to the selected Xcode.

    The compiler and SDK are named explicitly: an autoconf script left to itself tries `gcc` first, and
    on a host whose Command Line Tools SDK is newer than the selected Xcode's linker understands, that
    resolves to an SDK the linker rejects (OBSERVED on a development Mac: `ld: tapi error: malformed
    file ... unknown architecture`).
    """
    environment = {key: value for key, value in os.environ.items() if key not in INHERITED_BUILD_VARIABLES}
    environment["PATH"] = BUILD_PATH
    sdk = subprocess.run(
        ["/usr/bin/xcrun", "--sdk", "macosx", "--show-sdk-path"], text=True, capture_output=True, check=True,
        env=environment,
    )
    environment.update(SDKROOT=sdk.stdout.strip(), CC="/usr/bin/clang", CXX="/usr/bin/clang++")
    return environment


def toolchain_identity() -> str:
    clang = subprocess.run(
        ["/usr/bin/clang", "--version"], text=True, capture_output=True, check=True, env=build_environment(),
    )
    sdk = subprocess.run(
        ["/usr/bin/xcrun", "--sdk", "macosx", "--show-sdk-version"], text=True, capture_output=True, check=True,
        env=build_environment(),
    )
    return f"{clang.stdout.splitlines()[0].strip()} sdk={sdk.stdout.strip()} arch={platform.machine()}"


def build_digest(pin: dict, toolchain: str) -> str:
    """What a reusable install must have been built from: the pin, this script, and the compiler."""
    digest = hashlib.sha256()
    digest.update(json.dumps(pin, sort_keys=True, separators=(",", ":")).encode())
    digest.update(b"\0")
    digest.update(Path(__file__).read_bytes())
    digest.update(b"\0")
    digest.update(toolchain.encode())
    return digest.hexdigest()


def fetch_verified(source: dict, directory: Path, opener=None) -> Path:
    """Download one source, hash it, and return that same file only if it equals the pin."""
    target = directory / source["archive"]
    failures: list[str] = []
    for url in source["urls"]:
        target.unlink(missing_ok=True)
        try:
            request = urllib.request.Request(url, headers={"User-Agent": "curl/8"})
            with (opener or urllib.request.urlopen)(request, timeout=120) as response, target.open("wb") as handle:
                while block := response.read(1024 * 1024):
                    handle.write(block)
        except OSError as error:
            failures.append(f"{url}: {error}")
            continue
        observed = sha256_file(target)
        if observed == source["sha256"]:
            print(
                f"DARWIN FFMPEG SOURCE PASS name={source['name']} version={source['version']} "
                f"expected_sha256={source['sha256']} observed_sha256={observed} url={url}"
            )
            return target
        failures.append(f"{url}: expected_sha256={source['sha256']} observed_sha256={observed}")
    target.unlink(missing_ok=True)
    raise SystemExit(
        f"source {source['name']} {source['version']} failed verification at every url; nothing extracted:\n  "
        + "\n  ".join(failures)
    )


def extract(archive: Path, directory: Path) -> Path:
    with tarfile.open(archive) as bundle:
        names = bundle.getnames()
        roots = {name.split("/", 1)[0] for name in names}
        if len(roots) != 1:
            raise SystemExit(f"{archive.name}: expected one top-level directory, observed {sorted(roots)}")
        bundle.extractall(directory, filter="data")
    return directory / roots.pop()


def run(command: list[str], cwd: Path, env: dict, log: Path) -> None:
    with log.open("a") as handle:
        handle.write(f"\n$ {' '.join(command)}\n")
        handle.flush()
        result = subprocess.run(command, cwd=cwd, env=env, stdout=handle, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        tail = log.read_text(errors="replace").splitlines()[-40:]
        raise SystemExit(f"build step failed ({result.returncode}): {' '.join(command)}\n" + "\n".join(tail))


def build(pin: dict, sources: list[dict], work: Path, jobs: int, digest: str, toolchain: str) -> Path:
    """Build into work/stage and return the staged prefix; never touches the install prefix."""
    downloads = work / "downloads"
    trees = work / "src"
    shim_dir = Path(tempfile.mkdtemp(prefix="dulcet-pkg-config-"))
    deps = work / "deps"
    stage = work / "stage"
    for directory in (downloads, trees, deps, stage):
        directory.mkdir(parents=True)
    shim = shim_dir / "pkg-config"
    if " " in str(shim_dir) or " " in sys.executable:
        raise SystemExit(f"pkg-config shim path must not contain a space: {shim_dir} {sys.executable}")
    shim.write_text(PKG_CONFIG_SHIM.replace("@PYTHON@", sys.executable))
    shim.chmod(0o755)
    environment = build_environment()
    environment.update(
        PATH=f"{shim_dir}:{BUILD_PATH}",
        DULCET_FFMPEG_DEPS=str(deps),
        LC_ALL="C",
        TZ="UTC",
        SOURCE_DATE_EPOCH="0",
        ZERO_AR_DATE="1",
    )
    log = work / "build.log"

    verified = {source["name"]: fetch_verified(source, downloads) for source in sources}
    tree = {name: extract(archive, trees) for name, archive in verified.items()}

    started = time.monotonic()
    # The two static libraries and their public headers are copied out of the build trees rather than
    # `make install`ed: libtool's install step does not quote paths, so it fails in a work directory
    # whose path holds a space. The placeholder prefix is never used.
    library_configure = ["--prefix=/dulcet-unused", "--disable-shared", "--enable-static"]
    run(["./configure", *library_configure, "--disable-frontend", "--disable-decoder"], tree["lame"], environment, log)
    run(["make", f"-j{jobs}"], tree["lame"], environment, log)
    run(["./configure", *library_configure, "--disable-doc", "--disable-extra-programs"], tree["opus"], environment, log)
    run(["make", f"-j{jobs}"], tree["opus"], environment, log)
    (deps / "lib").mkdir()
    (deps / "include" / "lame").mkdir(parents=True)
    (deps / "include" / "opus").mkdir()
    shutil.copy2(tree["lame"] / "libmp3lame" / ".libs" / "libmp3lame.a", deps / "lib")
    shutil.copy2(tree["lame"] / "include" / "lame.h", deps / "include" / "lame")
    shutil.copy2(tree["opus"] / ".libs" / "libopus.a", deps / "lib")
    for header in sorted((tree["opus"] / "include").glob("opus*.h")):
        shutil.copy2(header, deps / "include" / "opus")

    relative_deps = os.path.relpath(deps, tree["ffmpeg"])
    run(
        [
            "./configure",
            f"--prefix={pin['prefix']}",
            "--cc=clang",
            "--pkg-config=pkg-config",
            "--disable-autodetect",
            "--disable-debug",
            "--disable-doc",
            "--disable-ffplay",
            "--disable-network",
            "--enable-zlib",
            "--enable-libmp3lame",
            "--enable-libopus",
            f"--extra-cflags=-I{relative_deps}/include",
            f"--extra-ldflags=-L{relative_deps}/lib",
        ],
        tree["ffmpeg"], environment, log,
    )
    run(["make", f"-j{jobs}", "ffmpeg", "ffprobe"], tree["ffmpeg"], environment, log)
    elapsed = time.monotonic() - started
    shutil.rmtree(shim_dir)

    (stage / "bin").mkdir()
    for relative in INSTALLED_FILES:
        shutil.copy2(tree["ffmpeg"] / Path(relative).name, stage / relative)
    write_manifest(stage, digest, toolchain, sources, elapsed, jobs)
    print(f"DARWIN FFMPEG BUILD elapsed_seconds={elapsed:.0f} jobs={jobs} toolchain={toolchain!r}")
    return stage


def write_manifest(prefix: Path, digest: str, toolchain: str, sources: list[dict], elapsed: float, jobs: int) -> None:
    manifest = {
        "build_digest": digest,
        "toolchain": toolchain,
        "sources": {source["name"]: source["sha256"] for source in sources},
        "build_seconds": round(elapsed),
        "build_jobs": jobs,
        "files": {relative: sha256_file(prefix / relative) for relative in INSTALLED_FILES},
    }
    (prefix / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")


def reusable_install(prefix: Path, digest: str) -> tuple[bool, str]:
    """Whether the install at prefix is exactly the build this digest names, untouched."""
    manifest_path = prefix / MANIFEST_NAME
    if not manifest_path.is_file():
        return False, "no build manifest"
    try:
        manifest = json.loads(manifest_path.read_text())
    except ValueError as error:
        return False, f"unreadable build manifest: {error}"
    if manifest.get("build_digest") != digest:
        return False, f"build digest {manifest.get('build_digest')!r} is not {digest}"
    files = manifest.get("files")
    if not isinstance(files, dict) or sorted(files) != sorted(INSTALLED_FILES):
        return False, f"manifest lists {sorted(files) if isinstance(files, dict) else files!r}"
    present = sorted(
        str(path.relative_to(prefix)) for path in prefix.rglob("*")
        if not path.is_dir() and path.name != MANIFEST_NAME
    )
    if present != sorted(INSTALLED_FILES):
        return False, f"install holds {present}, expected {sorted(INSTALLED_FILES)}"
    for relative, expected in files.items():
        path = prefix / relative
        if path.is_symlink() or not path.is_file():
            return False, f"{relative} is not a regular file"
        observed = sha256_file(path)
        if observed != expected:
            return False, f"{relative} expected_sha256={expected} observed_sha256={observed}"
    return True, "manifest matches"


def system_linkage_errors(binary: str, otool_output: str) -> list[str]:
    """Every library `otool -L` reports must be a system library."""
    errors: list[str] = []
    lines = otool_output.splitlines()[1:]
    if not lines:
        errors.append(f"{binary}: otool reported no libraries")
    for line in lines:
        library = line.strip().split(" (compatibility", 1)[0].strip()
        if not library.startswith(SYSTEM_LIBRARY_PREFIXES):
            errors.append(f"{binary}: links non-system library {library}")
    return errors


def encoder_names(encoders_output: str) -> set[str]:
    names: set[str] = set()
    past_legend = False
    for line in encoders_output.splitlines():
        if line.strip().startswith("------"):
            past_legend = True
            continue
        fields = line.split()
        if past_legend and len(fields) >= 2:
            names.add(fields[1])
    return names


def verify(prefix: Path, pin: dict, check_linkage: bool = True, encode: bool = True) -> str:
    """Fail closed unless prefix holds the pinned ffmpeg. Returns a one-line attestation."""
    ffmpeg = prefix / "bin" / "ffmpeg"
    ffprobe = prefix / "bin" / "ffprobe"
    for binary in (ffmpeg, ffprobe):
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise SystemExit(f"pinned binary missing or not executable: {binary.name}")
    observed_versions = []
    for binary in (ffmpeg, ffprobe):
        result = subprocess.run([str(binary), "-version"], text=True, capture_output=True, timeout=30)
        if result.returncode != 0:
            raise SystemExit(f"{binary.name} -version failed ({result.returncode}): {result.stderr.strip()}")
        banner = result.stdout.splitlines()[0] if result.stdout else ""
        banner = banner.replace("ffprobe version", "ffmpeg version", 1) if binary == ffprobe else banner
        try:
            observed_versions.append(require_ffmpeg_version(banner, pin["version"]))
        except ValueError as error:
            raise SystemExit(f"{binary.name}: {error}") from error

    listing = subprocess.run([str(ffmpeg), "-hide_banner", "-encoders"], text=True, capture_output=True, timeout=30)
    if listing.returncode != 0:
        raise SystemExit(f"ffmpeg -encoders failed ({listing.returncode}): {listing.stderr.strip()}")
    available = encoder_names(listing.stdout)
    missing = [name for name in pin["required_encoders"] if name not in available]
    if missing:
        raise SystemExit(
            f"pinned ffmpeg lacks required encoders: missing={missing} "
            f"required={pin['required_encoders']} observed_count={len(available)}"
        )

    if check_linkage:
        errors: list[str] = []
        for binary in (ffmpeg, ffprobe):
            otool = subprocess.run(["/usr/bin/otool", "-L", str(binary)], text=True, capture_output=True, check=True)
            errors.extend(system_linkage_errors(binary.name, otool.stdout))
        if errors:
            raise SystemExit("pinned ffmpeg links outside the system:\n  " + "\n  ".join(errors))

    encoded: list[str] = []
    if encode:
        with tempfile.TemporaryDirectory(prefix="dulcet-ffmpeg-verify-") as temporary:
            for encoder, suffix in (("libmp3lame", "mp3"), ("libopus", "ogg")):
                if encoder not in pin["required_encoders"]:
                    continue
                output = Path(temporary) / f"probe.{suffix}"
                result = subprocess.run(
                    [str(ffmpeg), "-hide_banner", "-loglevel", "error", "-nostdin", "-f", "lavfi",
                     "-i", "sine=frequency=440:sample_rate=48000:duration=1", "-c:a", encoder, str(output)],
                    text=True, capture_output=True, timeout=60,
                )
                if result.returncode != 0 or not output.is_file() or output.stat().st_size == 0:
                    raise SystemExit(f"encode through {encoder} failed ({result.returncode}): {result.stderr.strip()}")
                encoded.append(f"{encoder}:{output.stat().st_size}")

    return (
        f"DARWIN FFMPEG PASS expected_version={pin['version']} observed_ffmpeg={observed_versions[0]} "
        f"observed_ffprobe={observed_versions[1]} required_encoders={','.join(pin['required_encoders'])} "
        f"observed_encoders={len(available)} linkage={'system-only' if check_linkage else 'unchecked'} "
        f"encoded={','.join(encoded) or 'none'} "
        f"ffmpeg_sha256={sha256_file(ffmpeg)} ffprobe_sha256={sha256_file(ffprobe)}"
    )


def require_host(pin: dict) -> None:
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise SystemExit(f"Darwin ffmpeg requires Darwin/arm64, observed {platform.system()}/{platform.machine()}")


def install(pin: dict, sources: list[dict], prefix: Path, work_parent: Path | None, jobs: int) -> None:
    toolchain = toolchain_identity()
    digest = build_digest(pin, toolchain)
    reusable, reason = reusable_install(prefix, digest) if prefix.exists() else (False, "no install")
    if reusable:
        print(f"DARWIN FFMPEG REUSE prefix_build_digest={digest} reason={reason!r}")
    else:
        print(f"DARWIN FFMPEG BUILD REQUIRED reason={reason!r} build_digest={digest}")
        work = Path(tempfile.mkdtemp(prefix="dulcet-ffmpeg-build-", dir=work_parent))
        stage = build(pin, sources, work, jobs, digest, toolchain)
        if prefix.exists():
            shutil.rmtree(prefix)
        prefix.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(stage, prefix)
        shutil.rmtree(work)
        reusable, reason = reusable_install(prefix, digest)
        if not reusable:
            raise SystemExit(f"fresh install does not match its own manifest: {reason}")
    print(verify(prefix, pin))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("command", nargs="?", default="install", choices=("install", "verify", "cache-key"))
    parser.add_argument("--prefix", help="install location; defaults to the pinned prefix")
    parser.add_argument("--work-dir", help="parent of the temporary build directory")
    parser.add_argument("--jobs", type=int, default=os.cpu_count() or 1)
    args = parser.parse_args()

    pin = load_pin()
    sources = validate_pin(pin)
    require_host(pin)
    prefix = Path(args.prefix or pin["prefix"])
    if args.command == "cache-key":
        print(f"darwin-ffmpeg-{pin['version']}-{build_digest(pin, toolchain_identity())[:32]}")
    elif args.command == "verify":
        print(verify(prefix, pin))
    else:
        install(pin, sources, prefix, Path(args.work_dir) if args.work_dir else None, args.jobs)


if __name__ == "__main__":
    main()
