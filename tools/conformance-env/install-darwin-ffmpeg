#!/usr/bin/env python3

"""Install and prove the complete checksum-pinned Darwin ffmpeg closure."""

import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import urllib.parse
import urllib.request
from urllib.error import HTTPError, URLError

from ffmpeg_version import require_ffmpeg_version


def run(
    arguments: list[str],
    *,
    capture: bool = False,
    local_homebrew_package: bool = False,
) -> str:
    environment = {**os.environ, "HOMEBREW_NO_AUTO_UPDATE": "1"}
    if local_homebrew_package:
        # Homebrew intentionally gates package-path installs behind developer mode. Suppress its
        # post-install dependent upgrade pass too: those upgrades would reintroduce live resolution.
        environment.update(
            {
                "HOMEBREW_DEVELOPER": "1",
                "HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK": "1",
                "HOMEBREW_NO_INSTALL_CLEANUP": "1",
            }
        )
    process = subprocess.run(
        arguments,
        text=True,
        capture_output=capture,
        env=environment,
    )
    if process.returncode != 0:
        detail = ((process.stdout or "") + (process.stderr or "")).strip()
        raise SystemExit(f"{' '.join(arguments)} failed ({process.returncode}): {detail}")
    return process.stdout.strip() if capture else ""


def installed_formula_versions(name: str) -> list[str]:
    process = subprocess.run(
        ["brew", "list", "--versions", name],
        text=True,
        capture_output=True,
        env={**os.environ, "HOMEBREW_NO_AUTO_UPDATE": "1"},
    )
    if process.returncode != 0:
        return []
    fields = process.stdout.split()
    return fields[1:] if fields and fields[0] == name else []


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def pinned_ghcr_repository(entry: dict) -> str:
    """Validate one immutable GHCR blob pin and return its repository name."""
    expected_sha256 = entry.get("sha256")
    if not isinstance(expected_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_sha256):
        raise SystemExit(f"invalid bottle sha256 pin for {entry.get('formula', '<unknown>')}")

    url = entry.get("url")
    if not isinstance(url, str):
        raise SystemExit(f"missing bottle URL pin for {entry.get('formula', '<unknown>')}")
    parsed = urllib.parse.urlsplit(url)
    match = re.fullmatch(r"/v2/(homebrew/core/.+)/blobs/sha256:([0-9a-f]{64})", parsed.path)
    if (
        parsed.scheme != "https"
        or parsed.netloc != "ghcr.io"
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
        or match is None
    ):
        raise SystemExit(
            f"bottle URL is not an immutable Homebrew GHCR blob for "
            f"{entry.get('formula', '<unknown>')}: {url!r}"
        )
    repository, url_digest = match.groups()
    if url_digest != expected_sha256:
        raise SystemExit(
            f"bottle digest pin disagreement for {entry['formula']}: "
            f"url={url_digest} sha256={expected_sha256}"
        )
    return repository


def validate_pinned_bottle_closure(closure: list[dict]) -> None:
    """Validate every immutable URL/checksum pair before any closure member is fetched."""
    for entry in closure:
        pinned_ghcr_repository(entry)


def bottle_filename(entry: dict) -> str:
    rebuild = entry["bottle_rebuild"]
    rebuild_suffix = f".{rebuild}" if rebuild else ""
    return (
        f"{entry['formula']}--{keg_version(entry)}.{entry['bottle_tag']}"
        f".bottle{rebuild_suffix}.tar.gz"
    )


def bottle_cache_filename(entry: dict) -> str:
    return f"{entry['sha256']}--{bottle_filename(entry)}"


def verify_bottle_checksum(path: Path, entry: dict) -> str:
    """Reject any archive whose bytes do not match the immutable digest pin."""
    pinned_ghcr_repository(entry)
    observed_sha256 = file_sha256(path)
    if observed_sha256 != entry["sha256"]:
        raise SystemExit(
            f"pinned bottle checksum mismatch for {entry['formula']}: "
            f"expected {entry['sha256']}, observed {observed_sha256}"
        )
    return observed_sha256


def ghcr_pull_token(repository: str) -> str:
    query = urllib.parse.urlencode(
        {
            "service": "ghcr.io",
            "scope": f"repository:{repository}:pull",
        }
    )
    request = urllib.request.Request(
        f"https://ghcr.io/token?{query}",
        headers={"User-Agent": "dulcet-darwin-conformance/1"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            token_document = json.load(response)
    except (HTTPError, URLError, TimeoutError, json.JSONDecodeError) as error:
        raise SystemExit(f"GHCR authentication failed for {repository}: {error}") from error
    token = token_document.get("token") or token_document.get("access_token")
    if not isinstance(token, str) or not token:
        raise SystemExit(f"GHCR authentication returned no pull token for {repository}")
    return token


def fetch_pinned_bottle(entry: dict, cache_directory: Path) -> tuple[Path, str, bool]:
    """Return a checksum-verified pinned bottle, using a reusable local cache when possible."""
    repository = pinned_ghcr_repository(entry)
    cache_directory.mkdir(parents=True, exist_ok=True)
    destination = cache_directory / bottle_cache_filename(entry)
    if destination.exists():
        if destination.is_symlink() or not destination.is_file():
            raise SystemExit(f"pinned bottle cache entry is not a file: {destination}")
        return destination, verify_bottle_checksum(destination, entry), True

    token = ghcr_pull_token(repository)
    request = urllib.request.Request(
        entry["url"],
        headers={
            "Accept": "application/vnd.oci.image.layer.v1.tar+gzip",
            "Authorization": f"Bearer {token}",
            "User-Agent": "dulcet-darwin-conformance/1",
        },
    )
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            prefix=f".{entry['formula']}-",
            suffix=".partial",
            dir=cache_directory,
            delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            try:
                with urllib.request.urlopen(request, timeout=60) as response:
                    while block := response.read(1024 * 1024):
                        temporary.write(block)
            except (HTTPError, URLError, TimeoutError) as error:
                raise SystemExit(
                    f"GHCR blob fetch failed for {entry['formula']} at its pinned digest: {error}"
                ) from error
        observed_sha256 = verify_bottle_checksum(temporary_path, entry)
        os.replace(temporary_path, destination)
        temporary_path = None
        return destination, observed_sha256, False
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def keg_payload_sha256(root: Path) -> tuple[str, int]:
    """Hash every installed payload path except Homebrew's mutable pour receipt."""
    digest = hashlib.sha256()
    entries = 0
    for path in sorted(root.rglob("*"), key=lambda candidate: candidate.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix()
        if relative == "INSTALL_RECEIPT.json":
            continue
        mode = path.lstat().st_mode
        if stat.S_ISDIR(mode):
            kind = b"directory"
            payload = b""
        elif stat.S_ISLNK(mode):
            kind = b"symlink"
            payload = os.readlink(path).encode()
        elif stat.S_ISREG(mode):
            kind = b"file"
            payload = bytes.fromhex(file_sha256(path))
        else:
            raise SystemExit(f"unsupported installed keg entry: {path}")
        digest.update(kind + b"\0" + relative.encode() + b"\0")
        digest.update(f"{stat.S_IMODE(mode):04o}".encode() + b"\0" + payload + b"\0")
        entries += 1
    if entries == 0:
        raise SystemExit(f"installed keg has no payload entries: {root}")
    return digest.hexdigest(), entries


def observe_keg(root: Path) -> dict[str, int | str] | None:
    """Retain the filesystem and receipt evidence that identifies one poured keg."""
    if not root.exists():
        return None
    if not root.is_dir():
        raise SystemExit(f"Homebrew keg path is not a directory: {root}")
    receipt_path = root / "INSTALL_RECEIPT.json"
    try:
        receipt = json.loads(receipt_path.read_text())
        receipt_time = int(receipt["time"])
        root_stat = root.stat()
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        raise SystemExit(f"invalid Homebrew pour receipt: {receipt_path}") from error
    return {
        "root_device": root_stat.st_dev,
        "root_inode": root_stat.st_ino,
        "receipt_sha256": file_sha256(receipt_path),
        "receipt_time": receipt_time,
    }


def path_file_type(path: Path) -> str:
    """Name one path's own filesystem type.

    The type comes from `lstat`, so a symlink is named as a symlink rather than as whatever it
    points at. The link target is read only to say whether that symlink is broken.
    """
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        return "absent"
    except OSError as error:
        raise SystemExit(f"unreadable Homebrew Cellar path {path}: {error}") from error
    if stat.S_ISLNK(mode):
        return "symlink" if path.exists() else "broken-symlink"
    if stat.S_ISDIR(mode):
        return "directory"
    if stat.S_ISREG(mode):
        return "file"
    return f"other-{stat.S_IFMT(mode):#o}"


def observe_cellar_rack(rack: Path) -> dict:
    """Name every entry in one formula's `<cellar>/<formula>` rack, with each entry's file type.

    OBSERVED (apple-ci, hosted runner): a pour of the pinned openssl@3 3.6.4 bottle was rejected
    naming `Cellar/openssl@3/3.6.3` - an entry at a version the closure does not pin. So a pour
    reads more of the rack than the pinned keg path, and an entry elsewhere in the rack can decide
    its outcome. `brew list --versions` reports only what Homebrew still parses as an installed
    keg, and `observe_keg` reads one pinned path, so neither can see such an entry. This covers
    the whole rack and runs no Homebrew command.
    """
    rack_type = path_file_type(rack)
    entries: dict[str, str] = {}
    if rack_type == "directory":
        try:
            children = sorted(rack.iterdir(), key=lambda child: child.name)
        except OSError as error:
            raise SystemExit(f"unlistable Homebrew Cellar rack {rack}: {error}") from error
        entries = {child.name: path_file_type(child) for child in children}
    return {"rack_type": rack_type, "entries": entries}


def rack_takes_no_part_in_a_pour(observation: dict) -> bool:
    """Accept a rack as out of a pour's way only when it is absent or an empty directory.

    This is deliberately stricter than Homebrew, which pours happily alongside a valid keg at
    another version. This installer owns and re-pours the whole closure, so it requires the empty
    case rather than deciding which leftovers are benign - a judgement the runner failure shows is
    easy to get wrong.
    """
    if observation["rack_type"] == "absent":
        return True
    return observation["rack_type"] == "directory" and not observation["entries"]


def rack_entry_label(name: str) -> str:
    """Render one entry name as a token an attestation field can carry without ambiguity."""
    if re.fullmatch(r"[A-Za-z0-9._+@~-]+", name):
        return name
    return urllib.parse.quote(name, safe="")


def describe_rack_entries(entries: dict[str, str]) -> str:
    """Render rack entries as one whitespace-free field, every entry named with its own type."""
    if not entries:
        return "none"
    return ",".join(f"{rack_entry_label(name)}:{kind}" for name, kind in entries.items())


def describe_rack(observation: dict) -> str:
    """Render a whole rack observation as one whitespace-free attestation field."""
    if observation["rack_type"] == "absent":
        return "absent"
    if observation["rack_type"] != "directory":
        return f"rack:{observation['rack_type']}"
    if not observation["entries"]:
        return "empty"
    return describe_rack_entries(observation["entries"])


def remove_cellar_path(path: Path, kind: str) -> None:
    """Delete one Cellar entry of an already-observed type, or stop the run naming both."""
    try:
        if kind == "directory":
            shutil.rmtree(path)
        else:
            path.unlink()
    except OSError as error:
        raise SystemExit(
            f"Homebrew Cellar residue could not be removed: path={path} type={kind} "
            f"error={error}"
        ) from error


def remove_cellar_rack_residue(cellar: Path, formula: str) -> dict[str, str]:
    """Remove what `brew uninstall` left in one rack and name every entry that was removed.

    The formula name is required to be a single Homebrew-shaped path segment and a symlink is
    unlinked rather than followed, so only that formula's own rack and the tree beneath it can be
    removed here. A rack that is not a directory is removed whole and reported under the formula's
    own name. Absence is not inferred from these removals having been attempted: the caller
    re-observes every rack afterwards and stops the run on anything still there.
    """
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+@-]*", formula):
        raise SystemExit(f"refusing to clear a rack for an unexpected formula name: {formula!r}")
    rack = cellar / formula
    observation = observe_cellar_rack(rack)
    if observation["rack_type"] == "absent":
        return {}
    if observation["rack_type"] != "directory":
        remove_cellar_path(rack, observation["rack_type"])
        return {rack.name: observation["rack_type"]}
    removed: dict[str, str] = {}
    for name, kind in observation["entries"].items():
        remove_cellar_path(rack / name, kind)
        removed[name] = kind
    return removed


def assert_fresh_pour(
    name: str,
    preinstall: dict[str, int | str] | None,
    before_pour: dict[str, int | str] | None,
    after_pour: dict[str, int | str] | None,
) -> dict[str, bool]:
    """Require an observed absence checkpoint and a new post-install keg observation."""
    observed_absent_before_pour = before_pour is None
    observed_present_after_pour = after_pour is not None
    observed_changed = preinstall != after_pour
    if not observed_absent_before_pour:
        raise SystemExit(
            f"fresh-pour gate rejected retained keg {name}: "
            "expected_absent_before_pour=true observed_absent_before_pour=false"
        )
    if not observed_present_after_pour:
        raise SystemExit(
            f"fresh-pour gate rejected missing keg {name}: "
            "expected_present_after_pour=true observed_present_after_pour=false"
        )
    if not observed_changed:
        raise SystemExit(
            f"fresh-pour gate rejected unchanged keg {name}: "
            "expected_observation_changed=true observed_observation_changed=false"
        )
    return {
        "preinstall_present": preinstall is not None,
        "absent_before_pour": observed_absent_before_pour,
        "present_after_pour": observed_present_after_pour,
        "postinstall_receipt_observed": observed_present_after_pour,
        "postinstall_observation_differs_from_preinstall": observed_changed,
    }


def formula_shape(formula: dict, bottle_tag: str) -> dict:
    try:
        bottle = formula["bottle"]["stable"]
        artifact = bottle["files"][bottle_tag]
    except (KeyError, TypeError) as error:
        raise ValueError(
            f"formula {formula.get('name', '<unknown>')} has no stable {bottle_tag} bottle"
        ) from error
    return {
        "formula": formula["name"],
        "version": formula["versions"]["stable"],
        "revision": formula["revision"],
        "version_scheme": formula["version_scheme"],
        "dependencies": formula["dependencies"],
        "bottle_tag": bottle_tag,
        "bottle_rebuild": bottle["rebuild"],
        "url": artifact["url"],
        "sha256": artifact["sha256"],
    }


def keg_version(entry: dict) -> str:
    """Homebrew's on-disk keg name for a pinned entry.

    Homebrew appends the formula revision to the keg directory and to the version it reports in
    `brew info --json`, so a revision-1 build of 9.0.1 installs as "9.0.1_1" while the upstream
    version stays "9.0.1". Everything that names a KEG must use this; anything comparing the
    version the built binary reports about itself must not.
    """
    return entry["version"] if entry["revision"] == 0 else f"{entry['version']}_{entry['revision']}"


def assert_locked_graph(closure: list[dict], root_formula: str) -> None:
    by_name = {entry["formula"]: entry for entry in closure}
    if len(by_name) != len(closure):
        raise SystemExit("Darwin ffmpeg closure contains duplicate formula names")
    if root_formula not in by_name:
        raise SystemExit(f"Darwin ffmpeg closure omits root formula {root_formula}")

    indexes = {entry["formula"]: index for index, entry in enumerate(closure)}
    for entry in closure:
        missing = set(entry["dependencies"]) - set(by_name)
        if missing:
            raise SystemExit(f"closure omits dependencies of {entry['formula']}: {sorted(missing)}")
        if any(indexes[dependency] >= indexes[entry["formula"]] for dependency in entry["dependencies"]):
            raise SystemExit(f"closure is not topologically ordered at {entry['formula']}")

    reachable: set[str] = set()
    pending = [root_formula]
    while pending:
        name = pending.pop()
        if name in reachable:
            continue
        reachable.add(name)
        pending.extend(by_name[name]["dependencies"])
    if reachable != set(by_name):
        raise SystemExit(
            f"closure is not exact: reachable={sorted(reachable)} locked={sorted(by_name)}"
        )


def expected_runtime_dependencies(entry: dict, by_name: dict[str, dict]) -> dict[str, dict]:
    reachable: set[str] = set()
    pending = list(entry["dependencies"])
    while pending:
        name = pending.pop()
        if name in reachable:
            continue
        reachable.add(name)
        pending.extend(by_name[name]["dependencies"])
    direct = set(entry["dependencies"])
    return {
        name: {
            "version": by_name[name]["version"],
            "revision": by_name[name]["revision"],
            "bottle_rebuild": by_name[name]["bottle_rebuild"],
            "pkg_version": keg_version(by_name[name]),
            "declared_directly": name in direct,
        }
        for name in sorted(reachable)
    }


MAX_BOTTLE_METADATA_BYTES = 2 * 1024 * 1024


class BottleMetadataError(ValueError):
    """The authenticated archive cannot supply an unambiguous metadata shape."""


def _read_bottle_metadata_member(
    archive: tarfile.TarFile,
    member: tarfile.TarInfo,
    *,
    label: str,
) -> bytes:
    if not member.isfile():
        raise BottleMetadataError(f"{label} is not a regular file: {member.name}")
    if member.size > MAX_BOTTLE_METADATA_BYTES:
        raise BottleMetadataError(
            f"{label} exceeds {MAX_BOTTLE_METADATA_BYTES} bytes: {member.name}"
        )
    extracted = archive.extractfile(member)
    if extracted is None:
        raise BottleMetadataError(f"cannot read {label}: {member.name}")
    payload = extracted.read(MAX_BOTTLE_METADATA_BYTES + 1)
    if len(payload) != member.size:
        raise BottleMetadataError(f"truncated {label}: {member.name}")
    return payload


def _strip_ruby_comment(line: str) -> str:
    """Remove a Ruby comment without treating # inside a quoted string as a comment."""
    quote: str | None = None
    escaped = False
    for index, character in enumerate(line):
        if escaped:
            escaped = False
            continue
        if quote is not None and character == "\\":
            escaped = True
            continue
        if character in {'"', "'"}:
            if quote == character:
                quote = None
            elif quote is None:
                quote = character
            continue
        if character == "#" and quote is None:
            return line[:index].rstrip()
    return line.rstrip()


def _dependency_condition_applies(condition: str, bottle_tag: str) -> bool:
    """Evaluate the small platform predicate subset used by authenticated declarations."""
    fixed_predicates = {
        "OS.mac?": True,
        "OS.linux?": False,
        "Hardware::CPU.arm?": True,
        "Hardware::CPU.intel?": False,
    }
    if condition in fixed_predicates:
        return fixed_predicates[condition]

    # The x264 formula retains a compiler fallback for pre-Xcode-10 hosts. An arm64 Tahoe bottle
    # cannot have been authored for that toolchain. Keep this narrow and fail closed if the formula
    # changes the predicate or if a different bottle platform ever needs it.
    if (
        condition == "DevelopmentTools.clang_build_version <= 902"
        and bottle_tag == "arm64_tahoe"
    ):
        return False
    raise BottleMetadataError(f"unsupported conditional dependency predicate: {condition!r}")


def _formula_declarations(source: str, bottle_tag: str) -> dict:
    """Statically read declarative formula facts without evaluating Ruby or loading Homebrew."""
    revision: int | None = None
    version_scheme: int | None = None
    explicit_version: str | None = None
    dependencies: set[str] = set()
    class_scope: str | None = None
    formula_class_open = False
    formula_class_closed = False

    for line_number, original_line in enumerate(source.splitlines(), start=1):
        line = _strip_ruby_comment(original_line)
        stripped = line.strip()
        if not stripped:
            continue
        indentation = len(line) - len(line.lstrip(" "))
        if original_line.startswith("\t"):
            raise BottleMetadataError(f"tab-indented formula declaration at line {line_number}")

        formula_class = re.fullmatch(
            r"class\s+[A-Z][A-Za-z0-9]*(?:::[A-Z][A-Za-z0-9]*)*\s*<\s*Formula",
            stripped,
        )
        if indentation == 0 and formula_class is not None:
            if formula_class_open or formula_class_closed:
                raise BottleMetadataError("formula source has multiple Formula classes")
            formula_class_open = True
            continue
        if indentation == 0 and stripped == "end" and formula_class_open:
            formula_class_open = False
            formula_class_closed = True
            class_scope = None
            continue

        if indentation == 2 and stripped == "end":
            class_scope = None
            continue
        if indentation == 2:
            block = re.fullmatch(
                r"([a-z_][a-z0-9_!?]*)(?:\s+.*?)?\s+do(?:\s+\|.*\|)?",
                stripped,
            )
            if block is not None:
                class_scope = block.group(1)

        if indentation == 2 and stripped.startswith("revision "):
            if not formula_class_open:
                raise BottleMetadataError(f"revision outside Formula class at line {line_number}")
            match = re.fullmatch(r"revision\s+([0-9]+)", stripped)
            if match is None or revision is not None:
                raise BottleMetadataError(f"ambiguous revision declaration at line {line_number}")
            revision = int(match.group(1))
            continue
        if indentation == 2 and stripped.startswith("version_scheme "):
            if not formula_class_open:
                raise BottleMetadataError(
                    f"version_scheme outside Formula class at line {line_number}"
                )
            match = re.fullmatch(r"version_scheme\s+([0-9]+)", stripped)
            if match is None or version_scheme is not None:
                raise BottleMetadataError(
                    f"ambiguous version_scheme declaration at line {line_number}"
                )
            version_scheme = int(match.group(1))
            continue
        if indentation == 2 and stripped.startswith("version "):
            if not formula_class_open:
                raise BottleMetadataError(f"version outside Formula class at line {line_number}")
            match = re.fullmatch(r'version\s+(["\'])([^"\']+)\1', stripped)
            if match is None or explicit_version is not None:
                raise BottleMetadataError(f"ambiguous version declaration at line {line_number}")
            explicit_version = match.group(2)
            continue

        if "depends_on" not in stripped:
            continue
        if not stripped.startswith("depends_on"):
            raise BottleMetadataError(
                f"unsupported dependency expression at line {line_number}: {stripped!r}"
            )
        if not formula_class_open:
            raise BottleMetadataError(f"dependency outside Formula class at line {line_number}")
        match = re.fullmatch(r'depends_on\s+(["\'])([^"\']+)\1(.*)', stripped)
        if match is None:
            raise BottleMetadataError(
                f"unsupported dependency declaration at line {line_number}: {stripped!r}"
            )
        name = match.group(2)
        remainder = match.group(3).strip()

        if indentation == 2:
            if class_scope is not None:
                raise BottleMetadataError(
                    f"dependency declaration has ambiguous scope at line {line_number}: "
                    f"{class_scope}"
                )
            scope_applies = True
        elif indentation == 4 and class_scope in {
            "head",
            "on_arm",
            "on_intel",
            "on_linux",
            "on_macos",
        }:
            scope_applies = class_scope in {"on_arm", "on_macos"}
        else:
            raise BottleMetadataError(
                f"dependency declaration has unsupported scope at line {line_number}: "
                f"{class_scope!r}"
            )

        condition_applies = True
        conditional = re.fullmatch(r"(?:(.*?)\s+)?(if|unless)\s+(.+)", remainder)
        if conditional is not None:
            remainder, keyword, expression = conditional.groups()
            remainder = (remainder or "").strip()
            condition_applies = _dependency_condition_applies(expression, bottle_tag)
            if keyword == "unless":
                condition_applies = not condition_applies

        tags: set[str] = set()
        if remainder:
            tag_match = re.fullmatch(r"=>\s*:(build|test|no_linkage)", remainder)
            tag_list_match = re.fullmatch(
                r"=>\s*\[\s*((?::(?:build|test|no_linkage)\s*,?\s*)+)\]",
                remainder,
            )
            if tag_match is not None:
                tags = {tag_match.group(1)}
            elif tag_list_match is not None:
                tags = set(re.findall(r":(build|test|no_linkage)", tag_list_match.group(1)))
            else:
                raise BottleMetadataError(
                    f"unsupported dependency tags at line {line_number}: {remainder!r}"
                )

        if scope_applies and condition_applies and not tags.intersection({"build", "test"}):
            if name in dependencies:
                raise BottleMetadataError(
                    f"duplicate runtime dependency at line {line_number}: {name}"
                )
            dependencies.add(name)

    if formula_class_open or not formula_class_closed:
        raise BottleMetadataError("formula source has no complete Formula class")

    return {
        "revision": revision or 0,
        "version_scheme": version_scheme or 0,
        "explicit_version": explicit_version,
        "dependencies": sorted(dependencies),
    }


def bottle_archive_shape(path: Path, entry: dict) -> tuple[dict, int]:
    """Read identity and graph facts only from authenticated bottle archive members."""
    formula_index_accesses = 0
    try:
        with tarfile.open(path, "r:gz") as archive:
            members = archive.getmembers()
            if not members:
                raise BottleMetadataError("archive is empty")
            member_paths: list[tuple[str, ...]] = []
            for member in members:
                if member.name.startswith("/") or "\\" in member.name:
                    raise BottleMetadataError(f"unsafe archive member path: {member.name!r}")
                parts = tuple(part for part in member.name.rstrip("/").split("/") if part)
                if len(parts) < 2 or any(part in {".", ".."} for part in parts):
                    raise BottleMetadataError(f"invalid archive member path: {member.name!r}")
                member_paths.append(parts)

            keg_roots = {(parts[0], parts[1]) for parts in member_paths}
            if len(keg_roots) != 1:
                raise BottleMetadataError(f"archive has ambiguous keg roots: {sorted(keg_roots)!r}")
            archive_formula, archive_keg_version = next(iter(keg_roots))
            metadata_root = f"{archive_formula}/{archive_keg_version}"
            expected_members = {
                "SPDX metadata": f"{metadata_root}/sbom.spdx.json",
                "formula declarations": (
                    f"{metadata_root}/.brew/{archive_formula}.rb"
                ),
            }
            selected: dict[str, tarfile.TarInfo] = {}
            for label, member_name in expected_members.items():
                matches = [member for member in members if member.name == member_name]
                if len(matches) != 1:
                    raise BottleMetadataError(
                        f"archive requires exactly one {label} member {member_name!r}; "
                        f"observed={len(matches)}"
                    )
                selected[label] = matches[0]

            sbom = json.loads(
                _read_bottle_metadata_member(
                    archive, selected["SPDX metadata"], label="SPDX metadata"
                ).decode("utf-8")
            )
            if not isinstance(sbom, dict) or sbom.get("spdxVersion") != "SPDX-2.3":
                raise BottleMetadataError("archive has no SPDX-2.3 document")
            packages = sbom.get("packages")
            document_describes = sbom.get("documentDescribes")
            if not isinstance(packages, list) or not isinstance(document_describes, list):
                raise BottleMetadataError("SPDX document omits packages or documentDescribes")
            described = [
                package
                for package in packages
                if isinstance(package, dict) and package.get("SPDXID") in document_describes
            ]
            if len(described) != 1:
                raise BottleMetadataError(
                    f"SPDX document must describe exactly one source package; observed={len(described)}"
                )
            package_name = described[0].get("name")
            package_version = described[0].get("versionInfo")
            if not isinstance(package_name, str) or not package_name:
                raise BottleMetadataError("SPDX source package has no name")
            if not isinstance(package_version, str) or not package_version:
                raise BottleMetadataError("SPDX source package has no versionInfo")
            if package_name != archive_formula:
                raise BottleMetadataError(
                    f"SPDX/path formula disagreement: spdx={package_name!r} "
                    f"path={archive_formula!r}"
                )

            if archive_keg_version == package_version:
                archive_revision = 0
            else:
                revised = re.fullmatch(
                    re.escape(package_version) + r"_([1-9][0-9]*)",
                    archive_keg_version,
                )
                if revised is None:
                    raise BottleMetadataError(
                        f"SPDX/path version disagreement: spdx={package_version!r} "
                        f"path={archive_keg_version!r}"
                    )
                archive_revision = int(revised.group(1))

            formula_source = _read_bottle_metadata_member(
                archive,
                selected["formula declarations"],
                label="formula declarations",
            ).decode("utf-8")
            declarations = _formula_declarations(formula_source, entry["bottle_tag"])
            if (
                declarations["explicit_version"] is not None
                and declarations["explicit_version"] != package_version
            ):
                raise BottleMetadataError(
                    f"SPDX/formula version disagreement: spdx={package_version!r} "
                    f"formula={declarations['explicit_version']!r}"
                )
            if declarations["revision"] != archive_revision:
                raise BottleMetadataError(
                    f"path/formula revision disagreement: path={archive_revision} "
                    f"formula={declarations['revision']}"
                )
    except (
        BottleMetadataError,
        KeyError,
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
        tarfile.TarError,
    ) as error:
        raise SystemExit(
            f"unusable authenticated metadata in pinned bottle {entry['formula']}: "
            f"{type(error).__name__}: {error}; "
            f"formula_index_accesses={formula_index_accesses}"
        ) from error

    return (
        {
            "formula": package_name,
            "version": package_version,
            "revision": archive_revision,
            "version_scheme": declarations["version_scheme"],
            "dependencies": declarations["dependencies"],
        },
        formula_index_accesses,
    )


def assert_bottle_archive_shape(path: Path, entry: dict) -> int:
    expected = {
        "formula": entry["formula"],
        "version": entry["version"],
        "revision": entry["revision"],
        "version_scheme": entry["version_scheme"],
        "dependencies": sorted(entry["dependencies"]),
    }
    observed, formula_index_accesses = bottle_archive_shape(path, entry)
    if observed != expected:
        raise SystemExit(
            f"authenticated archive metadata drift in pinned bottle {entry['formula']}: "
            f"expected {expected}, observed {observed}"
        )
    return formula_index_accesses


def observed_runtime_dependencies(receipt: dict, context: str) -> dict[str, dict]:
    records = receipt.get("runtime_dependencies")
    if not isinstance(records, list):
        raise SystemExit(f"{context} has no runtime dependency receipt")
    observed: dict[str, dict] = {}
    for record in records:
        try:
            name = record["full_name"]
            shape = {
                "version": record["version"],
                "revision": record["revision"],
                "bottle_rebuild": record["bottle_rebuild"],
                "pkg_version": record["pkg_version"],
                "declared_directly": record["declared_directly"],
            }
        except (KeyError, TypeError) as error:
            raise SystemExit(f"invalid runtime dependency in {context}: {record!r}") from error
        if name in observed:
            raise SystemExit(f"duplicate runtime dependency {name} in {context}")
        observed[name] = shape
    return observed


def assert_receipt_identity(
    receipt: dict,
    entry: dict,
    *,
    context: str,
    require_poured: bool,
) -> None:
    try:
        source_versions = receipt["source"]["versions"]
        observed_source = {
            "version": source_versions["stable"],
            "version_scheme": source_versions["version_scheme"],
        }
    except (KeyError, TypeError) as error:
        raise SystemExit(f"invalid source metadata in {context}") from error
    expected_source = {
        "version": entry["version"],
        "version_scheme": entry["version_scheme"],
    }
    if observed_source != expected_source:
        raise SystemExit(
            f"source metadata drift in {context}: expected {expected_source}, "
            f"observed {observed_source}"
        )
    if receipt.get("built_as_bottle") is not True:
        raise SystemExit(f"{context} is not recorded as built as a bottle")
    if require_poured and receipt.get("poured_from_bottle") is not True:
        raise SystemExit(f"{context} is not recorded as poured from a bottle")


def assert_receipt_shape(
    receipt: dict,
    entry: dict,
    by_name: dict[str, dict],
    *,
    context: str,
    require_poured: bool,
) -> None:
    assert_receipt_identity(
        receipt,
        entry,
        context=context,
        require_poured=require_poured,
    )

    expected_runtime = expected_runtime_dependencies(entry, by_name)
    observed_runtime = observed_runtime_dependencies(receipt, context)
    if observed_runtime != expected_runtime:
        raise SystemExit(
            f"runtime closure drift in {context}: expected {expected_runtime}, "
            f"observed {observed_runtime}"
        )


def normalize_runtime_receipt(path: Path, entry: dict, by_name: dict[str, dict]) -> dict:
    """Replace Homebrew's live-index-derived mutable dependency receipt with the pinned graph."""
    try:
        receipt = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"invalid installed Homebrew receipt for {entry['formula']}: {path}") from error
    assert_receipt_identity(
        receipt,
        entry,
        context=f"installed keg {entry['formula']}",
        require_poured=True,
    )
    receipt["runtime_dependencies"] = [
        {"full_name": name, **shape}
        for name, shape in expected_runtime_dependencies(entry, by_name).items()
    ]
    temporary = path.with_name(f".{path.name}.dulcet-{os.getpid()}")
    try:
        temporary.write_text(json.dumps(receipt, indent=2) + "\n")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    return receipt


def advise_live_shape(closure: list[dict]) -> tuple[str, list[dict]]:
    """Report refresh availability without making the live resolver part of installation."""
    observed_live_closure: list[dict] = []
    drift: list[tuple[str, dict, dict]] = []
    try:
        for expected in closure:
            name = expected["formula"]
            quoted_name = urllib.parse.quote(name, safe="")
            request = urllib.request.Request(
                f"https://formulae.brew.sh/api/formula/{quoted_name}.json",
                headers={"User-Agent": "dulcet-darwin-conformance/1"},
            )
            with urllib.request.urlopen(request, timeout=10) as response:
                live_formula = json.load(response)
            live = formula_shape(live_formula, expected["bottle_tag"])
            if live != expected:
                drift.append((name, expected, live))
            observed_live_closure.append(live)
    except Exception as error:
        print(
            "DARWIN FFMPEG PIN ADVISORY advisory_status=unavailable "
            f"detail={str(error)!r}",
            file=sys.stderr,
        )
        return "unavailable", []

    if drift:
        print(
            f"DARWIN FFMPEG PIN REFRESH AVAILABLE formulas={len(drift)}/{len(closure)} "
            "advisory_status=refresh-available",
            file=sys.stderr,
        )
        for name, expected, live in drift:
            fields = sorted(
                key for key in set(expected) | set(live) if expected.get(key) != live.get(key)
            )
            print(
                f"  {name}: "
                + ", ".join(
                    f"{key} {expected.get(key)!r} -> {live.get(key)!r}" for key in fields
                ),
                file=sys.stderr,
            )
        return "refresh-available", observed_live_closure

    print(
        f"DARWIN FFMPEG PIN ADVISORY advisory_status=matches formulas={len(closure)}",
        file=sys.stderr,
    )
    return "matches", observed_live_closure


def main(pins_path: Path | None = None) -> None:
    pins_path = pins_path or Path(__file__).parent / "pins.json"
    pins = json.loads(pins_path.read_text())
    ffmpeg = pins["ffmpeg"]["darwin"]
    closure = ffmpeg["closure"]
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise SystemExit(
            f"Darwin ffmpeg pin requires Darwin/arm64, observed "
            f"{platform.system()}/{platform.machine()}"
        )
    assert_locked_graph(closure, ffmpeg["formula"])
    validate_pinned_bottle_closure(closure)

    names = [entry["formula"] for entry in closure]
    by_name = {entry["formula"]: entry for entry in closure}
    observed_keg_hashes: dict[str, str] = {}
    observed_bottle_sha256s: dict[str, str] = {}
    observed_formula_index_accesses = 0
    bottle_paths: dict[str, Path] = {}
    brew_cache = Path(run(["brew", "--cache"], capture=True))
    bottle_cache = brew_cache / "dulcet" / "darwin-conformance-bottles"
    for expected in closure:
        name = expected["formula"]
        bottle_path, observed_sha256, cache_hit = fetch_pinned_bottle(expected, bottle_cache)
        observed_formula_index_accesses += assert_bottle_archive_shape(
            bottle_path, expected
        )
        bottle_paths[name] = bottle_path
        observed_bottle_sha256s[name] = observed_sha256
        print(
            f"DARWIN BOTTLE VERIFIED formula={name} sha256={observed_sha256} "
            f"cache_hit={str(cache_hit).lower()} authenticated_archive_metadata_matches_pin=true "
            "formula_index_accesses=0"
        )

    live_shape_status, observed_live_closure = advise_live_shape(closure)

    cellar = Path(run(["brew", "--cellar"], capture=True))
    homebrew_prefix = Path(run(["brew", "--prefix"], capture=True))
    keg_paths = {
        expected["formula"]: cellar / expected["formula"] / keg_version(expected)
        for expected in closure
    }
    preinstall_kegs = {name: observe_keg(path) for name, path in keg_paths.items()}
    preinstall_racks = {name: observe_cellar_rack(cellar / name) for name in names}

    # Remove every installed member first, in reverse dependency order. This removes what Homebrew
    # itself still reports as installed, and only that; the rack checkpoint below covers the rest.
    for name in reversed(names):
        if installed_formula_versions(name):
            run(["brew", "uninstall", "--force", "--ignore-dependencies", name])

    # A pour reads more of `<cellar>/<formula>` than the pinned keg path: a hosted runner rejected
    # the pinned openssl@3 3.6.4 pour naming `Cellar/openssl@3/3.6.3 is not a directory`, an entry
    # at a version the closure does not pin. Homebrew does not remove an entry it can no longer
    # parse as an installed keg, and a pinned-path observation cannot see one at another version,
    # so an entry of that shape survives both and reaches the pour. Observe every rack, name and
    # remove whatever the uninstall left, then observe every rack again. Absence is asserted from
    # that second observation, never inferred from the removals having been attempted, and a rack
    # that is still occupied stops the run. This removal stays inside racks the uninstall above is
    # already asking Homebrew to empty: `--force` asks it to delete every installed version of the
    # formula. The runner-side cause of the leftover entry is not established.
    racks_after_uninstall = {name: observe_cellar_rack(cellar / name) for name in names}
    removed_rack_residue: dict[str, dict[str, str]] = {}
    for name in names:
        if rack_takes_no_part_in_a_pour(racks_after_uninstall[name]):
            continue
        removed_rack_residue[name] = remove_cellar_rack_residue(cellar, name)
    racks_before_pour = {name: observe_cellar_rack(cellar / name) for name in names}
    racks_observed_clear = [
        name for name in names if rack_takes_no_part_in_a_pour(racks_before_pour[name])
    ]
    occupied_racks = [name for name in names if name not in racks_observed_clear]
    if occupied_racks:
        raise SystemExit(
            "fresh-pour rack absence checkpoint could not clear "
            + " ".join(
                f"{name}={describe_rack(racks_before_pour[name])}" for name in occupied_racks
            )
        )
    for name, removed in removed_rack_residue.items():
        print(
            f"DARWIN CELLAR RACK CLEARED formula={name} "
            f"preinstall={describe_rack(preinstall_racks[name])} "
            f"after_uninstall={describe_rack(racks_after_uninstall[name])} "
            f"removed={describe_rack_entries(removed)} "
            f"before_pour={describe_rack(racks_before_pour[name])}"
        )
    print(
        f"DARWIN CELLAR RACKS OBSERVED formulas={len(names)} "
        f"racks_clear_after_uninstall={len(names) - len(removed_rack_residue)} "
        f"racks_cleared_by_installer={len(removed_rack_residue)} "
        f"entries_removed={sum(len(removed) for removed in removed_rack_residue.values())} "
        f"racks_observed_clear_before_pour={len(racks_observed_clear)}"
    )

    # The pinned keg path is then observed on its own. The rack checkpoint above should already
    # have made a retained keg unreachable here, so this fires only if a rack was observed clear
    # and the pinned keg is present anyway. It stays because it is the observation
    # `assert_fresh_pour` consumes per formula, and because it reads the pour receipt as well as
    # the path.
    absent_before_pour = {name: observe_keg(path) for name, path in keg_paths.items()}
    retained = [name for name, observation in absent_before_pour.items() if observation is not None]
    if retained:
        raise SystemExit(
            f"fresh-pour absence checkpoint retained locked kegs: {','.join(retained)}"
        )

    # Pour every local bottle in the validated dependency order. The fail-closed archive metadata
    # check above rejects missing, ambiguous or inconsistent SPDX/path/formula declaration data;
    # this final hash binds the exact checked archive to the immediately following install attempt.
    for name in names:
        verify_bottle_checksum(bottle_paths[name], by_name[name])
        run(
            [
                "brew",
                "install",
                "--force",
                "--ignore-dependencies",
                str(bottle_paths[name]),
            ],
            local_homebrew_package=True,
        )

    observed_install_observations: dict[str, dict[str, bool]] = {}
    installed_receipts: dict[str, dict] = {}
    for expected in closure:
        name = expected["formula"]
        active_link = homebrew_prefix / "opt" / name
        try:
            active_prefix = active_link.resolve(strict=True)
        except OSError as error:
            raise SystemExit(f"locked Homebrew formula has no active prefix: {active_link}") from error
        expected_prefix = keg_paths[name].resolve(strict=True)
        if active_prefix != expected_prefix:
            raise SystemExit(
                f"active Homebrew keg drift for {name}: expected {expected_prefix}, "
                f"observed {active_prefix}"
            )
        receipt = normalize_runtime_receipt(
            active_prefix / "INSTALL_RECEIPT.json", expected, by_name
        )
        assert_receipt_shape(
            receipt,
            expected,
            by_name,
            context=f"installed keg {name}",
            require_poured=True,
        )
        installed_receipts[name] = receipt
        postinstall_keg = observe_keg(active_prefix)
        attestation = assert_fresh_pour(
            name,
            preinstall_kegs[name],
            absent_before_pour[name],
            postinstall_keg,
        )
        observed_install_observations[name] = attestation
        keg_sha256, keg_entries = keg_payload_sha256(active_prefix)
        observed_keg_hashes[name] = keg_sha256
        print(
            f"DARWIN KEG PAYLOAD formula={name} sha256={keg_sha256} entries={keg_entries} "
            f"preinstall_present={str(attestation['preinstall_present']).lower()} "
            f"absent_after_uninstall={str(attestation['absent_before_pour']).lower()} "
            f"present_after_install={str(attestation['present_after_pour']).lower()} "
            f"postinstall_receipt_observed={str(attestation['postinstall_receipt_observed']).lower()} "
            "postinstall_observation_differs_from_preinstall="
            f"{str(attestation['postinstall_observation_differs_from_preinstall']).lower()} "
            f"receipt_time={postinstall_keg['receipt_time']}"
        )

    rehashed_kegs = {name: keg_payload_sha256(keg_paths[name])[0] for name in names}
    if rehashed_kegs != observed_keg_hashes:
        raise SystemExit(
            f"installed Homebrew keg payload changed during verification: "
            f"first={observed_keg_hashes}, second={rehashed_kegs}"
        )
    installed_digest = hashlib.sha256(
        json.dumps(observed_keg_hashes, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    all_absent_after_uninstall = all(
        observation["absent_before_pour"]
        for observation in observed_install_observations.values()
    )
    all_present_after_install = all(
        observation["present_after_pour"]
        for observation in observed_install_observations.values()
    )
    all_postinstall_receipts_observed = all(
        observation["postinstall_receipt_observed"]
        for observation in observed_install_observations.values()
    )
    all_postinstall_observations_differ = all(
        observation["postinstall_observation_differs_from_preinstall"]
        for observation in observed_install_observations.values()
    )
    print(
        f"DARWIN KEG OBSERVATIONS PASS formulas={len(observed_install_observations)} "
        f"absent_after_uninstall={str(all_absent_after_uninstall).lower()} "
        f"present_after_install={str(all_present_after_install).lower()} "
        f"postinstall_receipts_observed={str(all_postinstall_receipts_observed).lower()} "
        "postinstall_observations_differ_from_preinstall="
        f"{str(all_postinstall_observations_differ).lower()} "
        f"payload_hashes_match_second_in_run=true aggregate_sha256={installed_digest}"
    )

    version_line = run([ffmpeg["path"], "-version"], capture=True).splitlines()[0]
    try:
        observed_version = require_ffmpeg_version(version_line, ffmpeg["version"])
    except ValueError as error:
        raise SystemExit(f"installed {error}") from error
    encoders = run([ffmpeg["path"], "-hide_banner", "-encoders"], capture=True)
    observed_encoder_names = {
        fields[1]
        for line in encoders.splitlines()
        if len(fields := line.split()) >= 2
    }
    observed_required_encoders = sorted(
        set(ffmpeg["required_encoders"]) & observed_encoder_names
    )
    missing_encoders = sorted(set(ffmpeg["required_encoders"]) - observed_encoder_names)
    if missing_encoders:
        raise SystemExit(f"locked ffmpeg omits required corpus encoders: {missing_encoders}")

    expected_closure_digest = hashlib.sha256(
        json.dumps(closure, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    observed_live_closure_digest = (
        hashlib.sha256(
            json.dumps(observed_live_closure, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()
        if observed_live_closure
        else "unavailable"
    )
    observed_bottle_digest = hashlib.sha256(
        json.dumps(observed_bottle_sha256s, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()
    print(
        f"DARWIN FFMPEG CLOSURE PASS expected_root={ffmpeg['version']} "
        f"observed_root={observed_version} expected_formulas={len(closure)} "
        f"observed_formulas={len(observed_keg_hashes)} "
        f"expected_encoders={','.join(sorted(ffmpeg['required_encoders']))} "
        f"observed_encoders={','.join(observed_required_encoders)} "
        f"expected_closure_sha256={expected_closure_digest} "
        f"authenticated_archive_metadata_matching_pin={len(bottle_paths)} "
        f"formula_index_accesses={observed_formula_index_accesses} "
        f"installed_receipts_matching_pin={len(installed_receipts)} "
        f"live_shape_status={live_shape_status} "
        f"observed_live_closure_sha256={observed_live_closure_digest} "
        f"observed_bottle_sha256={observed_bottle_digest}"
    )


if __name__ == "__main__":
    main()
