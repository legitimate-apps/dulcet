#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import tarfile
import tempfile
import urllib.request


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description="Fetch and verify the pinned Darwin Navidrome release.")
    parser.add_argument("--output", required=True)
    args = parser.parse_args()

    pins = json.loads((Path(__file__).parent / "pins.json").read_text())
    navidrome = pins["navidrome"]
    darwin = navidrome["darwin"]
    observed_system = platform.system()
    observed_architecture = platform.machine()
    if observed_system != "Darwin" or observed_architecture != darwin["architecture"]:
        raise SystemExit(
            f"Darwin harness requires {darwin['architecture']}, "
            f"observed {observed_system}/{observed_architecture}"
        )

    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="dulcet-navidrome-download-") as temporary:
        archive = Path(temporary) / darwin["asset"]
        with urllib.request.urlopen(darwin["url"], timeout=60) as response, archive.open("wb") as target:
            while block := response.read(1024 * 1024):
                target.write(block)
        observed_sha256 = sha256(archive)
        if observed_sha256 != darwin["sha256"]:
            raise SystemExit(
                f"Navidrome asset checksum mismatch: expected {darwin['sha256']}, "
                f"observed {observed_sha256}"
            )

        with tarfile.open(archive, "r:gz") as bundle:
            for member in bundle.getmembers():
                resolved = (output / member.name).resolve()
                if output != resolved and output not in resolved.parents:
                    raise SystemExit(f"unsafe Navidrome archive member: {member.name}")
            bundle.extractall(output, filter="data")

    binary = output / "navidrome"
    if not binary.is_file():
        raise SystemExit("verified Navidrome archive did not contain the navidrome binary")
    binary.chmod(binary.stat().st_mode | 0o111)
    version = subprocess.run([str(binary), "--version"], text=True, capture_output=True, check=True)
    combined = version.stdout + version.stderr
    version_match = re.search(r"(?<![0-9.])([0-9]+\.[0-9]+\.[0-9]+)(?![0-9.])", combined)
    observed_version = version_match.group(1) if version_match else None
    if observed_version != navidrome["version"]:
        raise SystemExit(
            f"Navidrome binary version mismatch: expected {navidrome['version']}, "
            f"observed {observed_version!r}; banner={combined.strip()}"
        )
    print(
        f"DARWIN NAVIDROME PASS expected_version={navidrome['version']} "
        f"observed_version={observed_version} expected_arch={darwin['architecture']} "
        f"observed_arch={observed_architecture} expected_sha256={darwin['sha256']} "
        f"observed_sha256={observed_sha256}"
    )


if __name__ == "__main__":
    main()
