#!/usr/bin/env python3

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import tarfile
import tempfile
import urllib.request


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def main() -> None:
    parser = argparse.ArgumentParser(description="Fetch and verify the pinned Darwin Navidrome release.")
    parser.add_argument("--output", required=True)
    args = parser.parse_args()

    pins = json.loads((Path(__file__).parent / "pins.json").read_text())
    navidrome = pins["navidrome"]
    darwin = navidrome["darwin"]
    if platform.system() != "Darwin" or platform.machine() != darwin["architecture"]:
        raise SystemExit(
            f"Darwin harness requires {darwin['architecture']}, observed {platform.system()}/{platform.machine()}"
        )

    output = Path(args.output).resolve()
    output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="dulcet-navidrome-download-") as temporary:
        archive = Path(temporary) / darwin["asset"]
        with urllib.request.urlopen(darwin["url"], timeout=60) as response, archive.open("wb") as target:
            while block := response.read(1024 * 1024):
                target.write(block)
        observed = sha256(archive)
        if observed != darwin["sha256"]:
            raise SystemExit(f"Navidrome asset checksum mismatch: expected {darwin['sha256']}, observed {observed}")

        with tarfile.open(archive, "r:gz") as bundle:
            for member in bundle.getmembers():
                resolved = (output / member.name).resolve()
                if output != resolved and output not in resolved.parents:
                    raise SystemExit(f"unsafe Navidrome archive member: {member.name}")
            bundle.extractall(output, filter="data")

    binary = output / "navidrome"
    if not binary.is_file():
        raise SystemExit("verified Navidrome archive did not contain the navidrome binary")
    binary.chmod(binary.stat().st_mode | 0o111)
    version = subprocess.run([str(binary), "--version"], text=True, capture_output=True, check=True)
    combined = version.stdout + version.stderr
    if navidrome["version"] not in combined:
        raise SystemExit(f"Navidrome binary did not report {navidrome['version']}: {combined.strip()}")
    print(
        f"DARWIN NAVIDROME PASS version={navidrome['version']} arch={darwin['architecture']} "
        f"sha256={darwin['sha256']}"
    )


if __name__ == "__main__":
    main()
