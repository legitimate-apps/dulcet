#!/usr/bin/env python3
"""The second, Navidrome-default `PurgeMissing` conformance server (design spec §16.11, CONF-74).

The fixture server purges missing files (`PurgeMissing = "always"`). Navidrome's default keeps them,
and the two answer a removed album differently, so the reader's gone-ness rules are pinned against
both. This tool prepares and bootstraps the second one; the caller starts the process (a native
binary on Darwin, a container on Linux) exactly as it starts the fixture server.

  prepare    copy the reader albums out of a generated corpus into a fresh music folder
  bootstrap  wait for the server, create the fixed admin, and wait for its first scan to finish

The configuration is the fixture's with only `PurgeMissing` left unset (`render-config
--purge-missing server-default`), so the two servers differ in exactly the setting under test.

Never point this at a personal or production server: the suite moves files in its music folder.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import secrets
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ADMIN_USER = "dulcet-admin"
ADMIN_PASSWORD = "dulcet-ci-canary-password"
# The albums the reader suite needs on this server: the one CONF-74 removes and restores, and one
# that is never touched, so a removal that emptied the whole library cannot read as a removal.
READER_ALBUMS = ("Double Lines", "Long Titles")
SENTINEL_LAST_SCAN = "0001-01-01T00:00:00Z"


def prepare(corpus: Path, music_folder: Path) -> None:
    if not (corpus / "corpus-manifest.json").is_file():
        raise SystemExit(f"not a generated corpus (no corpus-manifest.json): {corpus}")
    if music_folder.exists() and any(music_folder.iterdir()):
        raise SystemExit(f"refusing to reuse a non-empty music folder: {music_folder}")
    music_folder.mkdir(parents=True, exist_ok=True)
    copied = []
    for album in READER_ALBUMS:
        source = corpus / album
        files = sorted(path for path in source.rglob("*") if path.is_file())
        if not files:
            raise SystemExit(f"corpus album is missing or empty: {source}")
        shutil.copytree(source, music_folder / album)
        copied.append({"album": album, "files": len(files)})
    print(f"OBSERVED purge-default corpus albums={json.dumps(copied, sort_keys=True)}")


def request_json(url: str, *, method: str = "GET", body: dict | None = None) -> dict:
    headers = {"Accept": "application/json"}
    payload = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        payload = json.dumps(body).encode()
    request = urllib.request.Request(url, data=payload, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode(errors="replace").replace(ADMIN_PASSWORD, "<redacted>")
        raise SystemExit(f"{method} {urllib.parse.urlsplit(url).path} returned HTTP {error.code}: {detail}")


def scan_status(base_url: str) -> dict:
    salt = secrets.token_hex(16)
    token = hashlib.md5((ADMIN_PASSWORD + salt).encode(), usedforsecurity=False).hexdigest()
    query = urllib.parse.urlencode(
        {"u": ADMIN_USER, "t": token, "s": salt, "v": "1.16.1", "c": "dulcet-conformance", "f": "json"}
    )
    envelope = request_json(f"{base_url}/rest/getScanStatus.view?{query}")["subsonic-response"]
    if envelope.get("status") != "ok":
        raise SystemExit(f"getScanStatus failed: {envelope.get('error')}")
    return envelope["scanStatus"]


def bootstrap(base_url: str, timeout_seconds: float) -> None:
    deadline = time.monotonic() + timeout_seconds
    attempts = 0
    while True:
        attempts += 1
        try:
            with urllib.request.urlopen(f"{base_url}/ping", timeout=2) as response:
                if response.status == 200:
                    break
        except (OSError, urllib.error.URLError):
            pass
        if time.monotonic() >= deadline:
            raise SystemExit(f"purge-default server did not answer /ping: attempts={attempts}")
        time.sleep(0.2)
    admin = request_json(
        f"{base_url}/auth/createAdmin",
        method="POST",
        body={"username": ADMIN_USER, "password": ADMIN_PASSWORD},
    )
    if not admin.get("token") or admin.get("isAdmin") is not True:
        raise SystemExit("fresh purge-default database did not create the fixed admin role")
    # A fresh database runs a full scan shortly after start whatever ScanOnStartup says (OBSERVED
    # on 0.63.2: "Full scan required after migration", ~2 s after start). Wait for it to finish with
    # a real stamp and rows, so the suite starts from a scanned library rather than racing that scan.
    polls = 0
    while True:
        polls += 1
        status = scan_status(base_url)
        stamp = status.get("lastScan")
        if (
            status.get("scanning") is False
            and stamp not in (None, SENTINEL_LAST_SCAN)
            and not status.get("error")
            and (status.get("count") or 0) > 0
        ):
            break
        if time.monotonic() >= deadline:
            observed = {key: status.get(key) for key in ("scanning", "count", "error")}
            raise SystemExit(f"purge-default first scan did not finish: polls={polls} status={observed}")
        time.sleep(0.2)
    print(
        f"OBSERVED purge-default bootstrap ping_attempts={attempts} scan_polls={polls} "
        f"count={status.get('count')} real_stamp=true"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    prepare_parser = commands.add_parser("prepare")
    prepare_parser.add_argument("--corpus", required=True, type=Path)
    prepare_parser.add_argument("--music-folder", required=True, type=Path)
    bootstrap_parser = commands.add_parser("bootstrap")
    bootstrap_parser.add_argument("--base-url", required=True)
    bootstrap_parser.add_argument("--timeout-seconds", type=float, default=60)
    args = parser.parse_args()
    if args.command == "prepare":
        prepare(args.corpus.resolve(), args.music_folder.resolve())
    else:
        bootstrap(args.base_url.rstrip("/"), args.timeout_seconds)
    return 0


if __name__ == "__main__":
    sys.exit(main())
