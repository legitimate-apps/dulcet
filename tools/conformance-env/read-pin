#!/usr/bin/env python3

import json
from pathlib import Path
import sys


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: read-pin dotted.path")
    value = json.loads((Path(__file__).parent / "pins.json").read_text())
    for component in sys.argv[1].split("."):
        if not isinstance(value, dict) or component not in value:
            raise SystemExit(f"unknown pin: {sys.argv[1]}")
        value = value[component]
    if isinstance(value, (dict, list)):
        print(json.dumps(value, separators=(",", ":")))
    else:
        print(value)


if __name__ == "__main__":
    main()
