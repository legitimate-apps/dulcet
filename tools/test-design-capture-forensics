#!/usr/bin/env python3

"""Negative control for deterministic design-capture mismatch forensics."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
import shutil
import struct
import subprocess
import sys
import tempfile


FORENSICS = Path(__file__).with_name("design_capture_forensics.py")


def write_bmp(path: Path, width: int, height: int, pixels: list[tuple[int, int, int]]) -> None:
    if len(pixels) != width * height:
        raise ValueError("fixture pixel count does not match its dimensions")
    stride = (width * 3 + 3) & ~3
    pixel_bytes = bytearray()
    for y in reversed(range(height)):
        row = bytearray()
        for red, green, blue in pixels[y * width:(y + 1) * width]:
            row.extend((blue, green, red))
        row.extend(b"\0" * (stride - len(row)))
        pixel_bytes.extend(row)

    pixel_offset = 14 + 40
    file_size = pixel_offset + len(pixel_bytes)
    header = struct.pack("<2sIHHI", b"BM", file_size, 0, 0, pixel_offset)
    dib = struct.pack(
        "<IiiHHIIiiII",
        40,
        width,
        height,
        1,
        24,
        0,
        len(pixel_bytes),
        2835,
        2835,
        0,
        0,
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(header + dib + pixel_bytes)


def assert_equal(observed: object, expected: object, label: str) -> None:
    if observed != expected:
        raise SystemExit(f"{label} mismatch: expected {expected!r}, observed {observed!r}")


def run_forensics(
    run_a: Path,
    run_b: Path,
    output: Path,
    diagnostics_a: Path | None = None,
    diagnostics_b: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    command = [
        sys.executable,
        str(FORENSICS),
        str(run_a),
        str(run_b),
        "--output",
        str(output),
    ]
    if diagnostics_a is not None and diagnostics_b is not None:
        command.extend([
            "--run-a-diagnostics",
            str(diagnostics_a),
            "--run-b-diagnostics",
            str(diagnostics_b),
        ])
    return subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )


def write_process_diagnostics(
    path: Path,
    filename: str,
    preflight_milliseconds: float,
    first_frame_milliseconds: float,
    stable_frame_milliseconds: float,
    settle_attempts: int,
) -> None:
    path.write_text(json.dumps({
        "schemaVersion": 1,
        "clock": "dispatch-monotonic-uptime",
        "durationUnit": "milliseconds",
        "comparedSurfacePolicy": "external-sidecar-outside-byte-compared-capture-root",
        "preflightDurationMilliseconds": preflight_milliseconds,
        "mainEntryToFirstRecordedStableFrameMilliseconds": stable_frame_milliseconds + 100,
        "mainEntryToDiagnosticsWriteMilliseconds": stable_frame_milliseconds + 110,
        "renders": [{
            "appearance": "light",
            "file": filename,
            "firstComparisonMatched": settle_attempts == 1,
            "fixtureState": "synthetic",
            "phase": "recorded-reference",
            "renderStartToFirstFrameMilliseconds": first_frame_milliseconds,
            "renderStartToStableFrameMilliseconds": stable_frame_milliseconds,
            "mainEntryToStableFrameMilliseconds": stable_frame_milliseconds + 100,
            "settleAttempts": settle_attempts,
            "variant": "reference",
        }],
    }, indent=2, sort_keys=True) + "\n")


def patterned_pixels(width: int, height: int) -> list[tuple[int, int, int]]:
    return [
        (
            10 + x * 20 + y * 3,
            20 + x * 5 + y * 17,
            30 + x * 7 + y * 11,
        )
        for y in range(height)
        for x in range(width)
    ]


def draw_text_like_element(
    pixels: list[tuple[int, int, int]],
    width: int,
    top: int,
    segments: tuple[tuple[int, int], ...],
) -> None:
    for y in range(top, top + 3):
        for min_x, max_x in segments:
            for x in range(min_x, max_x + 1):
                pixels[y * width + x] = (24, 24, 24)


def main() -> None:
    with tempfile.TemporaryDirectory(prefix="dulcet-forensics-negative-control-") as temporary:
        root = Path(temporary)
        run_a = root / "run-a"
        run_b = root / "run-b"
        output = root / "forensics"
        fixture = Path("fixtures") / "deliberate-delta.bmp"
        pixels_a = patterned_pixels(4, 3)
        pixels_b = list(pixels_a)
        pixels_b[1] = (
            pixels_a[1][0] + 2,
            pixels_a[1][1] - 3,
            pixels_a[1][2],
        )
        pixels_b[11] = (
            pixels_a[11][0] - 1,
            pixels_a[11][1],
            pixels_a[11][2] + 4,
        )
        write_bmp(run_a / fixture, 4, 3, pixels_a)
        write_bmp(run_b / fixture, 4, 3, pixels_b)

        result = run_forensics(run_a, run_b, output)
        if result.returncode != 1:
            raise SystemExit(
                "forensics negative control did not preserve the failing gate: "
                f"exit={result.returncode} output={result.stdout!r}"
            )

        report = json.loads((output / "report.json").read_text())
        assert_equal(report["schemaVersion"], 3, "report schema version")
        assert_equal(report["differingFileCount"], 1, "differing file count")
        assert_equal(report["differingImageCount"], 1, "differing image count")
        assert_equal(report["measurementErrorCount"], 0, "measurement error count")
        delta = report["differingImages"][0]["decodedPixelDelta"]
        assert_equal(
            delta["bestFitTranslation"]["classification"],
            "not-translation",
            "content-change translation classification",
        )
        assert_equal(
            delta["bestFitTranslation"]["shiftAppliedToRunB"],
            {"dy": 0, "dx": 0},
            "content-change best-fit shift",
        )
        assert_equal(delta["differingPixels"], 2, "differing pixel count")
        assert_equal(delta["totalPixels"], 12, "total pixel count")
        assert_equal(
            delta["differingPixelPercentage"],
            16.6666666667,
            "differing pixel percentage",
        )
        assert_equal(
            delta["boundingBoxInclusive"],
            {"minX": 1, "minY": 0, "maxX": 3, "maxY": 2, "width": 3, "height": 3},
            "bounding box",
        )
        assert_equal(
            delta["signedChannelDeltaDistribution"],
            {
                "red": [{"delta": -1, "pixels": 1}, {"delta": 2, "pixels": 1}],
                "green": [{"delta": -3, "pixels": 1}, {"delta": 0, "pixels": 1}],
                "blue": [{"delta": 0, "pixels": 1}, {"delta": 4, "pixels": 1}],
            },
            "signed per-channel distribution",
        )
        assert_equal(
            delta["absoluteChannelDeltaDistribution"],
            {
                "red": [{"delta": 1, "pixels": 1}, {"delta": 2, "pixels": 1}],
                "green": [{"delta": 0, "pixels": 1}, {"delta": 3, "pixels": 1}],
                "blue": [{"delta": 0, "pixels": 1}, {"delta": 4, "pixels": 1}],
            },
            "absolute per-channel distribution",
        )
        for expected_log_fragment in (
            "differing-pixels=2/12",
            "bbox=x=1..3,y=0..2,width=3,height=3",
            "R[-1:1,2:1] G[-3:1,0:1] B[0:1,4:1]",
            "classification=not-translation dy=0 dx=0",
        ):
            if expected_log_fragment not in result.stdout:
                raise SystemExit(
                    "forensics negative control log omitted "
                    f"{expected_log_fragment!r}: {result.stdout!r}"
                )

        for run in ("run-a", "run-b"):
            retained = output / "retained" / run / fixture
            original = root / run / fixture
            if not retained.is_file():
                raise SystemExit(f"missing retained negative-control image: {retained}")
            assert_equal(
                hashlib.sha256(retained.read_bytes()).hexdigest(),
                hashlib.sha256(original.read_bytes()).hexdigest(),
                f"retained {run} bytes",
            )

        second_output = root / "identical-forensics"
        shutil.copyfile(run_a / fixture, run_b / fixture)
        identical = run_forensics(run_a, run_b, second_output)
        if identical.returncode != 0:
            raise SystemExit(
                "forensics negative control rejected identical fixtures: "
                f"exit={identical.returncode} output={identical.stdout!r}"
            )

        shift_run_a = root / "shift-run-a"
        shift_run_b = root / "shift-run-b"
        shift_output = root / "shift-forensics"
        shift_fixture = Path("fixtures") / "known-shift.bmp"
        diagnostics_a = root / "run-a-diagnostics.json"
        diagnostics_b = root / "run-b-diagnostics.json"
        shift_width = 48
        shift_height = 36
        shift_a_pixels = [(224, 224, 224)] * (shift_width * shift_height)
        shift_b_pixels = list(shift_a_pixels)
        elements = (
            (5, ((8, 10), (14, 17), (22, 23), (31, 34))),
            (16, ((7, 9), (15, 16), (25, 28), (35, 37))),
            (25, ((9, 12), (18, 20), (27, 28), (33, 36))),
        )
        for index, (top, segments) in enumerate(elements):
            draw_text_like_element(shift_a_pixels, shift_width, top, segments)
            draw_text_like_element(
                shift_b_pixels,
                shift_width,
                top + (1 if index == 0 else 3),
                segments,
            )
        write_bmp(
            shift_run_a / shift_fixture,
            shift_width,
            shift_height,
            shift_a_pixels,
        )
        write_bmp(
            shift_run_b / shift_fixture,
            shift_width,
            shift_height,
            shift_b_pixels,
        )
        write_process_diagnostics(
            diagnostics_a,
            shift_fixture.name,
            preflight_milliseconds=120.0,
            first_frame_milliseconds=8.0,
            stable_frame_milliseconds=30.0,
            settle_attempts=1,
        )
        write_process_diagnostics(
            diagnostics_b,
            shift_fixture.name,
            preflight_milliseconds=90.0,
            first_frame_milliseconds=7.0,
            stable_frame_milliseconds=52.0,
            settle_attempts=2,
        )
        shifted = run_forensics(
            shift_run_a,
            shift_run_b,
            shift_output,
            diagnostics_a,
            diagnostics_b,
        )
        if shifted.returncode != 1:
            raise SystemExit(
                "known-shift fixture did not preserve the failing gate: "
                f"exit={shifted.returncode} output={shifted.stdout!r}"
            )
        shift_report = json.loads((shift_output / "report.json").read_text())
        process_diagnostics = shift_report["processDiagnostics"]
        assert_equal(
            process_diagnostics["renderComparisons"][0]["settleAttemptsDelta"],
            1,
            "known-shift settle attempt delta",
        )
        for run in ("run-a", "run-b"):
            if not (shift_output / "retained-diagnostics" / f"{run}.json").is_file():
                raise SystemExit(f"missing retained process diagnostics for {run}")
        shift_delta = shift_report["differingImages"][0]["decodedPixelDelta"]
        translation = shift_delta["bestFitTranslation"]
        assert_equal(
            translation["classification"],
            "translation-component",
            "known-shift classification",
        )
        assert_equal(
            translation["shiftAppliedToRunB"],
            {"dy": -3, "dx": 0},
            "known-shift best-fit shift",
        )
        assert_equal(
            translation["analysisRegionInclusive"],
            shift_delta["boundingBoxInclusive"],
            "known-shift translation analysis region",
        )
        assert_equal(
            translation["regionStartY"],
            shift_delta["boundingBoxInclusive"]["minY"],
            "known-shift translation region start",
        )
        if translation["residualAfter"] <= 0:
            raise SystemExit(
                "known-shift non-rigid fixture incorrectly has zero residual after shift"
            )
        if not 0.5 <= translation["residualFractionRemoved"] < 1.0:
            raise SystemExit(
                "known-shift residual fraction does not expose a translation component: "
                f'{translation["residualFractionRemoved"]!r}'
            )
        paired_spans = shift_delta["inkRowSpans"]["paired"]
        assert_equal(
            [
                (
                    element["runA"]["top"],
                    element["runB"]["top"],
                    element["topDelta"],
                    element["runA"]["height"],
                    element["runB"]["height"],
                    element["runA"]["gapFromPreviousTop"],
                    element["runB"]["gapFromPreviousTop"],
                )
                for element in paired_spans
            ],
            [
                (5, 6, 1, 3, 3, None, None),
                (16, 19, 3, 3, 3, 11, 13),
                (25, 28, 3, 3, 3, 9, 9),
            ],
            "known-shift paired ink spans",
        )
        no_information_bands = [
            band
            for band in shift_delta["verticalSelfSimilarity"]["bands"]
            if band["runComparison"] == "apparently-unchanged"
            and band["information"] == "no-information"
        ]
        if not no_information_bands:
            raise SystemExit(
                "known-shift uniform region was not labelled no-information: "
                f'{shift_delta["verticalSelfSimilarity"]["bands"]!r}'
            )
        for expected_log_fragment in (
            "classification=translation-component dy=-3 dx=0",
            f'region-start-y={translation["regionStartY"]}',
            f'residual-before={translation["residualBefore"]} '
            f'residual-after={translation["residualAfter"]}',
            "run-comparison=apparently-unchanged information=no-information",
            "element=0 run-a=5..7(height=3,gap-top=None) "
            "run-b=6..8(height=3,gap-top=None) top-delta=1 height-delta=0",
            "element=1 run-a=16..18(height=3,gap-top=11) "
            "run-b=19..21(height=3,gap-top=13) top-delta=3 height-delta=0",
            "DESIGN CAPTURE PROCESS TIMING clock=dispatch-monotonic-uptime",
            "run-a-attempts=1 run-b-attempts=2",
        ):
            if expected_log_fragment not in shifted.stdout:
                raise SystemExit(
                    "known-shift summary omitted "
                    f"{expected_log_fragment!r}: {shifted.stdout!r}"
                )

    print(
        "DESIGN CAPTURE FORENSICS NEGATIVE CONTROL PASS "
        "differing-pixels=2 total-pixels=12 "
        "bbox=x=1..3,y=0..2 retained-both=true exact-gate-failed=true "
        "identical-control-passed=true content-change-not-translation=true "
        "known-shift-classification=translation-component known-shift-dy=-3 "
        f'known-shift-residual-fraction-removed={translation["residualFractionRemoved"]:.10f} '
        "element-top-deltas=1,3,3 element-top-gaps-a=11,9 element-top-gaps-b=13,9 "
        "uniform-region=no-information ink-spans-compared=true"
        " process-diagnostics-retained=true settle-attempt-delta=1"
    )


if __name__ == "__main__":
    main()
