+#if os(iOS)
+private struct PrivateSlowAXProbe: UIViewRepresentable {
+    func makeUIView(context: Context) -> PrivateSlowAXButton {
+        let view = PrivateSlowAXButton(type: .custom)
+        view.isAccessibilityElement = true
+        view.accessibilityIdentifier = "dulcet.private.unrelated-button"
+        return view
+    }
+    func updateUIView(_ uiView: PrivateSlowAXButton, context: Context) {}
+}
+private final class PrivateSlowAXButton: UIButton {
+    private var delayed = false
+    override var accessibilityLabel: String? {
+        get {
+            let stack = Thread.callStackSymbols.joined(separator: "\n")
+            FileHandle.standardError.write(Data(("PRIVATE AX LABEL getter delayed=\(delayed)\n" + stack + "\n").utf8))
+            if !delayed && stack.contains("XCTFilteringTransformerIterator") { delayed = true; FileHandle.standardError.write(Data("PRIVATE AX HOLD seconds=120\n".utf8)); Thread.sleep(forTimeInterval: 120) }
+            return "Unrelated accessibility probe"
+        }
+        set {}
+    }
+}
+#endif
