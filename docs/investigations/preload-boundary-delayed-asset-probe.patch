+private final class DelayedBoundaryPCM: DulcetPlaybackResourceLoading, @unchecked Sendable {
+    private let held = SuspendedPlaybackResource()
+    private let data: Data
+    private let lock = NSLock()
+    private var scheduled = false
+    init(data: Data) { self.data = data }
+    var description: String { "DelayedBoundaryPCM(<redacted>)" }
+    func load(_ request: DulcetPlaybackResourceLoadRequest,
+              completion: @escaping @Sendable (DulcetPlaybackResourceLoadOutcome) -> Void
+    ) -> any DulcetPlaybackResourceLoadOperation {
+        let operation = held.load(request, completion: completion)
+        lock.lock()
+        let first = !scheduled
+        scheduled = true
+        lock.unlock()
+        if first {
+            print("DULCET PCM DELAY first-request holdSeconds=30")
+            DispatchQueue.global().asyncAfter(deadline: .now() + 30) { [self] in
+                print("DULCET PCM DELAY releasing-valid-PCM")
+                held.resume(with: data)
+            }
+        }
+        return operation
+    }
+}
