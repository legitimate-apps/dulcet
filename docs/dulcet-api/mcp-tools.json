    {
      "name": "search_catalog",
      "title": "Search catalog",
      "description": "Search artists, albums, tracks and playlists the user can see.",
      "x-dulcet-scope": "catalog:read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "artist",
                "album",
                "track",
                "playlist"
              ]
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "library",
              "favorites"
            ],
            "default": "all"
          },
          "cursor": {
            "type": "string",
            "description": "From a previous call's nextCursor; omit for the first page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "An opaque Dulcet id."
                },
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "name"
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
