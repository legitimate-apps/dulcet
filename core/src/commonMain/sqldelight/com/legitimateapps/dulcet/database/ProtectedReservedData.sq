CREATE TABLE mutation_outbox (
  server_id TEXT NOT NULL,
  target_id TEXT NOT NULL,
  field TEXT NOT NULL,
  value TEXT NOT NULL,
  local_sequence INTEGER NOT NULL CHECK (local_sequence >= 0),
  wall_clock INTEGER NOT NULL,
  PRIMARY KEY (server_id, target_id, field),
  UNIQUE (server_id, local_sequence)
);

CREATE TABLE download (
  server_id TEXT NOT NULL,
  raw_id TEXT NOT NULL,
  transcode_profile TEXT NOT NULL,
  download_id TEXT NOT NULL,
  state TEXT NOT NULL CHECK (
    state IN ('queued', 'downloading', 'interrupted', 'complete', 'stale')
  ),
  file_relative_path TEXT NOT NULL,
  expected_byte_length INTEGER,
  file_size_bytes INTEGER NOT NULL DEFAULT 0 CHECK (file_size_bytes >= 0),
  platform_resume_data BLOB,
  resume_data_created_at_wall_clock INTEGER,
  PRIMARY KEY (server_id, raw_id, transcode_profile),
  UNIQUE (download_id),
  UNIQUE (file_relative_path),
  CHECK (expected_byte_length IS NULL OR expected_byte_length >= 0)
);

-- The mutation outbox (spec §18.3, §16.20) --------------------------------------------------------
--
-- One row per pending (target_id, field): a later change to the same field REPLACES the row, which
-- is the compaction rule. `field` is KIND-QUALIFIED (`album.starred`, `artist.rating`): ids of
-- different kinds may be equal, and this table's schema is protected (§11.4), so the kind rides in
-- the key's existing column rather than a new one. `value` is a small JSON object of integers written
-- and read only by MutationOutbox.kt; it never carries a credential or a URL.
-- `local_sequence` is the seen-cache issue sequence taken when the change was made, so it orders the
-- change against every live read by when each was issued (never by a clock).

selectPendingMutations:
SELECT target_id, field, value, local_sequence, wall_clock FROM mutation_outbox
WHERE server_id = ?
ORDER BY local_sequence;

selectPendingMutation:
SELECT target_id, field, value, local_sequence, wall_clock FROM mutation_outbox
WHERE server_id = ? AND target_id = ? AND field = ?;

insertPendingMutation:
INSERT INTO mutation_outbox(server_id, target_id, field, value, local_sequence, wall_clock)
VALUES (?, ?, ?, ?, ?, ?);

replacePendingMutation:
UPDATE mutation_outbox SET value = :value, local_sequence = :local_sequence, wall_clock = :wall_clock
WHERE server_id = :server_id AND target_id = :target_id AND field = :field;

-- Written only while the row still holds the change that was sent; a change made during the send
-- has a newer local_sequence and is left alone.
updatePendingMutationValue:
UPDATE mutation_outbox SET value = :value
WHERE server_id = :server_id AND target_id = :target_id AND field = :field
  AND local_sequence = :local_sequence;

deletePendingMutationIfUnchanged:
DELETE FROM mutation_outbox
WHERE server_id = ? AND target_id = ? AND field = ? AND local_sequence = ?;

deletePendingMutation:
DELETE FROM mutation_outbox WHERE server_id = ? AND target_id = ? AND field = ?;

countPendingMutations:
SELECT count(*) FROM mutation_outbox WHERE server_id = ?;

-- Adopt-on-echo: the server acknowledged a set-to-value change, so the value it now holds is known.
-- Written into the seen-cache row under the issue sequence taken when the acknowledgement arrived,
-- and only when that outranks the row, so a read issued before the acknowledgement — which may
-- have been answered before the change was applied — can no longer overwrite it.

adoptArtistStarred:
UPDATE cache_artist SET starred = :starred,
  starred_at = CASE WHEN :starred = 1 THEN starred_at ELSE NULL END, issue_seq = :issue_seq
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

adoptAlbumStarred:
UPDATE cache_album SET starred = :starred,
  starred_at = CASE WHEN :starred = 1 THEN starred_at ELSE NULL END, issue_seq = :issue_seq
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

-- An identity-only track (pinned, metadata not yet read) takes the value but keeps its sequence, so
-- the read that refills its metadata is never rejected; that read's own value then wins, as it should.
adoptTrackStarred:
UPDATE cache_track SET starred = :starred,
  starred_at = CASE WHEN :starred = 1 THEN starred_at ELSE NULL END,
  issue_seq = CASE WHEN metadata_missing = 1 THEN issue_seq ELSE :issue_seq END
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

adoptArtistRating:
UPDATE cache_artist SET user_rating = :user_rating, issue_seq = :issue_seq
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

adoptAlbumRating:
UPDATE cache_album SET user_rating = :user_rating, issue_seq = :issue_seq
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

adoptTrackRating:
UPDATE cache_track SET user_rating = :user_rating,
  issue_seq = CASE WHEN metadata_missing = 1 THEN issue_seq ELSE :issue_seq END
WHERE server_id = :server_id AND raw_id = :raw_id AND issue_seq < :issue_seq;

-- Rebinding to a different USERNAME discards the account's queued changes in the same transaction
-- (SeenCacheStore.bind), so no crash can leave them to be sent as another person.
countMutationsForServer:
SELECT count(*) FROM mutation_outbox WHERE server_id = ?;

deleteMutationsForServer:
DELETE FROM mutation_outbox WHERE server_id = ?;
