countRowsForServer:
SELECT sum(row_count) FROM (
  SELECT count(*) AS row_count FROM connection_enrollment WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM server_route WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM discover_read WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM wishlist_snapshot WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM wish_intent WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM wish_receipt WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM wish_clock WHERE server_id = :server_id
  UNION ALL
  SELECT count(*) FROM mutation_outbox WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM download WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM download_policy_state WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM offline_media_retention WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM offline_library_settings WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM offline_source_snapshot WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM resume_position WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM scrobble_outbox WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM queue_state WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM active_queue WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM queue_entry WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM music_folder WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM artist WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM album WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM track WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM credit WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM playlist WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM playlist_entry WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM library_starred WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM genre WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM sync_checkpoint WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM sync_seen WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM sync_generation WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM deletion_reconciliation WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_binding WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM my_library_item WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM my_library_state WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_epoch WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_artist WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_album WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_track WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_playlist WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_credit WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_list WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_list_member WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_pin WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_lyrics WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_lyrics_layer WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM cache_lyrics_line WHERE server_id = :server_id
  UNION ALL SELECT count(*) FROM library_depth_entry WHERE server_id = :server_id
);

-- Every account id that owns a row in a table countRowsForServer counts, for the launch sweep of
-- accounts that are no longer saved (spec §14.7). The same tables, in the same order; a core test
-- compares the two lists.
selectServerIdsWithRows:
SELECT server_id FROM connection_enrollment
UNION SELECT server_id FROM server_route
UNION SELECT server_id FROM discover_read
UNION SELECT server_id FROM wishlist_snapshot
UNION SELECT server_id FROM wish_intent
UNION SELECT server_id FROM wish_receipt
UNION SELECT server_id FROM wish_clock
UNION SELECT server_id FROM mutation_outbox
UNION SELECT server_id FROM download
UNION SELECT server_id FROM download_policy_state
UNION SELECT server_id FROM offline_media_retention
UNION SELECT server_id FROM offline_library_settings
UNION SELECT server_id FROM offline_source_snapshot
UNION SELECT server_id FROM resume_position
UNION SELECT server_id FROM scrobble_outbox
UNION SELECT server_id FROM queue_state
UNION SELECT server_id FROM active_queue
UNION SELECT server_id FROM queue_entry
UNION SELECT server_id FROM music_folder
UNION SELECT server_id FROM artist
UNION SELECT server_id FROM album
UNION SELECT server_id FROM track
UNION SELECT server_id FROM credit
UNION SELECT server_id FROM playlist
UNION SELECT server_id FROM playlist_entry
UNION SELECT server_id FROM library_starred
UNION SELECT server_id FROM genre
UNION SELECT server_id FROM sync_checkpoint
UNION SELECT server_id FROM sync_seen
UNION SELECT server_id FROM sync_generation
UNION SELECT server_id FROM deletion_reconciliation
UNION SELECT server_id FROM cache_binding
UNION SELECT server_id FROM my_library_item
UNION SELECT server_id FROM my_library_state
UNION SELECT server_id FROM cache_epoch
UNION SELECT server_id FROM cache_artist
UNION SELECT server_id FROM cache_album
UNION SELECT server_id FROM cache_track
UNION SELECT server_id FROM cache_playlist
UNION SELECT server_id FROM cache_credit
UNION SELECT server_id FROM cache_list
UNION SELECT server_id FROM cache_list_member
UNION SELECT server_id FROM cache_pin
UNION SELECT server_id FROM cache_lyrics
UNION SELECT server_id FROM cache_lyrics_layer
UNION SELECT server_id FROM cache_lyrics_line
UNION SELECT server_id FROM library_depth_entry;

deleteMutationOutboxForServer:
DELETE FROM mutation_outbox WHERE server_id = ?;

deleteDownloadsForServer:
DELETE FROM download WHERE server_id = ?;

