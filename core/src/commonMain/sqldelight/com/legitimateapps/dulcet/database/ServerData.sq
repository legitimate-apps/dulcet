-- The seen-cache of one account (spec §16.10), including its binding and pins. Account removal
-- (§14.7) deletes the account's downloads in the same transaction, so no pin outlives its reason.
-- Disposable depth metadata follows the cache; accepted identity and media lineage survive a cache reset.
deleteSeenCacheForServer {
  DELETE FROM discover_read WHERE server_id = :server_id;
  DELETE FROM wishlist_snapshot WHERE server_id = :server_id;
  DELETE FROM library_depth_entry WHERE server_id = :server_id AND category NOT IN ('download.mediaBinding', 'account.serverIdentity');
  DELETE FROM my_library_item WHERE server_id = :server_id;
  DELETE FROM my_library_state WHERE server_id = :server_id;
  DELETE FROM cache_lyrics_line WHERE server_id = :server_id;
  DELETE FROM cache_lyrics_layer WHERE server_id = :server_id;
  DELETE FROM cache_lyrics WHERE server_id = :server_id;
  DELETE FROM cache_list_member WHERE server_id = :server_id;
  DELETE FROM cache_list WHERE server_id = :server_id;
  DELETE FROM cache_credit WHERE server_id = :server_id;
  DELETE FROM cache_track WHERE server_id = :server_id;
  DELETE FROM cache_album WHERE server_id = :server_id;
  DELETE FROM cache_artist WHERE server_id = :server_id;
  DELETE FROM cache_playlist WHERE server_id = :server_id;
  DELETE FROM cache_pin WHERE server_id = :server_id;
  DELETE FROM cache_epoch WHERE server_id = :server_id;
  DELETE FROM cache_binding WHERE server_id = :server_id;
}
