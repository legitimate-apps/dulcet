closeMissingMusicFolders:
UPDATE music_folder SET valid_to_generation = :generation
WHERE server_id = :server_id AND valid_to_generation IS NULL
  AND valid_from_generation < :generation
  AND NOT EXISTS (
    SELECT 1 FROM sync_seen
    WHERE sync_seen.server_id = :server_id AND sync_seen.generation = :generation
      AND sync_seen.stage = :stage AND sync_seen.raw_id = music_folder.raw_id
  );

