selectAlbumIdsAtGeneration:
SELECT raw_id FROM album
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY title COLLATE NOCASE, raw_id;

selectFoldersAtGeneration:
SELECT raw_id, name FROM music_folder
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY name COLLATE NOCASE, raw_id;

selectArtistsAtGeneration:
SELECT raw_id, name, media_source_id FROM artist
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY name COLLATE NOCASE, raw_id;

selectAlbumsAtGeneration:
SELECT raw_id, title, artist_name, artist_raw_id, year, duration_milliseconds,
  media_source_id, artwork_key
FROM album
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY title COLLATE NOCASE, raw_id;

selectTracksAtGeneration:
SELECT raw_id, album_raw_id, title, artist_name, artist_raw_id, album_title,
  disc_number, track_number, duration_milliseconds, source_container, media_source_id,
  artwork_key
FROM track
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY album_title COLLATE NOCASE, disc_number, track_number, title COLLATE NOCASE, raw_id;

selectPlaylistsAtGeneration:
SELECT raw_id, name FROM playlist
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY name COLLATE NOCASE, raw_id;

selectPlaylistEntriesAtGeneration:
SELECT playlist_raw_id, entry_position, track_raw_id FROM playlist_entry
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY playlist_raw_id, entry_position;

selectStarredAtGeneration:
SELECT item_kind, raw_id FROM library_starred
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY item_kind, raw_id;

selectGenresAtGeneration:
SELECT name, song_count, album_count FROM genre
WHERE server_id = :server_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation)
ORDER BY name COLLATE NOCASE;

deleteMusicFoldersFromGeneration:
DELETE FROM music_folder WHERE server_id = ? AND valid_from_generation = ?;
reopenMusicFoldersClosedAtGeneration:
UPDATE music_folder SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteArtistsFromGeneration:
DELETE FROM artist WHERE server_id = ? AND valid_from_generation = ?;
reopenArtistsClosedAtGeneration:
UPDATE artist SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteAlbumsFromGeneration:
DELETE FROM album WHERE server_id = ? AND valid_from_generation = ?;
reopenAlbumsClosedAtGeneration:
UPDATE album SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteTracksFromGeneration:
DELETE FROM track WHERE server_id = ? AND valid_from_generation = ?;
reopenTracksClosedAtGeneration:
UPDATE track SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteCreditsFromGenerationByOwnerKind:
DELETE FROM credit WHERE server_id = ? AND owner_kind = ? AND valid_from_generation = ?;
reopenCreditsClosedAtGenerationByOwnerKind:
UPDATE credit SET valid_to_generation = NULL
WHERE server_id = ? AND owner_kind = ? AND valid_to_generation = ?;
deletePlaylistsFromGeneration:
DELETE FROM playlist WHERE server_id = ? AND valid_from_generation = ?;
reopenPlaylistsClosedAtGeneration:
UPDATE playlist SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deletePlaylistEntriesFromGeneration:
DELETE FROM playlist_entry WHERE server_id = ? AND valid_from_generation = ?;
reopenPlaylistEntriesClosedAtGeneration:
UPDATE playlist_entry SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteStarredFromGeneration:
DELETE FROM library_starred WHERE server_id = ? AND valid_from_generation = ?;
reopenStarredClosedAtGeneration:
UPDATE library_starred SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;
deleteGenresFromGeneration:
DELETE FROM genre WHERE server_id = ? AND valid_from_generation = ?;
reopenGenresClosedAtGeneration:
UPDATE genre SET valid_to_generation = NULL WHERE server_id = ? AND valid_to_generation = ?;

insertSyncGeneration:
INSERT INTO sync_generation(generation, server_id, stability) VALUES (?, ?, ?);

selectSyncGeneration:
SELECT server_id, stability FROM sync_generation WHERE generation = ?;

insertDeletionReconciliations:
INSERT OR REPLACE INTO deletion_reconciliation(
  server_id, generation, raw_id, downloaded_reference_count, queue_reference_count
)
SELECT
  closed.server_id,
  :generation,
  closed.raw_id,
  (SELECT count(*) FROM download WHERE download.server_id = closed.server_id AND download.raw_id = closed.raw_id AND download.state = 'complete'),
  (SELECT count(*) FROM queue_entry WHERE queue_entry.server_id = closed.server_id AND queue_entry.raw_id = closed.raw_id)
FROM track AS closed
WHERE closed.server_id = :server_id
  AND closed.valid_to_generation = :generation
  AND NOT EXISTS (
    SELECT 1 FROM track AS replacement
    WHERE replacement.server_id = closed.server_id
      AND replacement.raw_id = closed.raw_id
      AND replacement.valid_from_generation <= :generation
      AND (replacement.valid_to_generation IS NULL OR :generation < replacement.valid_to_generation)
  )
  AND (
    EXISTS (SELECT 1 FROM download WHERE download.server_id = closed.server_id AND download.raw_id = closed.raw_id AND download.state = 'complete')
    OR EXISTS (SELECT 1 FROM queue_entry WHERE queue_entry.server_id = closed.server_id AND queue_entry.raw_id = closed.raw_id)
  );

selectVisibleDeletionReconciliations:
SELECT deletion_reconciliation.generation, raw_id, downloaded_reference_count, queue_reference_count
FROM deletion_reconciliation, schema_meta
WHERE deletion_reconciliation.server_id = ?
  AND deletion_reconciliation.generation <= schema_meta.committed_generation
  AND schema_meta.singleton_id = 1
ORDER BY deletion_reconciliation.generation DESC, raw_id;

selectDeletionReconciliationsForGeneration:
SELECT generation, raw_id, downloaded_reference_count, queue_reference_count
FROM deletion_reconciliation
WHERE server_id = :server_id AND generation = :generation
ORDER BY raw_id;

countVisibleTracksWithoutAlbum:
SELECT count(*)
FROM track, schema_meta
WHERE track.server_id = :server_id
  AND schema_meta.singleton_id = 1
  AND track.album_raw_id IS NOT NULL
  AND track.valid_from_generation <= schema_meta.committed_generation
  AND (track.valid_to_generation IS NULL OR schema_meta.committed_generation < track.valid_to_generation)
  AND NOT EXISTS (
    SELECT 1 FROM album
    WHERE album.server_id = track.server_id
      AND album.raw_id = track.album_raw_id
      AND album.valid_from_generation <= schema_meta.committed_generation
      AND (album.valid_to_generation IS NULL OR schema_meta.committed_generation < album.valid_to_generation)
  );

countTrackAtGeneration:
SELECT count(*) FROM track
WHERE server_id = :server_id AND raw_id = :raw_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation);

countArtistAtGeneration:
SELECT count(*) FROM artist
WHERE server_id = :server_id AND raw_id = :raw_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation);

countAlbumAtGeneration:
SELECT count(*) FROM album
WHERE server_id = :server_id AND raw_id = :raw_id
  AND valid_from_generation <= :generation
  AND (valid_to_generation IS NULL OR :generation < valid_to_generation);

countVisiblePlaylistEntriesWithoutTrack:
SELECT count(*)
FROM playlist_entry, schema_meta
WHERE playlist_entry.server_id = :server_id
  AND schema_meta.singleton_id = 1
  AND playlist_entry.valid_from_generation <= schema_meta.committed_generation
  AND (playlist_entry.valid_to_generation IS NULL OR schema_meta.committed_generation < playlist_entry.valid_to_generation)
  AND NOT EXISTS (
    SELECT 1 FROM track
    WHERE track.server_id = playlist_entry.server_id
      AND track.raw_id = playlist_entry.track_raw_id
      AND track.valid_from_generation <= schema_meta.committed_generation
      AND (track.valid_to_generation IS NULL OR schema_meta.committed_generation < track.valid_to_generation)
  );

countVisibleStarredArtistsWithoutTarget:
SELECT count(*)
FROM library_starred, schema_meta
WHERE library_starred.server_id = :server_id
  AND schema_meta.singleton_id = 1
  AND item_kind = 'artist'
  AND library_starred.valid_from_generation <= schema_meta.committed_generation
  AND (library_starred.valid_to_generation IS NULL OR schema_meta.committed_generation < library_starred.valid_to_generation)
  AND NOT EXISTS (
    SELECT 1 FROM artist WHERE artist.server_id = library_starred.server_id
      AND artist.raw_id = library_starred.raw_id
      AND artist.valid_from_generation <= schema_meta.committed_generation
      AND (artist.valid_to_generation IS NULL OR schema_meta.committed_generation < artist.valid_to_generation)
  );

countVisibleStarredAlbumsWithoutTarget:
SELECT count(*)
FROM library_starred, schema_meta
WHERE library_starred.server_id = :server_id
  AND schema_meta.singleton_id = 1
  AND item_kind = 'album'
  AND library_starred.valid_from_generation <= schema_meta.committed_generation
  AND (library_starred.valid_to_generation IS NULL OR schema_meta.committed_generation < library_starred.valid_to_generation)
  AND NOT EXISTS (
    SELECT 1 FROM album WHERE album.server_id = library_starred.server_id
      AND album.raw_id = library_starred.raw_id
      AND album.valid_from_generation <= schema_meta.committed_generation
      AND (album.valid_to_generation IS NULL OR schema_meta.committed_generation < album.valid_to_generation)
  );

countVisibleStarredTracksWithoutTarget:
SELECT count(*)
FROM library_starred, schema_meta
WHERE library_starred.server_id = :server_id
  AND schema_meta.singleton_id = 1
  AND item_kind = 'track'
  AND library_starred.valid_from_generation <= schema_meta.committed_generation
  AND (library_starred.valid_to_generation IS NULL OR schema_meta.committed_generation < library_starred.valid_to_generation)
  AND NOT EXISTS (
    SELECT 1 FROM track WHERE track.server_id = library_starred.server_id
      AND track.raw_id = library_starred.raw_id
      AND track.valid_from_generation <= schema_meta.committed_generation
      AND (track.valid_to_generation IS NULL OR schema_meta.committed_generation < track.valid_to_generation)
  );

pruneMusicFolders:
DELETE FROM music_folder WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneArtists:
DELETE FROM artist WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneAlbums:
DELETE FROM album WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneTracks:
DELETE FROM track WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneCredits:
DELETE FROM credit WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
prunePlaylists:
DELETE FROM playlist WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
prunePlaylistEntries:
DELETE FROM playlist_entry WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneStarred:
DELETE FROM library_starred WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;
pruneGenres:
DELETE FROM genre WHERE valid_to_generation IS NOT NULL AND valid_to_generation <= ?;

deleteDeletionReconciliationsForGeneration:
DELETE FROM deletion_reconciliation WHERE server_id = ? AND generation = ?;
