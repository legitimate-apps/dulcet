CREATE TABLE offline_library_settings (
  server_id TEXT NOT NULL PRIMARY KEY,
  automatic_downloads INTEGER NOT NULL DEFAULT 1 CHECK (automatic_downloads IN (0, 1)),
  cache_budget_bytes INTEGER NOT NULL DEFAULT 1073741824 CHECK (cache_budget_bytes >= 0)
);


-- The latest source size is retained independently of a streaming representation's byte length.
CREATE TABLE offline_source_snapshot (
  server_id TEXT NOT NULL,
  raw_id TEXT NOT NULL,
  duration_milliseconds INTEGER,
  size_bytes INTEGER,
  PRIMARY KEY (server_id, raw_id),
  FOREIGN KEY (server_id, raw_id) REFERENCES cache_track(server_id, raw_id) ON DELETE CASCADE
);

-- Missing ownership means explicit: pre-feature downloads are always protected.
CREATE TABLE offline_media_retention (
  server_id TEXT NOT NULL,
  raw_id TEXT NOT NULL,
  transcode_profile TEXT NOT NULL,
  explicit_download INTEGER NOT NULL CHECK (explicit_download IN (0, 1)),
  automatic_download INTEGER NOT NULL CHECK (automatic_download IN (0, 1)),
  added_rank INTEGER NOT NULL,
  last_access_wall INTEGER NOT NULL,
  PRIMARY KEY (server_id, raw_id, transcode_profile),
  FOREIGN KEY (server_id, raw_id, transcode_profile)
    REFERENCES download(server_id, raw_id, transcode_profile) ON DELETE CASCADE
);

CREATE INDEX offline_media_retention_cache
ON offline_media_retention(server_id, explicit_download, automatic_download, last_access_wall);

ensureSettings:
INSERT OR IGNORE INTO offline_library_settings(server_id) VALUES (?);
selectSettings:
SELECT * FROM offline_library_settings WHERE server_id = ?;
setAutomaticDownloads:
UPDATE offline_library_settings SET automatic_downloads = ? WHERE server_id = ?;
setCacheBudget:
UPDATE offline_library_settings SET cache_budget_bytes = ? WHERE server_id = ?;
selectRetention:
SELECT * FROM offline_media_retention WHERE server_id = ? AND raw_id = ? AND transcode_profile = ?;
selectServerRetentions:
SELECT * FROM offline_media_retention WHERE server_id = ?;
upsertRetention:
INSERT OR REPLACE INTO offline_media_retention(server_id, raw_id, transcode_profile, explicit_download, automatic_download, added_rank, last_access_wall)
VALUES (?, ?, ?, ?, ?, ?, ?);
deleteSettings:
DELETE FROM offline_library_settings WHERE server_id = ?;

-- Tee appends use this indexed cache-only aggregate, never materialize a large download library.
selectCompletedCacheBytes:
SELECT coalesce(sum(d.file_size_bytes), 0) AS cache_bytes
FROM offline_media_retention AS r
JOIN download AS d USING (server_id, raw_id, transcode_profile)
WHERE r.server_id = ? AND r.explicit_download = 0 AND r.automatic_download = 0
  AND d.state IN ('complete', 'stale');

selectCacheIdentitiesByAccess:
SELECT server_id, raw_id, transcode_profile
FROM offline_media_retention
WHERE server_id = ? AND explicit_download = 0 AND automatic_download = 0
ORDER BY last_access_wall;

-- Called only after a live cache write won its issue-sequence comparison. Applies equally to
-- downloads and streaming cache, across all representations of this source item.
markChangedSourceStale:
UPDATE download SET state = 'stale'
WHERE server_id = :server_id AND raw_id = :raw_id AND state IN ('complete', 'stale')
  AND transcode_profile IN (
    SELECT transcode_profile FROM download_policy_state
    WHERE server_id = :server_id AND raw_id = :raw_id
      AND ((source_duration_milliseconds IS NOT NULL AND :duration IS NOT NULL AND source_duration_milliseconds != :duration)
        OR (source_size_bytes IS NOT NULL AND :size IS NOT NULL AND source_size_bytes != :size))
  );

adoptLiveSourceSnapshot:
UPDATE download_policy_state SET
  source_duration_milliseconds = coalesce(:duration, source_duration_milliseconds),
  source_size_bytes = coalesce(:size, source_size_bytes)
WHERE server_id = :server_id AND raw_id = :raw_id;

selectSourceSnapshot:
SELECT duration_milliseconds, size_bytes FROM offline_source_snapshot WHERE server_id = ? AND raw_id = ?;

upsertSourceSnapshot:
INSERT OR REPLACE INTO offline_source_snapshot(server_id, raw_id, duration_milliseconds, size_bytes)
VALUES (?, ?, ?, ?);

deleteSourceSnapshots:
DELETE FROM offline_source_snapshot WHERE server_id = ?;

selectProtectedArtworkKeys:
SELECT DISTINCT coalesce(a.artwork_key, t.artwork_key) AS artwork_key
FROM download AS d
JOIN cache_track AS t ON t.server_id = d.server_id AND t.raw_id = d.raw_id
LEFT JOIN cache_album AS a ON a.server_id = t.server_id AND a.raw_id = t.album_raw_id
LEFT JOIN offline_media_retention AS r ON r.server_id = d.server_id
  AND r.raw_id = d.raw_id AND r.transcode_profile = d.transcode_profile
WHERE d.server_id = ? AND d.state IN ('complete', 'stale')
  AND (r.explicit_download IS NULL OR r.explicit_download = 1 OR r.automatic_download = 1)
  AND coalesce(a.artwork_key, t.artwork_key) IS NOT NULL;
