CREATE TABLE offline_library_settings (
  server_id TEXT NOT NULL PRIMARY KEY,
  automatic_downloads INTEGER NOT NULL DEFAULT 1 CHECK (automatic_downloads IN (0, 1)),
  cache_budget_bytes INTEGER NOT NULL DEFAULT 1073741824 CHECK (cache_budget_bytes >= 0)
);


-- The latest source size is retained independently of a streaming representation's byte length.
CREATE TABLE offline_source_snapshot (
  server_id TEXT NOT NULL,
  raw_id TEXT NOT NULL,
  duration_milliseconds INTEGER,
  size_bytes INTEGER,
  PRIMARY KEY (server_id, raw_id),
  FOREIGN KEY (server_id, raw_id) REFERENCES cache_track(server_id, raw_id) ON DELETE CASCADE
);

-- Missing ownership means explicit: pre-feature downloads are always protected.
CREATE TABLE offline_media_retention (
  server_id TEXT NOT NULL,
  raw_id TEXT NOT NULL,
  transcode_profile TEXT NOT NULL,
  explicit_download INTEGER NOT NULL CHECK (explicit_download IN (0, 1)),
  automatic_download INTEGER NOT NULL CHECK (automatic_download IN (0, 1)),
  added_rank INTEGER NOT NULL,
  last_access_wall INTEGER NOT NULL,
  PRIMARY KEY (server_id, raw_id, transcode_profile),
  FOREIGN KEY (server_id, raw_id, transcode_profile)
    REFERENCES download(server_id, raw_id, transcode_profile) ON DELETE CASCADE
);

CREATE INDEX offline_media_retention_cache
ON offline_media_retention(server_id, explicit_download, automatic_download, last_access_wall);
