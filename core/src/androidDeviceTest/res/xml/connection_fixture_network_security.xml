<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK compile template only. The disposable proof runner replaces the user entry with
     its fresh CA raw resource, then restores this file; it never changes a device trust store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
